diff --git a/src/render/rt64_profiler_worker_identity.h b/src/render/rt64_profiler_worker_identity.h
new file mode 100644
--- /dev/null
+++ b/src/render/rt64_profiler_worker_identity.h
@@ -0,0 +1,71 @@
+#pragma once
+
+// Include after rt64_render_worker.h.
+#include "common/rt64_performance_profiler.h"
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <mutex>
+
+namespace RT64::ProfilerWorkerIdentity {
+    struct Registry {
+        std::mutex mutex;
+        std::array<RenderWorker *, 64> roots{};
+        std::atomic<uint64_t> nextWorker{1};
+        uint64_t nextLogical = 1, nextNative = 1;
+    };
+
+    inline Registry &registry() {
+        // Keep the registry alive through static renderer teardown.
+        static Registry *value = new Registry();
+        return *value;
+    }
+
+    inline void assign(RenderWorker *worker, RenderWorker *sharedQueueWorker) {
+        auto &state = registry();
+        worker->profilerWorkerId = state.nextWorker.fetch_add(1, std::memory_order_relaxed);
+        bool untracked = false;
+        if (sharedQueueWorker) {
+            worker->profilerLogicalQueueId = sharedQueueWorker->profilerLogicalQueueId;
+            worker->profilerNativeQueueId = sharedQueueWorker->profilerNativeQueueId;
+        }
+        else {
+            const std::scoped_lock lock(state.mutex);
+            worker->profilerLogicalQueueId = state.nextLogical++;
+            worker->profilerNativeQueueId = 0;
+            for (RenderWorker *root : state.roots) {
+                if (root && root->device == worker->device && worker->commandQueue->sharesNativeQueue(root->commandQueue)) {
+                    worker->profilerNativeQueueId = root->profilerNativeQueueId;
+                    break;
+                }
+            }
+            auto slot = std::find(state.roots.begin(), state.roots.end(), nullptr);
+            if (slot == state.roots.end()) {
+                // Do not invent identities for untracked native objects.
+                untracked = true;
+                worker->profilerNativeQueueId = 0;
+            }
+            else {
+                if (!worker->profilerNativeQueueId) worker->profilerNativeQueueId = state.nextNative++;
+                *slot = worker;
+            }
+        }
+        PerformanceProfiler::registerRenderWorker(worker->profilerWorkerId, worker->name,
+            worker->profilerLogicalQueueId, worker->profilerNativeQueueId, static_cast<uint32_t>(worker->commandListType));
+        PerformanceProfiler::recordCriticalInstant(PerformanceCategory::CPU, "RenderWorker.IdentityRegistered",
+            worker->profilerWorkerId, worker->profilerLogicalQueueId, worker->profilerNativeQueueId);
+        if (untracked) PerformanceProfiler::recordCriticalInstant(PerformanceCategory::CPU,
+            "Recorder.WorkerIdentityCapacityExceeded", worker->profilerWorkerId);
+    }
+
+    inline void retire(RenderWorker *worker) {
+        if (worker->ownedCommandQueue) {
+            auto &state = registry();
+            const std::scoped_lock lock(state.mutex);
+            auto slot = std::find(state.roots.begin(), state.roots.end(), worker);
+            if (slot != state.roots.end()) *slot = nullptr;
+        }
+        PerformanceProfiler::recordCriticalInstant(PerformanceCategory::CPU, "RenderWorker.IdentityRetired",
+            worker->profilerWorkerId, worker->profilerLogicalQueueId, worker->profilerNativeQueueId);
+    }
+}
diff --git a/src/render/rt64_profiler_gpu_queries.h b/src/render/rt64_profiler_gpu_queries.h
new file mode 100644
--- /dev/null
+++ b/src/render/rt64_profiler_gpu_queries.h
@@ -0,0 +1,61 @@
+#pragma once
+
+#include "common/rt64_performance_profiler.h"
+#include <atomic>
+
+namespace RT64::ProfilerGpuQueries {
+    inline uint64_t nextFailureIdentity() {
+        static std::atomic<uint64_t> next{1};
+        return next.fetch_add(1, std::memory_order_relaxed);
+    }
+    // A sampled output may execute several serial workload command lists.
+    struct FrameSpan {
+        uint64_t begin = 0, end = 0;
+        uint32_t parts = 0;
+        bool valid = true;
+        bool include(uint64_t first, uint64_t last) {
+            if (!valid || first > last || (parts && first < end) || parts == UINT32_MAX) {
+                valid = false;
+                return false;
+            }
+            if (!parts) begin = first;
+            end = last;
+            ++parts;
+            return true;
+        }
+        void unavailable() { valid = false; }
+        bool complete() const { return valid && parts != 0; }
+    };
+
+    // Call after fence retirement and queryResults.
+    template<class QueryPool> bool validRead(const QueryPool *pool,
+        uint32_t first, uint32_t count, uint64_t owner, bool sequential = false) {
+        if (!pool || !pool->queryResultsValid(first, count)) {
+            PerformanceProfiler::recordCriticalInstant(PerformanceCategory::GPU,
+                "Recorder.GPUQueryReadUnavailable", owner, first, count);
+            return false;
+        }
+        const uint64_t *values = pool->getResults();
+        if (!values) {
+            PerformanceProfiler::recordCriticalInstant(PerformanceCategory::GPU,
+                "Recorder.GPUQueryReadUnavailable", owner, first, count);
+            return false;
+        }
+        // Draw ranges can contain nested begin/end pairs.
+        for (uint32_t i = 1; i < count; i += sequential ? 1 : 2) {
+            if (values[first + i] < values[first + i - 1]) {
+                // Keep the actual rejected values.
+                const uint64_t failure = nextFailureIdentity();
+                PerformanceProfiler::recordCriticalInstant(PerformanceCategory::GPU,
+                    "GPU.QueryOrderFailureOwner", failure, owner,
+                    (uint64_t(first + i - 1) << 32) | (first + i));
+                PerformanceProfiler::recordCriticalInstant(PerformanceCategory::GPU,
+                    "GPU.QueryOrderFailureValues", failure, values[first + i - 1], values[first + i]);
+                PerformanceProfiler::recordCriticalInstant(PerformanceCategory::GPU,
+                    "Recorder.GPUQueryTimestampOrderInvalid", owner, first + i - 1, first + i);
+                return false;
+            }
+        }
+        return true;
+    }
+}
diff --git a/src/render/rt64_profiler_gpu_clocks.h b/src/render/rt64_profiler_gpu_clocks.h
new file mode 100644
--- /dev/null
+++ b/src/render/rt64_profiler_gpu_clocks.h
@@ -0,0 +1,83 @@
+#pragma once
+// Include after rt64_render_worker.h.
+#include "common/rt64_performance_profiler.h"
+#include <atomic>
+#include <cmath>
+#include <limits>
+#ifdef _WIN32
+#include <windows.h>
+#else
+#include <time.h>
+#endif
+
+namespace RT64::ProfilerGpuClocks {
+    inline void recordFrame(RenderWorker *worker, uint64_t frame, uint64_t workload) {
+        if (!PerformanceProfiler::gpuInstrumentationEnabled() || !worker || !worker->commandQueue) return;
+        static std::atomic<bool> declared{false};
+        if (!declared.exchange(true, std::memory_order_relaxed)) {
+            PerformanceProfiler::setMetadata("producer.gpu_clock_calibration.supported", "1");
+            PerformanceProfiler::setMetadata("producer.gpu_clock_calibration.enabled", "1");
+        }
+        const uint64_t queue = worker->profilerNativeQueueId;
+        PerformanceProfiler::recordCriticalInstant(PerformanceCategory::GPU, "GPU.FrameQueue", frame, workload, queue);
+        PerformanceScope overhead(PerformanceCategory::CPU, "Recorder.GPUClockCalibration", queue);
+        plume::ProfileClockCalibration sample;
+        auto unavailable = [&](uint64_t reason) {
+            PerformanceProfiler::recordCriticalInstant(PerformanceCategory::GPU,
+                "GPU.ClockCalibrationUnavailable", queue, reason);
+        };
+        if (!queue || !worker->commandQueue->getProfileClockCalibration(sample)) {
+            unavailable(0);
+            return;
+        }
+        uint64_t host = 0;
+        const uint64_t before = PerformanceProfiler::nowNanoseconds();
+#ifdef _WIN32
+        LARGE_INTEGER ticks;
+        if (sample.hostClock != plume::ProfileHostClock::QueryPerformanceCounter || !QueryPerformanceCounter(&ticks)) {
+            unavailable(1);
+            return;
+        }
+        host = uint64_t(ticks.QuadPart);
+#else
+        timespec ticks;
+        if (sample.hostClock != plume::ProfileHostClock::Monotonic || clock_gettime(CLOCK_MONOTONIC, &ticks) != 0) {
+            unavailable(1);
+            return;
+        }
+        host = uint64_t(ticks.tv_sec) * 1000000000 + uint64_t(ticks.tv_nsec);
+#endif
+        const uint64_t after = PerformanceProfiler::nowNanoseconds();
+        const uint64_t deltaTicks = host >= sample.hostTicks ? host - sample.hostTicks : sample.hostTicks - host;
+        const long double delta = sample.hostFrequency ?
+            static_cast<long double>(deltaTicks) * 1000000000.0L / sample.hostFrequency : -1;
+        if (!(delta >= 0 && delta <= 60000000000.0L) || after < before ||
+                !(sample.queryScaleErrorPartsPerBillion >= 0 && sample.queryScaleErrorPartsPerBillion <= 1000000000.0)) {
+            unavailable(2);
+            return;
+        }
+        const uint64_t middle = before + (after - before) / 2;
+        if ((host >= sample.hostTicks && uint64_t(delta) > middle) ||
+                (host < sample.hostTicks && uint64_t(delta) > UINT64_MAX - middle)) {
+            unavailable(2);
+            return;
+        }
+        const uint64_t cpu = host >= sample.hostTicks ? middle - uint64_t(delta) : middle + uint64_t(delta);
+        const uint64_t bridgeError = (after - before + 1) / 2 +
+            uint64_t(std::ceil(1000000000.0 / sample.hostFrequency)) + 2;
+        uint64_t error = UINT64_MAX;
+        if (sample.maximumDeviationKnown && sample.maximumDeviationNanoseconds < UINT64_MAX - bridgeError) {
+            error = sample.maximumDeviationNanoseconds + bridgeError;
+        }
+        static std::atomic<uint64_t> next{1};
+        const uint64_t identity = next.fetch_add(1, std::memory_order_relaxed);
+        PerformanceProfiler::recordCriticalInstant(PerformanceCategory::GPU, "GPU.ClockPair", identity,
+            sample.gpuNanoseconds, cpu);
+        PerformanceProfiler::recordCriticalInstant(PerformanceCategory::GPU, "GPU.ClockQueue", identity,
+            queue, uint64_t(sample.timestampValidBits) | (uint64_t(sample.hostClock) << 32));
+        PerformanceProfiler::recordCriticalInstant(PerformanceCategory::GPU, "GPU.ClockQuality", identity,
+            error, uint64_t(std::ceil(sample.queryScaleErrorPartsPerBillion)));
+        PerformanceProfiler::recordCriticalInstant(PerformanceCategory::GPU, "GPU.ClockWrap", identity,
+            sample.gpuWrapNanoseconds);
+    }
+}
