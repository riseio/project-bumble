+        // Enforce a hard disk quota on the writer thread, including metadata.
+        class LimitedOutput : public std::streambuf {
+            std::streambuf *destination;
+            uint64_t remaining;
+        protected:
+            std::streamsize xsputn(const char *data, std::streamsize count) override {
+                const auto allowed = std::min<uint64_t>(uint64_t(count), remaining);
+                const auto written = destination->sputn(data, std::streamsize(allowed));
+                remaining -= uint64_t(written);
+                return written;
+            }
+            int_type overflow(int_type character) override {
+                if (traits_type::eq_int_type(character, traits_type::eof())) return traits_type::not_eof(character);
+                if (!remaining) return traits_type::eof();
+                const auto result = destination->sputc(traits_type::to_char_type(character));
+                if (!traits_type::eq_int_type(result, traits_type::eof())) --remaining;
+                return result;
+            }
+            int sync() override { return destination->pubsync(); }
+        public:
+            LimitedOutput(std::streambuf *destination, uint64_t quota) : destination(destination), remaining(quota) {}
+            uint64_t unused() const { return remaining; }
+        };
 
