+            base += ".snapshot-" + std::to_string(generation) + ".json";
+            const std::filesystem::path journalPath = base.string() + ".journal.jsonl";
+            const std::filesystem::path summaryPath = base.string() + ".summary.json";
+            if (std::filesystem::exists(journalPath) || std::filesystem::exists(summaryPath)) return false;
+            if (profiler.snapshotBytes >= profiler.maximumSnapshotBytes) return false;
+            std::ofstream journalFile(journalPath, std::ios::binary);
+            if (!journalFile) return false;
+            const uint64_t available = profiler.maximumSnapshotBytes - profiler.snapshotBytes;
+            LimitedOutput limited(journalFile.rdbuf(), available);
+            std::ostream journal(&limited);
+            journal << "{\"record\":\"header\",\"schema\":\"rt64-performance-journal-v1\"}\n";
+            std::map<std::string, std::string> metadata;
+            { const std::scoped_lock lock(profiler.metadataMutex); metadata = profiler.metadata; }
+            for (const auto &entry : metadata) journal << "{\"record\":\"metadata\",\"key\":\""
+                << jsonEscape(entry.first) << "\",\"value\":\"" << jsonEscape(entry.second) << "\"}\n";
+            for (const auto &event : events) writeJournalEvent(journal, event);
+            journal.flush();
+            const bool healthy = journal.good();
+            journalFile.close();
+            profiler.snapshotBytes += available - limited.unused();
+            if (!healthy || journalFile.fail()) return false;
+            std::ofstream summary(summaryPath, std::ios::binary);
+            summary << "{\"schema\":\"n64profiler-snapshot-v1\",\"analysis_scope\":\"ROLLING_EVENT_WINDOW\",\"budget_ms\":"
+                << profiler.budgetMilliseconds << ",\"durability\":{\"journal_healthy\":true,\"journal_events_written\":"
+                << events.size() << ",\"events_dropped\":" << busy + ring->dropped()
+                << ",\"events_streamed_only\":0},\"snapshot_generation\":" << generation << "}\n";
