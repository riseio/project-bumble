+        // Accept valid Unicode scalar values only.
+        bool validUTF8(std::string_view text, bool allowNull = true) {
+            for (size_t i = 0; i < text.size();) {
+                const auto first = static_cast<unsigned char>(text[i++]);
+                if (first < 0x80) {
+                    if (!allowNull && first == 0) return false;
+                    continue;
+                }
+                const size_t extra = first >= 0xc2 && first <= 0xdf ? 1 :
+                    first >= 0xe0 && first <= 0xef ? 2 :
+                    first >= 0xf0 && first <= 0xf4 ? 3 : 0;
+                if (!extra || extra > text.size() - i) return false;
+                const auto second = static_cast<unsigned char>(text[i]);
+                if ((first == 0xe0 && second < 0xa0) || (first == 0xed && second >= 0xa0) ||
+                    (first == 0xf0 && second < 0x90) || (first == 0xf4 && second >= 0x90)) return false;
+                for (size_t j = 0; j < extra; ++j) {
+                    const auto continuation = static_cast<unsigned char>(text[i++]);
+                    if (continuation < 0x80 || continuation > 0xbf) return false;
+                }
+            }
+            return true;
+        }
