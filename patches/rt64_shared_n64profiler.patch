+        // Detailed attachments have an independent, hard session budget.
+        class AttachmentWriter {
+            struct Job {
+                std::filesystem::path path;
+                std::vector<char> data;
+                std::function<void(bool)> completed;
+            };
+            std::mutex mutex;
+            std::condition_variable ready;
+            std::deque<Job> jobs;
+            std::thread worker;
+            bool closed = false;
+            uint64_t pending = 0;
+            void run() {
+                for (;;) {
+                    Job job;
+                    {
+                        std::unique_lock<std::mutex> lock(mutex);
+                        ready.wait(lock, [&] { return closed || !jobs.empty(); });
+                        if (jobs.empty()) return;
+                        job = std::move(jobs.front()); jobs.pop_front();
+                    }
+#ifdef _WIN32
+                    FILE *file = _wfopen(job.path.c_str(), L"wbx");
+#else
+                    FILE *file = std::fopen(job.path.c_str(), "wbx");
+#endif
+                    bool success = false;
+                    if (file) {
+                        success = std::fwrite(job.data.data(), 1, job.data.size(), file) == job.data.size();
+                        success = (std::fclose(file) == 0) && success;
+                    }
+                    if (success) { written.fetch_add(job.data.size()); completed.fetch_add(1); }
+                    else failed.fetch_add(1);
+                    job.completed(success);
+                    const size_t size = job.data.size();
+                    std::vector<char>().swap(job.data);
+                    std::lock_guard<std::mutex> lock(mutex);
+                    pending -= size;
+                }
+            }
+        public:
+            uint64_t maximumBytes = 256ull * 1024 * 1024;
+            static constexpr uint64_t maximumPending = 64ull * 1024 * 1024;
+            std::atomic<uint64_t> reserved{0}, written{0}, rejected{0}, failed{0}, completed{0}, highWater{0};
+            bool enqueue(std::filesystem::path path, const void *data, size_t bytes,
+                    std::function<void(bool)> callback) {
+                std::unique_lock<std::mutex> lock(mutex, std::try_to_lock);
+                if (!lock || closed || bytes == 0 || bytes > maximumPending ||
+                    pending > maximumPending - bytes || jobs.size() >= 8 ||
+                    bytes > maximumBytes || reserved.load() > maximumBytes - bytes) {
+                    rejected.fetch_add(1); return false;
+                }
+                try {
+                    Job job{std::move(path), std::vector<char>(bytes), std::move(callback)};
+                    std::memcpy(job.data.data(), data, bytes);
+                    if (!worker.joinable()) worker = std::thread([this] { run(); });
+                    jobs.emplace_back(std::move(job));
+                }
+                catch (...) { rejected.fetch_add(1); return false; }
+                pending += bytes; reserved.fetch_add(bytes);
+                highWater.store(std::max(highWater.load(), pending));
+                ready.notify_one();
+                return true;
+            }
+            void stop() {
+                { std::lock_guard<std::mutex> lock(mutex); closed = true; }
+                ready.notify_all();
+                if (worker.joinable()) worker.join();
+            }
+        };
