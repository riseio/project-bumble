diff --git a/src/common/rt64_profiler_ring.h b/src/common/rt64_profiler_ring.h
new file mode 100644
--- /dev/null
+++ b/src/common/rt64_profiler_ring.h
@@ -0,0 +1,61 @@
+#pragma once
+
+#include <algorithm>
+#include <atomic>
+#include <cstdint>
+#include <memory>
+#include <vector>
+
+namespace RT64::RecorderStorage {
+    // Fixed memory; O(1) producer work.
+    template<class Event> class Ring {
+        struct Slot {
+            std::atomic_flag owned = ATOMIC_FLAG_INIT;
+            uint64_t sequence = 0;
+            Event event{};
+        };
+        std::unique_ptr<Slot[]> slots;
+        uint64_t capacity;
+        std::atomic<uint64_t> next{0};
+        std::atomic<uint64_t> lost{0};
+    public:
+        explicit Ring(uint64_t count) : slots(new Slot[count]), capacity(count) {}
+
+        void append(const Event &event) {
+            const uint64_t ticket = next.fetch_add(1, std::memory_order_relaxed) + 1;
+            Slot &slot = slots[(ticket - 1) % capacity];
+            if (slot.owned.test_and_set(std::memory_order_acquire)) {
+                lost.fetch_add(1, std::memory_order_relaxed);
+                return;
+            }
+            if (slot.sequence < ticket) {
+                slot.event = event;
+                slot.sequence = ticket;
+            }
+            else lost.fetch_add(1, std::memory_order_relaxed);
+            slot.owned.clear(std::memory_order_release);
+        }
+
+        std::vector<Event> snapshot(uint64_t &busy) {
+            struct Copy { uint64_t sequence; Event event; };
+            std::vector<Copy> copies;
+            copies.reserve(size_t(capacity));
+            const uint64_t end = next.load(std::memory_order_acquire);
+            const uint64_t begin = end > capacity ? end - capacity : 0;
+            for (uint64_t i = 0; i < capacity; ++i) {
+                Slot &slot = slots[i];
+                if (slot.owned.test_and_set(std::memory_order_acquire)) { ++busy; continue; }
+                if (slot.sequence > begin && slot.sequence <= end) copies.push_back({slot.sequence, slot.event});
+                slot.owned.clear(std::memory_order_release);
+            }
+            std::sort(copies.begin(), copies.end(), [](const Copy &a, const Copy &b) { return a.sequence < b.sequence; });
+            std::vector<Event> events;
+            events.reserve(copies.size());
+            for (const auto &copy : copies) events.push_back(copy.event);
+            return events;
+        }
+        uint64_t submitted() const { return next.load(std::memory_order_acquire); }
+        uint64_t dropped() const { return lost.load(std::memory_order_acquire); }
+        uint64_t bytes() const { return capacity * sizeof(Slot); }
+    };
+}
diff --git a/src/common/rt64_profiler_aggregates.h b/src/common/rt64_profiler_aggregates.h
new file mode 100644
--- /dev/null
+++ b/src/common/rt64_profiler_aggregates.h
@@ -0,0 +1,103 @@
+#pragma once
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <cstring>
+#include <string_view>
+
+namespace RT64::RecorderStorage {
+#ifndef N64PROFILER_AGGREGATE_SHARDS
+#define N64PROFILER_AGGREGATE_SHARDS 8
+#endif
+    constexpr size_t AggregateShardCount = N64PROFILER_AGGREGATE_SHARDS;
+    static_assert(AggregateShardCount == 1 || AggregateShardCount == 8);
+    // CPU-scope aggregates survive event eviction and filtering.
+    struct alignas(64) AggregateShard {
+        std::atomic<uint64_t> count{0}, total{0}, maximum{0}, minimum{UINT64_MAX};
+        std::array<std::atomic<uint64_t>, 64> histogram{};
+    };
+    struct AggregateSnapshot {
+        uint64_t count = 0, total = 0, maximum = 0, minimum = UINT64_MAX;
+        std::array<uint64_t, 64> histogram{};
+        bool overflow = false;
+        void merge(const AggregateSnapshot &other) {
+            const auto add = [&](uint64_t &target, uint64_t amount) {
+                if (amount > UINT64_MAX - target) { target = UINT64_MAX; overflow = true; }
+                else target += amount;
+            };
+            add(count, other.count);
+            add(total, other.total);
+            if (other.minimum < minimum) minimum = other.minimum;
+            if (other.maximum > maximum) maximum = other.maximum;
+            overflow = overflow || other.overflow;
+            for (size_t i = 0; i < histogram.size(); ++i) add(histogram[i], other.histogram[i]);
+        }
+    };
+    struct Aggregate {
+        std::atomic<uint64_t> identity{0};
+        std::atomic<bool> ready{false};
+        std::array<char, 80> name{};
+        uint8_t category = 0;
+        // Separate cache lines for concurrent producers.
+        std::array<AggregateShard, AggregateShardCount> shards{};
+        AggregateSnapshot snapshot() const {
+            AggregateSnapshot value;
+            const auto add = [&](uint64_t &target, uint64_t amount) {
+                if (amount > UINT64_MAX - target) { target = UINT64_MAX; value.overflow = true; }
+                else target += amount;
+            };
+            for (const auto &shard : shards) {
+                add(value.count, shard.count.load(std::memory_order_relaxed));
+                add(value.total, shard.total.load(std::memory_order_relaxed));
+                const uint64_t minimum = shard.minimum.load(std::memory_order_relaxed);
+                const uint64_t maximum = shard.maximum.load(std::memory_order_relaxed);
+                if (minimum < value.minimum) value.minimum = minimum;
+                if (maximum > value.maximum) value.maximum = maximum;
+                for (size_t i = 0; i < value.histogram.size(); ++i) add(value.histogram[i], shard.histogram[i].load(std::memory_order_relaxed));
+            }
+            return value;
+        }
+    };
+    struct Aggregates {
+        std::array<Aggregate, 1024> entries{};
+        std::atomic<uint64_t> rejected{0};
+        void observe(std::string_view name, uint8_t category, uint64_t duration) {
+            static std::atomic<uint64_t> nextShard{0};
+            static thread_local const size_t shardIndex = nextShard.fetch_add(1, std::memory_order_relaxed) % AggregateShardCount;
+            if (name.empty() || name.size() >= 80) { ++rejected; return; }
+            uint64_t key = 14695981039346656037ULL;
+            for (unsigned char c : name) { key ^= c; key *= 1099511628211ULL; }
+            key ^= category;
+            if (key == 0) key = 1;
+            for (size_t probe = 0; probe < 32; ++probe) {
+                Aggregate &entry = entries[(key + probe) % entries.size()];
+                uint64_t empty = 0;
+                if (entry.identity.load(std::memory_order_acquire) == 0 &&
+                    entry.identity.compare_exchange_strong(empty, key, std::memory_order_acq_rel)) {
+                    std::memcpy(entry.name.data(), name.data(), name.size());
+                    entry.category = category;
+                    entry.ready.store(true, std::memory_order_release);
+                }
+                if (entry.identity.load(std::memory_order_acquire) != key) continue;
+                // Initialization may be descheduled; wait for publication.
+                if (!entry.ready.load(std::memory_order_acquire)) continue;
+                if (entry.category != category || std::string_view(entry.name.data()) != name) continue;
+                auto &shard = entry.shards[shardIndex];
+                uint64_t total = shard.total.load(std::memory_order_relaxed);
+                do {
+                    if (duration > UINT64_MAX - total) { ++rejected; return; }
+                } while (!shard.total.compare_exchange_weak(total, total + duration, std::memory_order_relaxed));
+                shard.count.fetch_add(1, std::memory_order_relaxed);
+                uint64_t minimum = shard.minimum.load(std::memory_order_relaxed);
+                while (duration < minimum && !shard.minimum.compare_exchange_weak(minimum, duration, std::memory_order_relaxed)) {}
+                uint64_t maximum = shard.maximum.load(std::memory_order_relaxed);
+                while (duration > maximum && !shard.maximum.compare_exchange_weak(maximum, duration, std::memory_order_relaxed)) {}
+                unsigned bin = 0;
+                for (uint64_t v = duration; v > 1; v >>= 1) ++bin;
+                shard.histogram[bin].fetch_add(1, std::memory_order_relaxed);
+                return;
+            }
+            ++rejected;
+        }
+    };
+}
