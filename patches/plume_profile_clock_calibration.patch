+    bool D3D12CommandQueue::getProfileClockCalibration(ProfileClockCalibration &sample) {
+        sample = {};
+        UINT64 gpuTicks = 0, hostTicks = 0, frequency = 0;
+        LARGE_INTEGER hostFrequency;
+        if (FAILED(d3d->GetTimestampFrequency(&frequency)) || !frequency ||
+                frequency != device->timestampFrequency ||
+                FAILED(d3d->GetClockCalibration(&gpuTicks, &hostTicks)) ||
+                !QueryPerformanceFrequency(&hostFrequency) || hostFrequency.QuadPart <= 0) return false;
+        // Same conversion as the owning D3D12 query pool.
+        const double nanoseconds = double(gpuTicks) / double(frequency) * 1000000000.0;
+        if (!(nanoseconds >= 0.0 && nanoseconds < 18446744073709551616.0)) return false;
+        sample.gpuNanoseconds = uint64_t(nanoseconds);
+        sample.hostTicks = hostTicks;
+        sample.hostFrequency = uint64_t(hostFrequency.QuadPart);
+        sample.hostClock = ProfileHostClock::QueryPerformanceCounter;
+        sample.timestampValidBits = 64;
+        // GetClockCalibration provides no maximum-deviation estimate.
+        sample.maximumDeviationKnown = false;
+        return true;
+    }
+
     std::unique_ptr<RenderCommandList> D3D12CommandQueue::createCommandList() {
         return std::make_unique<D3D12CommandList>(this);
     }
