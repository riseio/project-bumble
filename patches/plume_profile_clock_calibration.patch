+    bool VulkanCommandQueue::getProfileClockCalibration(ProfileClockCalibration &sample) {
+        sample = {};
+        if (!device->profileCalibrationExtension) return false;
+        const bool khr = device->profileCalibrationExtension == 2;
+        const auto domains = reinterpret_cast<PFN_vkGetPhysicalDeviceCalibrateableTimeDomainsEXT>(
+            vkGetInstanceProcAddr(device->renderInterface->instance,
+                khr ? "vkGetPhysicalDeviceCalibrateableTimeDomainsKHR" : "vkGetPhysicalDeviceCalibrateableTimeDomainsEXT"));
+        const auto timestamps = reinterpret_cast<PFN_vkGetCalibratedTimestampsEXT>(
+            vkGetDeviceProcAddr(device->vk, khr ? "vkGetCalibratedTimestampsKHR" : "vkGetCalibratedTimestampsEXT"));
+        if (!domains || !timestamps) return false;
+        // Tiny fixed arrays: never allocate or retry on a game worker.
+        VkTimeDomainEXT available[16] = {};
+        uint32_t count = 16;
+        if (domains(device->physicalDevice, &count, available) != VK_SUCCESS) return false;
+#ifdef _WIN32
+        constexpr auto hostDomain = VK_TIME_DOMAIN_QUERY_PERFORMANCE_COUNTER_EXT;
+        LARGE_INTEGER frequency;
+        if (!QueryPerformanceFrequency(&frequency) || frequency.QuadPart <= 0) return false;
+        sample.hostClock = ProfileHostClock::QueryPerformanceCounter;
+        sample.hostFrequency = uint64_t(frequency.QuadPart);
+#else
+        constexpr auto hostDomain = VK_TIME_DOMAIN_CLOCK_MONOTONIC_EXT;
+        sample.hostClock = ProfileHostClock::Monotonic;
+        sample.hostFrequency = 1000000000;
+#endif
+        bool host = false, gpu = false;
+        for (uint32_t i = 0; i < count; ++i) {
+            host |= available[i] == hostDomain;
+            gpu |= available[i] == VK_TIME_DOMAIN_DEVICE_EXT;
+        }
+        if (!host || !gpu) return false;
+        VkQueueFamilyProperties families[32] = {};
+        uint32_t familyCount = 32;
+        vkGetPhysicalDeviceQueueFamilyProperties(device->physicalDevice, &familyCount, families);
+        if (familyIndex >= familyCount || familyIndex >= 32) return false;
+        sample.timestampValidBits = families[familyIndex].timestampValidBits;
+        if (!sample.timestampValidBits || sample.timestampValidBits > 64) return false;
+        VkCalibratedTimestampInfoEXT info[2] = {};
+        info[0].sType = info[1].sType = VK_STRUCTURE_TYPE_CALIBRATED_TIMESTAMP_INFO_EXT;
+        info[0].timeDomain = VK_TIME_DOMAIN_DEVICE_EXT;
+        info[1].timeDomain = hostDomain;
+        uint64_t values[2] = {}, deviation = 0;
+        if (timestamps(device->vk, 2, info, values, &deviation) != VK_SUCCESS || !deviation) return false;
+        const double period = device->physicalDeviceProperties.limits.timestampPeriod;
+        if (sample.timestampValidBits < 64) {
+            const uint64_t wrapTicks = uint64_t(1) << sample.timestampValidBits;
+            values[0] &= wrapTicks - 1;
+            if (!profileVulkanNanoseconds(wrapTicks, period, sample.gpuWrapNanoseconds)) return false;
+        }
+        if (!profileVulkanNanoseconds(values[0], period, sample.gpuNanoseconds)) return false;
+        const double effectivePeriod = double(uint64_t(period * 65536.0)) / 65536.0;
+        sample.queryScaleErrorPartsPerBillion = (period / effectivePeriod - 1.0) * 1000000000.0;
+        sample.hostTicks = values[1];
+        sample.maximumDeviationKnown = true;
+        sample.maximumDeviationNanoseconds = deviation;
+        return true;
+    }
+
