diff --git a/src/shaders/GeometryDepthCS.hlsl b/src/shaders/GeometryDepthCS.hlsl
new file mode 100644
--- /dev/null
+++ b/src/shaders/GeometryDepthCS.hlsl
@@ -0,0 +1,23 @@
+// Opt-in numeric profiler readback. Does not write the game's render targets.
+struct GeometryDepthCB { uint width; uint height; uint samples; };
+[[vk::push_constant]] ConstantBuffer<GeometryDepthCB> gConstants : register(b0);
+#ifdef MULTISAMPLING
+Texture2DMS<float> sourceDepth : register(t1);
+#else
+Texture2D<float> sourceDepth : register(t1);
+#endif
+RWStructuredBuffer<float2> depthExtrema : register(u2);
+[numthreads(8, 8, 1)]
+void CSMain(uint2 pixel : SV_DispatchThreadID) {
+    if (pixel.x >= gConstants.width || pixel.y >= gConstants.height) { return; }
+#ifdef MULTISAMPLING
+    float lo = sourceDepth.Load(pixel, 0), hi = lo;
+    for (uint s = 1; s < gConstants.samples; ++s) {
+        float z = sourceDepth.Load(pixel, s);
+        lo = min(lo, z); hi = max(hi, z);
+    }
+#else
+    float lo = sourceDepth.Load(uint3(pixel, 0)), hi = lo;
+#endif
+    depthExtrema[pixel.y * gConstants.width + pixel.x] = float2(lo, hi);
+}
