diff --git a/src/render/rt64_geometry_records.h b/src/render/rt64_geometry_records.h
new file mode 100644
--- /dev/null
+++ b/src/render/rt64_geometry_records.h
@@ -0,0 +1,75 @@
+#pragma once
+#include "common/rt64_performance_profiler.h"
+#include <algorithm>
+#include <array>
+#include <cstring>
+#include <string>
+#include <vector>
+
+namespace RT64 {
+// Fixed RT64 geometry fields, not a general event serialization protocol.
+inline constexpr const char *GeometryRecordNames[] = {
+    "Geometry.VertexOwner", "Geometry.SourceXY", "Geometry.SourceZW", "Geometry.NativeXY", "Geometry.NativeZW",
+    "Geometry.RebuiltXY", "Geometry.RebuiltZW", "Geometry.RenderXY", "Geometry.RenderZW", "Geometry.VertexState",
+    "Geometry.IndexPair", "Geometry.InvalidModify", "Geometry.RepeatedModify", "Geometry.InvalidVertex",
+    "Geometry.SourceAddressUnavailable", "Geometry.DrawRange", "Geometry.DrawMode", "Geometry.DrawOwner",
+    "Geometry.DrawIdentity", "Geometry.DrawAlpha", "Geometry.DrawAlphaCompare", "Geometry.DrawCombiner",
+    "Geometry.GPUXY", "Geometry.GPUZW", "Geometry.InvalidGPU"
+};
+class GeometryRecords {
+    struct Record { uint32_t field, reserved = 0; uint64_t a, b; };
+    static_assert(sizeof(Record) == 24);
+    static constexpr size_t Limit = (16 * 1024 * 1024) / sizeof(Record);
+    std::vector<Record> records;
+    uint64_t workload, output;
+    bool gpu, rejected = false;
+public:
+    GeometryRecords(uint64_t workload, uint64_t output, bool gpu, size_t expected) : workload(workload), output(output), gpu(gpu) {
+        try { records.reserve(std::min(Limit, expected)); }
+        catch (const std::bad_alloc &) { rejected = true; }
+    }
+    void event(const char *name, uint64_t a, uint64_t b) {
+        for (uint32_t field = 0; field < std::size(GeometryRecordNames); ++field) {
+            if (std::strcmp(name, GeometryRecordNames[field]) != 0) continue;
+            if (rejected || records.size() == Limit) { rejected = true; return; }
+            try {
+                if (records.size() == records.capacity()) records.reserve(std::min(Limit, std::max(size_t(64), records.capacity() * 2)));
+            }
+            catch (const std::bad_alloc &) { rejected = true; return; }
+            records.push_back({field, 0, a, b});
+            return;
+        }
+        PerformanceProfiler::recordCriticalInstant(PerformanceCategory::Counter, name, workload, a, b);
+    }
+    bool finish() try {
+        if (rejected) {
+            PerformanceProfiler::recordCriticalInstant(PerformanceCategory::Counter, "Geometry.Rejected", workload, output, records.size());
+            return false;
+        }
+        // A zero-record workload still publishes a header.
+        struct Header { uint64_t magic, workload, output, count; };
+        const Header header{0x314f454734364eULL, workload, output, records.size()};
+        std::vector<uint8_t> bytes(sizeof(header) + records.size() * sizeof(Record));
+        std::memcpy(bytes.data(), &header, sizeof(header));
+        if (!records.empty()) std::memcpy(bytes.data() + sizeof(header), records.data(), records.size() * sizeof(Record));
+        static const auto table = [] {
+            std::array<uint32_t, 256> values{};
+            for (uint32_t i = 0; i < 256; ++i) {
+                uint32_t value = i;
+                for (unsigned bit = 0; bit < 8; ++bit) value = (value >> 1) ^ ((value & 1) ? 0xedb88320U : 0);
+                values[i] = value;
+            }
+            return values;
+        }();
+        uint32_t crc = UINT32_MAX;
+        for (uint8_t byte : bytes) crc = table[(crc ^ byte) & 255] ^ (crc >> 8);
+        crc ^= UINT32_MAX;
+        std::string suffix = std::string(".geometry-") + (gpu ? "gpu-" : "cpu-") + std::to_string(workload) + "-" + std::to_string(output) + ".bin";
+        return PerformanceProfiler::writeAttachment(suffix, bytes.data(), bytes.size(),
+            gpu ? "Geometry.BinaryGPU" : "Geometry.BinaryCPU", workload, output, crc);
+    } catch (const std::bad_alloc &) {
+        PerformanceProfiler::recordCriticalInstant(PerformanceCategory::Counter, "Geometry.Rejected", workload, output, records.size());
+        return false;
+    }
+};
+}
