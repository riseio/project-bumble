+#pragma once
+#include <cstdint>
+#include "rt64_render_worker.h"
+#include "shared/rt64_hlsl.h"
+#include "rt64_descriptor_sets.h"
+#if __has_include("rt64_conforming_mesh.h")
+#include "rt64_conforming_mesh.h"
+#define RT64_PROFILER_CONFORMING_SUPPORT 1
+#endif
+
+namespace RT64 {
+    struct Workload;
+    struct GameFrameMap;
+    struct RenderTarget;
+    struct ShaderLibrary;
+    // Opt-in numeric geometry evidence, never a rendering or matching policy.
+    bool profileGeometry(const Workload &workload, const GameFrameMap &map,
+        uint32_t workloadIndex, uint64_t output, float weight,
+        bool processedTransforms, bool processedProjections);
+    bool geometryGPUEnabled();
+    void profileGeometryRasterState(uint32_t call, const hlslpp::float2 &resolution,
+        const RenderViewport &viewport, const RenderRect &scissor,
+        const hlslpp::float2 &scale, const hlslpp::float2 &offset, uint32_t flags,
+        const hlslpp::float2 &primDepth, const RenderMultisampling &multisampling);
+    void profileGeometryRasterSubmitted(uint32_t call);
+    std::unique_ptr<RenderBuffer> recordGeometryReadback(RenderWorker *worker,
+        const Workload &workload);
+    struct GeometryDepthReadback {
+        std::unique_ptr<RenderBuffer> gpu, readback;
+        std::unique_ptr<GeometryDepthDescriptorSet> descriptors;
+        uint32_t framebuffer = 0, width = 0, height = 0, samples = 0;
+    };
+    struct GeometryReadback {
+        std::unique_ptr<RenderBuffer> buffer;
+        uint64_t workloadId = 0, output = 0;
+        uint32_t vertexCount = 0;
+        bool pending = false;
+#ifdef RT64_PROFILER_CONFORMING_SUPPORT
+        std::vector<ConformingDerivedVertex> derived;
+#endif
+        std::vector<GeometryDepthReadback> depth;
+    };
+    bool geometryCoverageEnabled();
+    void recordGeometryDepth(RenderWorker *worker, RenderTarget &target,
+        const ShaderLibrary &shaders, uint32_t framebuffer, GeometryReadback &capture,
+        RenderTextureLayout restoreLayout);
+    void finishGeometryDepth(GeometryReadback &capture);
+    void finishGeometryReadback(GeometryReadback &readback);
+}
diff --git a/src/render/rt64_geometry_profiler.cpp b/src/render/rt64_geometry_profiler.cpp
new file mode 100644
--- /dev/null
+++ b/src/render/rt64_geometry_profiler.cpp
@@ -0,0 +1,295 @@
+#include "rt64_geometry_profiler.h"
+#include "rt64_geometry_records.h"
+#include "common/rt64_performance_profiler.h"
+#include "hle/rt64_game_frame.h"
+#include "hle/rt64_workload.h"
+#include <algorithm>
+#include <array>
+#include <cstdlib>
+#include <cstring>
+#include <limits>
+#include <type_traits>
+#include <utility>
+
+namespace RT64 {
+namespace {
+uint64_t pair(uint32_t a, uint32_t b) { return (uint64_t(a) << 32U) | b; }
+uint32_t bits(float value) { uint32_t v; std::memcpy(&v, &value, 4); return v; }
+uint64_t floats(float a, float b) { return pair(bits(a), bits(b)); }
+thread_local bool rasterCapture = false;
+thread_local uint64_t rasterWorkload = 0, rasterOutput = 0;
+template<class T, class = void> struct HasSourceAddresses : std::false_type {};
+template<class T> struct HasSourceAddresses<T, std::void_t<decltype(std::declval<T>().vertexSourceAddresses)>> : std::true_type {};
+template<class T> uint32_t sourceAddress(const T &draw, uint32_t vertex) {
+    if constexpr (HasSourceAddresses<T>::value) {
+        return vertex < draw.vertexSourceAddresses.size() ? draw.vertexSourceAddresses[vertex] : UINT32_MAX;
+    }
+    return UINT32_MAX;
+}
+template<class T> bool sourceIndexValid(const T &draw, uint32_t vertex) {
+    if constexpr (HasSourceAddresses<T>::value) return vertex < draw.vertexSourceAddresses.size();
+    return true;
+}
+template<class T, class = void> struct HasCameraAnchor : std::false_type {};
+template<class T> struct HasCameraAnchor<T, std::void_t<decltype(std::declval<T>().cameraAnchorWorkloadIndex)>> : std::true_type {};
+template<class T> bool cameraAnchored(const T &transform) {
+    if constexpr (HasCameraAnchor<T>::value) return transform.cameraAnchorWorkloadIndex != UINT32_MAX;
+    return false;
+}
+void rasterEvent(const char *name, uint32_t call, uint64_t value) {
+    PerformanceProfiler::recordCriticalInstant(PerformanceCategory::Counter,
+        name, rasterWorkload, pair(uint32_t(rasterOutput), call), value);
+}
+}
+
+bool geometryGPUEnabled() {
+    static const bool enabled = [] {
+        const char *value = std::getenv("RT64_PROFILE_GEOMETRY_GPU");
+        return value && std::strcmp(value, "1") == 0;
+    }();
+    return enabled;
+}
+
+bool profileGeometry(const Workload &workload, const GameFrameMap &map,
+        uint32_t workloadIndex, uint64_t output, float weight,
+        bool processedTransforms, bool processedProjections) {
+    rasterCapture = false;
+    static const bool enabled = [] {
+        const char *value = std::getenv("RT64_PROFILE_GEOMETRY");
+        const bool requested = value && std::strcmp(value, "1") == 0;
+        PerformanceProfiler::setMetadata("producer.geometry.supported", "1");
+        PerformanceProfiler::setMetadata("producer.geometry.enabled", requested ? "1" : "0");
+        PerformanceProfiler::setMetadata("producer.gpu_geometry.supported", "1");
+        PerformanceProfiler::setMetadata("producer.gpu_geometry.enabled", requested && geometryGPUEnabled() ? "1" : "0");
+        PerformanceProfiler::setMetadata("producer.depth_coverage.supported", "1");
+        PerformanceProfiler::setMetadata("producer.depth_coverage.enabled", requested && geometryGPUEnabled() && geometryCoverageEnabled() ? "1" : "0");
+        return requested;
+    }();
+    if (!enabled || !PerformanceProfiler::captureEnabled()) { return false; }
+    static const uint32_t interval = [] {
+        const char *value = std::getenv("RT64_PROFILE_GEOMETRY_INTERVAL");
+        if (!value) { return 64U; }
+        char *end = nullptr;
+        const unsigned long n = std::strtoul(value, &end, 10);
+        return end != value && *end == '\0' && n >= 1 && n <= 4096
+            ? uint32_t(n) : 64U;
+    }();
+    if (workload.workloadId % interval != 0) { return false; }
+    constexpr uint32_t MaxVertices = 32768;
+    const auto &draw = workload.drawData;
+    const uint32_t count = draw.vertexCount();
+    GeometryRecords records(workload.workloadId, output, false, std::min(size_t(count), size_t(MaxVertices)) * 10 + std::min(draw.faceIndices.size(), size_t(196608)) / 2 + 1024);
+    const auto event = [&](const char *name, uint64_t a, uint64_t b) { records.event(name, a, b); };
+    if (output > UINT32_MAX || count > MaxVertices || draw.faceIndices.size() > 196608) {
+        event("Geometry.Rejected", output, pair(count, uint32_t(draw.faceIndices.size())));
+        return false;
+    }
+    rasterCapture = geometryGPUEnabled();
+    rasterWorkload = workload.workloadId;
+    rasterOutput = output;
+    PerformanceScope scope(PerformanceCategory::CPU, "Geometry.Capture", workload.workloadId);
+    static const bool metadata = [] {
+        PerformanceProfiler::setMetadata("geometry_contract", "n64-geometry-v1");
+        PerformanceProfiler::setMetadata("geometry_numeric_encoding", "rt64-binary-records-v1");
+        PerformanceProfiler::setMetadata("geometry_position_stage", "CPU_INPUT_WITH_OPTIONAL_FENCE_RETIRED_GPU_READBACK");
+        return true;
+    }();
+    (void)metadata;
+    event("Geometry.Begin", output, pair(count, uint32_t(draw.faceIndices.size())));
+    if constexpr (!HasSourceAddresses<DrawData>::value) event("Geometry.SourceAddressUnavailable", output, count);
+    event("Geometry.Config", output, pair(bits(weight),
+        uint32_t(processedTransforms) | (uint32_t(processedProjections) << 1U) |
+        (uint32_t(geometryGPUEnabled()) << 2U) |
+        (uint32_t(geometryGPUEnabled() && geometryCoverageEnabled()) << 3U) |
+        16U | (uint32_t(geometryGPUEnabled()) << 5U)));
+
+    // Fixed scratch, reused only by the renderer producer.
+    thread_local std::array<uint32_t, MaxVertices> xy{}, z{};
+    thread_local std::array<uint8_t, MaxVertices> modified{};
+    std::fill_n(modified.begin(), count, uint8_t(0));
+    for (size_t i = 0; i + 1 < draw.modifyPosUints.size(); i += 2) {
+        const uint32_t key = draw.modifyPosUints[i], v = key >> 1U;
+        if (v >= count) { event("Geometry.InvalidModify", pair(uint32_t(output), uint32_t(i)), key); continue; }
+        const uint8_t flag = key & 1U ? 2U : 1U;
+        if (modified[v] & flag) {
+            event("Geometry.RepeatedModify", pair(uint32_t(output), v), key);
+        }
+        modified[v] |= flag;
+        (flag == 1 ? xy[v] : z[v]) = draw.modifyPosUints[i + 1];
+    }
+    const auto screen = [&](const hlslpp::float4 &position, uint32_t v, uint32_t projection) {
+        const auto &viewport = draw.rspViewports[projection];
+        const auto xyz = (position.xyz / hlslpp::float3(position.w, -position.w, position.w))
+            * viewport.scale + viewport.translate;
+        hlslpp::float4 result(xyz, position.w);
+        if (modified[v] & 1U) {
+            result[0] = int16_t(xy[v] >> 16U) / 4.0f;
+            result[1] = int16_t(xy[v]) / 4.0f;
+        }
+        if (modified[v] & 2U) { result[2] = z[v] / 65536.0f; }
+        return result;
+    };
+    for (uint32_t v = 0; v < count; ++v) {
+        const uint64_t key = pair(uint32_t(output), v);
+        if (v >= draw.viewProjIndices.size() || v >= draw.worldIndices.size()) {
+            event("Geometry.InvalidVertex", key, 1); continue;
+        }
+        const uint32_t t = draw.worldIndices[v];
+        const uint32_t p = draw.viewProjIndices[v];
+        if (size_t(v) * 3 + 2 >= draw.posFloats.size() || v >= draw.posScreen.size() ||
+                v >= draw.posTransformed.size() || !sourceIndexValid(draw, v) ||
+                t >= draw.worldTransforms.size() || p >= draw.viewProjTransforms.size() ||
+                p >= draw.rspViewports.size() ||
+                (processedTransforms && t >= draw.lerpWorldTransforms.size()) ||
+                (processedProjections && p >= draw.modViewProjTransforms.size())) {
+            event("Geometry.InvalidVertex", key, 2); continue;
+        }
+        const auto &native = draw.posScreen[v];
+        const hlslpp::float4 pos(draw.posFloats[v * 3], draw.posFloats[v * 3 + 1], draw.posFloats[v * 3 + 2], 1);
+        const auto rebuilt = screen(hlslpp::mul(pos,
+            hlslpp::mul(draw.worldTransforms[t], draw.viewProjTransforms[p])), v, p);
+        auto movingPos = pos;
+        if (size_t(v) * 3 + 2 < draw.velFloats.size()) {
+            for (uint32_t a = 0; a < 3; ++a) { movingPos[a] -= draw.velFloats[v * 3 + a] * (1 - weight); }
+        }
+        const auto &world = processedTransforms ? draw.lerpWorldTransforms[t] : draw.worldTransforms[t];
+        const auto &projection = processedProjections ? draw.modViewProjTransforms[p] : draw.viewProjTransforms[p];
+        const auto rendered = screen(hlslpp::mul(movingPos, hlslpp::mul(world, projection)), v, p);
+        event("Geometry.VertexOwner", key, pair(sourceAddress(draw, v), (t << 16U) | p));
+        event("Geometry.SourceXY", key, floats(pos[0], pos[1]));
+        event("Geometry.SourceZW", key, floats(pos[2], 1.0f));
+        event("Geometry.NativeXY", key, floats(native[0], native[1]));
+        event("Geometry.NativeZW", key, floats(native[2], draw.posTransformed[v][3]));
+        event("Geometry.RebuiltXY", key, floats(rebuilt[0], rebuilt[1]));
+        event("Geometry.RebuiltZW", key, floats(rebuilt[2], rebuilt[3]));
+        event("Geometry.RenderXY", key, floats(rendered[0], rendered[1]));
+        event("Geometry.RenderZW", key, floats(rendered[2], rendered[3]));
+        uint32_t flags = uint32_t(modified[v]) << 2U;
+        if (workloadIndex < map.workloads.size() && t < map.workloads[workloadIndex].transforms.size()) {
+            const auto &transform = map.workloads[workloadIndex].transforms[t];
+            flags |= uint32_t(transform.mapped) | (uint32_t(cameraAnchored(transform)) << 1U);
+        }
+        event("Geometry.VertexState", key, flags);
+    }
+    for (uint32_t i = 0; i < draw.faceIndices.size(); i += 2) {
+        event("Geometry.IndexPair", pair(uint32_t(output), i), pair(draw.faceIndices[i],
+            i + 1 < draw.faceIndices.size() ? draw.faceIndices[i + 1] : UINT32_MAX));
+    }
+    uint32_t calls = 0;
+    for (uint32_t f = 0; f < workload.fbPairCount; ++f) {
+        const auto &fb = workload.fbPairs[f];
+        for (uint32_t p = 0; p < fb.projectionCount; ++p) {
+            const auto &projection = fb.projections[p];
+            if (projection.type == Projection::Type::Rectangle) { continue; }
+            for (uint32_t c = 0; c < projection.gameCallCount; ++c) {
+                const auto &call = projection.gameCalls[c];
+                if (!call.callDesc.otherMode.zCmp() && !call.callDesc.otherMode.zUpd()) { continue; }
+                const uint64_t key = pair(uint32_t(output), calls++);
+                event("Geometry.DrawRange", key, pair(call.meshDesc.faceIndicesStart, call.callDesc.triangleCount * 3U));
+                event("Geometry.DrawOwner", key, pair(fb.colorImage.address, projection.transformsIndex));
+                event("Geometry.DrawMode", key, pair(call.callDesc.otherMode.H, call.callDesc.otherMode.L));
+                event("Geometry.DrawIdentity", key, pair(call.callDesc.callIndex, f));
+                event("Geometry.DrawCombiner", key, pair(call.callDesc.colorCombiner.L, call.callDesc.colorCombiner.H));
+                event("Geometry.DrawAlpha", key, floats(call.callDesc.rdpParams.primColor.w, call.callDesc.rdpParams.envColor.w));
+                event("Geometry.DrawAlphaCompare", key, floats(call.callDesc.rdpParams.blendColor.w, call.callDesc.rdpParams.primLOD.x));
+            }
+        }
+    }
+    if (!records.finish()) { rasterCapture = false; return false; }
+    event("Geometry.End", output, pair(count, calls));
+    return true;
+}
+
+std::unique_ptr<RenderBuffer> recordGeometryReadback(RenderWorker *worker, const Workload &workload) {
+    const uint64_t bytes = (uint64_t(workload.drawData.vertexCount())
+#ifdef RT64_PROFILER_CONFORMING_SUPPORT
+        + workload.conformingMesh.derived.size()
+#endif
+        ) * 4 * sizeof(float);
+    if (bytes == 0) { return nullptr; }
+    auto buffer = worker->device->createBuffer(RenderBufferDesc::ReadbackBuffer(bytes));
+    if (!buffer) { return nullptr; }
+    auto *source = workload.outputBuffers.screenPosBuffer.buffer.get();
+    const RenderBufferBarrier before[] = {
+        RenderBufferBarrier(source, RenderBufferAccess::READ),
+        RenderBufferBarrier(buffer.get(), RenderBufferAccess::WRITE)
+    };
+    worker->commandList->barriers(RenderBarrierStage::COPY, before, uint32_t(std::size(before)));
+    worker->commandList->copyBufferRegion(buffer.get(), source, bytes);
+    worker->commandList->barriers(RenderBarrierStage::GRAPHICS,
+        RenderBufferBarrier(source, RenderBufferAccess::READ));
+    return buffer;
+}
+
+void profileGeometryRasterState(uint32_t call, const hlslpp::float2 &resolution,
+        const RenderViewport &viewport, const RenderRect &scissor,
+        const hlslpp::float2 &scale, const hlslpp::float2 &offset, uint32_t flags,
+        const hlslpp::float2 &primDepth, const RenderMultisampling &multisampling) {
+    if (!rasterCapture) { return; }
+    rasterEvent("Geometry.RasterResolution", call, floats(resolution.x, resolution.y));
+    rasterEvent("Geometry.RasterViewportXY", call, floats(viewport.x, viewport.y));
+    rasterEvent("Geometry.RasterViewportWH", call, floats(viewport.width, viewport.height));
+    rasterEvent("Geometry.RasterScale", call, floats(scale.x, scale.y));
+    rasterEvent("Geometry.RasterOffset", call, floats(offset.x, offset.y));
+    rasterEvent("Geometry.RasterScissorLT", call, pair(uint32_t(scissor.left), uint32_t(scissor.top)));
+    rasterEvent("Geometry.RasterScissorRB", call, pair(uint32_t(scissor.right), uint32_t(scissor.bottom)));
+    rasterEvent("Geometry.RasterFlags", call, flags);
+    rasterEvent("Geometry.RasterPrimDepth", call, floats(primDepth.x, primDepth.y));
+    rasterEvent("Geometry.RasterSamples",call,pair(multisampling.sampleCount,multisampling.sampleLocationsEnabled?1:0));
+    static constexpr const char *patterns[]={"Geometry.RasterSamplePattern0","Geometry.RasterSamplePattern1",
+        "Geometry.RasterSamplePattern2","Geometry.RasterSamplePattern3"};
+    for (unsigned group=0;group<4;++group) {
+        uint64_t value=0;
+        for (unsigned i=0;i<4;++i) {
+            const auto &p=multisampling.sampleLocations[group*4+i];
+            value|=uint64_t(uint8_t(p.x))<<(i*16);
+            value|=uint64_t(uint8_t(p.y))<<(i*16+8);
+        }
+        rasterEvent(patterns[group],call,value);
+    }
+}
+
+void profileGeometryRasterSubmitted(uint32_t call) {
+    if (rasterCapture) { rasterEvent("Geometry.RasterSubmitted", call, 1); }
+}
+
+void finishGeometryReadback(GeometryReadback &readback) {
+    if (!readback.pending) { return; }
+    auto *buffer = readback.buffer.get();
+    const uint64_t output = readback.output;
+    GeometryRecords records(readback.workloadId, output, true, size_t(readback.vertexCount) * 2 + 8);
+    const auto event = [&](const char *name, uint64_t a, uint64_t b) { records.event(name, a, b); };
+    const uint32_t count = readback.vertexCount;
+    if (buffer) {
+        const size_t floatCount=(size_t(count)
+#ifdef RT64_PROFILER_CONFORMING_SUPPORT
+            + readback.derived.size()
+#endif
+            )*4;
+        RenderRange range{0, floatCount * sizeof(float)};
+        const auto *positions = static_cast<const float *>(buffer->map(0, &range));
+        if (positions) {
+            for (uint32_t v = 0; v < count; ++v) {
+                event("Geometry.GPUXY", pair(uint32_t(output), v), floats(positions[v * 4], positions[v * 4 + 1]));
+                event("Geometry.GPUZW", pair(uint32_t(output), v), floats(positions[v * 4 + 2], positions[v * 4 + 3]));
+            }
+#ifdef RT64_PROFILER_CONFORMING_SUPPORT
+            const auto validation=validateConformingPositions(count,readback.derived,positions,floatCount);
+            event("Renderer.ConformingGPUChecked",output,pair(validation.checked,validation.validMetadata?1:0));
+            event("Renderer.ConformingGPUErrors",output,pair(validation.referenceMismatches,validation.nonfiniteVertices));
+#endif
+            buffer->unmap();
+        }
+        else { event("Geometry.InvalidGPU", pair(uint32_t(output), 0), 1); }
+    }
+    else if (count != 0) { event("Geometry.InvalidGPU", pair(uint32_t(output), 0), 2); }
+    finishGeometryDepth(readback);
+    records.finish();
+    event("Geometry.GPUEnd", output, count);
+    readback.pending = false;
+    readback.buffer.reset();
+#ifdef RT64_PROFILER_CONFORMING_SUPPORT
+    readback.derived.clear();
+#endif
+}
+}
diff --git a/src/render/rt64_geometry_depth_profiler.cpp b/src/render/rt64_geometry_depth_profiler.cpp
new file mode 100644
--- /dev/null
+++ b/src/render/rt64_geometry_depth_profiler.cpp
@@ -0,0 +1,103 @@
+#include "rt64_geometry_profiler.h"
+#include "rt64_render_target.h"
+#include "rt64_shader_library.h"
+#include "common/rt64_performance_profiler.h"
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <filesystem>
+
+namespace RT64 {
+namespace {
+uint64_t packed(uint32_t a, uint32_t b) { return (uint64_t(a) << 32) | b; }
+void event(const GeometryReadback &capture, const char *name, uint32_t index, uint64_t value) {
+    PerformanceProfiler::recordCriticalInstant(PerformanceCategory::Counter, name,
+        capture.workloadId, packed(uint32_t(capture.output), index), value);
+}
+// Adler-32, matching Python's standard-library zlib implementation.
+uint32_t checksum(const uint8_t *data, size_t size) {
+    uint32_t a = 1, b = 0;
+    while (size) {
+        const size_t count = std::min<size_t>(size, 5552);
+        for (size_t i = 0; i < count; ++i) { a += *data++; b += a; }
+        a %= 65521; b %= 65521; size -= count;
+    }
+    return (b << 16) | a;
+}
+}
+
+bool geometryCoverageEnabled() {
+    static const bool enabled = [] {
+        const char *value = std::getenv("RT64_PROFILE_GEOMETRY_COVERAGE");
+        return value && std::strcmp(value, "1") == 0;
+    }();
+    return enabled;
+}
+
+void recordGeometryDepth(RenderWorker *worker, RenderTarget &target,
+        const ShaderLibrary &shaders, uint32_t framebuffer, GeometryReadback &capture,
+        RenderTextureLayout restoreLayout) {
+    if (!geometryCoverageEnabled()) { return; }
+    PerformanceScope measure(PerformanceCategory::CPU, "Geometry.DepthRecord", capture.workloadId);
+    const uint64_t pixels = uint64_t(target.width) * target.height;
+    const auto &shader = target.multisampling.sampleCount > 1 ? shaders.geometryDepthMS : shaders.geometryDepth;
+    if (pixels == 0 || pixels > 4194304 || capture.depth.size() >= 8 || !shader.pipeline) {
+        event(capture, "Geometry.InvalidDepth", framebuffer, 1);
+        return;
+    }
+    GeometryDepthReadback item;
+    item.framebuffer = framebuffer;
+    item.width = target.width; item.height = target.height;
+    item.samples = uint32_t(target.multisampling.sampleCount);
+    const uint64_t bytes = pixels * 2 * sizeof(float);
+    item.gpu = worker->device->createBuffer(RenderBufferDesc::DefaultBuffer(bytes,
+        RenderBufferFlag::STORAGE | RenderBufferFlag::UNORDERED_ACCESS));
+    item.readback = worker->device->createBuffer(RenderBufferDesc::ReadbackBuffer(bytes));
+    item.descriptors = std::make_unique<GeometryDepthDescriptorSet>(worker->device);
+    if (!item.gpu || !item.readback) { event(capture, "Geometry.InvalidDepth", framebuffer, 2); return; }
+    item.descriptors->setTexture(item.descriptors->source, target.texture.get(),
+        RenderTextureLayout::SHADER_READ, target.textureView.get());
+    item.descriptors->setBuffer(item.descriptors->destination, item.gpu.get(), RenderBufferStructuredView(2 * sizeof(float)));
+    worker->commandList->barriers(RenderBarrierStage::COMPUTE,
+        RenderTextureBarrier(target.texture.get(), RenderTextureLayout::SHADER_READ));
+    worker->commandList->barriers(RenderBarrierStage::COMPUTE, RenderBufferBarrier(item.gpu.get(), RenderBufferAccess::WRITE));
+    const uint32_t constants[] = {item.width, item.height, item.samples};
+    worker->commandList->setPipeline(shader.pipeline.get());
+    worker->commandList->setComputePipelineLayout(shader.pipelineLayout.get());
+    worker->commandList->setComputeDescriptorSet(item.descriptors->get(), 0);
+    worker->commandList->setComputePushConstants(0, constants);
+    worker->commandList->dispatch((item.width + 7) / 8, (item.height + 7) / 8, 1);
+    const RenderBufferBarrier copies[] = {
+        RenderBufferBarrier(item.gpu.get(), RenderBufferAccess::READ),
+        RenderBufferBarrier(item.readback.get(), RenderBufferAccess::WRITE)};
+    worker->commandList->barriers(RenderBarrierStage::COPY, copies, 2);
+    worker->commandList->copyBufferRegion(item.readback.get(), item.gpu.get(), bytes);
+    worker->commandList->barriers(RenderBarrierStage::GRAPHICS,
+        RenderTextureBarrier(target.texture.get(), restoreLayout));
+    capture.depth.emplace_back(std::move(item));
+}
+
+void finishGeometryDepth(GeometryReadback &capture) {
+    const char *output = std::getenv("RT64_PROFILE_OUTPUT");
+    for (auto &item : capture.depth) {
+        const size_t bytes = size_t(item.width) * item.height * 2 * sizeof(float);
+        const RenderRange range{0, bytes};
+        const auto *data = static_cast<const uint8_t *>(item.readback->map(0, &range));
+        bool queued = false;
+        if (output && data) {
+            PerformanceScope measure(PerformanceCategory::CPU, "Geometry.DepthQueue", capture.workloadId);
+            const uint32_t hash = checksum(data, bytes);
+            const std::string suffix = ".depth-" + std::to_string(capture.workloadId) + "-" +
+                std::to_string(capture.output) + "-" + std::to_string(item.framebuffer) + ".f32";
+            queued = PerformanceProfiler::writeAttachment(suffix, data, bytes,
+                "Geometry.DepthContent", capture.workloadId,
+                packed(uint32_t(capture.output), item.framebuffer), packed(hash, item.samples));
+        }
+        if (data) { item.readback->unmap(); }
+        if (!queued) { event(capture, "Geometry.InvalidDepth", item.framebuffer, 3); continue; }
+        event(capture, "Geometry.DepthShape", item.framebuffer, packed(item.width, item.height));
+    }
+    capture.depth.clear();
+}
+}
