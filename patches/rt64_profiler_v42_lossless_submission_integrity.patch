+        void updateSubmissionIntegrity(
+            ProfilerState &profiler,
+            const Event &event
+        ) {
+            const std::string_view name(event.name.data());
+            if (event.kind == EventKind::Instant &&
+                name == "Host.Context.World") {
+                const std::scoped_lock lock(
+                    profiler.submissionIntegrityMutex
+                );
+                SubmissionIntegrityTracker &tracker =
+                    profiler.submissionIntegrity;
+                tracker.worldContextActive = event.argument0 != 0u;
+                if (!tracker.worldContextActive) {
+                    tracker.consecutiveCollapsedSamples = 0u;
+                    tracker.collapseCandidateTimestamp = 0u;
+                    tracker.pendingSamples.clear();
+                }
+                return;
+            }
+
+            if (event.kind != EventKind::Counter ||
+                (name != "Work.DrawCalls" &&
+                 name != "Work.Triangles" &&
+                 name != "Work.SpecializedPipelines.World")) {
+                return;
+            }
+
+            const std::scoped_lock lock(profiler.submissionIntegrityMutex);
+            SubmissionIntegrityTracker &tracker = profiler.submissionIntegrity;
+            if (!tracker.worldContextActive) {
+                return;
+            }
+
+            SubmissionIntegritySample &sample =
+                tracker.pendingSamples[event.correlationId];
+            sample.timestampNanoseconds = std::max(
+                sample.timestampNanoseconds,
+                event.timestampNanoseconds
+            );
+            sample.correlationId = event.correlationId;
+            if (name == "Work.DrawCalls") {
+                sample.drawCalls = event.value;
+            }
+            else if (name == "Work.Triangles") {
+                sample.triangles = event.value;
+            }
+            else {
+                sample.worldPipelines = event.value;
+            }
+            if (sample.drawCalls < 0.0 || sample.triangles < 0.0 ||
+                sample.worldPipelines < 0.0) {
+                return;
+            }
+
+            const SubmissionIntegritySample completeSample = sample;
+            tracker.pendingSamples.erase(event.correlationId);
+            const bool establishedWorld =
+                tracker.peakGameplayDrawCalls >= 128.0 &&
+                tracker.peakGameplayTriangles >= 1'024.0;
+            const bool drawCollapse = establishedWorld &&
+                completeSample.drawCalls <= std::max(
+                    16.0,
+                    tracker.peakGameplayDrawCalls * 0.05
+                );
+            const bool triangleCollapse =
+                completeSample.triangles <= std::max(
+                    128.0,
+                    tracker.peakGameplayTriangles * 0.05
+                );
+            const bool worldPipelineCollapse =
+                completeSample.worldPipelines <= 1.0;
+            if (drawCollapse && triangleCollapse && worldPipelineCollapse) {
+                if (tracker.consecutiveCollapsedSamples == 0u) {
+                    tracker.collapseCandidateTimestamp =
+                        completeSample.timestampNanoseconds;
+                    tracker.firstCollapsedSubmission = completeSample;
+                }
+                ++tracker.consecutiveCollapsedSamples;
+                ++tracker.collapsedSampleCount;
+                if (tracker.consecutiveCollapsedSamples >=
+                        RequiredCollapsedSubmissionSamples &&
+                    !tracker.collapseDetected) {
+                    tracker.collapseDetected = true;
+                    tracker.detectedCollapseTimestamp =
+                        tracker.collapseCandidateTimestamp;
+                    tracker.detectedHealthySubmission =
+                        tracker.lastHealthySubmission;
+                    tracker.detectedCollapsedSubmission =
+                        tracker.firstCollapsedSubmission;
+                }
+                return;
+            }
+
+            tracker.consecutiveCollapsedSamples = 0u;
+            tracker.collapseCandidateTimestamp = 0u;
+            if (completeSample.drawCalls >= 32.0) {
+                tracker.lastHealthySubmission = completeSample;
+                tracker.peakGameplayDrawCalls = std::max(
+                    tracker.peakGameplayDrawCalls,
+                    completeSample.drawCalls
+                );
+                tracker.peakGameplayTriangles = std::max(
+                    tracker.peakGameplayTriangles,
+                    completeSample.triangles
+                );
+            }
+        }
+
+        bool appendStreamedJournalEvent(
+            ProfilerState &profiler,
+            ThreadBuffer &buffer,
