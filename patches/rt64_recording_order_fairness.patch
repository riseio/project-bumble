diff --git a/src/common/rt64_recording_mutex.h b/src/common/rt64_recording_mutex.h
new file mode 100644
--- /dev/null
+++ b/src/common/rt64_recording_mutex.h
@@ -0,0 +1,37 @@
+#pragma once
+
+#include <condition_variable>
+#include <cstdint>
+#include <mutex>
+
+namespace RT64 {
+    // Keep ready presentation work ahead of later recording requests.
+    class RecordingMutex {
+        std::mutex mutex;
+        std::condition_variable condition;
+        uint64_t next = 0;
+        uint64_t serving = 0;
+
+    public:
+        void lock() {
+            std::unique_lock<std::mutex> guard(mutex);
+            const uint64_t ticket = next++;
+            condition.wait(guard, [&]() { return ticket == serving; });
+        }
+
+        bool try_lock() {
+            std::unique_lock<std::mutex> guard(mutex, std::try_to_lock);
+            if (!guard.owns_lock() || next != serving) return false;
+            ++next;
+            return true;
+        }
+
+        void unlock() {
+            {
+                std::lock_guard<std::mutex> guard(mutex);
+                ++serving;
+            }
+            condition.notify_all();
+        }
+    };
+}
