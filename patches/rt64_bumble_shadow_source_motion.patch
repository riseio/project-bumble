diff --git a/src/render/rt64_bumble_shadow_geometry.h b/src/render/rt64_bumble_shadow_geometry.h
--- a/src/render/rt64_bumble_shadow_geometry.h
+++ b/src/render/rt64_bumble_shadow_geometry.h
@@ -3,7 +3,22 @@
 #include "hle/rt64_workload.h"
 #include "xxHash/xxh3.h"
 #include <stdexcept>
+#include <cstring>
 
 namespace RT64 {
+    inline bool bumbleShadowTransformChanged(const interop::float4x4 &previous,
+        const interop::float4x4 &current) {
+        return std::memcmp(&previous, &current, sizeof(current)) != 0;
+    }
+
+    inline bool bumbleShadowTransformsMoving(const DrawData &data,
+        uint32_t first, uint32_t last) {
+        if (first > last || last >= data.worldTransformMotion.size())
+            throw std::runtime_error("Invalid shadow caster source motion range");
+        for (uint32_t matrix = first; matrix <= last; ++matrix)
+            if (data.worldTransformMotion[matrix]) return true;
+        return false;
+    }
