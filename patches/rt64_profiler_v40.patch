+        bool writeLiveCheckpoint(
+            ProfilerState &profiler,
+            const std::vector<ThreadBuffer *> &buffers
+        ) {
+            std::filesystem::path temporaryPath = profiler.livePath;
+            temporaryPath += ".tmp";
+            ensureParentDirectory(temporaryPath);
+            std::ofstream output(temporaryPath, std::ios::binary);
+            if (!output.is_open()) {
+                return false;
+            }
+
+            uint64_t latestTimestampNanoseconds = 0;
+            for (const ThreadBuffer *buffer : buffers) {
+                const uint64_t count = buffer->eventCount.load(
+                    std::memory_order_acquire
+                );
+                if (count > 0) {
+                    latestTimestampNanoseconds = std::max(
+                        latestTimestampNanoseconds,
+                        eventAt(*buffer, count - 1).timestampNanoseconds
+                    );
+                }
+            }
+            const uint64_t generation =
+                profiler.checkpointGeneration.fetch_add(
+                    1,
+                    std::memory_order_relaxed
+                ) + 1;
+            output << "{\n"
+                << "  \"schema\": \"rt64-performance-live-v1\",\n"
+                << "  \"generation\": " << generation << ",\n"
+                << "  \"journal\": \""
+                << jsonEscape(profiler.journalPath.string()) << "\",\n"
+                << "  \"journal_healthy\": "
+                << (profiler.journalHealthy.load(std::memory_order_acquire)
+                    ? "true" : "false") << ",\n"
+                << "  \"journal_events_written\": "
+                << profiler.journalEventsWritten.load(
+                    std::memory_order_acquire
+                ) << ",\n"
+                << "  \"journal_flush_count\": "
+                << profiler.journalFlushCount.load(
+                    std::memory_order_acquire
+                ) << ",\n"
+                << "  \"recorded_events\": "
+                << recordedEventCount(buffers) << ",\n"
+                << "  \"dropped_events\": "
+                << droppedEventCount(profiler, buffers) << ",\n"
+                << "  \"latest_timestamp_ns\": "
+                << latestTimestampNanoseconds << "\n}\n";
+            output.flush();
+            const bool written = output.good();
+            output.close();
+            return written && replaceFileAtomically(
+                temporaryPath,
+                profiler.livePath
+            );
+        }
