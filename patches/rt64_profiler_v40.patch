+        void startCheckpointObservation(ProfilerState &profiler) {
+            const std::scoped_lock startLock(profiler.checkpointMutex);
+            if (profiler.checkpointThread.joinable()) {
+                return;
+            }
+
+            ensureParentDirectory(profiler.journalPath);
+            {
+                const std::scoped_lock metadataLock(profiler.metadataMutex);
+                profiler.metadata["capture_durability"] =
+                    "incremental_jsonl_journal";
+                profiler.metadata["journal_path"] =
+                    profiler.journalPath.string();
+                profiler.metadata["journal_interval_ms"] =
+                    std::to_string(profiler.journalIntervalMilliseconds);
+                profiler.metadata["live_checkpoint_interval_ms"] =
+                    std::to_string(profiler.checkpointIntervalMilliseconds);
+            }
+            profiler.checkpointRunning.store(true, std::memory_order_release);
+            profiler.checkpointThread = std::thread([&profiler]() {
+                std::ofstream journal(
+                    profiler.journalPath,
+                    std::ios::binary | std::ios::trunc
+                );
+                if (!journal.is_open()) {
+                    std::fprintf(
+                        stderr,
+                        "RT64_PROFILE journal_open_failed=1 path=%s\n",
+                        profiler.journalPath.string().c_str()
+                    );
+                    std::fflush(stderr);
+                    return;
+                }
+
+                journal << "{\"record\":\"header\",\"schema\":\"rt64-performance-journal-v1\",\"clock\":\"steady_clock_nanoseconds\"}\n";
+                journal.flush();
+                profiler.journalHealthy.store(
+                    journal.good(),
+                    std::memory_order_release
+                );
+
+                std::unordered_map<ThreadBuffer *, uint64_t> cursors;
+                std::unordered_map<ThreadBuffer *, std::string> threadNames;
+                std::map<std::string, std::string> writtenMetadata;
+                auto nextLiveCheckpoint = Clock::now();
+                while (true) {
+                    std::vector<ThreadBuffer *> buffers;
+                    {
+                        const std::scoped_lock registryLock(
+                            profiler.registryMutex
+                        );
+                        buffers = profiler.threadBuffers;
+                    }
+
+                    std::map<std::string, std::string> metadata;
+                    {
+                        const std::scoped_lock metadataLock(
+                            profiler.metadataMutex
+                        );
+                        metadata = profiler.metadata;
+                    }
+                    for (const auto &[key, value] : metadata) {
+                        const auto previous = writtenMetadata.find(key);
+                        if ((previous == writtenMetadata.end()) ||
+                            (previous->second != value)) {
+                            journal << "{\"record\":\"metadata\",\"key\":\""
+                                << jsonEscape(key) << "\",\"value\":\""
+                                << jsonEscape(value) << "\"}\n";
+                            writtenMetadata[key] = value;
+                        }
+                    }
+
+                    uint64_t eventsWritten = 0;
+                    for (ThreadBuffer *buffer : buffers) {
+                        std::string name;
+                        {
+                            const std::scoped_lock nameLock(
+                                buffer->nameMutex
+                            );
+                            name = buffer->name;
+                        }
+                        const auto previousName = threadNames.find(buffer);
+                        if ((previousName == threadNames.end()) ||
+                            (previousName->second != name)) {
+                            journal << "{\"record\":\"thread\",\"thread_id\":"
+                                << buffer->id << ",\"name\":\""
+                                << jsonEscape(name) << "\"}\n";
+                            threadNames[buffer] = name;
+                        }
+
+                        uint64_t &cursor = cursors[buffer];
+                        const uint64_t count = buffer->eventCount.load(
+                            std::memory_order_acquire
+                        );
+                        while (cursor < count) {
+                            writeJournalEvent(
+                                journal,
+                                eventAt(*buffer, cursor)
+                            );
+                            ++cursor;
+                            ++eventsWritten;
+                        }
+                    }
+                    journal.flush();
+                    const bool healthy = journal.good();
+                    profiler.journalHealthy.store(
+                        healthy,
+                        std::memory_order_release
+                    );
+                    profiler.journalEventsWritten.fetch_add(
+                        eventsWritten,
+                        std::memory_order_release
+                    );
+                    profiler.journalFlushCount.fetch_add(
+                        1,
+                        std::memory_order_release
+                    );
+
+                    const auto now = Clock::now();
+                    if (now >= nextLiveCheckpoint) {
+                        writeLiveCheckpoint(profiler, buffers);
+                        nextLiveCheckpoint = now + std::chrono::milliseconds(
+                            profiler.checkpointIntervalMilliseconds
+                        );
+                    }
+
+                    if (!healthy ||
