diff --git a/src/shaders/BumbleLightingGrade.hlsli b/src/shaders/BumbleLightingGrade.hlsli
new file mode 100644
index 0000000..7602dd4
--- /dev/null
+++ b/src/shaders/BumbleLightingGrade.hlsli
@@ -0,0 +1,7 @@
+#pragma once
+
+float3 bumbleLightingContrast(float3 color) {
+    const float luma = dot(saturate(color), float3(.2126f, .7152f, .0722f));
+    const float gain = 1.0f + .5f * (1.0f - luma) * (2.0f * luma - 1.0f);
+    return saturate(color * gain);
+}
