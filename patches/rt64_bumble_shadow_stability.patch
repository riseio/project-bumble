 namespace RT64 {
+    struct BumbleShadowOwnership {
+        uint32_t level = UINT32_MAX;
+        std::unordered_set<uint32_t> movingGroups;
+
+        bool beginLevel(uint32_t nextLevel) {
+            if (level == nextLevel) return false;
+            level = nextLevel;
+            movingGroups.clear();
+            return true;
+        }
+
+        static uint32_t groupId(const DrawData &data, size_t matrix) {
+            if (matrix >= data.worldTransformGroups.size()) return G_EX_ID_AUTO;
+            const uint32_t group = data.worldTransformGroups[matrix];
+            return group < data.transformGroups.size()
+                ? data.transformGroups[group].matrixId : G_EX_ID_AUTO;
+        }
+
+        static bool explicitId(uint32_t id) {
+            return id != G_EX_ID_AUTO && id != G_EX_ID_IGNORE;
+        }
+
+        void observe(DrawData &data) {
+            data.shadowDynamicTransforms = data.worldTransformMotion;
+            if (data.shadowDynamicTransforms.size() != data.worldTransforms.size() ||
+                data.velFloats.size() < data.worldIndices.size() * 3)
+                throw std::runtime_error("Invalid shadow motion streams");
+            for (size_t vertex = 0; vertex < data.worldIndices.size(); ++vertex) {
+                const size_t p = vertex * 3;
+                if (data.velFloats[p] == 0 && data.velFloats[p + 1] == 0 &&
+                    data.velFloats[p + 2] == 0) continue;
+                const uint32_t matrix = data.worldIndices[vertex];
+                if (matrix >= data.shadowDynamicTransforms.size())
+                    throw std::runtime_error("Invalid shadow motion transform");
+                data.shadowDynamicTransforms[matrix] = 1;
+            }
+            for (size_t matrix = 0; matrix < data.shadowDynamicTransforms.size(); ++matrix) {
+                const uint32_t id = groupId(data, matrix);
+                if (data.shadowDynamicTransforms[matrix] && explicitId(id))
+                    movingGroups.insert(id);
+            }
+            data.shadowOwnershipPrepared = true;
+        }
+
+        // Observe all workloads before assigning a shared actor hierarchy.
+        void assign(DrawData &data) const {
+            for (size_t matrix = 0; matrix < data.shadowDynamicTransforms.size(); ++matrix) {
+                const uint32_t id = groupId(data, matrix);
+                if (explicitId(id) && movingGroups.count(id))
+                    data.shadowDynamicTransforms[matrix] = 1;
+            }
+        }
+    };
+
+    inline bool bumbleShadowCasterDynamic(const DrawData &data, uint32_t first, uint32_t last) {
+        if (first > last || last >= data.shadowDynamicTransforms.size())
+            throw std::runtime_error("Invalid shadow ownership range");
+        for (uint32_t matrix = first; matrix <= last; ++matrix)
+            if (data.shadowDynamicTransforms[matrix]) return true;
+        return false;
+    }
