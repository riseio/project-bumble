+            pipelineCacheDirty = true;
+        }
+    }
+
+    void D3D12Device::initializePipelineCache() {
+        const wchar_t *configuredPath =
+            _wgetenv(L"RT64_D3D12_PIPELINE_CACHE");
+        if (configuredPath != nullptr && configuredPath[0] != 0) {
+            pipelineCachePath = std::filesystem::path(configuredPath);
+        }
+
+        constexpr uint64_t MaxPipelineCacheBytes =
+            64ULL * 1024ULL * 1024ULL;
+        std::vector<uint8_t> initialData;
+        if (!pipelineCachePath.empty()) {
+            std::ifstream input(
+                pipelineCachePath,
+                std::ios::binary | std::ios::ate
+            );
+            if (input) {
+                const std::streamoff size = input.tellg();
+                if (size > 0 &&
+                    static_cast<uint64_t>(size) <= MaxPipelineCacheBytes) {
+                    initialData.resize(static_cast<size_t>(size));
+                    input.seekg(0, std::ios::beg);
+                    if (!input.read(
+                            reinterpret_cast<char *>(initialData.data()),
+                            size)) {
+                        initialData.clear();
+                    }
+                }
+            }
+        }
+
+        HRESULT result = d3d->CreatePipelineLibrary(
+            initialData.empty() ? nullptr : initialData.data(),
+            initialData.size(),
+            IID_PPV_ARGS(&pipelineLibrary)
+        );
+        if (FAILED(result) && !initialData.empty()) {
+            pipelineLibrary = nullptr;
+            result = d3d->CreatePipelineLibrary(
+                nullptr,
+                0,
+                IID_PPV_ARGS(&pipelineLibrary)
+            );
+        }
+        if (FAILED(result)) {
+            pipelineLibrary = nullptr;
+        }
+    }
+
+    void D3D12Device::savePipelineCache() {
+        if (pipelineLibrary == nullptr || pipelineCachePath.empty() ||
+            !pipelineCacheDirty) {
+            return;
+        }
+
+        const std::lock_guard cacheLock(pipelineCacheMutex);
+        constexpr uint64_t MaxPipelineCacheBytes =
+            64ULL * 1024ULL * 1024ULL;
+        const SIZE_T dataSize = pipelineLibrary->GetSerializedSize();
+        if (dataSize == 0 ||
+            static_cast<uint64_t>(dataSize) > MaxPipelineCacheBytes) {
+            return;
+        }
+
+        std::vector<uint8_t> data(dataSize);
+        if (FAILED(pipelineLibrary->Serialize(
+                data.data(),
+                data.size()))) {
+            return;
+        }
+
+        std::error_code error;
+        const std::filesystem::path parent =
+            pipelineCachePath.parent_path();
+        if (!parent.empty()) {
+            std::filesystem::create_directories(parent, error);
+            if (error) {
+                return;
+            }
+        }
+
+        std::filesystem::path temporaryPath = pipelineCachePath;
+        temporaryPath += L".tmp";
+        {
+            std::ofstream output(
+                temporaryPath,
+                std::ios::binary | std::ios::trunc
+            );
+            if (!output.write(
+                    reinterpret_cast<const char *>(data.data()),
+                    static_cast<std::streamsize>(data.size()))) {
+                return;
+            }
+        }
+
+        std::filesystem::rename(
+            temporaryPath,
+            pipelineCachePath,
+            error
+        );
+        if (error) {
+            error.clear();
+            std::filesystem::remove(pipelineCachePath, error);
+            error.clear();
+            std::filesystem::rename(
+                temporaryPath,
+                pipelineCachePath,
+                error
+            );
+        }
+        if (!error) {
+            pipelineCacheDirty = false;
+        }
+    }
+
     void D3D12Device::release() {
+        if (pipelineLibrary != nullptr) {
+            savePipelineCache();
+            pipelineLibrary->Release();
+            pipelineLibrary = nullptr;
+        }
+
         if (d3d != nullptr) {
             d3d->Release();
             d3d = nullptr;
