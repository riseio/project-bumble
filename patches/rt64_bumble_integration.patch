+                    " triangles=%" PRIu32
+                    " span_x=%.3f span_y=%.3f span_z=%.3f"
+                    " segment_vertical_allowance=%.3f"
+                    " accepted=%d pickup_safe=1\n",
+                    record,
+                    tile.tmemHashOrID,
+                    call.callDesc.triangleCount,
+                    static_cast<double>(spanX),
+                    static_cast<double>(spanY),
+                    static_cast<double>(spanZ),
+                    static_cast<double>(segmentVerticalAllowance),
+                    accepted ? 1 : 0
+                );
+                std::fflush(stderr);
+            }
+        }
+        return accepted;
+    }
+
+    static bool bumbleLegacyWaterOverlayContract(
+        const DrawData &drawData,
+        const DrawCallTile &tile,
+        const GameCall &call
+    ) {
+        return (bumbleLegacyWaterSheetContract(tile, call) &&
+                bumbleLegacyWaterOverlayGeometryContract(
+                    drawData,
+                    tile,
+                    call
+                )) ||
+            (bumbleLegacyWaterSegmentContract(tile, call) &&
+                bumbleLegacyWaterOverlayGeometryContract(
+                    drawData,
+                    tile,
+                    call
+                )) ||
+            bumbleLegacyWaterRibbonContract(tile, call);
+    }
+
+    static uint32_t bumbleMaterialClass(
+        const DrawData &drawData,
+        const Projection &projection,
+        const GameCall &call
+    ) {
+        if (projection.type != Projection::Type::Perspective ||
+            call.callDesc.extendedType != DrawExtendedType::None ||
+            call.callDesc.triangleCount == 0u) {
+            return BumbleMaterialNone;
+        }
+        if (call.callDesc.tileCount == 0u) {
+            return BumbleMaterialNone;
+        }
+
+        uint32_t selected = BumbleMaterialNone;
+        for (uint32_t tile = 0; tile < call.callDesc.tileCount; ++tile) {
+            const uint64_t tileIndex =
+                static_cast<uint64_t>(call.callDesc.tileIndex) + tile;
+            if (tileIndex >= drawData.callTiles.size()) {
+                break;
+            }
+            const DrawCallTile &drawTile =
+                drawData.callTiles[static_cast<size_t>(tileIndex)];
+            if (bumbleLegacyWaterOverlayContract(
+                    drawData,
+                    drawTile,
+                    call
+                )) {
+                // The known-texture draw below owns the replacement surface.
+                return BumbleMaterialLegacyWaterOverlay;
+            }
+            const uint32_t candidate = bumbleMaterialClassForHash(
+                drawTile.tmemHashOrID
+            );
+            // Water is deliberately strongest because a mipmapped call can carry more than one tile.
+            if (bumbleWaterMaterialClass(candidate)) {
+                return candidate;
+            }
+            if (candidate == BumbleMaterialLegacyWaterOverlay &&
+                bumbleLegacyWaterOverlayContract(
+                    drawData,
+                    drawTile,
+                    call
+                )) {
+                return candidate;
+            }
+            if (candidate == BumbleMaterialEarth) {
+                selected = candidate;
+            }
+        }
+        return selected;
+    }
+
+    static uint32_t bumbleCachedMaterialClass(
+        std::unordered_map<const GameCall *, uint32_t> &cache,
+        const DrawData &drawData,
+        const Projection &projection,
+        const GameCall &call
+    ) {
+        const auto existing = cache.find(&call);
+        if (existing != cache.end()) {
+            return existing->second;
+        }
+        const uint32_t materialClass = bumbleMaterialClass(
+            drawData,
+            projection,
+            call
+        );
+        cache.emplace(&call, materialClass);
+        return materialClass;
+    }
+
+    static uint64_t bumbleShadowHashMix(
+        uint64_t hash,
+        uint64_t value
+    ) {
+        // FNV-1a over explicit renderer identities.
+        for (uint32_t byte = 0u; byte < 8u; ++byte) {
+            hash ^= (value >> (byte * 8u)) & 0xFFu;
+            hash *= 1099511628211ull;
+        }
+        return hash;
+    }
+
+    static uint64_t bumbleStaticShadowContentKey(
+        const Workload &workload,
+        uint32_t submittedCallCount,
+        uint32_t levelIndex,
+        std::unordered_map<const GameCall *, uint32_t> &materialClassCache
+    ) {
+        uint64_t hash = bumbleShadowHashMix(
+            1469598103934665603ull,
+            levelIndex
+        );
+        uint64_t callCursor = 0u;
+        uint32_t casterCount = 0u;
+        const uint64_t callLimit = submittedCallCount == UINT_MAX
+            ? UINT64_MAX
+            : static_cast<uint64_t>(submittedCallCount);
+        for (uint32_t pairIndex = 0u;
+             pairIndex < workload.fbPairCount &&
+                 pairIndex < workload.fbPairs.size();
+             ++pairIndex) {
+            const FramebufferPair &pair = workload.fbPairs[pairIndex];
+            for (uint32_t projectionIndex = 0u;
+                 projectionIndex < pair.projectionCount;
+                 ++projectionIndex) {
+                const Projection &projection =
+                    pair.projections[projectionIndex];
+                for (uint32_t drawIndex = 0u;
+                     drawIndex < projection.gameCallCount;
+                     ++drawIndex, ++callCursor) {
+                    if (callCursor >= callLimit) {
+                        hash = bumbleShadowHashMix(hash, casterCount);
+                        hash = bumbleShadowHashMix(hash, callCursor);
+                        return hash;
+                    }
+                    const GameCall &call = projection.gameCalls[drawIndex];
+                    if (!bumbleShadowCasterEligible(projection, call) ||
+                        bumbleDynamicShadowCaster(workload.drawData, call)) {
+                        continue;
+                    }
+                    const uint32_t materialClass = bumbleCachedMaterialClass(
+                        materialClassCache,
+                        workload.drawData,
+                        projection,
+                        call
+                    );
+                    if (bumbleWaterMaterialClass(materialClass) ||
+                        materialClass == BumbleMaterialLegacyWaterOverlay) {
+                        continue;
+                    }
+                    ++casterCount;
+                    hash = bumbleShadowHashMix(hash, pairIndex);
+                    hash = bumbleShadowHashMix(hash, projectionIndex);
+                    hash = bumbleShadowHashMix(
+                        hash,
+                        call.callDesc.callIndex
+                    );
+                    hash = bumbleShadowHashMix(
+                        hash,
+                        call.meshDesc.faceIndicesStart
+                    );
+                    hash = bumbleShadowHashMix(
+                        hash,
+                        call.callDesc.triangleCount
+                    );
+                    hash = bumbleShadowHashMix(
+                        hash,
+                        (static_cast<uint64_t>(
+                            call.callDesc.minWorldMatrix
+                        ) << 32u) | call.callDesc.maxWorldMatrix
+                    );
+                    // AUTO/IGNORE transforms can own doors, elevators, and other engine geometry.
+                    const uint32_t firstMatrix =
+                        call.callDesc.minWorldMatrix;
+                    const uint32_t lastMatrix =
+                        call.callDesc.maxWorldMatrix;
+                    if (firstMatrix <= lastMatrix &&
+                        lastMatrix < workload.drawData.worldTransforms.size()) {
+                        for (uint32_t matrixIndex = firstMatrix;
+                             matrixIndex <= lastMatrix;
+                             ++matrixIndex) {
+                            const interop::float4x4 &matrix =
+                                workload.drawData.worldTransforms[matrixIndex];
+                            static_assert(
+                                sizeof(matrix) % sizeof(uint64_t) == 0u
+                            );
+                            const auto *matrixBytes =
+                                reinterpret_cast<const unsigned char *>(&matrix);
+                            for (size_t byte = 0u;
+                                 byte < sizeof(matrix);
+                                 byte += sizeof(uint64_t)) {
+                                uint64_t matrixWord = 0u;
+                                std::memcpy(
+                                    &matrixWord,
+                                    matrixBytes + byte,
+                                    sizeof(matrixWord)
+                                );
+                                hash = bumbleShadowHashMix(hash, matrixWord);
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        hash = bumbleShadowHashMix(hash, casterCount);
+        hash = bumbleShadowHashMix(hash, callCursor);
+        return hash;
+    }
+
+    static uint64_t bumbleCachedStaticShadowContentKey(
+        const Workload &workload,
+        uint32_t submittedCallCount,
+        uint32_t levelIndex,
+        uint64_t submissionFrame,
+        std::unordered_map<const GameCall *, uint32_t> &materialClassCache
+    ) {
+        struct CachedKey {
+            uint32_t submittedCallCount = 0u;
+            uint64_t value = 0u;
+        };
+        thread_local const Workload *cachedWorkload = nullptr;
+        thread_local uint64_t cachedSubmissionFrame = UINT64_MAX;
+        thread_local uint32_t cachedLevelIndex = UINT32_MAX;
+        thread_local std::vector<CachedKey> cachedKeys;
+
+        if (cachedWorkload != &workload ||
+            cachedSubmissionFrame != submissionFrame ||
+            cachedLevelIndex != levelIndex) {
+            cachedWorkload = &workload;
+            cachedSubmissionFrame = submissionFrame;
+            cachedLevelIndex = levelIndex;
+            cachedKeys.clear();
+        }
+        const auto existing = std::find_if(
+            cachedKeys.begin(),
+            cachedKeys.end(),
+            [&](const CachedKey &entry) {
+                return entry.submittedCallCount == submittedCallCount;
+            }
+        );
+        if (existing != cachedKeys.end()) {
+            return existing->value;
+        }
+
+        const uint64_t value = bumbleStaticShadowContentKey(
+            workload,
+            submittedCallCount,
+            levelIndex,
+            materialClassCache
+        );
+        cachedKeys.push_back({ submittedCallCount, value });
+        return value;
+    }
+
+    static bool bumbleWorldVertex(
+        const DrawData &drawData,
+        uint32_t vertexIndex,
+        hlslpp::float3 &worldPosition
+    ) {
+        const size_t positionIndex = static_cast<size_t>(vertexIndex) * 3u;
+        if (vertexIndex >= drawData.worldIndices.size() ||
+            positionIndex + 2u >= drawData.posFloats.size()) {
+            return false;
+        }
+        const uint32_t transformIndex =
+            drawData.worldIndices[vertexIndex];
+        const bool interpolatedTransformsReady =
+            drawData.lerpWorldTransforms.size() ==
+            drawData.worldTransforms.size();
+        const auto &worldTransforms = interpolatedTransformsReady
+            ? drawData.lerpWorldTransforms
+            : drawData.worldTransforms;
+        if (transformIndex >= worldTransforms.size()) {
+            return false;
+        }
+        const hlslpp::float4 localPosition(
+            drawData.posFloats[positionIndex + 0u],
+            drawData.posFloats[positionIndex + 1u],
+            drawData.posFloats[positionIndex + 2u],
+            1.0f
+        );
+        const hlslpp::float4 transformed = hlslpp::mul(
+            localPosition,
+            worldTransforms[transformIndex]
+        );
+        if (!std::isfinite(transformed[0]) ||
+            !std::isfinite(transformed[1]) ||
+            !std::isfinite(transformed[2]) ||
+            !std::isfinite(transformed[3]) ||
+            std::abs(transformed[3]) < 1.0e-6f) {
+            return false;
+        }
+        worldPosition = transformed.xyz / transformed[3];
+        return bumbleFinite(worldPosition);
+    }
+
+    struct BumbleDrawLocalBounds {
+        bool valid = false;
+        bool singleTransform = false;
+        uint32_t transformIndex = UINT32_MAX;
+        hlslpp::float3 minimum = { 0.0f, 0.0f, 0.0f };
+        hlslpp::float3 maximum = { 0.0f, 0.0f, 0.0f };
+    };
+
+    static bool bumbleDrawCachedWorldBounds(
+        const DrawData &drawData,
+        const GameCall &call,
+        std::unordered_map<const GameCall *, BumbleDrawLocalBounds>
+            &localBoundsCache,
+        std::vector<hlslpp::float3> &worldVertexPositions,
+        std::vector<uint32_t> &worldVertexGenerations,
+        std::vector<uint8_t> &worldVertexStates,
+        uint32_t worldVertexGeneration,
+        hlslpp::float3 &minimumWorld,
+        hlslpp::float3 &maximumWorld
+    ) {
+        const uint64_t firstIndex = call.meshDesc.faceIndicesStart;
+        const uint64_t indexCount =
+            static_cast<uint64_t>(call.callDesc.triangleCount) * 3u;
+        if (indexCount == 0u ||
+            firstIndex + indexCount > drawData.faceIndices.size()) {
+            return false;
+        }
+
+        // Local geometry belongs to the immutable source workload.
+        auto [cachedIt, inserted] = localBoundsCache.try_emplace(&call);
+        BumbleDrawLocalBounds &cached = cachedIt->second;
+        if (inserted) {
+            cached.valid = true;
+            cached.singleTransform = true;
+            cached.transformIndex = UINT32_MAX;
+            cached.minimum = hlslpp::float3(
+                std::numeric_limits<float>::max()
+            );
+            cached.maximum = hlslpp::float3(
+                std::numeric_limits<float>::lowest()
+            );
+            for (uint64_t index = 0u; index < indexCount; ++index) {
+                const uint32_t vertexIndex = drawData.faceIndices[
+                    static_cast<size_t>(firstIndex + index)
+                ];
+                const size_t positionIndex =
+                    static_cast<size_t>(vertexIndex) * 3u;
+                if (vertexIndex >= drawData.worldIndices.size() ||
+                    positionIndex + 2u >= drawData.posFloats.size()) {
+                    cached.valid = false;
+                    break;
+                }
+                const uint32_t vertexTransform =
+                    drawData.worldIndices[vertexIndex];
+                if (cached.transformIndex == UINT32_MAX) {
+                    cached.transformIndex = vertexTransform;
+                }
+                else if (cached.transformIndex != vertexTransform) {
+                    cached.singleTransform = false;
+                    break;
+                }
+                const hlslpp::float3 localPosition(
+                    drawData.posFloats[positionIndex + 0u],
+                    drawData.posFloats[positionIndex + 1u],
+                    drawData.posFloats[positionIndex + 2u]
+                );
+                if (!bumbleFinite(localPosition)) {
+                    cached.valid = false;
+                    break;
+                }
+                cached.minimum = hlslpp::min(cached.minimum, localPosition);
+                cached.maximum = hlslpp::max(cached.maximum, localPosition);
+            }
+        }
+        if (!cached.valid) {
+            return false;
+        }
+        if (cached.singleTransform) {
+            const bool interpolatedTransformsReady =
+                drawData.lerpWorldTransforms.size() ==
+                drawData.worldTransforms.size();
+            const auto &worldTransforms = interpolatedTransformsReady
+                ? drawData.lerpWorldTransforms
+                : drawData.worldTransforms;
+            if (cached.transformIndex >= worldTransforms.size()) {
+                return false;
+            }
+            minimumWorld = hlslpp::float3(
+                std::numeric_limits<float>::max()
+            );
+            maximumWorld = hlslpp::float3(
+                std::numeric_limits<float>::lowest()
+            );
+            for (uint32_t corner = 0u; corner < 8u; ++corner) {
+                const hlslpp::float4 localCorner(
+                    (corner & 1u) != 0u
+                        ? cached.maximum[0] : cached.minimum[0],
+                    (corner & 2u) != 0u
+                        ? cached.maximum[1] : cached.minimum[1],
+                    (corner & 4u) != 0u
+                        ? cached.maximum[2] : cached.minimum[2],
+                    1.0f
+                );
+                const hlslpp::float4 transformed = hlslpp::mul(
+                    localCorner,
+                    worldTransforms[cached.transformIndex]
+                );
+                if (!std::isfinite(transformed[0]) ||
+                    !std::isfinite(transformed[1]) ||
+                    !std::isfinite(transformed[2]) ||
+                    !std::isfinite(transformed[3]) ||
+                    std::abs(transformed[3]) < 1.0e-6f) {
+                    return false;
+                }
+                const hlslpp::float3 worldPosition =
+                    transformed.xyz / transformed[3];
+                minimumWorld = hlslpp::min(
+                    minimumWorld,
+                    worldPosition
+                );
+                maximumWorld = hlslpp::max(
+                    maximumWorld,
+                    worldPosition
+                );
+            }
+            return bumbleFinite(minimumWorld) &&
+                bumbleFinite(maximumWorld);
+        }
+
+        minimumWorld = hlslpp::float3(
+            std::numeric_limits<float>::max()
+        );
+        maximumWorld = hlslpp::float3(
+            std::numeric_limits<float>::lowest()
+        );
+        for (uint64_t index = 0u; index < indexCount; ++index) {
+            const uint32_t vertexIndex = drawData.faceIndices[
+                static_cast<size_t>(firstIndex + index)
+            ];
+            if (vertexIndex >= worldVertexPositions.size() ||
+                vertexIndex >= worldVertexGenerations.size() ||
+                vertexIndex >= worldVertexStates.size()) {
+                return false;
+            }
+            uint8_t &vertexState = worldVertexStates[vertexIndex];
+            uint32_t &vertexGeneration = worldVertexGenerations[vertexIndex];
+            if (vertexGeneration != worldVertexGeneration) {
+                vertexState = bumbleWorldVertex(
+                    drawData,
+                    vertexIndex,
+                    worldVertexPositions[vertexIndex]
+                ) ? 1u : 2u;
+                vertexGeneration = worldVertexGeneration;
+            }
+            if (vertexState != 1u) {
+                return false;
+            }
+            const hlslpp::float3 &worldPosition =
+                worldVertexPositions[vertexIndex];
+            minimumWorld = hlslpp::min(minimumWorld, worldPosition);
+            maximumWorld = hlslpp::max(maximumWorld, worldPosition);
+        }
+        return bumbleFinite(minimumWorld) && bumbleFinite(maximumWorld);
+    }
+
+    static bool bumbleBoundsOutsideFrustum(
+        const hlslpp::float3 &minimumWorld,
+        const hlslpp::float3 &maximumWorld,
+        const hlslpp::float4x4 &viewProjection,
+        float clipScaleX = 1.0f,
+        float clipScaleY = 1.0f,
+        float clipOffsetX = 0.0f,
+        float clipOffsetY = 0.0f
+    ) {
+        uint32_t outsideLeft = 0u;
+        uint32_t outsideRight = 0u;
+        uint32_t outsideBottom = 0u;
+        uint32_t outsideTop = 0u;
+        uint32_t outsideNear = 0u;
+        uint32_t outsideFar = 0u;
+        for (uint32_t corner = 0u; corner < 8u; ++corner) {
+            const float x = (corner & 1u) != 0u
+                ? maximumWorld[0]
+                : minimumWorld[0];
+            const float y = (corner & 2u) != 0u
+                ? maximumWorld[1]
+                : minimumWorld[1];
+            const float z = (corner & 4u) != 0u
+                ? maximumWorld[2]
+                : minimumWorld[2];
+            hlslpp::float4 clip = hlslpp::mul(
+                hlslpp::float4(x, y, z, 1.0f),
+                viewProjection
+            );
+            if (!std::isfinite(clip[0]) ||
+                !std::isfinite(clip[1]) ||
+                !std::isfinite(clip[2]) ||
+                !std::isfinite(clip[3])) {
+                return false;
+            }
+            // Match RasterVS's post-projection guard, aspect, and origin transform.
+            clip[0] = clip[0] * clipScaleX + clipOffsetX * clip[3];
+            clip[1] = clip[1] * clipScaleY + clipOffsetY * clip[3];
+            const float padding =
+                std::max(1.0f, std::abs(clip[3])) * 1.0e-4f;
+            outsideLeft += clip[0] < -clip[3] - padding;
+            outsideRight += clip[0] > clip[3] + padding;
+            outsideBottom += clip[1] < -clip[3] - padding;
+            outsideTop += clip[1] > clip[3] + padding;
+            outsideNear += clip[2] < -padding;
+            outsideFar += clip[2] > clip[3] + padding;
+        }
+        return outsideLeft == 8u || outsideRight == 8u ||
+            outsideBottom == 8u || outsideTop == 8u ||
+            outsideNear == 8u || outsideFar == 8u;
+    }
+
+    struct BumbleNdcBounds {
+        float minimumX = 0.0f;
+        float minimumY = 0.0f;
+        float maximumX = 0.0f;
+        float maximumY = 0.0f;
+    };
+
+    // Conservatively project an exact world AABB through the same post-view scale and offset used by RasterVS.
+    static bool bumbleProjectedNdcBounds(
+        const hlslpp::float3 &minimumWorld,
+        const hlslpp::float3 &maximumWorld,
+        const hlslpp::float4x4 &viewProjection,
+        float clipScaleX,
+        float clipScaleY,
+        float clipOffsetX,
+        float clipOffsetY,
+        BumbleNdcBounds &bounds
+    ) {
+        bounds.minimumX = std::numeric_limits<float>::max();
+        bounds.minimumY = std::numeric_limits<float>::max();
+        bounds.maximumX = std::numeric_limits<float>::lowest();
+        bounds.maximumY = std::numeric_limits<float>::lowest();
+        for (uint32_t corner = 0u; corner < 8u; ++corner) {
+            const float x = (corner & 1u) != 0u
+                ? maximumWorld[0]
+                : minimumWorld[0];
+            const float y = (corner & 2u) != 0u
+                ? maximumWorld[1]
+                : minimumWorld[1];
+            const float z = (corner & 4u) != 0u
+                ? maximumWorld[2]
+                : minimumWorld[2];
+            hlslpp::float4 clip = hlslpp::mul(
+                hlslpp::float4(x, y, z, 1.0f),
+                viewProjection
+            );
+            if (!std::isfinite(clip[0]) || !std::isfinite(clip[1]) ||
+                !std::isfinite(clip[2]) || !std::isfinite(clip[3]) ||
+                clip[3] <= 1.0e-4f) {
+                return false;
+            }
+            clip[0] = clip[0] * clipScaleX + clipOffsetX * clip[3];
+            clip[1] = clip[1] * clipScaleY + clipOffsetY * clip[3];
+            const float ndcX = clip[0] / clip[3];
+            const float ndcY = clip[1] / clip[3];
+            if (!std::isfinite(ndcX) || !std::isfinite(ndcY)) {
+                return false;
+            }
+            bounds.minimumX = std::min(bounds.minimumX, ndcX);
+            bounds.minimumY = std::min(bounds.minimumY, ndcY);
+            bounds.maximumX = std::max(bounds.maximumX, ndcX);
+            bounds.maximumY = std::max(bounds.maximumY, ndcY);
+        }
+        return bounds.minimumX <= bounds.maximumX &&
+            bounds.minimumY <= bounds.maximumY;
+    }
+
+    static bool bumbleNdcBoundsOverlap(
+        const BumbleNdcBounds &left,
+        const BumbleNdcBounds &right,
+        float paddingX,
+        float paddingY
+    ) {
+        return left.maximumX + paddingX >= right.minimumX &&
+            left.minimumX - paddingX <= right.maximumX &&
+            left.maximumY + paddingY >= right.minimumY &&
+            left.minimumY - paddingY <= right.maximumY;
+    }
+
+    static RenderRect bumbleNdcBoundsScissor(
+        const BumbleNdcBounds &bounds,
+        uint32_t width,
+        uint32_t height,
+        int32_t padding
+    ) {
+        const float widthF = static_cast<float>(width);
+        const float heightF = static_cast<float>(height);
+        return RenderRect(
+            std::clamp(
+                static_cast<int32_t>(std::floor(
+                    (bounds.minimumX * 0.5f + 0.5f) * widthF
+                )) - padding,
+                0,
+                static_cast<int32_t>(width)
+            ),
+            std::clamp(
+                static_cast<int32_t>(std::floor(
+                    (0.5f - bounds.maximumY * 0.5f) * heightF
+                )) - padding,
+                0,
+                static_cast<int32_t>(height)
+            ),
+            std::clamp(
+                static_cast<int32_t>(std::ceil(
+                    (bounds.maximumX * 0.5f + 0.5f) * widthF
+                )) + padding,
+                0,
+                static_cast<int32_t>(width)
+            ),
+            std::clamp(
+                static_cast<int32_t>(std::ceil(
+                    (0.5f - bounds.minimumY * 0.5f) * heightF
+                )) + padding,
+                0,
+                static_cast<int32_t>(height)
+            )
+        );
+    }
+
+    static bool bumbleWaterDrawPlaneHeight(
+        const DrawData &drawData,
+        const GameCall &call,
+        float &planeHeight,
+        hlslpp::float3 *minimumWorldOut = nullptr,
+        hlslpp::float3 *maximumWorldOut = nullptr
+    ) {
+        const uint64_t firstIndex = call.meshDesc.faceIndicesStart;
+        const uint64_t indexCount =
+            static_cast<uint64_t>(call.callDesc.triangleCount) * 3u;
+        if (indexCount == 0u ||
+            firstIndex + indexCount > drawData.faceIndices.size()) {
+            return false;
+        }
+
+        bool horizontalTriangleFound = false;
+        hlslpp::float3 minimumWorld(
+            std::numeric_limits<float>::max()
+        );
+        hlslpp::float3 maximumWorld(
+            std::numeric_limits<float>::lowest()
+        );
+        float minimumHeight = std::numeric_limits<float>::max();
+        float maximumHeight = std::numeric_limits<float>::lowest();
+        for (uint64_t triangle = 0;
+             triangle < call.callDesc.triangleCount;
+             ++triangle) {
+            hlslpp::float3 p0;
+            hlslpp::float3 p1;
