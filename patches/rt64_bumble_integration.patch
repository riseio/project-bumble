diff --git a/src/render/rt64_bumble_collision_debug.cpp b/src/render/rt64_bumble_collision_debug.cpp
new file mode 100644
index 0000000..f7e9d6f
--- /dev/null
+++ b/src/render/rt64_bumble_collision_debug.cpp
@@ -0,0 +1,263 @@
+//
+// Project-owned Buck Bumble collision debug bridge.
+//
+
+#include "rt64_bumble_collision_debug.h"
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cinttypes>
+#include <cctype>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <mutex>
+#include <string>
+#include <utility>
+
+namespace RT64 {
+    namespace {
+        std::mutex collisionDebugMutex;
+        BumbleCollisionDebugMesh collisionDebugMesh{};
+        BumbleCollisionDebugGateMesh collisionDebugGateMesh{};
+        BumbleCollisionDebugCapsule collisionDebugCapsule{};
+        constexpr size_t SnapshotRingSize = 64u;
+
+        struct SnapshotEntry {
+            uint32_t ticket = 0u;
+            BumbleCollisionDebugSnapshot snapshot{};
+        };
+
+        std::array<SnapshotEntry, SnapshotRingSize> snapshotRing{};
+        std::atomic_uint32_t nextSnapshotTicket{1u};
+        std::mutex snapshotMutex;
+        std::atomic_uint64_t missedSnapshots{0u};
+
+        uint64_t nextGeneration(uint64_t generation) {
+            ++generation;
+            return generation == 0u ? 1u : generation;
+        }
+
+        uint32_t readMode() {
+            const char *value = std::getenv("BUMBLE_COLLISION_VISUALIZE");
+            if (value == nullptr || value[0] == '\0') {
+                return 0u;
+            }
+
+            std::string normalized(value);
+            std::transform(
+                normalized.begin(),
+                normalized.end(),
+                normalized.begin(),
+                [](unsigned char character) {
+                    return static_cast<char>(std::tolower(character));
+                }
+            );
+            if (normalized == "0" || normalized == "off" ||
+                normalized == "false" || normalized == "no") {
+                return 0u;
+            }
+            if (normalized == "2" || normalized == "xray" ||
+                normalized == "strong") {
+                return 2u;
+            }
+            return 1u;
+        }
+
+        std::atomic_uint32_t &collisionDebugModeStorage() {
+            static std::atomic_uint32_t mode{readMode()};
+            return mode;
+        }
+    }
+
+    uint32_t bumbleCollisionDebugMode() {
+        return collisionDebugModeStorage().load(std::memory_order_acquire);
+    }
+
+    void setBumbleCollisionDebugMode(uint32_t mode) {
+        collisionDebugModeStorage().store(
+            std::min(mode, 2u),
+            std::memory_order_release
+        );
+    }
+
+    void publishBumbleCollisionDebugMesh(
+        uint32_t levelIndex,
+        std::vector<BumbleCollisionDebugVertex> vertices,
+        std::vector<BumbleCollisionDebugVertex> liquidCells
+    ) {
+        const std::lock_guard<std::mutex> lock(collisionDebugMutex);
+        collisionDebugMesh.generation = nextGeneration(
+            collisionDebugMesh.generation
+        );
+        collisionDebugMesh.levelIndex = levelIndex;
+        collisionDebugMesh.valid = !vertices.empty();
+        collisionDebugMesh.vertices = std::move(vertices);
+        collisionDebugMesh.liquidCells = std::move(liquidCells);
+    }
+
+    void clearBumbleCollisionDebugScene() {
+        const std::lock_guard<std::mutex> lock(collisionDebugMutex);
+        collisionDebugMesh.generation = nextGeneration(
+            collisionDebugMesh.generation
+        );
+        collisionDebugMesh.levelIndex = 0u;
+        collisionDebugMesh.valid = false;
+        collisionDebugMesh.vertices.clear();
+        collisionDebugMesh.liquidCells.clear();
+        collisionDebugGateMesh.generation = nextGeneration(
+            collisionDebugGateMesh.generation
+        );
+        collisionDebugGateMesh.levelIndex = 0u;
+        collisionDebugGateMesh.valid = false;
+        collisionDebugGateMesh.vertices.clear();
+        collisionDebugCapsule = {};
+    }
+
+    bool copyBumbleCollisionDebugMeshIfChanged(
+        uint64_t knownGeneration,
+        BumbleCollisionDebugMesh &mesh
+    ) {
+        if (bumbleCollisionDebugMode() == 0u) {
+            return false;
+        }
+
+        const std::lock_guard<std::mutex> lock(collisionDebugMutex);
+        if (collisionDebugMesh.generation == knownGeneration) {
+            return false;
+        }
+        mesh = collisionDebugMesh;
+        return true;
+    }
+
+    void publishBumbleCollisionDebugGateMesh(
+        uint32_t levelIndex,
+        std::vector<BumbleCollisionDebugVertex> vertices
+    ) {
+        const std::lock_guard<std::mutex> lock(collisionDebugMutex);
+        collisionDebugGateMesh.generation = nextGeneration(
+            collisionDebugGateMesh.generation
+        );
+        collisionDebugGateMesh.levelIndex = levelIndex;
+        collisionDebugGateMesh.valid = !vertices.empty();
+        collisionDebugGateMesh.vertices = std::move(vertices);
+    }
+
+    bool copyBumbleCollisionDebugGateMeshIfChanged(
+        uint64_t knownGeneration,
+        BumbleCollisionDebugGateMesh &mesh
+    ) {
+        if (bumbleCollisionDebugMode() == 0u) {
+            return false;
+        }
+
+        const std::lock_guard<std::mutex> lock(collisionDebugMutex);
+        if (collisionDebugGateMesh.generation == knownGeneration) {
+            return false;
+        }
+        mesh = collisionDebugGateMesh;
+        return true;
+    }
+
+    void publishBumbleCollisionDebugCapsule(
+        float centerX,
+        float centerY,
+        float centerZ,
+        float radius,
+        float halfHeight,
+        float supportProbeDistance
+    ) {
+        if (!std::isfinite(centerX) || !std::isfinite(centerY) ||
+            !std::isfinite(centerZ) || !std::isfinite(radius) ||
+            !std::isfinite(halfHeight) ||
+            !std::isfinite(supportProbeDistance) || radius <= 0.0f ||
+            halfHeight < 0.0f || supportProbeDistance < 0.0f) {
+            return;
+        }
+
+        const std::lock_guard<std::mutex> lock(collisionDebugMutex);
+        collisionDebugCapsule.centerX = centerX;
+        collisionDebugCapsule.centerY = centerY;
+        collisionDebugCapsule.centerZ = centerZ;
+        collisionDebugCapsule.radius = radius;
+        collisionDebugCapsule.halfHeight = halfHeight;
+        collisionDebugCapsule.supportProbeDistance = supportProbeDistance;
+        collisionDebugCapsule.valid = true;
+    }
+
+    bool readBumbleCollisionDebugCapsule(
+        BumbleCollisionDebugCapsule &capsule
+    ) {
+        if (bumbleCollisionDebugMode() == 0u) {
+            return false;
+        }
+
+        const std::lock_guard<std::mutex> lock(collisionDebugMutex);
+        capsule = collisionDebugCapsule;
+        return capsule.valid;
+    }
+
+    uint32_t publishBumbleCollisionDebugSnapshot(
+        BumbleCollisionDebugSnapshot snapshot
+    ) {
+        if (bumbleCollisionDebugMode() == 0u ||
+            snapshot.listMask != 0x3FFFu ||
+            snapshot.malformedListCount != 0u) {
+            return 0u;
+        }
+
+        uint32_t ticket = nextSnapshotTicket.fetch_add(
+            1u,
+            std::memory_order_relaxed
+        );
+        if (ticket == 0u) {
+            ticket = nextSnapshotTicket.fetch_add(
+                1u,
+                std::memory_order_relaxed
+            );
+        }
+
+        const std::lock_guard<std::mutex> lock(snapshotMutex);
+        SnapshotEntry &entry = snapshotRing[ticket % SnapshotRingSize];
+        entry.snapshot = std::move(snapshot);
+        entry.ticket = ticket;
+        return ticket;
+    }
+
+    bool consumeBumbleCollisionDebugSnapshot(
+        uint32_t ticket,
+        BumbleCollisionDebugSnapshot &snapshot
+    ) {
+        if (bumbleCollisionDebugMode() == 0u || ticket == 0u) {
+            return false;
+        }
+
+        const std::lock_guard<std::mutex> lock(snapshotMutex);
+        SnapshotEntry &entry = snapshotRing[ticket % SnapshotRingSize];
+        if (entry.ticket != ticket) {
+            const uint64_t missed = missedSnapshots.fetch_add(
+                1u,
+                std::memory_order_relaxed
+            ) + 1u;
+            if (missed <= 4u || (missed % 240u) == 0u) {
+                std::fprintf(
+                    stderr,
+                    "BUMBLE_COLLISION_DEBUG stage=snapshot_missed"
+                    " ticket=%" PRIu32 " misses=%" PRIu64
+                    " ring=%zu\n",
+                    ticket,
+                    missed,
+                    SnapshotRingSize
+                );
+                std::fflush(stderr);
+            }
+            return false;
+        }
+
+        snapshot = std::move(entry.snapshot);
+        entry.snapshot = {};
+        entry.ticket = 0u;
+        return true;
+    }
+}
diff --git a/src/render/rt64_bumble_collision_debug.h b/src/render/rt64_bumble_collision_debug.h
new file mode 100644
index 0000000..fe36496
