+++ b/src/render/rt64_bumble_electric.h
@@ -0,0 +1,70 @@
+//
+// Project-owned Buck Bumble modern electric-effect bridge.
+//
+
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <type_traits>
+
+namespace RT64 {
+    // Match the complete retained producer sets in native_electric_effect.
+    constexpr uint32_t BumbleElectricMaxArcs = 32u;
+    constexpr uint32_t BumbleParticleMaxEffects = 32u;
+
+    enum BumbleElectricArcFlags : uint32_t {
+        BumbleElectricArcGeometry = 1u << 0u,
+        BumbleElectricArcEnemy = 1u << 1u,
+        BumbleElectricArcImpact = 1u << 2u,
+    };
+
+    struct BumbleElectricPosition {
+        float x = 0.0f;
+        float y = 0.0f;
+        float z = 0.0f;
+    };
+
+    struct BumbleElectricArc {
+        BumbleElectricPosition source;
+        BumbleElectricPosition target;
+        BumbleElectricPosition normal;
+        float intensity = 1.0f;
+        float ageSeconds = 0.0f;
+        float targetRadius = 0.0f;
+        uint32_t seed = 0u;
+        uint32_t flags = 0u;
+    };
+
+    struct BumbleParticleEffect {
+        BumbleElectricPosition position;
+        float scale = 1.0f;
+        float ageSeconds = 0.0f;
+        uint32_t seed = 0u;
+        uint32_t type = 0u;
+        uint32_t flags = 0u;
+    };
+
+    // One immutable value copy is attached to the exact perspective projection that produced the world.
+    struct BumbleElectricSnapshot {
+        uint64_t sequence = 0u;
+        float phaseSeconds = 0.0f;
+        uint32_t arcCount = 0u;
+        uint32_t effectCount = 0u;
+        std::array<BumbleElectricArc, BumbleElectricMaxArcs> arcs{};
+        std::array<BumbleParticleEffect, BumbleParticleMaxEffects> effects{};
+    };
+
+    static_assert(std::is_trivially_copyable_v<BumbleElectricPosition>);
+    static_assert(std::is_trivially_copyable_v<BumbleElectricArc>);
+    static_assert(std::is_trivially_copyable_v<BumbleParticleEffect>);
+    static_assert(std::is_trivially_copyable_v<BumbleElectricSnapshot>);
+
+    uint32_t publishBumbleElectricSnapshot(
+        const BumbleElectricSnapshot &snapshot
+    );
+    bool consumeBumbleElectricSnapshot(
+        uint32_t ticket,
+        BumbleElectricSnapshot &snapshot
+    );
+}
diff --git a/src/render/rt64_bumble_electric_renderer.cpp b/src/render/rt64_bumble_electric_renderer.cpp
new file mode 100644
index 0000000..9044dd2
--- /dev/null
+++ b/src/render/rt64_bumble_electric_renderer.cpp
@@ -0,0 +1,1103 @@
+//
+// Project-owned Buck Bumble modern electric-effect renderer.
+//
+
+#include "rt64_bumble_electric_renderer.h"
+
+#include <algorithm>
+#include <array>
+#include <cassert>
+#include <cmath>
+#include <cinttypes>
+#include <cstdio>
+
+#include "shaders/BumbleElectricPS.hlsl.spirv.h"
+#include "shaders/BumbleElectricVS.hlsl.spirv.h"
+#ifdef _WIN32
+#   include "shaders/BumbleElectricPS.hlsl.dxil.h"
+#   include "shaders/BumbleElectricVS.hlsl.dxil.h"
+#elif defined(__APPLE__)
+#   include "shaders/BumbleElectricPS.hlsl.metal.h"
+#   include "shaders/BumbleElectricVS.hlsl.metal.h"
+#endif
+
+#include "rt64_render_target.h"
+#include "rt64_render_worker.h"
+#include "rt64_bumble_environment.h"
+
+namespace RT64 {
+    namespace {
+        constexpr uint32_t QuadVertexCount = 6u;
+        constexpr uint32_t MainMinimumSegments = 12u;
+        constexpr uint32_t MainMaximumSegments = 22u;
+        constexpr uint32_t BranchCount = 2u;
+        constexpr uint32_t BranchSegments = 5u;
+        constexpr uint32_t BaseSparkCount = 10u;
+        constexpr uint32_t ImpactSparkCount = 8u;
+        constexpr uint32_t ContactRingSegments = 12u;
+        constexpr uint32_t ExplosionFireballs = 4u;
+        constexpr uint32_t ExplosionSparks = 8u;
+        constexpr uint32_t ExplosionSmokePuffs = 6u;
+        constexpr float ExplosionLifetime = 1.75f;
+        constexpr float Pi = 3.14159265358979323846f;
+
+        constexpr float explosionRadius(float authoredScale) {
+            return std::clamp(authoredScale * 70.0f, 24.0f, 350.0f);
+        }
+
+        constexpr float explosionSparkWidth(float radius) {
+            return std::clamp(
+                0.28f + radius * 0.0024f,
+                0.35f,
+                1.10f
+            );
+        }
+
+        static_assert(explosionRadius(0.2f) == 24.0f);
+        static_assert(explosionRadius(1.0f) == 70.0f);
+        static_assert(explosionRadius(5.0f) == 350.0f);
+
+        enum RecordKind : uint32_t {
+            RecordMainArc = 0u,
+            RecordBranch = 1u,
+            RecordSpark = 2u,
+            RecordHalo = 3u,
+            RecordContactRing = 4u,
+            RecordFireball = 5u,
+            RecordSmoke = 6u,
+            RecordExplosionSpark = 7u,
+            RecordExplosionFlash = 8u,
+        };
+
+        struct Vec3 {
+            float x = 0.0f;
+            float y = 0.0f;
+            float z = 0.0f;
+        };
+
+        Vec3 add(const Vec3& left, const Vec3& right) {
+            return {
+                left.x + right.x,
+                left.y + right.y,
+                left.z + right.z,
+            };
+        }
+
+        Vec3 subtract(const Vec3& left, const Vec3& right) {
+            return {
+                left.x - right.x,
+                left.y - right.y,
+                left.z - right.z,
+            };
+        }
+
+        Vec3 multiply(const Vec3& value, float scalar) {
+            return {
+                value.x * scalar,
+                value.y * scalar,
+                value.z * scalar,
+            };
+        }
+
+        float dot(const Vec3& left, const Vec3& right) {
+            return left.x * right.x + left.y * right.y +
+                left.z * right.z;
+        }
+
+        Vec3 cross(const Vec3& left, const Vec3& right) {
+            return {
+                left.y * right.z - left.z * right.y,
+                left.z * right.x - left.x * right.z,
+                left.x * right.y - left.y * right.x,
+            };
+        }
+
+        float length(const Vec3& value) {
+            return std::sqrt(std::max(dot(value, value), 0.0f));
+        }
+
+        bool normalize(Vec3& value) {
+            const float magnitude = length(value);
+            if (!std::isfinite(magnitude) || magnitude < 1.0e-5f) {
+                return false;
+            }
+            value = multiply(value, 1.0f / magnitude);
+            return true;
+        }
+
+        Vec3 lerp(const Vec3& first, const Vec3& second, float t) {
+            return add(first, multiply(subtract(second, first), t));
+        }
+
+        uint32_t mix32(uint32_t value) {
+            value ^= value >> 16u;
+            value *= 0x7FEB352Du;
+            value ^= value >> 15u;
+            value *= 0x846CA68Bu;
+            value ^= value >> 16u;
+            return value;
+        }
+
+        float hashUnit(uint32_t value) {
+            return static_cast<float>(mix32(value) & 0x00FFFFFFu) /
+                static_cast<float>(0x01000000u);
+        }
+
+        float signedHash(uint32_t value) {
+            return hashUnit(value) * 2.0f - 1.0f;
+        }
+
+        float fract(float value) {
+            return value - std::floor(value);
+        }
+
+        void appendRecord(
+            std::vector<BumbleElectricGPURecord>& records,
+            const Vec3& start,
+            const Vec3& end,
+            float width,
+            float intensity,
+            float taper,
+            float pulse,
+            uint32_t kind,
+            uint32_t seed
+        ) {
+            if (!std::isfinite(start.x) || !std::isfinite(start.y) ||
+                !std::isfinite(start.z) || !std::isfinite(end.x) ||
+                !std::isfinite(end.y) || !std::isfinite(end.z) ||
+                !std::isfinite(width) || !std::isfinite(intensity) ||
+                width <= 0.0f || intensity <= 0.0f) {
+                return;
+            }
+            records.push_back({
+                start.x,
+                start.y,
+                start.z,
+                width,
+                end.x,
+                end.y,
+                end.z,
+                intensity,
+                taper,
+                pulse,
+                kind,
+                seed,
+            });
+        }
+
+        Vec3 arcPoint(
+            const Vec3& source,
+            const Vec3& target,
+            const Vec3& side,
+            const Vec3& up,
+            float t,
+            float amplitude,
+            uint32_t seed,
+            float phase
+        ) {
+            if (t <= 0.0f) {
+                return source;
+            }
+            if (t >= 1.0f) {
+                return target;
+            }
+
+            const float envelope = std::sin(Pi * t);
+            const float first =
+                std::sin(phase * 15.7f + t * 37.0f +
+                    static_cast<float>(seed & 1023u) * 0.017f) *
+                    0.68f +
+                std::sin(phase * -9.3f + t * 83.0f +
+                    static_cast<float>((seed >> 10u) & 1023u) * 0.031f) *
+                    0.32f;
+            const float second =
+                std::sin(phase * -13.1f + t * 51.0f +
+                    static_cast<float>((seed >> 20u) & 1023u) * 0.023f) *
+                    0.70f +
+                std::cos(phase * 7.7f + t * 97.0f +
+                    static_cast<float>(seed & 511u) * 0.041f) *
+                    0.30f;
+            return add(
+                lerp(source, target, t),
+                add(
+                    multiply(side, first * amplitude * envelope),
+                    multiply(up, second * amplitude * 0.72f * envelope)
+                )
+            );
+        }
+
+        void appendArcRecords(
+            std::vector<BumbleElectricGPURecord>& records,
+            const BumbleElectricArc& arc,
+            float phase
+        ) {
+            Vec3 source{arc.source.x, arc.source.y, arc.source.z};
+            Vec3 target{arc.target.x, arc.target.y, arc.target.z};
+            Vec3 direction = subtract(target, source);
+            const float arcLength = length(direction);
+            if (!normalize(direction) || arcLength < 1.0f ||
+                arcLength > 400.0f || !std::isfinite(arc.intensity)) {
+                return;
+            }
+
+            Vec3 reference =
+                std::abs(direction.y) < 0.82f
+                    ? Vec3{0.0f, 1.0f, 0.0f}
+                    : Vec3{1.0f, 0.0f, 0.0f};
+            Vec3 side = cross(direction, reference);
+            if (!normalize(side)) {
+                return;
+            }
+            Vec3 up = cross(side, direction);
+            if (!normalize(up)) {
+                return;
+            }
+
+            const float amplitude = std::clamp(
+                arcLength * 0.085f,
+                3.0f,
+                20.0f
+            );
+            const uint32_t mainSegments = std::clamp(
+                static_cast<uint32_t>(std::ceil(arcLength / 13.0f)),
+                MainMinimumSegments,
+                MainMaximumSegments
+            );
+            for (uint32_t segment = 0u;
+                 segment < mainSegments;
+                 ++segment) {
+                const float t0 =
+                    static_cast<float>(segment) /
+                    static_cast<float>(mainSegments);
+                const float t1 =
+                    static_cast<float>(segment + 1u) /
+                    static_cast<float>(mainSegments);
+                appendRecord(
+                    records,
+                    arcPoint(
+                        source,
+                        target,
+                        side,
+                        up,
+                        t0,
+                        amplitude,
+                        arc.seed,
+                        phase
+                    ),
+                    arcPoint(
+                        source,
+                        target,
+                        side,
+                        up,
+                        t1,
+                        amplitude,
+                        arc.seed,
+                        phase
+                    ),
+                    1.55f,
+                    arc.intensity,
+                    1.0f,
+                    phase,
+                    RecordMainArc,
+                    mix32(arc.seed ^ segment)
+                );
+            }
+
+            for (uint32_t branch = 0u;
+                 branch < BranchCount;
+                 ++branch) {
+                const uint32_t branchSeed =
+                    mix32(arc.seed ^ (0xA341316Cu + branch * 0x9E3779B9u));
+                const float startT =
+                    0.24f + hashUnit(branchSeed) * 0.48f;
+                const Vec3 branchSource = arcPoint(
+                    source,
+                    target,
+                    side,
+                    up,
+                    startT,
+                    amplitude,
+                    arc.seed,
+                    phase
+                );
+                const float angle =
+                    signedHash(branchSeed ^ 0xC8013EA4u) * 1.45f;
+                Vec3 branchDirection = add(
+                    multiply(direction, 0.16f),
+                    add(
+                        multiply(side, std::cos(angle)),
+                        multiply(up, std::sin(angle))
+                    )
+                );
+                normalize(branchDirection);
+                const float branchLength = std::clamp(
+                    arcLength *
+                        (0.16f + hashUnit(branchSeed ^ 0xAD90777Du) *
+                            0.12f),
+                    12.0f,
+                    38.0f
+                );
+                const Vec3 branchTarget = add(
+                    branchSource,
+                    multiply(branchDirection, branchLength)
+                );
+                Vec3 branchSide = cross(branchDirection, up);
+                if (!normalize(branchSide)) {
+                    branchSide = side;
+                }
+                Vec3 branchUp = cross(branchSide, branchDirection);
+                normalize(branchUp);
+                for (uint32_t segment = 0u;
+                     segment < BranchSegments;
+                     ++segment) {
+                    const float t0 =
+                        static_cast<float>(segment) /
+                        static_cast<float>(BranchSegments);
+                    const float t1 =
+                        static_cast<float>(segment + 1u) /
+                        static_cast<float>(BranchSegments);
+                    appendRecord(
+                        records,
+                        arcPoint(
+                            branchSource,
+                            branchTarget,
+                            branchSide,
+                            branchUp,
+                            t0,
+                            amplitude * 0.34f,
+                            branchSeed,
+                            phase
+                        ),
+                        arcPoint(
+                            branchSource,
+                            branchTarget,
+                            branchSide,
+                            branchUp,
+                            t1,
+                            amplitude * 0.34f,
+                            branchSeed,
+                            phase
+                        ),
+                        0.92f,
+                        arc.intensity * (0.52f - t0 * 0.30f),
+                        1.0f - t0,
+                        phase,
+                        RecordBranch,
+                        mix32(branchSeed ^ segment)
+                    );
+                }
+            }
+
+            Vec3 normal{arc.normal.x, arc.normal.y, arc.normal.z};
+            if (!normalize(normal)) {
+                normal = multiply(direction, -1.0f);
+            }
+            Vec3 tangent = cross(normal, reference);
+            if (!normalize(tangent)) {
+                tangent = side;
+            }
+            Vec3 bitangent = cross(normal, tangent);
+            if (!normalize(bitangent)) {
+                bitangent = up;
+            }
+
+            const bool impact =
+                (arc.flags & BumbleElectricArcImpact) != 0u;
+            const uint32_t sparkCount =
+                BaseSparkCount + (impact ? ImpactSparkCount : 0u);
+            for (uint32_t spark = 0u; spark < sparkCount; ++spark) {
+                const uint32_t sparkSeed =
+                    mix32(arc.seed ^ (spark * 0x85EBCA6Bu));
+                const float cycle = fract(
+                    phase * (impact ? 4.4f : 3.2f) +
+                    hashUnit(sparkSeed)
+                );
+                const float angle =
+                    hashUnit(sparkSeed ^ 0xD3A2646Cu) * 2.0f * Pi;
+                const float normalWeight =
+                    0.20f + hashUnit(sparkSeed ^ 0xFD7046C5u) * 0.75f;
+                Vec3 sparkDirection = add(
+                    multiply(normal, normalWeight),
+                    add(
+                        multiply(tangent, std::cos(angle)),
+                        multiply(bitangent, std::sin(angle))
+                    )
+                );
+                normalize(sparkDirection);
+                const float speed =
+                    9.0f + hashUnit(sparkSeed ^ 0xB55A4F09u) *
+                        (impact ? 34.0f : 23.0f);
+                const Vec3 origin = add(target, multiply(normal, 0.8f));
+                Vec3 sparkPosition = add(
+                    origin,
+                    multiply(sparkDirection, speed * cycle)
+                );
+                sparkPosition.y -= 10.0f * cycle * cycle;
+                const float trail =
+                    2.5f + (1.0f - cycle) * (impact ? 8.0f : 5.0f);
+                appendRecord(
+                    records,
+                    sparkPosition,
+                    subtract(
+                        sparkPosition,
+                        multiply(sparkDirection, trail)
+                    ),
+                    impact ? 0.92f : 0.72f,
+                    arc.intensity *
+                        (impact ? 0.78f : 0.50f) *
+                        (1.0f - cycle) * (1.0f - cycle),
+                    1.0f - cycle,
+                    phase,
+                    RecordSpark,
+                    sparkSeed
+                );
+            }
+
+            const float ringPulse =
+                0.5f + 0.5f * std::sin(phase * 19.0f + arc.seed * 0.001f);
+            const float ringRadius =
+                std::clamp(arc.targetRadius * 0.35f, 4.0f, 12.0f) +
+                ringPulse * (impact ? 10.0f : 5.0f);
+            const Vec3 ringCenter = add(target, multiply(normal, 0.65f));
+            for (uint32_t segment = 0u;
+                 segment < ContactRingSegments;
+                 ++segment) {
+                if ((mix32(arc.seed ^ segment) & 3u) == 0u) {
+                    continue;
+                }
+                const float angle0 =
+                    static_cast<float>(segment) /
+                    static_cast<float>(ContactRingSegments) *
+                    2.0f * Pi;
+                const float angle1 =
+                    static_cast<float>(segment + 1u) /
+                    static_cast<float>(ContactRingSegments) *
+                    2.0f * Pi;
+                const Vec3 ringStart = add(
+                    ringCenter,
+                    add(
+                        multiply(tangent, std::cos(angle0) * ringRadius),
+                        multiply(bitangent, std::sin(angle0) * ringRadius)
+                    )
+                );
+                const Vec3 ringEnd = add(
+                    ringCenter,
+                    add(
+                        multiply(tangent, std::cos(angle1) * ringRadius),
+                        multiply(bitangent, std::sin(angle1) * ringRadius)
+                    )
+                );
+                appendRecord(
+                    records,
+                    ringStart,
+                    ringEnd,
+                    0.82f,
+                    arc.intensity * (impact ? 0.72f : 0.38f),
+                    1.0f,
+                    ringPulse,
+                    RecordContactRing,
+                    mix32(arc.seed ^ segment ^ 0x27D4EB2Fu)
+                );
+            }
+
+            // Endpoint/source flares are radial additive billboards.
+            appendRecord(
+                records,
+                target,
+                target,
+                impact ? 24.0f : 18.0f,
+                arc.intensity * (impact ? 0.82f : 0.50f),
+                1.0f,
+                phase,
+                RecordHalo,
+                arc.seed ^ 0x165667B1u
+            );
+            appendRecord(
+                records,
+                source,
+                source,
+                10.0f,
+                arc.intensity * 0.26f,
+                1.0f,
+                phase,
+                RecordHalo,
+                arc.seed ^ 0xD3A2646Cu
+            );
+        }
+
+        void appendEffectAdditiveRecords(
+            std::vector<BumbleElectricGPURecord>& records,
+            const BumbleParticleEffect& effect
+        ) {
+            if (!std::isfinite(effect.position.x) ||
+                !std::isfinite(effect.position.y) ||
+                !std::isfinite(effect.position.z) ||
+                !std::isfinite(effect.scale) ||
+                !std::isfinite(effect.ageSeconds) ||
+                effect.scale <= 0.0f ||
+                effect.ageSeconds < 0.0f ||
+                effect.ageSeconds > ExplosionLifetime) {
+                return;
+            }
+
+            const Vec3 origin{
+                effect.position.x,
+                effect.position.y,
+                effect.position.z,
+            };
+            const float age = effect.ageSeconds;
+            const float baseRadius = explosionRadius(effect.scale);
+            if (age < 0.24f) {
+                const float progress = age / 0.24f;
+                appendRecord(
+                    records,
+                    origin,
+                    origin,
+                    baseRadius * (0.72f + progress * 1.35f),
+                    (1.0f - progress) * 1.45f,
+                    1.0f,
+                    progress,
+                    RecordExplosionFlash,
+                    effect.seed ^ effect.type
+                );
+            }
+
+            for (uint32_t index = 0u;
+                 index < ExplosionFireballs;
+                 ++index) {
+                const float delay = static_cast<float>(index) * 0.055f;
+                const float localAge = age - delay;
+                if (localAge < 0.0f || localAge > 0.78f) {
+                    continue;
+                }
+                const float progress = localAge / 0.78f;
+                const uint32_t seed = mix32(
+                    effect.seed ^ effect.type ^
+                    (index * 0x9E3779B9u)
+                );
+                const Vec3 drift{
+                    signedHash(seed) * baseRadius * 0.46f * progress,
+                    baseRadius *
+                        (0.18f + hashUnit(seed ^ 0x68BC21EBu)) *
+                        progress,
+                    signedHash(seed ^ 0x02E5BE93u) *
+                        baseRadius * 0.46f * progress,
+                };
+                const Vec3 center = add(origin, drift);
+                appendRecord(
+                    records,
+                    center,
+                    center,
+                    baseRadius *
+                        (0.34f + progress * 0.58f) *
+                        (0.82f +
+                            hashUnit(seed ^ 0xA511E9B3u) * 0.36f),
+                    (1.0f - progress) * (1.0f - progress) * 1.12f,
+                    1.0f,
+                    progress,
+                    RecordFireball,
+                    seed
+                );
+            }
+
+            if (age > 0.88f) {
+                return;
+            }
+            for (uint32_t index = 0u;
+                 index < ExplosionSparks;
+                 ++index) {
+                const uint32_t seed = mix32(
+                    effect.seed ^ effect.type ^
+                    (index * 0x85EBCA6Bu)
+                );
+                const float azimuth = hashUnit(seed) * 2.0f * Pi;
+                const float lift =
+                    0.18f + hashUnit(seed ^ 0xC2B2AE35u) * 0.78f;
+                Vec3 direction{
+                    std::cos(azimuth),
+                    lift,
+                    std::sin(azimuth),
+                };
+                normalize(direction);
+                const float speed = baseRadius *
+                    (1.8f + hashUnit(seed ^ 0x27D4EB2Fu) * 2.4f);
+                Vec3 tip = add(origin, multiply(direction, speed * age));
+                tip.y -= baseRadius * 1.35f * age * age;
+                const Vec3 tail = subtract(
+                    tip,
+                    multiply(
+                        direction,
+                        baseRadius * (0.12f + age * 0.34f)
+                    )
+                );
+                appendRecord(
+                    records,
+                    tail,
+                    tip,
+                    explosionSparkWidth(baseRadius),
+                    (1.0f - age / 0.88f) * 0.92f,
+                    1.0f,
+                    age,
+                    RecordExplosionSpark,
+                    seed
+                );
+            }
+        }
+
+        void appendEffectSmokeRecords(
+            std::vector<BumbleElectricGPURecord>& records,
+            const BumbleParticleEffect& effect
+        ) {
+            if (!std::isfinite(effect.position.x) ||
+                !std::isfinite(effect.position.y) ||
+                !std::isfinite(effect.position.z) ||
+                !std::isfinite(effect.scale) ||
+                !std::isfinite(effect.ageSeconds) ||
+                effect.scale <= 0.0f) {
+                return;
+            }
+
+            const Vec3 origin{
+                effect.position.x,
+                effect.position.y,
+                effect.position.z,
+            };
+            const float baseRadius = explosionRadius(effect.scale);
+            for (uint32_t index = 0u;
+                 index < ExplosionSmokePuffs;
+                 ++index) {
+                const float delay =
+                    0.10f + static_cast<float>(index) * 0.10f;
+                const float localAge = effect.ageSeconds - delay;
+                const float lifetime =
+                    0.82f + static_cast<float>(index) * 0.065f;
+                if (localAge < 0.0f || localAge > lifetime) {
+                    continue;
+                }
+                const float progress = localAge / lifetime;
+                const uint32_t seed = mix32(
+                    effect.seed ^ effect.type ^
+                    (index * 0xD3A2646Cu)
+                );
+                const Vec3 drift{
+                    signedHash(seed) * baseRadius *
+                        (0.22f + progress * 0.42f),
+                    baseRadius *
+                        (0.32f +
+                            hashUnit(seed ^ 0x9E3779B9u) * 0.42f) *
+                        progress,
+                    signedHash(seed ^ 0xA511E9B3u) * baseRadius *
+                        (0.22f + progress * 0.42f),
+                };
+                const Vec3 center = add(origin, drift);
+                const float fade =
+                    (1.0f - progress) *
+                    std::min(localAge / 0.12f, 1.0f);
+                appendRecord(
+                    records,
+                    center,
+                    center,
+                    baseRadius *
+                        (0.42f + progress * 1.12f) *
+                        (0.84f +
+                            hashUnit(seed ^ 0x7F4A7C15u) * 0.32f),
+                    fade * (0.58f + effect.scale * 0.16f),
+                    1.0f,
+                    progress,
+                    RecordSmoke,
+                    seed
+                );
+            }
+        }
+
+        const void *shaderBlob(
+            RenderShaderFormat format,
+            bool vertex,
+            size_t &size
+        ) {
+            switch (format) {
+#ifdef _WIN32
+            case RenderShaderFormat::DXIL:
+                if (vertex) {
+                    size = sizeof(BumbleElectricVSBlobDXIL);
+                    return BumbleElectricVSBlobDXIL;
+                }
+                size = sizeof(BumbleElectricPSBlobDXIL);
+                return BumbleElectricPSBlobDXIL;
+#endif
+            case RenderShaderFormat::SPIRV:
+                if (vertex) {
+                    size = sizeof(BumbleElectricVSBlobSPIRV);
+                    return BumbleElectricVSBlobSPIRV;
+                }
+                size = sizeof(BumbleElectricPSBlobSPIRV);
+                return BumbleElectricPSBlobSPIRV;
+#ifdef __APPLE__
+            case RenderShaderFormat::METAL:
+                if (vertex) {
+                    size = sizeof(BumbleElectricVSBlobMSL);
+                    return BumbleElectricVSBlobMSL;
+                }
+                size = sizeof(BumbleElectricPSBlobMSL);
+                return BumbleElectricPSBlobMSL;
+#endif
+            default:
+                size = 0u;
+                return nullptr;
+            }
+        }
+    }
+
+    BumbleElectricRenderer::BumbleElectricRenderer() { }
+
+    void BumbleElectricRenderer::reset() {
+        records.clear();
+        draws.clear();
+        uploadPending = false;
+        const auto now = std::chrono::steady_clock::now();
+        if (animationClockInitialized) {
+            animationTimeSeconds = std::fmod(
+                animationTimeSeconds + std::clamp(
+                    std::chrono::duration<float>(
+                        now - animationLastFrame
+                    ).count(),
+                    0.0f,
+                    0.05f
+                ),
+                4096.0f
+            );
+        }
+        animationLastFrame = now;
+        animationClockInitialized = true;
+    }
+
+    bool BumbleElectricRenderer::ensurePipeline(
+        RenderWorker *worker,
+        RenderShaderFormat format,
+        const RenderMultisampling &multisampling,
+        bool usesHDR
+    ) {
+        assert(worker != nullptr);
+        if (pipeline != nullptr && smokePipeline != nullptr &&
+            shaderFormat == format &&
+            sampleCount == multisampling.sampleCount &&
+            pipelineUsesHDR == usesHDR) {
+            return true;
+        }
+
+        pipeline.reset();
+        smokePipeline.reset();
+        pipelineLayout.reset();
+        vertexShader.reset();
+        pixelShader.reset();
+
+        size_t vertexBlobSize = 0u;
+        size_t pixelBlobSize = 0u;
+        const void *vertexBlob = shaderBlob(
+            format,
+            true,
+            vertexBlobSize
+        );
+        const void *pixelBlob = shaderBlob(
+            format,
+            false,
+            pixelBlobSize
+        );
+        if (vertexBlob == nullptr || pixelBlob == nullptr) {
+            return false;
+        }
+        vertexShader = worker->device->createShader(
+            vertexBlob,
+            vertexBlobSize,
+            "VSMain",
+            format
+        );
+        pixelShader = worker->device->createShader(
+            pixelBlob,
+            pixelBlobSize,
+            "PSMain",
+            format
+        );
+
+        if (descriptorSet == nullptr) {
+            descriptorSet = std::make_unique<RenderDescriptorSetBase>();
+            descriptorSet->builder.begin();
+            recordDescriptorIndex =
+                descriptorSet->builder.addStructuredBuffer(1);
+            descriptorSet->builder.end();
+            descriptorSet->create(worker->device);
+        }
+
+        RenderPipelineLayoutBuilder layoutBuilder;
+        layoutBuilder.begin(false, false);
+        layoutBuilder.addPushConstant(
+            0,
+            0,
+            sizeof(PushConstants),
+            RenderShaderStageFlag::VERTEX | RenderShaderStageFlag::PIXEL
+        );
+        layoutBuilder.addDescriptorSet(*descriptorSet);
+        layoutBuilder.end();
+        pipelineLayout = layoutBuilder.create(worker->device);
+
+        RenderBlendDesc additive{};
+        additive.blendEnabled = true;
+        additive.srcBlend = RenderBlend::ONE;
+        additive.dstBlend = RenderBlend::ONE;
+        additive.blendOp = RenderBlendOperation::ADD;
+        additive.srcBlendAlpha = RenderBlend::ONE;
+        additive.dstBlendAlpha = RenderBlend::ONE;
+        additive.blendOpAlpha = RenderBlendOperation::ADD;
+
+        RenderGraphicsPipelineDesc desc;
+        desc.pipelineLayout = pipelineLayout.get();
+        desc.vertexShader = vertexShader.get();
+        desc.pixelShader = pixelShader.get();
+        desc.primitiveTopology = RenderPrimitiveTopology::TRIANGLE_LIST;
+        desc.cullMode = RenderCullMode::NONE;
+        desc.depthClipEnabled = true;
+        desc.depthEnabled = true;
+        desc.depthWriteEnabled = false;
+        desc.depthFunction = RenderComparisonFunction::LESS_EQUAL;
+        desc.depthTargetFormat = RenderFormat::D32_FLOAT;
+        desc.multisampling = multisampling;
+        desc.alphaToCoverageEnabled = false;
+        desc.renderTargetFormat[0] =
+            RenderTarget::colorBufferFormat(usesHDR);
+        desc.renderTargetBlend[0] = additive;
+        desc.renderTargetCount = 1;
+        pipeline = worker->device->createGraphicsPipeline(desc);
+        desc.renderTargetBlend[0] = RenderBlendDesc::AlphaBlend();
+        smokePipeline = worker->device->createGraphicsPipeline(desc);
+
+        shaderFormat = format;
+        sampleCount = multisampling.sampleCount;
+        pipelineUsesHDR = usesHDR;
+        if (bumbleRendererProofLogEnabled()) {
+            std::fprintf(
+                stderr,
+                "BUMBLE_ELECTRIC stage=gpu_pipeline_ready"
+                " shader_format=%d samples=%" PRIu32
+                " topology=depth_tested_instanced_effects"
+                " depth=less_equal_read_only"
+                " passes=soft_glow,bright_core,alpha_smoke\n",
+                static_cast<int>(format),
+                static_cast<uint32_t>(sampleCount)
+            );
+            std::fflush(stderr);
+        }
+        return pipeline != nullptr && smokePipeline != nullptr;
+    }
+
+    uint32_t BumbleElectricRenderer::addDraw(
+        const BumbleElectricSnapshot &snapshot,
+        const interop::float4x4 &viewProj,
+        const interop::RSPViewport &rspViewport,
+        const RenderRect &scissor
+    ) {
+        if ((snapshot.arcCount == 0u && snapshot.effectCount == 0u) ||
+            snapshot.arcCount > BumbleElectricMaxArcs ||
+            snapshot.effectCount > BumbleParticleMaxEffects ||
+            scissor.isEmpty()) {
+            return BumbleElectricInvalidDraw;
+        }
+
+        Draw draw{};
+        draw.constants.viewProj = viewProj;
+        draw.constants.depthViewport = {
+            rspViewport.scale.z,
+            rspViewport.translate.z,
+            static_cast<float>(
+                std::max(scissor.right - scissor.left, 1)
+            ),
+            static_cast<float>(
+                std::max(scissor.bottom - scissor.top, 1)
+            ),
+        };
+        draw.constants.passParams = {
+            0.0f,
+            1.0f,
+            1.0f,
+            animationTimeSeconds,
+        };
+        draw.recordStart = static_cast<uint32_t>(records.size());
+        draw.arcCount = snapshot.arcCount;
+        draw.effectCount = snapshot.effectCount;
+        draw.sequence = snapshot.sequence;
+        draw.scissor = scissor;
+        for (uint32_t index = 0u;
+             index < snapshot.arcCount;
+             ++index) {
+            appendArcRecords(
+                records,
+                snapshot.arcs[index],
+                animationTimeSeconds
+            );
+        }
+        for (uint32_t index = 0u;
+             index < snapshot.effectCount;
+             ++index) {
+            appendEffectAdditiveRecords(records, snapshot.effects[index]);
+        }
+        draw.additiveRecordCount =
+            static_cast<uint32_t>(records.size()) - draw.recordStart;
+        draw.smokeRecordStart = static_cast<uint32_t>(records.size());
+        for (uint32_t index = 0u;
+             index < snapshot.effectCount;
+             ++index) {
+            appendEffectSmokeRecords(records, snapshot.effects[index]);
+        }
+        draw.smokeRecordCount =
+            static_cast<uint32_t>(records.size()) - draw.smokeRecordStart;
+        draw.recordCount =
+            static_cast<uint32_t>(records.size()) - draw.recordStart;
+        if (draw.recordCount == 0u) {
+            return BumbleElectricInvalidDraw;
+        }
+        draw.constants.population = {
+            draw.recordStart,
+            draw.recordCount,
+            draw.arcCount,
+            draw.effectCount,
+        };
+        uploadPending = true;
+
+        const uint32_t drawIndex = static_cast<uint32_t>(draws.size());
+        draws.push_back(draw);
+        ++loggedDraws;
+        loggedRecords += draw.recordCount;
+        if (bumbleRendererProofLogEnabled() &&
+            (loggedDraws <= 8u || (loggedDraws % 240u) == 0u)) {
+            std::fprintf(
+                stderr,
+                "BUMBLE_ELECTRIC stage=gpu_draw_prepared"
+                " draw=%" PRIu64 " sequence=%" PRIu64
+                " arcs=%" PRIu32 " effects=%" PRIu32
+                " records=%" PRIu32
+                " total_records=%" PRIu64
+                " features=electricity,fireball,flash,sparks,smoke"
+                " endpoint_space=world depth_occlusion=1\n",
+                loggedDraws,
+                draw.sequence,
+                draw.arcCount,
+                draw.effectCount,
+                draw.recordCount,
+                loggedRecords
+            );
+            std::fflush(stderr);
+        }
+        return drawIndex;
+    }
+
+    void BumbleElectricRenderer::appendUpload(
+        std::vector<BufferUploader::Upload> &uploads
+    ) {
+        if (!uploadPending || draws.empty()) {
+            return;
+        }
+        if (records.empty()) {
+            records.emplace_back();
+        }
+        uploads.push_back({
+            records.data(),
+            {0u, records.size()},
+            sizeof(BumbleElectricGPURecord),
+            RenderBufferFlag::STORAGE,
+            {},
+            &recordBuffer,
+        });
+        uploadPending = false;
+    }
+
+    void BumbleElectricRenderer::record(
+        RenderWorker *worker,
+        uint32_t drawIndex
+    ) {
+        if (worker == nullptr || pipeline == nullptr ||
+            smokePipeline == nullptr ||
+            descriptorSet == nullptr || recordBuffer.get() == nullptr ||
+            drawIndex >= draws.size()) {
+            return;
+        }
+        const Draw& draw = draws[drawIndex];
+        if (draw.recordCount == 0u || draw.scissor.isEmpty()) {
+            return;
+        }
+
+        descriptorSet->setBuffer(
+            recordDescriptorIndex,
+            recordBuffer.get(),
+            recordBuffer.allocatedSize,
+            RenderBufferStructuredView(sizeof(BumbleElectricGPURecord))
+        );
+        worker->commandList->setGraphicsPipelineLayout(pipelineLayout.get());
+        worker->commandList->setScissors(draw.scissor);
+        worker->commandList->setVertexBuffers(0, nullptr, 0, nullptr);
+        worker->commandList->setIndexBuffer(nullptr);
+        worker->commandList->setGraphicsDescriptorSet(
+            descriptorSet->get(),
+            0
+        );
+
+        PushConstants constants = draw.constants;
+        if (draw.additiveRecordCount > 0u) {
+            constants.population = {
+                draw.recordStart,
+                draw.additiveRecordCount,
+                draw.arcCount,
+                draw.effectCount,
+            };
+            worker->commandList->setPipeline(pipeline.get());
+            constants.passParams = {
+                1.0f,
+                4.8f,
+                pipelineUsesHDR ? 0.24f : 0.19f,
+                draw.constants.passParams.w,
+            };
+            worker->commandList->setGraphicsPushConstants(0, &constants);
+            worker->commandList->drawInstanced(
+                QuadVertexCount,
+                draw.additiveRecordCount,
+                0u,
+                0u
+            );
+
+            constants.passParams = {
+                0.0f,
+                1.0f,
+                pipelineUsesHDR ? 1.10f : 0.86f,
+                draw.constants.passParams.w,
+            };
+            worker->commandList->setGraphicsPushConstants(0, &constants);
+            worker->commandList->drawInstanced(
+                QuadVertexCount,
+                draw.additiveRecordCount,
+                0u,
+                0u
+            );
+        }
+
+        if (draw.smokeRecordCount > 0u) {
+            constants.population = {
+                draw.smokeRecordStart,
+                draw.smokeRecordCount,
+                0u,
+                draw.effectCount,
+            };
+            constants.passParams = {
+                2.0f,
+                1.0f,
+                1.0f,
+                draw.constants.passParams.w,
+            };
+            worker->commandList->setPipeline(smokePipeline.get());
+            worker->commandList->setGraphicsPushConstants(0, &constants);
+            worker->commandList->drawInstanced(
+                QuadVertexCount,
+                draw.smokeRecordCount,
+                0u,
+                0u
+            );
+        }
+    }
+}
