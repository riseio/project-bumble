+++ b/src/shaders/BumbleSkyVS.hlsl
@@ -0,0 +1,38 @@
+// Project-owned fullscreen procedural sky vertex shader.
+
+struct BumbleSkyConstants {
+    float4 rayCenterFogScale;
+    float4 rayRightStepAspect;
+    float4 rayUpStep;
+    float4 horizonPreset;
+    float4 cloudShape;
+    float4 sunDirectionAngular;
+    float4 sunColorIntensity;
+    float4 shaftParams;
+};
+
+[[vk::push_constant]] ConstantBuffer<BumbleSkyConstants> gSky
+    : register(b0, space0);
+
+struct VSOutput {
+    float4 position : SV_Position;
+    float3 direction : TEXCOORD0;
+};
+
+VSOutput VSMain(uint id : SV_VertexID) {
+    VSOutput output;
+    const float2 uv = float2(id == 2 ? 2.0f : 0.0f,
+                             id == 1 ? 2.0f : 0.0f);
+    const float2 clip = uv * float2(2.0f, -2.0f) + float2(-1.0f, 1.0f);
+    output.position = float4(clip, 1.0f, 1.0f);
+
+    const float2 view = float2(
+        uv.x * 2.0f - 1.0f,
+        1.0f - uv.y * 2.0f
+    );
+    output.direction =
+        gSky.rayCenterFogScale.xyz +
+        gSky.rayRightStepAspect.xyz * view.x +
+        gSky.rayUpStep.xyz * view.y;
+    return output;
+}
