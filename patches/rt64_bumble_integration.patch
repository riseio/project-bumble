diff --git a/src/render/rt64_bumble_electric.cpp b/src/render/rt64_bumble_electric.cpp
new file mode 100644
index 0000000..ff6f380
--- /dev/null
+++ b/src/render/rt64_bumble_electric.cpp
@@ -0,0 +1,91 @@
+//
+// Project-owned Buck Bumble modern electric-effect bridge.
+//
+
+#include "rt64_bumble_electric.h"
+#include "rt64_bumble_environment.h"
+
+#include <array>
+#include <atomic>
+#include <cinttypes>
+#include <cstdio>
+#include <mutex>
+
+namespace RT64 {
+    namespace {
+        constexpr size_t SnapshotRingSize = 64u;
+
+        struct SnapshotEntry {
+            uint32_t ticket = 0u;
+            BumbleElectricSnapshot snapshot{};
+        };
+
+        std::array<SnapshotEntry, SnapshotRingSize> snapshotRing{};
+        std::atomic_uint32_t nextTicket{1u};
+        std::atomic_uint64_t missedSnapshots{0u};
+        std::mutex snapshotMutex;
+    }
+
+    uint32_t publishBumbleElectricSnapshot(
+        const BumbleElectricSnapshot &snapshot
+    ) {
+        if ((snapshot.arcCount == 0u && snapshot.effectCount == 0u) ||
+            snapshot.arcCount > BumbleElectricMaxArcs ||
+            snapshot.effectCount > BumbleParticleMaxEffects) {
+            return 0u;
+        }
+
+        uint32_t ticket = nextTicket.fetch_add(
+            1u,
+            std::memory_order_relaxed
+        );
+        if (ticket == 0u) {
+            ticket = nextTicket.fetch_add(
+                1u,
+                std::memory_order_relaxed
+            );
+        }
+
+        const std::lock_guard<std::mutex> lock(snapshotMutex);
+        SnapshotEntry &entry = snapshotRing[ticket % SnapshotRingSize];
+        entry.snapshot = snapshot;
+        entry.ticket = ticket;
+        return ticket;
+    }
+
+    bool consumeBumbleElectricSnapshot(
+        uint32_t ticket,
+        BumbleElectricSnapshot &snapshot
+    ) {
+        if (ticket == 0u) {
+            return false;
+        }
+
+        const std::lock_guard<std::mutex> lock(snapshotMutex);
+        SnapshotEntry &entry = snapshotRing[ticket % SnapshotRingSize];
+        if (entry.ticket != ticket) {
+            const uint64_t misses = missedSnapshots.fetch_add(
+                1u,
+                std::memory_order_relaxed
+            ) + 1u;
+            if (bumbleRendererProofLogEnabled() &&
+                (misses <= 4u || (misses % 240u) == 0u)) {
+                std::fprintf(
+                    stderr,
+                    "BUMBLE_ELECTRIC stage=snapshot_missed"
+                    " ticket=%" PRIu32 " misses=%" PRIu64
+                    " ring=%zu\n",
+                    ticket,
+                    misses,
+                    SnapshotRingSize
+                );
+                std::fflush(stderr);
+            }
+            return false;
+        }
+
+        snapshot = entry.snapshot;
+        entry = {};
+        return true;
+    }
+}
diff --git a/src/render/rt64_bumble_electric.h b/src/render/rt64_bumble_electric.h
new file mode 100644
