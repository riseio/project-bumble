+
+namespace RT64 {
+    constexpr uint32_t BumbleSkyPresetCloudyDay = 1u;
+    constexpr uint32_t BumbleSkyPresetDarkOvercast = 2u;
+    constexpr uint32_t BumbleSkyInvalidDraw = UINT32_MAX;
+
+    struct BumbleSkyDirection {
+        float x = 0.0f;
+        float y = 0.0f;
+        float z = 0.0f;
+    };
+
+    // Immutable game-thread state copied into the decoded workload.
+    struct BumbleSkySnapshot {
+        uint32_t mode = 0;
+        uint32_t preset = 0;
+        uint32_t levelIndex = 0;
+        uint32_t levelIdWord = 0;
+        uint32_t horizonRgb = 0;
+        float fogScale = 1.0f;
+        float playerY = 0.0f;
+        BumbleSkyDirection eye{};
+        BumbleSkyDirection forward{};
+        BumbleSkyDirection right{};
+        BumbleSkyDirection up{};
+    };
+
+    static_assert(std::is_trivially_copyable_v<BumbleSkySnapshot>);
+
+    uint32_t publishBumbleSkySnapshot(const BumbleSkySnapshot &snapshot);
+    bool consumeBumbleSkySnapshot(
+        uint32_t ticket,
+        BumbleSkySnapshot &snapshot
+    );
+
+    struct RenderWorker;
+
+    // One fullscreen triangle and no sampled asset.
+    struct BumbleSkyRenderer {
+        struct PushConstants {
+            // xyz: exact world-space ray through presentation NDC (0, 0); w: fog scale.
+            interop::float4 rayCenterFogScale;
+            // xyz: exact world-space ray delta from NDC center to (1, 0); w: presentation aspect (diagnostic only).
+            interop::float4 rayRightStepAspect;
+            // xyz: exact world-space ray delta from NDC center to (0, 1).
+            interop::float4 rayUpStep;
+            // rgb: authored horizon; w: camera eye Z.
+            interop::float4 horizonPreset;
+            // x: cloud threshold, y: Player 1 Y, z: cloud contribution, w: camera eye X.
+            interop::float4 cloudShape;
+            // xyz: the same stable world-space sun direction used by the receiver shader; w: outer solar-disk cosine.
+            interop::float4 sunDirectionAngular;
+            // rgb: warm solar radiance; w: disk intensity.
+            interop::float4 sunColorIntensity;
+            // x: shaft strength, y: corona strength, z: cloud extinction, w: camera eye Y.
+            interop::float4 shaftParams;
+        };
+
+        struct Draw {
+            PushConstants constants{};
+            RenderRect scissor{};
+            uint32_t levelIndex = 0;
+            uint32_t levelIdWord = 0;
+            uint32_t horizonRgb = 0;
+            uint32_t preset = 0;
+            uint64_t submissionFrame = 0;
+            float aspect = 4.0f / 3.0f;
+        };
+
+        std::vector<Draw> draws;
+        std::unique_ptr<RenderPipelineLayout> pipelineLayout;
+        std::unique_ptr<RenderShader> vertexShader;
+        std::unique_ptr<RenderShader> pixelShader;
+        std::unique_ptr<RenderPipeline> pipeline;
+        RenderShaderFormat shaderFormat = RenderShaderFormat::UNKNOWN;
+        RenderSampleCounts sampleCount = 0;
+        bool pipelineUsesHDR = false;
+        uint64_t loggedPreparedDraws = 0;
+        uint64_t loggedRecordedDraws = 0;
+
+        BumbleSkyRenderer();
+        void reset();
+        bool ensurePipeline(
+            RenderWorker *worker,
+            RenderShaderFormat format,
+            const RenderMultisampling &multisampling,
+            bool usesHDR
+        );
+        uint32_t addDraw(
+            const BumbleSkySnapshot &snapshot,
+            const interop::float4x4 &presentationView,
+            const interop::float4x4 &presentationProjection,
+            const RenderRect &scissor,
+            float viewportWidth,
+            float viewportHeight,
+            uint64_t submissionFrame,
+            bool modernLightingActive
+        );
+        void record(RenderWorker *worker, uint32_t drawIndex);
+    };
+}
