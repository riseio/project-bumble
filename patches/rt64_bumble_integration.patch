+//
+// Project-owned Buck Bumble GPU grass bridge.
+//
+
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <type_traits>
+
+#include "shared/rt64_hlsl.h"
+#include "shared/rt64_rsp_viewport.h"
+
+namespace RT64 {
+    // The High radius can contain roughly 320 complete 160-unit terrain cells.
+    constexpr uint32_t BumbleGrassMaxPatches = 512;
+    constexpr uint32_t BumbleGrassPlayerCount = 2;
+
+    struct BumbleGrassPosition {
+        float x = 0.0f;
+        float y = 0.0f;
+        float z = 0.0f;
+    };
+
+    struct BumbleGrassPatch {
+        BumbleGrassPosition center;
+        uint32_t seed = 0;
+    };
+
+    // POD copied on the display-list decode thread.
+    struct BumbleGrassSnapshot {
+        uint32_t mode = 0;
+        uint32_t patchCount = 0;
+        uint32_t playerMask = 0;
+        uint32_t playerGroundedMask = 0;
+        BumbleGrassPosition camera;
+        std::array<BumbleGrassPosition, BumbleGrassPlayerCount> playerCurrent{};
+        std::array<BumbleGrassPosition, BumbleGrassPlayerCount> playerPrevious{};
+        std::array<BumbleGrassPatch, BumbleGrassMaxPatches> patches{};
+    };
+
+    static_assert(std::is_trivially_copyable_v<BumbleGrassSnapshot>);
+
+    // Value-owned recipe assembled while scanning the workload.
+    struct BumbleGrassRenderRecipe {
+        BumbleGrassSnapshot snapshot{};
+        interop::float4x4 viewProj{};
+        interop::RSPViewport rspViewport{};
+        uint64_t targetPresentId = 0;
+        uint64_t submissionFrame = 0;
+        uint32_t colorAddress = 0;
+        uint32_t colorWidth = 0;
+        uint32_t colorSiz = 0;
+        uint32_t depthAddress = 0;
+        uint32_t depthWidth = 0;
+        uint32_t depthSiz = 0;
+        int32_t scissorLeft = 0;
+        int32_t scissorTop = 0;
+        int32_t scissorRight = 0;
+        int32_t scissorBottom = 0;
+        float viewportX = 0.0f;
+        float viewportY = 0.0f;
+        float viewportWidth = 0.0f;
+        float viewportHeight = 0.0f;
+        float viewportMinDepth = 0.0f;
+        float viewportMaxDepth = 1.0f;
+    };
+
+    // Publishing returns a non-zero ticket encoded in the private extended GBI marker.
+    uint32_t publishBumbleGrassSnapshot(const BumbleGrassSnapshot &snapshot);
+    bool consumeBumbleGrassSnapshot(uint32_t ticket, BumbleGrassSnapshot &snapshot);
+
+}
diff --git a/src/render/rt64_bumble_grass_renderer.cpp b/src/render/rt64_bumble_grass_renderer.cpp
new file mode 100644
index 0000000..267f00b
--- /dev/null
+++ b/src/render/rt64_bumble_grass_renderer.cpp
@@ -0,0 +1,891 @@
+//
+// Project-owned Buck Bumble instanced grass renderer.
+//
+
+#include "rt64_bumble_grass_renderer.h"
+
+#include <algorithm>
+#include <array>
+#include <cassert>
+#include <cmath>
+#include <cinttypes>
+#include <cstdio>
+#include <cstring>
+#include <limits>
+
+#include "shaders/BumbleGrassPS.hlsl.spirv.h"
+#include "shaders/BumbleGrassVS.hlsl.spirv.h"
+#ifdef _WIN32
+#   include "shaders/BumbleGrassPS.hlsl.dxil.h"
+#   include "shaders/BumbleGrassVS.hlsl.dxil.h"
+#elif defined(__APPLE__)
+#   include "shaders/BumbleGrassPS.hlsl.metal.h"
+#   include "shaders/BumbleGrassVS.hlsl.metal.h"
+#endif
+
+#include "rt64_render_target.h"
+#include "rt64_render_worker.h"
+#include "rt64_bumble_environment.h"
+
+namespace RT64 {
+    namespace {
+        // Buck is bee-sized.
+        constexpr uint32_t MaxVertexCount = 54; // 3 blades, 3 segments.
+        constexpr float InteractionRadius = 82.0f;
+        constexpr float InteractionBend = 96.0f;
+        constexpr float InteractionFlatten = 72.0f;
+        constexpr float InteractionVerticalBand = 56.0f;
+        constexpr float WakeLifetimeSeconds = 2.4f;
+        // Wake evaluation runs in the vertex shader.
+        constexpr uint32_t MaxWakeStamps = 6;
+
+        uint32_t mix32(uint32_t value) {
+            value ^= value >> 16;
+            value *= 0x7FEB352Du;
+            value ^= value >> 15;
+            value *= 0x846CA68Bu;
+            value ^= value >> 16;
+            return value;
+        }
+
+        float hashUnit(uint32_t value) {
+            return static_cast<float>(value & 0x00FFFFFFu) /
+                static_cast<float>(0x01000000u);
+        }
+
+        BumbleGrassPosition rootForClump(
+            const BumbleGrassPatch &patch,
+            uint32_t clump
+        ) {
+            const uint32_t seed = mix32(
+                patch.seed ^ (clump * 0x9E3779B9u)
+            );
+            return {
+                patch.center.x +
+                    (hashUnit(mix32(seed ^ 0xA341316Cu)) * 2.0f - 1.0f) *
+                        76.0f,
+                patch.center.y,
+                patch.center.z +
+                    (hashUnit(mix32(seed ^ 0xC8013EA4u)) * 2.0f - 1.0f) *
+                        76.0f,
+            };
+        }
+
+        void interactionForSegment(
+            float x,
+            float y,
+            float z,
+            const BumbleGrassPosition &previous,
+            const BumbleGrassPosition &current,
+            float &bendX,
+            float &bendZ,
+            float &flatten
+        ) {
+            const float segmentX = current.x - previous.x;
+            const float segmentZ = current.z - previous.z;
+            const float segmentLengthSquared =
+                segmentX * segmentX + segmentZ * segmentZ;
+            float t = 1.0f;
+            if (segmentLengthSquared > 0.0001f) {
+                t = std::clamp(
+                    ((x - previous.x) * segmentX +
+                        (z - previous.z) * segmentZ) /
+                        segmentLengthSquared,
+                    0.0f,
+                    1.0f
+                );
+            }
+
+            const float closestX = previous.x + segmentX * t;
+            const float closestZ = previous.z + segmentZ * t;
+            const float closestY = previous.y + (current.y - previous.y) * t;
+            const float verticalDistance = std::abs(y - closestY);
+            if (verticalDistance >= InteractionVerticalBand) {
+                return;
+            }
+            float awayX = x - closestX;
+            float awayZ = z - closestZ;
+            const float distanceSquared = awayX * awayX + awayZ * awayZ;
+            if (distanceSquared >= InteractionRadius * InteractionRadius) {
+                return;
+            }
+
+            const float distance = std::sqrt(std::max(distanceSquared, 0.001f));
+            awayX /= distance;
+            awayZ /= distance;
+            const float influence =
+                1.0f - std::clamp(distance / InteractionRadius, 0.0f, 1.0f);
+            const float verticalWeight =
+                1.0f - verticalDistance / InteractionVerticalBand;
+            const float weight =
+                influence * influence * verticalWeight * verticalWeight;
+            bendX += awayX * weight * InteractionBend;
+            bendZ += awayZ * weight * InteractionBend;
+            flatten = std::max(flatten, weight * InteractionFlatten);
+        }
+
+        const void *shaderBlob(
+            RenderShaderFormat format,
+            bool vertex,
+            size_t &size
+        ) {
+            switch (format) {
+#ifdef _WIN32
+            case RenderShaderFormat::DXIL:
+                if (vertex) {
+                    size = sizeof(BumbleGrassVSBlobDXIL);
+                    return BumbleGrassVSBlobDXIL;
+                }
+                size = sizeof(BumbleGrassPSBlobDXIL);
+                return BumbleGrassPSBlobDXIL;
+#endif
+            case RenderShaderFormat::SPIRV:
+                if (vertex) {
+                    size = sizeof(BumbleGrassVSBlobSPIRV);
+                    return BumbleGrassVSBlobSPIRV;
+                }
+                size = sizeof(BumbleGrassPSBlobSPIRV);
+                return BumbleGrassPSBlobSPIRV;
+#ifdef __APPLE__
+            case RenderShaderFormat::METAL:
+                if (vertex) {
+                    size = sizeof(BumbleGrassVSBlobMSL);
+                    return BumbleGrassVSBlobMSL;
+                }
+                size = sizeof(BumbleGrassPSBlobMSL);
+                return BumbleGrassPSBlobMSL;
+#endif
+            default:
+                size = 0;
+                return nullptr;
+            }
+        }
+    }
+
+    BumbleGrassRenderer::BumbleGrassRenderer() { }
+
+    void BumbleGrassRenderer::reset() {
+        gpuRecords.clear();
+        gpuWakeRecords.clear();
+        draws.clear();
+        const auto now = std::chrono::steady_clock::now();
+        if (windClockInitialized) {
+            const float elapsed = std::chrono::duration<float>(
+                now - windLastFrame
+            ).count();
+            windTimeSeconds = std::fmod(
+                windTimeSeconds + std::clamp(elapsed, 0.0f, 0.25f),
+                4096.0f
+            );
+        }
+        windLastFrame = now;
+        windClockInitialized = true;
+    }
+
+    void BumbleGrassRenderer::clearWakeHistory() {
+        wakeHistory.clear();
+        contactSeconds.fill(0.0f);
+        previousGroundedMask = 0;
+        lastWakeCameraValid = false;
+    }
+
+    void BumbleGrassRenderer::updateWakeHistory(
+        const BumbleGrassSnapshot &snapshot,
+        uint64_t submissionFrame,
+        float deltaSeconds
+    ) {
+        (void)deltaSeconds;
+        // Interpolated samples render the same workload repeatedly.
+        if (lastWakeSubmissionFrame == submissionFrame) {
+            return;
+        }
+
+        const auto wakeNow = std::chrono::steady_clock::now();
+        const float ageStep = wakeClockInitialized
+            ? std::clamp(
+                std::chrono::duration<float>(
+                    wakeNow - lastWakeUpdate
+                ).count(),
+                0.0f,
+                0.25f
+            )
+            : 0.0f;
+        lastWakeUpdate = wakeNow;
+        wakeClockInitialized = true;
+
+        const bool firstSubmission =
+            lastWakeSubmissionFrame == UINT64_MAX;
+        const bool staleGap = !firstSubmission &&
+            (submissionFrame < lastWakeSubmissionFrame ||
+                submissionFrame - lastWakeSubmissionFrame > 8u);
+        const bool modeChanged = wakeMode != 0u &&
+            wakeMode != snapshot.mode;
+        bool cameraTeleported = false;
+        if (lastWakeCameraValid) {
+            const float dx = snapshot.camera.x - lastWakeCamera.x;
+            const float dy = snapshot.camera.y - lastWakeCamera.y;
+            const float dz = snapshot.camera.z - lastWakeCamera.z;
+            cameraTeleported = dx * dx + dy * dy + dz * dz >
+                800.0f * 800.0f;
+        }
+        if (staleGap || modeChanged || cameraTeleported) {
+            clearWakeHistory();
+        }
+
+        for (WakeStamp &stamp : wakeHistory) {
+            stamp.ageSeconds += ageStep;
+        }
+        wakeHistory.erase(
+            std::remove_if(
+                wakeHistory.begin(),
+                wakeHistory.end(),
+                [](const WakeStamp &stamp) {
+                    return !stamp.active &&
+                        stamp.ageSeconds >= WakeLifetimeSeconds;
+                }
+            ),
+            wakeHistory.end()
+        );
+
+        const uint32_t groundedMask =
+            snapshot.playerGroundedMask & snapshot.playerMask;
+        auto appendStamp = [&](uint32_t player,
+                               const BumbleGrassPosition &start,
+                               const BumbleGrassPosition &end,
+                               bool active) -> WakeStamp * {
+            WakeStamp stamp{};
+            stamp.start = start;
+            stamp.end = end;
+            stamp.ageSeconds = 0.0f;
+            stamp.radius = InteractionRadius;
+            stamp.bend = InteractionBend;
+            stamp.flatten = InteractionFlatten;
+            stamp.player = player;
+            stamp.active = active;
+            if (wakeHistory.size() == MaxWakeStamps) {
+                const auto replace = std::find_if(
+                    wakeHistory.begin(),
+                    wakeHistory.end(),
+                    [](const WakeStamp &candidate) {
+                        return !candidate.active;
+                    }
+                );
+                wakeHistory.erase(
+                    replace != wakeHistory.end()
+                        ? replace
+                        : wakeHistory.begin()
+                );
+            }
+            wakeHistory.push_back(stamp);
+            return &wakeHistory.back();
+        };
+
+        for (uint32_t player = 0;
+             player < BumbleGrassPlayerCount;
+             ++player) {
+            const uint32_t playerBit = 1u << player;
+            const BumbleGrassPosition current =
+                snapshot.playerCurrent[player];
+            if ((groundedMask & playerBit) == 0u) {
+                for (WakeStamp &stamp : wakeHistory) {
+                    if (stamp.player == player && stamp.active) {
+                        stamp.active = false;
+                    }
+                }
+                contactSeconds[player] = 0.0f;
+                lastContactPosition[player] = current;
+                continue;
+            }
+
+            auto activeStamp = std::find_if(
+                wakeHistory.begin(),
+                wakeHistory.end(),
+                [player](const WakeStamp &stamp) {
+                    return stamp.player == player && stamp.active;
+                }
+            );
+            const bool newlyGrounded =
+                (previousGroundedMask & playerBit) == 0u;
+            if (newlyGrounded || activeStamp == wakeHistory.end()) {
+                // Landing owns a radial contact at the exact reviewed foot probe.
+                appendStamp(player, current, current, true);
+                lastContactPosition[player] = current;
+                contactSeconds[player] = 0.0f;
+                continue;
+            }
+
+            contactSeconds[player] += ageStep;
+            const BumbleGrassPosition prior = lastContactPosition[player];
+            const float dx = current.x - prior.x;
+            const float dz = current.z - prior.z;
+            const float horizontalDistance =
+                std::sqrt(dx * dx + dz * dz);
+            BumbleGrassPosition start = prior;
+            if (horizontalDistance > InteractionRadius) {
+                const float invDistance = 1.0f / horizontalDistance;
+                start.x = current.x -
+                    dx * invDistance * InteractionRadius;
+                start.y = current.y;
+                start.z = current.z -
+                    dz * invDistance * InteractionRadius;
+            }
+            activeStamp->start = start;
+            activeStamp->end = current;
+            activeStamp->ageSeconds = 0.0f;
+
+            // Keep a single renewable footprint while stationary.
+            if (horizontalDistance >= 12.0f ||
+                (horizontalDistance >= 2.0f &&
+                    contactSeconds[player] >= 0.10f)) {
+                activeStamp->active = false;
+                appendStamp(player, current, current, true);
+                lastContactPosition[player] = current;
+                contactSeconds[player] = 0.0f;
+            }
+        }
+
+        previousGroundedMask = groundedMask;
+        wakeMode = snapshot.mode;
+        lastWakeSubmissionFrame = submissionFrame;
+        lastWakeCamera = snapshot.camera;
+        lastWakeCameraValid = true;
+    }
+
+    bool BumbleGrassRenderer::ensurePipeline(
+        RenderWorker *worker,
+        RenderShaderFormat format,
+        const RenderMultisampling &multisampling,
+        bool usesHDR
+    ) {
+        assert(worker != nullptr);
+        if (pipeline != nullptr && shaderFormat == format &&
+            sampleCount == multisampling.sampleCount &&
+            pipelineUsesHDR == usesHDR) {
+            return true;
+        }
+
+        pipeline.reset();
+        pipelineLayout.reset();
+        vertexShader.reset();
+        pixelShader.reset();
+
+        size_t vertexBlobSize = 0;
+        size_t pixelBlobSize = 0;
+        const void *vertexBlob = shaderBlob(format, true, vertexBlobSize);
+        const void *pixelBlob = shaderBlob(format, false, pixelBlobSize);
+        if (vertexBlob == nullptr || pixelBlob == nullptr) {
+            return false;
+        }
+
+        vertexShader = worker->device->createShader(
+            vertexBlob, vertexBlobSize, "VSMain", format
+        );
+        pixelShader = worker->device->createShader(
+            pixelBlob, pixelBlobSize, "PSMain", format
+        );
+
+        if (patchDescriptorSet == nullptr) {
+            patchDescriptorSet =
+                std::make_unique<RenderDescriptorSetBase>();
+            patchDescriptorSet->builder.begin();
+            patchDescriptorIndex =
+                patchDescriptorSet->builder.addStructuredBuffer(1);
+            wakeDescriptorIndex =
+                patchDescriptorSet->builder.addStructuredBuffer(2);
+            patchDescriptorSet->builder.end();
+            patchDescriptorSet->create(worker->device);
+        }
+
+        RenderPipelineLayoutBuilder layoutBuilder;
+        layoutBuilder.begin(false, false);
+        layoutBuilder.addPushConstant(
+            0,
+            0,
+            sizeof(PushConstants),
+            RenderShaderStageFlag::VERTEX | RenderShaderStageFlag::PIXEL
+        );
+        layoutBuilder.addDescriptorSet(*patchDescriptorSet);
+        layoutBuilder.end();
+        pipelineLayout = layoutBuilder.create(worker->device);
+
+        RenderGraphicsPipelineDesc desc;
+        desc.pipelineLayout = pipelineLayout.get();
+        desc.vertexShader = vertexShader.get();
+        desc.pixelShader = pixelShader.get();
+        desc.primitiveTopology = RenderPrimitiveTopology::TRIANGLE_LIST;
+        desc.cullMode = RenderCullMode::NONE;
+        desc.depthClipEnabled = true;
+        desc.depthEnabled = true;
+        desc.depthWriteEnabled = false;
+        desc.depthFunction = RenderComparisonFunction::LESS_EQUAL;
+        desc.depthTargetFormat = RenderFormat::D32_FLOAT;
+        desc.multisampling = multisampling;
+        desc.alphaToCoverageEnabled = multisampling.sampleCount > 1;
+        desc.renderTargetFormat[0] = RenderTarget::colorBufferFormat(usesHDR);
+        // MSAA uses alpha-to-coverage.
+        desc.renderTargetBlend[0] = multisampling.sampleCount > 1
+            ? RenderBlendDesc::Copy()
+            : RenderBlendDesc::AlphaBlend();
+        desc.renderTargetCount = 1;
+        pipeline = worker->device->createGraphicsPipeline(desc);
+
+        shaderFormat = format;
+        sampleCount = multisampling.sampleCount;
+        pipelineUsesHDR = usesHDR;
+        if (bumbleRendererProofLogEnabled()) {
+            std::fprintf(
+                stderr,
+                "BUMBLE_GRASS stage=gpu_pipeline_ready shader_format=%d"
+                " samples=%" PRIu32 " alpha_to_coverage=%d depth=%s"
+                " cull=none geometry=segmented_tapered_ribbons\n",
+                static_cast<int>(format),
+                sampleCount,
+                sampleCount > 1 ? 1 : 0,
+                "less_equal_read"
+            );
+            std::fflush(stderr);
+        }
+        return pipeline != nullptr;
+    }
+
+    uint32_t BumbleGrassRenderer::addDraw(
+        const BumbleGrassSnapshot &snapshot,
+        const interop::float4x4 &viewProj,
+        const interop::RSPViewport &rspViewport,
+        const RenderRect &scissor,
+        uint64_t submissionFrame,
+        float deltaSeconds
+    ) {
+        updateWakeHistory(
+            snapshot,
+            submissionFrame,
+            deltaSeconds
+        );
+        Draw draw{};
+        draw.playerMask = snapshot.playerMask;
+        for (uint32_t player = 0; player < BumbleGrassPlayerCount; ++player) {
+            if ((snapshot.playerMask & (1u << player)) == 0) {
+                continue;
+            }
+            const float dx = snapshot.playerCurrent[player].x -
+                snapshot.playerPrevious[player].x;
+            const float dy = snapshot.playerCurrent[player].y -
+                snapshot.playerPrevious[player].y;
+            const float dz = snapshot.playerCurrent[player].z -
+                snapshot.playerPrevious[player].z;
+            draw.maxPlayerDelta = std::max(
+                draw.maxPlayerDelta,
+                std::sqrt(dx * dx + dy * dy + dz * dz)
+            );
+        }
+        draw.constants.viewProj = viewProj;
+        draw.constants.cameraTime = {
+            snapshot.camera.x,
+            snapshot.camera.y,
+            snapshot.camera.z,
+            windTimeSeconds,
+        };
+
+        const bool high = snapshot.mode >= 2;
+        const float fadeStart = high ? 1050.0f : 700.0f;
+        const float fadeEnd = high ? 1500.0f : 1050.0f;
+        draw.constants.fadeWind = {
+            fadeStart,
+            fadeEnd,
+            rspViewport.scale.z,
+            rspViewport.translate.z,
+        };
+        draw.scissor = scissor;
+
+        const uint32_t density = high ? 32u : 20u;
+        const uint32_t patchCount =
+            std::min(snapshot.patchCount, BumbleGrassMaxPatches);
+        draw.recordStart = static_cast<uint32_t>(gpuRecords.size());
+        draw.recordCount = patchCount;
+        draw.wakeStart = static_cast<uint32_t>(gpuWakeRecords.size());
+        draw.wakeCount = static_cast<uint32_t>(wakeHistory.size());
+        draw.density = density;
+        draw.submittedInstances = patchCount * density;
+        draw.constants.population = {
+            draw.recordStart,
+            patchCount,
+            density,
+            sampleCount > 1 ? 1u : 0u,
+        };
+        draw.constants.interaction = {
+            draw.wakeStart,
+            draw.wakeCount,
+            snapshot.playerGroundedMask & snapshot.playerMask,
+            0u,
+        };
+
+        for (const WakeStamp &stamp : wakeHistory) {
+            const float dx = stamp.end.x - stamp.start.x;
+            const float dz = stamp.end.z - stamp.start.z;
+            const float horizontalLength = std::sqrt(dx * dx + dz * dz);
+            const float directionX = horizontalLength > 0.001f
+                ? dx / horizontalLength
+                : 0.0f;
+            const float directionZ = horizontalLength > 0.001f
+                ? dz / horizontalLength
+                : 0.0f;
+            gpuWakeRecords.push_back({
+                {
+                    stamp.start.x,
+                    stamp.start.y,
+                    stamp.start.z,
+                    stamp.ageSeconds,
+                },
+                {
+                    stamp.end.x,
+                    stamp.end.y,
+                    stamp.end.z,
+                    stamp.radius,
+                },
+                {
+                    directionX,
+                    directionZ,
+                    stamp.bend,
+                    stamp.flatten,
+                },
+            });
+        }
+        gpuRecords.insert(
+            gpuRecords.end(),
+            snapshot.patches.begin(),
+            snapshot.patches.begin() + patchCount
+        );
+
+        // The following population walk exists only for bounded diagnostic telemetry.
+        const bool emitTelemetry = bumbleRendererProofLogEnabled() &&
+            (loggedDraws < 5u || ((loggedDraws + 1u) % 240u) == 0u);
+        std::array<float, BumbleGrassPlayerCount> nearestHorizontalSquared;
+        std::array<float, BumbleGrassPlayerCount> nearestVertical{};
+        std::array<BumbleGrassPosition, BumbleGrassPlayerCount> nearestRoot{};
+        nearestHorizontalSquared.fill(std::numeric_limits<float>::max());
+
+        if (emitTelemetry) {
+            for (uint32_t patchIndex = 0; patchIndex < patchCount; ++patchIndex) {
+                const BumbleGrassPatch &patch = snapshot.patches[patchIndex];
+                for (uint32_t clump = 0; clump < density; ++clump) {
+                const BumbleGrassPosition root = rootForClump(patch, clump);
+                const uint32_t seed = mix32(
+                    patch.seed ^ (clump * 0x9E3779B9u)
+                );
+                const float dx = root.x - snapshot.camera.x;
+                const float dz = root.z - snapshot.camera.z;
+                const float distance = std::sqrt(dx * dx + dz * dz);
+                uint32_t lod = 2;
+                if (distance < 420.0f) {
+                    lod = 0;
+                }
+                else if (distance < 820.0f) {
+                    lod = 1;
+                }
+                ++draw.instanceCount[lod];
+                if (distance >= fadeStart && distance <= fadeEnd) {
+                    ++draw.fadingInstances;
+                }
+
+                float bendX = 0.0f;
+                float bendZ = 0.0f;
+                float flatten = 0.0f;
+                for (uint32_t player = 0;
+                     player < BumbleGrassPlayerCount;
+                     ++player) {
+                    if ((snapshot.playerMask & (1u << player)) == 0) {
+                        continue;
+                    }
+                    const float playerDx =
+                        root.x - snapshot.playerCurrent[player].x;
+                    const float playerDz =
+                        root.z - snapshot.playerCurrent[player].z;
+                    const float horizontalSquared =
+                        playerDx * playerDx + playerDz * playerDz;
+                    if (horizontalSquared < nearestHorizontalSquared[player]) {
+                        nearestHorizontalSquared[player] = horizontalSquared;
+                        nearestVertical[player] = std::abs(
+                            root.y - snapshot.playerCurrent[player].y
+                        );
+                        nearestRoot[player] = root;
+                    }
+                }
+                for (const WakeStamp &stamp : wakeHistory) {
+                    interactionForSegment(
+                        root.x,
+                        root.y,
+                        root.z,
+                        stamp.start,
+                        stamp.end,
+                        bendX,
+                        bendZ,
+                        flatten
+                    );
+                }
+                if (bendX != 0.0f || bendZ != 0.0f || flatten != 0.0f) {
+                    ++draw.bendCandidates;
+                }
+                    const uint64_t populationWord =
+                        static_cast<uint64_t>(seed) |
+                        (static_cast<uint64_t>(lod) << 32);
+                    draw.populationHash ^= populationWord;
+                    draw.populationHash *= 1099511628211ULL;
+                }
+            }
+        }
+
+        if (snapshot.patchCount > BumbleGrassMaxPatches) {
+            draw.truncated = true;
+            if (bumbleRendererProofLogEnabled()) {
+                std::fprintf(
+                    stderr,
+                    "BUMBLE_GRASS stage=gpu_population_truncated"
+                    " requested_patches=%" PRIu32
+                    " admitted_patches=%" PRIu32
+                    " reason=snapshot_patch_capacity\n",
+                    snapshot.patchCount,
+                    patchCount
+                );
+                std::fflush(stderr);
+            }
+        }
+
+        if (bumbleRendererProofLogEnabled() && loggedDraws == 0 &&
+            patchCount > 0) {
+            const BumbleGrassPosition firstRoot =
+                rootForClump(snapshot.patches[0], 0);
+            float patchMinY = std::numeric_limits<float>::max();
+            float patchMaxY = std::numeric_limits<float>::lowest();
+            for (uint32_t patchIndex = 0; patchIndex < patchCount; ++patchIndex) {
+                patchMinY = std::min(patchMinY, snapshot.patches[patchIndex].center.y);
+                patchMaxY = std::max(patchMaxY, snapshot.patches[patchIndex].center.y);
+            }
+            std::fprintf(
+                stderr,
+                "BUMBLE_GRASS stage=gpu_visibility_inputs camera=%.3f,%.3f,%.3f"
+                " first_origin=%.3f,%.3f,%.3f patch_y=%.3f..%.3f"
+                " player0=%.3f,%.3f,%.3f depth_map=%.6f,%.6f"
+                " debug_mode=%" PRIu32 "\n",
+                snapshot.camera.x,
+                snapshot.camera.y,
+                snapshot.camera.z,
+                firstRoot.x,
+                firstRoot.y,
+                firstRoot.z,
+                patchMinY,
+                patchMaxY,
+                snapshot.playerCurrent[0].x,
+                snapshot.playerCurrent[0].y,
+                snapshot.playerCurrent[0].z,
+                rspViewport.scale.z,
+                rspViewport.translate.z,
+                0u
+            );
+            std::fflush(stderr);
+        }
+
+        const uint32_t drawIndex = static_cast<uint32_t>(draws.size());
+        draws.push_back(draw);
+        ++loggedDraws;
+        if (emitTelemetry) {
+            std::fprintf(
+                stderr,
+                "BUMBLE_GRASS stage=gpu_draw_prepared draw=%" PRIu64
+                " mode=%s patches=%" PRIu32 " instances=%" PRIu32
+                " lod_near=%" PRIu32 " lod_mid=%" PRIu32
+                " lod_far=%" PRIu32 " fade_start=%.1f fade_end=%.1f"
+                " fade_band=%" PRIu32 " bend_candidates=%" PRIu32
+                " player_mask=0x%X grounded_mask=0x%X"
+                " wake_stamps=%" PRIu32 " max_player_delta=%.4f"
+                " population_hash=0x%016" PRIX64
+                " patch_upload_bytes=%zu truncated=%d"
+                " draw_calls=1 blades_per_clump=3"
+                " segment_topology=fixed_3_no_lod_pop"
+                " cover=bee_scale height_range=110..270"
+                " width_profile=thin_ribbon_tip_taper"
+                " density_per_cell=%" PRIu32
+                " palette=olive_meadow_straw"
+                " wind=layered_deformed_normals"
+                " actor_interaction=persistent_grounded_wake"
+                " wake_recovery=bend_1.5s_flatten_0.40s_exp2"
+                " population_selection=stable_nested_shader_generated"
+                " cpu_telemetry=sampled_1_in_240\n",
+                loggedDraws,
+                high ? "high" : "low",
+                patchCount,
+                draw.submittedInstances,
+                draw.instanceCount[0],
+                draw.instanceCount[1],
+                draw.instanceCount[2],
+                fadeStart,
+                fadeEnd,
+                draw.fadingInstances,
+                draw.bendCandidates,
+                draw.playerMask,
+                snapshot.playerGroundedMask & snapshot.playerMask,
+                draw.wakeCount,
+                draw.maxPlayerDelta,
+                draw.populationHash,
+                static_cast<size_t>(draw.recordCount) *
+                    sizeof(BumbleGrassPatch),
+                draw.truncated ? 1 : 0,
+                density
+            );
+            std::fflush(stderr);
+
+            for (uint32_t player = 0;
+                 player < BumbleGrassPlayerCount;
+                 ++player) {
+                if ((snapshot.playerMask & (1u << player)) == 0 ||
+                    nearestHorizontalSquared[player] ==
+                        std::numeric_limits<float>::max()) {
+                    continue;
+                }
+                const float horizontal =
+                    std::sqrt(nearestHorizontalSquared[player]);
+                const char *rejection = "none";
+                if ((snapshot.playerGroundedMask & (1u << player)) == 0u) {
+                    rejection = "airborne";
+                }
+                else if (nearestVertical[player] >=
+                         InteractionVerticalBand) {
+                    rejection = "vertical";
+                }
+                else if (horizontal >= InteractionRadius) {
+                    rejection = "horizontal";
+                }
+                std::fprintf(
+                    stderr,
+                    "BUMBLE_GRASS stage=interaction_probe draw=%" PRIu64
+                    " player=%" PRIu32
+                    " player_position=%.3f,%.3f,%.3f"
+                    " nearest_root=%.3f,%.3f,%.3f"
+                    " nearest_horizontal=%.3f vertical=%.3f"
+                    " grounded=%d rejection=%s wake_stamps=%" PRIu32
+                    " bend_candidates=%" PRIu32 "\n",
+                    loggedDraws,
+                    player,
+                    snapshot.playerCurrent[player].x,
+                    snapshot.playerCurrent[player].y,
+                    snapshot.playerCurrent[player].z,
+                    nearestRoot[player].x,
+                    nearestRoot[player].y,
+                    nearestRoot[player].z,
+                    horizontal,
+                    nearestVertical[player],
+                    (snapshot.playerGroundedMask & (1u << player)) != 0u
+                        ? 1
+                        : 0,
+                    rejection,
+                    draw.wakeCount,
+                    draw.bendCandidates
+                );
+                std::fflush(stderr);
+            }
+        }
+        return drawIndex;
+    }
+
+    void BumbleGrassRenderer::appendUpload(
+        std::vector<BufferUploader::Upload> &uploads
+    ) {
+        if (draws.empty()) {
+            return;
+        }
+        if (gpuWakeRecords.empty()) {
+            // Keep t2 valid even when no contact history is active.
+            gpuWakeRecords.emplace_back();
+        }
+        uploads.push_back({
+            gpuRecords.data(),
+            {0, gpuRecords.size()},
+            sizeof(BumbleGrassPatch),
+            RenderBufferFlag::STORAGE,
+            {},
+            &patchBuffer,
+        });
+        uploads.push_back({
+            gpuWakeRecords.data(),
+            {0, gpuWakeRecords.size()},
+            sizeof(GPUWakeRecord),
+            RenderBufferFlag::STORAGE,
+            {},
+            &wakeBuffer,
+        });
+    }
+
+    void BumbleGrassRenderer::record(
+        RenderWorker *worker,
+        uint32_t drawIndex
+    ) {
+        if (worker == nullptr || pipeline == nullptr ||
+            drawIndex >= draws.size() || patchBuffer.get() == nullptr ||
+            wakeBuffer.get() == nullptr ||
+            patchDescriptorSet == nullptr) {
+            return;
+        }
+
+        const Draw &draw = draws[drawIndex];
+        if (draw.scissor.isEmpty()) {
+            return;
+        }
+
+        patchDescriptorSet->setBuffer(
+            patchDescriptorIndex,
+            patchBuffer.get(),
+            patchBuffer.allocatedSize,
+            RenderBufferStructuredView(sizeof(BumbleGrassPatch))
+        );
+        patchDescriptorSet->setBuffer(
+            wakeDescriptorIndex,
+            wakeBuffer.get(),
+            wakeBuffer.allocatedSize,
+            RenderBufferStructuredView(sizeof(GPUWakeRecord))
+        );
+        worker->commandList->setGraphicsPipelineLayout(pipelineLayout.get());
+        worker->commandList->setPipeline(pipeline.get());
+        worker->commandList->setScissors(draw.scissor);
+        worker->commandList->setVertexBuffers(0, nullptr, 0, nullptr);
+        worker->commandList->setIndexBuffer(nullptr);
+        worker->commandList->setGraphicsPushConstants(0, &draw.constants);
+        worker->commandList->setGraphicsDescriptorSet(
+            patchDescriptorSet->get(),
+            0
+        );
+        if (draw.submittedInstances != 0) {
+            worker->commandList->drawInstanced(
+                MaxVertexCount,
+                draw.submittedInstances,
+                0,
+                0
+            );
+        }
+        ++loggedRecords;
+        if (bumbleRendererProofLogEnabled() &&
+            (loggedRecords <= 5 || (loggedRecords % 240) == 0)) {
+            std::fprintf(
+                stderr,
+                "BUMBLE_GRASS stage=gpu_draw_recorded record=%" PRIu64
+                " draw_calls=%" PRIu32 " instances=%" PRIu32
+                " submitted_vertices=%" PRIu64
+                " vertices_per_instance=%" PRIu32
+                " instance_bytes=%zu buffer_capacity=%" PRIu64
+                " scissor=%d,%d,%d,%d scissor_nonempty=1\n",
+                loggedRecords,
+                draw.submittedInstances != 0 ? 1u : 0u,
+                draw.submittedInstances,
+                static_cast<uint64_t>(draw.submittedInstances) *
+                    MaxVertexCount,
+                MaxVertexCount,
+                static_cast<size_t>(draw.recordCount) *
+                    sizeof(BumbleGrassPatch),
+                patchBuffer.allocatedSize,
+                draw.scissor.left,
+                draw.scissor.top,
+                draw.scissor.right,
+                draw.scissor.bottom
+            );
+            std::fflush(stderr);
+        }
+    }
+}
