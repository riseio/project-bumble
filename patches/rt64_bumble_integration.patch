diff --git a/src/shaders/BumbleCollisionDebugPS.hlsl b/src/shaders/BumbleCollisionDebugPS.hlsl
new file mode 100644
index 0000000..8475fd8
--- /dev/null
+++ b/src/shaders/BumbleCollisionDebugPS.hlsl
@@ -0,0 +1,55 @@
+// Complete Buck Bumble collision overlay.
+
+struct BumbleCollisionDebugConstants {
+    float4x4 viewProj;
+    float4 depthViewport;
+    float4 drawParams;
+    float4 passParams;
+};
+
+[[vk::push_constant]] ConstantBuffer<BumbleCollisionDebugConstants> gCollision
+    : register(b0, space0);
+
+struct PSInput {
+    float4 position : SV_POSITION;
+    nointerpolation uint style : TEXCOORD0;
+    nointerpolation float valid : TEXCOORD1;
+    nointerpolation float xray : TEXCOORD2;
+    float2 lineCoord : TEXCOORD3;
+};
+
+float3 collisionColor(uint style) {
+    switch (style) {
+    case 0u: return float3(0.10f, 0.92f, 1.00f); // Jolt floor/support face
+    case 1u: return float3(1.00f, 0.48f, 0.04f); // Jolt wall/ceiling face
+    case 2u: return float3(1.00f, 0.86f, 0.05f); // active actor/item sphere
+    case 3u: return float3(0.66f, 0.70f, 0.74f); // live non-colliding actor
+    case 4u: return float3(0.35f, 1.00f, 0.12f); // player interaction sphere
+    case 5u: return float3(1.00f, 0.08f, 0.82f); // Jolt player capsule
+    case 6u: return float3(0.10f, 0.38f, 1.00f); // liquid/void threshold
+    case 7u: return float3(1.00f, 0.12f, 0.08f); // manual Y=800 ceiling
+    case 8u: return float3(1.00f, 1.00f, 1.00f); // support/landing probe
+    default: return float3(1.00f, 1.00f, 1.00f);
+    }
+}
+
+float4 PSMain(PSInput input) : SV_TARGET0 {
+    clip(input.valid - 0.5f);
+    const float edgeDistance = abs(input.lineCoord.y);
+    const float antiAlias = max(fwidth(edgeDistance), 0.02f);
+    const float coverage = 1.0f - smoothstep(
+        1.0f - antiAlias,
+        1.0f,
+        edgeDistance
+    );
+    clip(coverage - 0.001f);
+
+    if (input.xray > 0.5f) {
+        // Dashed lines make hidden volumes unmistakable and prevent them from reading as visible world geometry.
+        const float dash = frac(input.lineCoord.x / 11.0f);
+        clip(0.62f - dash);
+    }
+
+    const float3 color = collisionColor(input.style);
+    return float4(color, coverage * saturate(gCollision.drawParams.w));
+}
diff --git a/src/shaders/BumbleCollisionDebugVS.hlsl b/src/shaders/BumbleCollisionDebugVS.hlsl
new file mode 100644
index 0000000..fb93256
--- /dev/null
+++ b/src/shaders/BumbleCollisionDebugVS.hlsl
@@ -0,0 +1,122 @@
+// Complete Buck Bumble collision overlay.
+
+struct BumbleCollisionDebugConstants {
+    float4x4 viewProj;
+    float4 depthViewport;
+    float4 drawParams;
+    float4 passParams;
+};
+
+struct BumbleCollisionDebugLine {
+    float3 start;
+    uint style;
+    float3 end;
+    uint metadata;
+};
+
+[[vk::push_constant]] ConstantBuffer<BumbleCollisionDebugConstants> gCollision
+    : register(b0, space0);
+StructuredBuffer<BumbleCollisionDebugLine> gStaticLines
+    : register(t1, space0);
+StructuredBuffer<BumbleCollisionDebugLine> gDynamicLines
+    : register(t2, space0);
+
+struct VSOutput {
+    float4 position : SV_POSITION;
+    nointerpolation uint style : TEXCOORD0;
+    nointerpolation float valid : TEXCOORD1;
+    nointerpolation float xray : TEXCOORD2;
+    float2 lineCoord : TEXCOORD3;
+};
+
+bool clipPositivePlane(inout float4 a, inout float4 b, float da, float db) {
+    if (da < 0.0f && db < 0.0f) {
+        return false;
+    }
+    if (da < 0.0f || db < 0.0f) {
+        const float denominator = da - db;
+        if (abs(denominator) < 0.000001f) {
+            return false;
+        }
+        const float t = saturate(da / denominator);
+        if (da < 0.0f) {
+            a = lerp(a, b, t);
+        }
+        else {
+            b = lerp(a, b, t);
+        }
+    }
+    return true;
+}
+
+VSOutput VSMain(uint vertexId : SV_VertexID, uint instanceId : SV_InstanceID) {
+    VSOutput output;
+    const bool dynamicSource = gCollision.drawParams.x > 0.5f;
+    const uint firstLine = (uint)gCollision.drawParams.y;
+    BumbleCollisionDebugLine record;
+    if (dynamicSource) {
+        record = gDynamicLines[firstLine + instanceId];
+    }
+    else {
+        record = gStaticLines[firstLine + instanceId];
+    }
+
+    float4 clipA = mul(gCollision.viewProj, float4(record.start, 1.0f));
+    float4 clipB = mul(gCollision.viewProj, float4(record.end, 1.0f));
+    bool valid = all(isfinite(clipA)) && all(isfinite(clipB));
+    if (valid) {
+        valid = clipPositivePlane(
+            clipA,
+            clipB,
+            clipA.w - 0.01f,
+            clipB.w - 0.01f
+        );
+    }
+    if (valid) {
+        const float depthA =
+            clipA.z * gCollision.depthViewport.x +
+            clipA.w * gCollision.depthViewport.y;
+        const float depthB =
+            clipB.z * gCollision.depthViewport.x +
+            clipB.w * gCollision.depthViewport.y;
+        valid = clipPositivePlane(clipA, clipB, depthA, depthB);
+    }
+
+    float2 ndcA = valid ? clipA.xy / clipA.w : float2(2.0f, 2.0f);
+    float2 ndcB = valid ? clipB.xy / clipB.w : float2(2.0f, 2.0f);
+    // Guard against unbounded near-camera endpoints.
+    ndcA = clamp(ndcA, -4.0f, 4.0f);
+    ndcB = clamp(ndcB, -4.0f, 4.0f);
+    const float2 viewport = max(gCollision.depthViewport.zw, 1.0f.xx);
+    const float2 screenDelta = (ndcB - ndcA) * viewport * 0.5f;
+    const float screenLength = length(screenDelta);
+    valid = valid && isfinite(screenLength) && screenLength > 0.01f;
+    const float2 tangent = valid
+        ? screenDelta / screenLength
+        : float2(1.0f, 0.0f);
+    const float2 normal = float2(-tangent.y, tangent.x);
+    const float2 ndcOffset = normal * gCollision.drawParams.z *
+        (2.0f / viewport);
+
+    static const uint endpointTable[6] = {0u, 0u, 1u, 0u, 1u, 1u};
+    static const float sideTable[6] = {-1.0f, 1.0f, 1.0f, -1.0f, 1.0f, -1.0f};
+    const uint corner = vertexId % 6u;
+    const bool endpointB = endpointTable[corner] != 0u;
+    float4 clipPosition = endpointB ? clipB : clipA;
+    const float2 endpointNdc = endpointB ? ndcB : ndcA;
+    clipPosition.xy =
+        (endpointNdc + ndcOffset * sideTable[corner]) * clipPosition.w;
+    clipPosition.z =
+        clipPosition.z * gCollision.depthViewport.x +
+        clipPosition.w * gCollision.depthViewport.y;
+
+    output.position = valid ? clipPosition : float4(2.0f, 2.0f, 2.0f, 1.0f);
+    output.style = record.style;
+    output.valid = valid ? 1.0f : 0.0f;
+    output.xray = gCollision.passParams.x;
+    output.lineCoord = float2(
+        endpointB ? screenLength : 0.0f,
+        sideTable[corner]
+    );
+    return output;
+}
diff --git a/src/shaders/BumbleElectricPS.hlsl b/src/shaders/BumbleElectricPS.hlsl
new file mode 100644
index 0000000..40b0ed1
--- /dev/null
+++ b/src/shaders/BumbleElectricPS.hlsl
@@ -0,0 +1,172 @@
+// Procedural electricity, fire, sparks, and alpha-blended smoke.
+
+struct BumbleElectricConstants {
+    float4x4 viewProj;
+    float4 depthViewport;
+    float4 passParams;
+    uint4 population;
+};
+
+[[vk::push_constant]] ConstantBuffer<BumbleElectricConstants> gElectric
+    : register(b0, space0);
+
+struct PSInput {
+    float4 position : SV_POSITION;
+    nointerpolation uint kind : TEXCOORD0;
+    nointerpolation float valid : TEXCOORD1;
+    nointerpolation float intensity : TEXCOORD2;
+    float2 shapeCoord : TEXCOORD3;
+    float along : TEXCOORD4;
+    nointerpolation float pulse : TEXCOORD5;
+    nointerpolation uint seed : TEXCOORD6;
+};
+
+float3 coreColor(uint kind) {
+    switch (kind) {
+    case 0u: return float3(1.24f, 1.08f, 0.48f);
+    case 1u: return float3(1.08f, 0.90f, 0.28f);
+    case 2u: return float3(1.34f, 1.12f, 0.45f);
+    case 3u: return float3(1.12f, 0.76f, 0.16f);
+    case 4u: return float3(1.16f, 0.82f, 0.20f);
+    case 7u: return float3(1.30f, 0.72f, 0.12f);
+    default: return float3(1.0f, 0.9f, 0.3f);
+    }
+}
+
+float3 glowColor(uint kind) {
+    switch (kind) {
+    case 2u: return float3(1.00f, 0.52f, 0.06f);
+    case 3u: return float3(1.00f, 0.38f, 0.025f);
+    case 4u: return float3(1.00f, 0.46f, 0.04f);
+    case 7u: return float3(1.00f, 0.22f, 0.015f);
+    default: return float3(1.00f, 0.43f, 0.035f);
+    }
+}
+
+float4 PSMain(PSInput input) : SV_TARGET0 {
+    clip(input.valid - 0.5f);
+    const bool smokePass = gElectric.passParams.x > 1.5f;
+    const bool glow =
+        gElectric.passParams.x > 0.5f && !smokePass;
+    const float seedPhase =
+        (float)(input.seed & 65535u) * 0.0000958738f;
+    const float radialNoise =
+        sin(input.shapeCoord.x * 8.3f +
+            input.shapeCoord.y * 5.7f + seedPhase) * 0.10f +
+        sin(input.shapeCoord.x * -13.1f +
+            input.shapeCoord.y * 11.9f - seedPhase * 1.7f) * 0.06f;
+
+    if (smokePass) {
+        clip(input.kind == 6u ? 1.0f : -1.0f);
+        const float radius =
+            length(input.shapeCoord) * (1.0f + radialNoise);
+        const float softBody =
+            1.0f - smoothstep(0.42f, 1.02f, radius);
+        const float hollowing = lerp(
+            0.78f,
+            0.42f,
+            smoothstep(0.35f, 1.0f, input.pulse)
+        );
+        const float density = softBody *
+            saturate(
+                hollowing +
+                sin(
+                    input.shapeCoord.x * 4.1f -
+                    input.shapeCoord.y * 6.7f +
+                    seedPhase * 2.3f
+                ) * 0.12f
+            );
+        const float alpha = saturate(
+            density * max(input.intensity, 0.0f) * 0.72f
+        );
+        clip(alpha - 0.003f);
+        const float soot = saturate(
+            input.pulse * 0.84f + radialNoise * 0.9f
+        );
+        const float3 color = lerp(
+            float3(0.29f, 0.245f, 0.19f),
+            float3(0.105f, 0.105f, 0.11f),
+            soot
+        );
+        return float4(color, alpha);
+    }
+
+    float coverage = 0.0f;
+    float3 particleColor = 0.0f;
+    if (input.kind == 3u ||
+        input.kind == 5u ||
+        input.kind == 8u) {
+        const float radius = length(input.shapeCoord) *
+            (input.kind == 3u ? 1.0f : 1.0f + radialNoise);
+        if (glow) {
+            coverage = exp2(
+                -radius * radius *
+                (input.kind == 3u ? 3.1f : 2.25f)
+            );
+        }
+        else {
+            coverage = exp2(
+                -radius * radius *
+                (input.kind == 3u ? 12.0f : 5.8f)
+            ) * (input.kind == 3u ? 0.72f : 1.0f);
+        }
+        if (input.kind == 5u) {
+            const float hot = saturate(1.0f - radius * 1.18f);
+            particleColor = glow
+                ? lerp(
+                    float3(0.92f, 0.08f, 0.005f),
+                    float3(1.0f, 0.42f, 0.018f),
+                    hot
+                )
+                : lerp(
+                    float3(1.0f, 0.12f, 0.006f),
+                    float3(1.35f, 1.05f, 0.36f),
+                    hot * hot
+                );
+        }
+        else if (input.kind == 8u) {
+            particleColor = glow
+                ? float3(1.0f, 0.24f, 0.012f)
+                : lerp(
+                    float3(1.0f, 0.34f, 0.025f),
+                    float3(1.42f, 1.22f, 0.72f),
+                    saturate(1.0f - radius)
+                );
+        }
+    }
+    else {
+        const float edge = abs(input.shapeCoord.y);
+        const float antiAlias = max(fwidth(edge), 0.015f);
+        if (glow) {
+            coverage = exp2(-edge * edge * 3.6f);
+        }
+        else {
+            coverage = 1.0f - smoothstep(
+                0.74f - antiAlias,
+                1.0f,
+                edge
+            );
+            // Branches and sparks taper gently rather than ending in square caps.
+            if (input.kind == 1u ||
+                input.kind == 2u ||
+                input.kind == 7u) {
+                const float endpointFade = min(
+                    saturate(input.along * 5.0f + 0.25f),
+                    saturate((1.0f - input.along) * 5.0f + 0.25f)
+                );
+                coverage *= endpointFade;
+            }
+        }
+    }
+    clip(coverage - 0.002f);
+
+    const float3 color =
+        any(particleColor > 0.0f)
+            ? particleColor
+            : (glow
+                ? glowColor(input.kind)
+                : coreColor(input.kind));
+    const float intensity = max(input.intensity, 0.0f) *
+        gElectric.passParams.z;
+    return float4(color * coverage * intensity, 0.0f);
+}
diff --git a/src/shaders/BumbleElectricVS.hlsl b/src/shaders/BumbleElectricVS.hlsl
new file mode 100644
index 0000000..f14b7bc
--- /dev/null
+++ b/src/shaders/BumbleElectricVS.hlsl
@@ -0,0 +1,196 @@
+// Modern Buck Bumble electricity, fire, sparks, and smoke.
+
+struct BumbleElectricConstants {
+    float4x4 viewProj;
+    float4 depthViewport;
+    float4 passParams;
+    uint4 population;
+};
+
+struct BumbleElectricRecord {
+    float3 start;
+    float width;
+    float3 end;
+    float intensity;
+    float taper;
+    float pulse;
+    uint kind;
+    uint seed;
+};
+
+[[vk::push_constant]] ConstantBuffer<BumbleElectricConstants> gElectric
+    : register(b0, space0);
+StructuredBuffer<BumbleElectricRecord> gRecords
+    : register(t1, space0);
+
+struct VSOutput {
+    float4 position : SV_POSITION;
+    nointerpolation uint kind : TEXCOORD0;
+    nointerpolation float valid : TEXCOORD1;
+    nointerpolation float intensity : TEXCOORD2;
+    float2 shapeCoord : TEXCOORD3;
+    float along : TEXCOORD4;
+    nointerpolation float pulse : TEXCOORD5;
+    nointerpolation uint seed : TEXCOORD6;
+};
+
+bool clipPositivePlane(inout float4 a, inout float4 b, float da, float db) {
+    if (da < 0.0f && db < 0.0f) {
+        return false;
+    }
+    if (da < 0.0f || db < 0.0f) {
+        const float denominator = da - db;
+        if (abs(denominator) < 0.000001f) {
+            return false;
+        }
+        const float t = saturate(da / denominator);
+        if (da < 0.0f) {
+            a = lerp(a, b, t);
+        }
+        else {
+            b = lerp(a, b, t);
+        }
+    }
+    return true;
+}
+
+VSOutput VSMain(uint vertexId : SV_VertexID, uint instanceId : SV_InstanceID) {
+    VSOutput output;
+    const uint recordIndex = gElectric.population.x + instanceId;
+    const BumbleElectricRecord record = gRecords[recordIndex];
+    const float2 viewport = max(gElectric.depthViewport.zw, 1.0f.xx);
+    static const float2 corners[6] = {
+        float2(-1.0f, -1.0f),
+        float2(-1.0f,  1.0f),
+        float2( 1.0f,  1.0f),
+        float2(-1.0f, -1.0f),
+        float2( 1.0f,  1.0f),
+        float2( 1.0f, -1.0f)
+    };
+
+    const bool billboard =
+        record.kind == 3u || record.kind == 5u ||
+        record.kind == 6u || record.kind == 8u;
+    if (billboard) {
+        float4 clipCenter = mul(
+            gElectric.viewProj,
+            float4(record.start, 1.0f)
+        );
+        bool valid = all(isfinite(clipCenter)) &&
+            clipCenter.w > 0.01f;
+        const float depth =
+            clipCenter.z * gElectric.depthViewport.x +
+            clipCenter.w * gElectric.depthViewport.y;
+        valid = valid && depth >= 0.0f;
+        const float2 corner = corners[vertexId % 6u];
+        float2 ndcOffset;
+        if (record.kind == 3u) {
+            const float haloPulse =
+                0.90f + 0.10f *
+                    sin(
+                        record.pulse * 21.0f +
+                        (float)(record.seed & 255u)
+                    );
+            const float passScale =
+                gElectric.passParams.x > 0.5f ? 1.55f : 0.52f;
+            ndcOffset =
+                corner * record.width * haloPulse * passScale *
+                (2.0f / viewport);
+        }
+        else {
+            const bool smokePass = gElectric.passParams.x > 1.5f;
+            const float passScale = smokePass
+                ? 1.0f
+                : (gElectric.passParams.x > 0.5f ? 1.22f : 0.84f);
+            const float2 projectionScale = max(
+                abs(float2(
+                    gElectric.viewProj[0][0],
+                    gElectric.viewProj[1][1]
+                )),
+                0.0001f.xx
+            );
+            ndcOffset =
+                corner * record.width * passScale * projectionScale /
+                max(clipCenter.w, 0.01f);
+        }
+        clipCenter.xy += ndcOffset * clipCenter.w;
+        clipCenter.z = depth - clipCenter.w * 0.00015f;
+        output.position = valid
+            ? clipCenter
+            : float4(2.0f, 2.0f, 2.0f, 1.0f);
+        output.kind = record.kind;
+        output.valid = valid ? 1.0f : 0.0f;
+        output.intensity = record.intensity;
+        output.shapeCoord = corner;
+        output.along = 0.5f;
+        output.pulse = record.pulse;
+        output.seed = record.seed;
+        return output;
+    }
+
+    float4 clipA = mul(gElectric.viewProj, float4(record.start, 1.0f));
+    float4 clipB = mul(gElectric.viewProj, float4(record.end, 1.0f));
+    bool valid = all(isfinite(clipA)) && all(isfinite(clipB));
+    if (valid) {
+        valid = clipPositivePlane(
+            clipA,
+            clipB,
+            clipA.w - 0.01f,
+            clipB.w - 0.01f
+        );
+    }
+    if (valid) {
+        const float depthA =
+            clipA.z * gElectric.depthViewport.x +
+            clipA.w * gElectric.depthViewport.y;
+        const float depthB =
+            clipB.z * gElectric.depthViewport.x +
+            clipB.w * gElectric.depthViewport.y;
+        valid = clipPositivePlane(clipA, clipB, depthA, depthB);
+    }
+
+    float2 ndcA = valid ? clipA.xy / clipA.w : float2(2.0f, 2.0f);
+    float2 ndcB = valid ? clipB.xy / clipB.w : float2(2.0f, 2.0f);
+    ndcA = clamp(ndcA, -4.0f, 4.0f);
+    ndcB = clamp(ndcB, -4.0f, 4.0f);
+    const float2 screenDelta = (ndcB - ndcA) * viewport * 0.5f;
+    const float screenLength = length(screenDelta);
+    valid = valid && isfinite(screenLength) && screenLength > 0.01f;
+    const float2 tangent = valid
+        ? screenDelta / screenLength
+        : float2(1.0f, 0.0f);
+    const float2 normal = float2(-tangent.y, tangent.x);
+    const float halfWidth = record.width * gElectric.passParams.y;
+    const float2 ndcOffset = normal * halfWidth * (2.0f / viewport);
+
+    static const uint endpointTable[6] = {0u, 0u, 1u, 0u, 1u, 1u};
+    static const float sideTable[6] = {
+        -1.0f, 1.0f, 1.0f, -1.0f, 1.0f, -1.0f
+    };
+    const uint cornerIndex = vertexId % 6u;
+    const bool endpointB = endpointTable[cornerIndex] != 0u;
+    float4 clipPosition = endpointB ? clipB : clipA;
+    const float2 endpointNdc = endpointB ? ndcB : ndcA;
+    clipPosition.xy =
+        (endpointNdc + ndcOffset * sideTable[cornerIndex]) *
+        clipPosition.w;
+    clipPosition.z =
+        clipPosition.z * gElectric.depthViewport.x +
+        clipPosition.w * gElectric.depthViewport.y -
+        clipPosition.w * 0.00008f;
+
+    output.position = valid
+        ? clipPosition
+        : float4(2.0f, 2.0f, 2.0f, 1.0f);
+    output.kind = record.kind;
+    output.valid = valid ? 1.0f : 0.0f;
+    output.intensity = record.intensity;
+    output.shapeCoord = float2(
+        endpointB ? 1.0f : 0.0f,
+        sideTable[cornerIndex]
+    );
+    output.along = endpointB ? 1.0f : 0.0f;
+    output.pulse = record.pulse;
+    output.seed = record.seed;
+    return output;
+}
diff --git a/src/shaders/BumbleGrassPS.hlsl b/src/shaders/BumbleGrassPS.hlsl
new file mode 100644
index 0000000..3ee2652
--- /dev/null
+++ b/src/shaders/BumbleGrassPS.hlsl
@@ -0,0 +1,42 @@
+// Project-owned Buck Bumble procedural grass pixel shader.
+
+struct BumbleGrassConstants {
+    float4x4 viewProj;
+    float4 cameraTime;
+    float4 fadeWind;
+    uint4 population;
+    uint4 interaction;
+};
+
+[[vk::push_constant]] ConstantBuffer<BumbleGrassConstants> gGrass
+    : register(b0, space0);
+
+struct PSInput {
+    float4 position : SV_POSITION;
+    float3 color : COLOR0;
+    float3 normal : NORMAL0;
+    float fade : TEXCOORD0;
+    float2 bladeCoord : TEXCOORD1;
+};
+
+float4 PSMain(PSInput input) : SV_TARGET0 {
+    const float lateralDerivative = max(
+        abs(ddx(input.bladeCoord.x)) + abs(ddy(input.bladeCoord.x)),
+        0.001f
+    );
+    const float edgeCoverage = saturate(
+        (1.0f - abs(input.bladeCoord.x)) /
+            (lateralDerivative * 0.72f)
+    );
+    const float tipCoverage =
+        1.0f - smoothstep(0.94f, 1.0f, input.bladeCoord.y);
+    const float coverage = edgeCoverage * tipCoverage * saturate(input.fade);
+
+    // MSAA maps continuous coverage to samples.
+    const float3 normal = normalize(input.normal);
+    const float3 lightDirection = normalize(float3(-0.66f, 0.42f, 0.62f));
+    const float directional =
+        abs(dot(normal, lightDirection)) * 0.45f + normal.y * 0.18f;
+    const float lighting = saturate(0.52f + directional);
+    return float4(input.color * lighting, coverage);
+}
diff --git a/src/shaders/BumbleGrassVS.hlsl b/src/shaders/BumbleGrassVS.hlsl
new file mode 100644
index 0000000..3043fab
--- /dev/null
+++ b/src/shaders/BumbleGrassVS.hlsl
@@ -0,0 +1,308 @@
+// Project-owned Buck Bumble shader-generated procedural grass.
+
+struct BumbleGrassConstants {
+    float4x4 viewProj;
+    float4 cameraTime;
+    float4 fadeWind;
+    uint4 population;
+    uint4 interaction;
+};
+
+struct BumbleGrassRecord {
+    float3 center;
+    uint seed;
+};
+
+struct BumbleGrassWakeRecord {
+    float4 startAge;
+    float4 endRadius;
+    float4 response;
+};
+
+[[vk::push_constant]] ConstantBuffer<BumbleGrassConstants> gGrass
+    : register(b0, space0);
+StructuredBuffer<BumbleGrassRecord> gGrassData : register(t1, space0);
+StructuredBuffer<BumbleGrassWakeRecord> gGrassWakes : register(t2, space0);
+
+struct VSOutput {
+    float4 position : SV_POSITION;
+    float3 color : COLOR0;
+    float3 normal : NORMAL0;
+    float fade : TEXCOORD0;
+    float2 bladeCoord : TEXCOORD1;
+};
+
+uint hash32(uint value) {
+    value ^= value >> 16;
+    value *= 0x7FEB352Du;
+    value ^= value >> 15;
+    value *= 0x846CA68Bu;
+    value ^= value >> 16;
+    return value;
+}
+
+float hashUnit(uint value) {
+    return float(value & 0x00FFFFFFu) / float(0x01000000u);
+}
+
+// Avoid transcendental sin/cos just to choose a stable random direction.
+float2 hashDirection(uint seed) {
+    float2 direction = float2(
+        hashUnit(hash32(seed ^ 0xA511E9B3u)),
+        hashUnit(hash32(seed ^ 0x63D83595u))
+    ) * 2.0f - 1.0f;
+    direction.x += 0.001f;
+    return normalize(direction);
+}
+
+float2 rotateThird(float2 direction, uint third) {
+    if (third == 0u) {
+        return direction;
+    }
+    const float s = third == 1u ? 0.86602540378f : -0.86602540378f;
+    return float2(
+        -0.5f * direction.x - s * direction.y,
+        s * direction.x - 0.5f * direction.y
+    );
+}
+
+float3 wakeInteraction(float3 root, BumbleGrassWakeRecord wake) {
+    const float3 previous = wake.startAge.xyz;
+    const float3 current = wake.endRadius.xyz;
+    const float2 segment = current.xz - previous.xz;
+    const float segmentLengthSquared = dot(segment, segment);
+    float segmentT = 1.0f;
+    if (segmentLengthSquared > 0.0001f) {
+        segmentT = saturate(
+            dot(root.xz - previous.xz, segment) / segmentLengthSquared
+        );
+    }
+
+    const float3 closest = lerp(previous, current, segmentT);
+    const float verticalDistance = abs(root.y - closest.y);
+    if (verticalDistance >= 56.0f) {
+        return 0.0f;
+    }
+
+    float2 away = root.xz - closest.xz;
+    const float distanceSquared = dot(away, away);
+    const float radius = max(wake.endRadius.w, 1.0f);
+    if (distanceSquared >= radius * radius) {
+        return 0.0f;
+    }
+
+    const float distance = sqrt(max(distanceSquared, 0.001f));
+    away /= distance;
+    const float influence = 1.0f - saturate(distance / radius);
+    const float verticalWeight = 1.0f - verticalDistance / 56.0f;
+    const float weight =
+        influence * influence * verticalWeight * verticalWeight;
+    const float2 travel = wake.response.xy;
+    float2 layDirection = away;
+    if (dot(travel, travel) > 0.001f) {
+        layDirection = normalize(travel * 0.75f + away * 0.25f);
+    }
+    const float age = max(wake.startAge.w, 0.0f);
+    const float lifetimeFade = 1.0f - smoothstep(1.8f, 2.4f, age);
+    const float bendRecovery = exp2(-age / 1.5f) * lifetimeFade;
+    const float flattenRecovery = exp2(-age / 0.40f) * lifetimeFade;
+    return float3(
+        layDirection * weight * wake.response.z * bendRecovery,
+        weight * wake.response.w * flattenRecovery
+    );
+}
+
+VSOutput VSMain(uint vertexId : SV_VertexID, uint instanceId : SV_InstanceID) {
+    VSOutput output;
+    output.position = float4(2.0f, 2.0f, 0.5f, 1.0f);
+    output.color = 0.0f;
+    output.normal = float3(0.0f, 1.0f, 0.0f);
+    output.fade = 0.0f;
+    output.bladeCoord = 0.0f;
+
+    const uint recordStart = gGrass.population.x;
+    const uint patchCount = gGrass.population.y;
+    const uint density = max(gGrass.population.z, 1u);
+    const uint patchIndex = instanceId / density;
+    const uint clumpIndex = instanceId % density;
+    if (patchIndex >= patchCount) {
+        return output;
+    }
+
+    const BumbleGrassRecord patch = gGrassData[recordStart + patchIndex];
+    const uint clumpSeed = hash32(
+        patch.seed ^ (clumpIndex * 0x9E3779B9u)
+    );
+    float3 root = patch.center;
+    root.x +=
+        (hashUnit(hash32(clumpSeed ^ 0xA341316Cu)) * 2.0f - 1.0f) *
+            76.0f;
+    root.z +=
+        (hashUnit(hash32(clumpSeed ^ 0xC8013EA4u)) * 2.0f - 1.0f) *
+            76.0f;
+
+    const float distanceToCamera = distance(root.xz, gGrass.cameraTime.xz);
+    if (distanceToCamera > gGrass.fadeWind.y) {
+        return output;
+    }
+
+    // Every plant is real tapered blade geometry: three narrow ribbons, each split into three deformation segments.
+    const uint verticesPerBlade = 18u;
+    const uint bladeIndex = vertexId / verticesPerBlade;
+    const uint bladeVertex = vertexId % verticesPerBlade;
+    const uint segmentIndex = bladeVertex / 6u;
+    const uint corner = bladeVertex % 6u;
+    if (bladeIndex >= 3u || segmentIndex >= 3u) {
+        return output;
+    }
+
+    const bool upper = corner == 2u || corner == 3u || corner == 5u;
+    const bool rightSide = corner == 1u || corner == 4u || corner == 5u;
+    const float t = (float(segmentIndex) + (upper ? 1.0f : 0.0f)) / 3.0f;
+
+    const uint bladeSeed = hash32(
+        clumpSeed ^ (bladeIndex * 0x85EBCA6Bu)
+    );
+    const float2 clumpDirection = hashDirection(clumpSeed ^ 0x5F356495u);
+    const float2 direction = rotateThird(clumpDirection, bladeIndex);
+    const float2 side = float2(-direction.y, direction.x);
+    const float2 rootDirection = hashDirection(bladeSeed ^ 0x4CF5AD43u);
+    const float rootRadius =
+        4.0f + hashUnit(hash32(bladeSeed ^ 0x63D83595u)) * 14.0f;
+    const float2 rootOffset = rootDirection * rootRadius;
+
+    // Exactly twenty times the former 5.5..13.5 range.
+    const float heightRandom = hashUnit(hash32(bladeSeed ^ 0x68BC21EBu));
+    const float tallRandom = hashUnit(hash32(bladeSeed ^ 0xD3A2646Cu));
+    const float height =
+        110.0f + 120.0f * heightRandom * heightRandom +
+        40.0f * smoothstep(0.91f, 1.0f, tallRandom);
+
+    // A continuous camera clearing keeps a low third-person camera playable inside bee-scale vegetation.
+    const float cameraInsideCanopy = 1.0f - smoothstep(
+        root.y + height * 0.78f,
+        root.y + height + 50.0f,
+        gGrass.cameraTime.y
+    );
+    const float cameraClearance = lerp(
+        1.0f,
+        smoothstep(48.0f, 150.0f, distanceToCamera),
+        cameraInsideCanopy
+    );
+
+    const float widthRandom = hashUnit(hash32(bladeSeed ^ 0x02E5BE93u));
+    const float widthBoost = hashUnit(hash32(bladeSeed ^ 0x4B7A70E9u));
+    const float distanceCompensation =
+        smoothstep(420.0f, 1100.0f, distanceToCamera);
+    const float rootHalfWidth =
+        1.0f + widthRandom * 0.9f +
+        distanceCompensation * (0.3f + widthBoost * 0.25f);
+    const float halfWidth =
+        rootHalfWidth * (1.0f - smoothstep(0.0f, 1.0f, t));
+
+    const float2 leanDirection = hashDirection(bladeSeed ^ 0xC13FA9A9u);
+    const float leanMagnitude =
+        9.0f + hashUnit(hash32(bladeSeed ^ 0x91E10DA5u)) * 42.0f;
+    const float signedCurve =
+        hashUnit(hash32(bladeSeed ^ 0x7A143595u)) * 2.0f - 1.0f;
+    const float2 curveDirection =
+        float2(-leanDirection.y, leanDirection.x);
+
+    const float time = gGrass.cameraTime.w;
+    const float phase = root.x * 0.0061f + root.z * 0.0047f;
+    const float gustPhase =
+        hashUnit(hash32(clumpSeed ^ 0xBB67AE85u)) * 6.28318530718f;
+    const float gustEnvelope =
+        0.68f + 0.32f * sin(
+            time * 0.19f + root.x * 0.0041f - root.z * 0.0033f +
+            gustPhase
+        );
+    const float wind = gustEnvelope * (
+        sin(time * 1.17f + phase + gustPhase * 0.31f) +
+        0.35f * sin(
+            time * 2.41f - phase * 1.7f + float(bladeIndex) + gustPhase
+        )
+    );
+    const float windResponse =
+        0.55f + hashUnit(hash32(bladeSeed ^ 0xE19B01AAu)) * 0.45f;
+
+    float3 interaction = 0.0f;
+    const uint wakeStart = gGrass.interaction.x;
+    const uint wakeCount = min(gGrass.interaction.y, 6u);
+    [loop]
+    for (uint wakeIndex = 0u; wakeIndex < wakeCount; ++wakeIndex) {
+        const float3 candidate = wakeInteraction(
+            root,
+            gGrassWakes[wakeStart + wakeIndex]
+        );
+        interaction.xy += candidate.xy;
+        interaction.z = max(interaction.z, candidate.z);
+    }
+    const float interactionLength = length(interaction.xy);
+    if (interactionLength > 110.0f) {
+        interaction.xy *= 110.0f / interactionLength;
+    }
+    interaction.z = min(interaction.z, 72.0f);
+    const float bladeStiffness =
+        0.68f + hashUnit(hash32(bladeSeed ^ 0x243F6A88u)) * 0.32f;
+    interaction *= bladeStiffness;
+
+    const float tipWeight = t * t;
+    float3 worldPosition = root;
+    worldPosition.xz += rootOffset;
+    worldPosition.xz += side * (rightSide ? halfWidth : -halfWidth);
+    worldPosition.xz += leanDirection * leanMagnitude * tipWeight;
+    worldPosition.xz +=
+        curveDirection * signedCurve * sin(t * 3.14159265359f) * t * 13.0f;
+    worldPosition.xz +=
+        float2(0.72f, 0.34f) * wind * windResponse * 13.0f * tipWeight;
+    worldPosition.xz += interaction.xy * tipWeight;
+    worldPosition.y += height * t - interaction.z * tipWeight;
+
+    // Lighting follows the same authored lean, curve, wind and player wake.
+    const float2 deformationDerivative =
+        leanDirection * leanMagnitude * 2.0f * t +
+        curveDirection * signedCurve *
+            (sin(t * 3.14159265359f) +
+                t * 3.14159265359f * cos(t * 3.14159265359f)) * 13.0f +
+        float2(0.72f, 0.34f) * wind * windResponse * 26.0f * t +
+        interaction.xy * 2.0f * t;
+    const float3 bladeTangent = normalize(float3(
+        deformationDerivative.x,
+        max(height - interaction.z * 2.0f * t, 10.0f),
+        deformationDerivative.y
+    ));
+    const float3 bladeAcross = float3(side.x, 0.0f, side.y);
+    float3 deformedNormal = normalize(cross(bladeAcross, bladeTangent));
+    if (deformedNormal.y < 0.0f) {
+        deformedNormal = -deformedNormal;
+    }
+
+    output.position = mul(gGrass.viewProj, float4(worldPosition, 1.0f));
+    output.position.z =
+        output.position.z * gGrass.fadeWind.z +
+        output.position.w * gGrass.fadeWind.w;
+    output.normal = deformedNormal;
+    output.fade = cameraClearance * (1.0f - smoothstep(
+        gGrass.fadeWind.x,
+        gGrass.fadeWind.y,
+        distanceToCamera
+    ));
+    output.bladeCoord = float2(rightSide ? 1.0f : -1.0f, t);
+
+    const float palette = hashUnit(hash32(bladeSeed ^ 0x1B56C4E9u));
+    const float variation = hashUnit(hash32(bladeSeed ^ 0xB4F0F2E5u));
+    float3 baseColor = lerp(
+        float3(0.075f, 0.155f, 0.030f),
+        float3(0.190f, 0.315f, 0.060f),
+        variation
+    );
+    const float strawWeight = smoothstep(0.82f, 0.98f, palette) * 0.50f;
+    output.color = lerp(
+        baseColor,
+        float3(0.275f, 0.235f, 0.075f),
+        strawWeight
+    );
+    output.color *= lerp(0.50f, 1.0f, pow(saturate(t), 0.72f));
+    return output;
+}
diff --git a/src/shaders/BumbleShadowVS.hlsl b/src/shaders/BumbleShadowVS.hlsl
new file mode 100644
index 0000000..f6538aa
--- /dev/null
+++ b/src/shaders/BumbleShadowVS.hlsl
@@ -0,0 +1,14 @@
+//
+// Project-owned depth-only directional shadow caster pass.
+//
+
+struct BumbleShadowConstants {
+    float4x4 lightViewProjection;
+};
+
+[[vk::push_constant]] ConstantBuffer<BumbleShadowConstants> gShadow
+    : register(b0);
+
+float4 VSMain(float4 worldPosition : POSITION0) : SV_POSITION {
+    return mul(gShadow.lightViewProjection, worldPosition);
+}
diff --git a/src/shaders/BumbleSkyPS.hlsl b/src/shaders/BumbleSkyPS.hlsl
new file mode 100644
index 0000000..8d80044
--- /dev/null
+++ b/src/shaders/BumbleSkyPS.hlsl
@@ -0,0 +1,259 @@
+
+struct BumbleSkyConstants {
+    float4 rayCenterFogScale;
+    float4 rayRightStepAspect;
+    float4 rayUpStep;
+    float4 horizonPreset;
+    float4 cloudShape;
+    float4 sunDirectionAngular;
+    float4 sunColorIntensity;
+    float4 shaftParams;
+};
+
+[[vk::push_constant]] ConstantBuffer<BumbleSkyConstants> gSky
+    : register(b0, space0);
+
+struct PSInput {
+    float4 position : SV_Position;
+    float3 direction : TEXCOORD0;
+};
+
+float triangleWave(float value) {
+    return 1.0f - abs(frac(value) * 2.0f - 1.0f);
+}
+
+float cloudRidge(float3 direction, float scale, float3 offset) {
+    const float3 p = direction * scale + offset;
+    const float a = triangleWave(dot(p, float3(0.783f, 0.417f, 0.462f)));
+    const float b = triangleWave(dot(p, float3(-0.329f, 0.811f, 0.484f)));
+    const float c = triangleWave(dot(p, float3(0.524f, -0.268f, 0.808f)));
+    const float rounded = a * b + b * c + c * a;
+    return saturate(rounded * 0.72f - 0.18f);
+}
+
+float directionSpaceClouds(float3 direction) {
+    const float broad = cloudRidge(
+        direction,
+        0.5875f,
+        float3(0.19f, 0.43f, 0.71f)
+    );
+    const float medium = cloudRidge(
+        direction,
+        1.175f,
+        float3(0.67f, 0.11f, 0.37f)
+    );
+    const float detail = cloudRidge(
+        direction,
+        2.2875f,
+        float3(0.31f, 0.79f, 0.23f)
+    );
+    return broad * 0.56f + medium * 0.29f + detail * 0.15f;
+}
+
+// Signed distance to the nearest boundary in a regular flat-top hex lattice.
+float honeycombEdgeDistance(float2 worldXZ) {
+    // Match the hex SDF to this triangular centre lattice.
+    const float2 latticePoint = worldXZ / 112.0f;
+    const float2 spacing = float2(1.0f, 1.732050808f);
+    const float2 halfSpacing = spacing * 0.5f;
+    const float2 cellA =
+        frac(latticePoint / spacing + 0.5f) * spacing - halfSpacing;
+    const float2 cellB =
+        frac((latticePoint - halfSpacing) / spacing + 0.5f) * spacing -
+        halfSpacing;
+    const float2 cell = dot(cellA, cellA) < dot(cellB, cellB)
+        ? cellA
+        : cellB;
+    const float2 absoluteCell = abs(cell);
+    const float hexRadius = max(
+        dot(absoluteCell, float2(0.5f, 0.866025404f)),
+        absoluteCell.x
+    );
+    return max(0.5f - hexRadius, 0.0f);
+}
+
+float honeycombBarrierOpacity(float3 direction) {
+    const float ceilingY = 800.0f;
+    const float playerGap = max(ceilingY - gSky.cloudShape.y, 0.0f);
+    // The proximity curve is exactly zero at and beyond this distance.
+    [branch]
+    if (playerGap >= 165.0f) {
+        return 0.0f;
+    }
+    const float3 eye = float3(
+        gSky.cloudShape.w,
+        gSky.shaftParams.w,
+        gSky.horizonPreset.w
+    );
+    const float cameraGap = ceilingY - eye.y;
+    if (direction.y <= 0.025f || cameraGap <= 0.0f) {
+        return 0.0f;
+    }
+
+    const float rayDistance = cameraGap / direction.y;
+    const float2 worldXZ = eye.xz + direction.xz * rayDistance;
+    const float edgeDistance = honeycombEdgeDistance(worldXZ);
+    const float antialias = max(fwidth(edgeDistance), 0.0015f);
+    const float core = 1.0f - smoothstep(
+        0.012f + antialias,
+        0.028f + antialias,
+        edgeDistance
+    );
+    const float glow = 1.0f - smoothstep(
+        0.028f + antialias,
+        0.082f + antialias,
+        edgeDistance
+    );
+
+    const float proximity = 1.0f - smoothstep(35.0f, 165.0f, playerGap);
+    const float proximityVisibility = proximity * proximity;
+    const float viewFade = smoothstep(0.025f, 0.115f, direction.y);
+    const float distanceFade = 1.0f - smoothstep(
+        5200.0f,
+        8200.0f,
+        rayDistance
+    );
+    return (core * 0.140f + glow * 0.0475f) * proximityVisibility *
+        viewFade * distanceFade;
+}
+
+float4 PSMain(PSInput input) : SV_Target {
+    const float3 direction = normalize(input.direction);
+    const float elevation = saturate(direction.y * 0.92f + 0.08f);
