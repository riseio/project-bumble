+//
+// Project-owned Buck Bumble instanced grass renderer.
+//
+
+#pragma once
+
+#include <array>
+#include <chrono>
+#include <cstdint>
+#include <memory>
+#include <vector>
+
+#include "common/rt64_plume.h"
+#include "shared/rt64_hlsl.h"
+#include "shared/rt64_rsp_viewport.h"
+
+#include "rt64_buffer_uploader.h"
+#include "rt64_bumble_grass.h"
+
+namespace RT64 {
+    struct RenderWorker;
+
+    struct BumbleGrassRenderer {
+        static constexpr uint32_t LodCount = 3;
+
+        struct PushConstants {
+            interop::float4x4 viewProj;
+            interop::float4 cameraTime;
+            interop::float4 fadeWind;
+            interop::uint4 population;
+            interop::uint4 interaction;
+        };
+
+        struct WakeStamp {
+            BumbleGrassPosition start{};
+            BumbleGrassPosition end{};
+            float ageSeconds = 0.0f;
+            float radius = 64.0f;
+            float bend = 7.5f;
+            float flatten = 4.0f;
+            uint32_t player = 0;
+            bool active = false;
+        };
+
+        struct GPUWakeRecord {
+            interop::float4 startAge;
+            interop::float4 endRadius;
+            interop::float4 response;
+        };
+
+        struct Draw {
+            PushConstants constants{};
+            RenderRect scissor{};
+            std::array<uint32_t, LodCount> instanceCount{};
+            uint32_t recordStart = 0;
+            uint32_t recordCount = 0;
+            uint32_t wakeStart = 0;
+            uint32_t wakeCount = 0;
+            uint32_t density = 0;
+            uint32_t submittedInstances = 0;
+            uint32_t fadingInstances = 0;
+            uint32_t bendCandidates = 0;
+            uint32_t playerMask = 0;
+            float maxPlayerDelta = 0.0f;
+            uint64_t populationHash = 1469598103934665603ULL;
+            bool truncated = false;
+        };
+
+        std::vector<BumbleGrassPatch> gpuRecords;
+        std::vector<GPUWakeRecord> gpuWakeRecords;
+        std::vector<Draw> draws;
+        BufferPair patchBuffer;
+        BufferPair wakeBuffer;
+        std::unique_ptr<RenderDescriptorSetBase> patchDescriptorSet;
+        uint32_t patchDescriptorIndex = 0;
+        uint32_t wakeDescriptorIndex = 0;
+        std::unique_ptr<RenderPipelineLayout> pipelineLayout;
+        std::unique_ptr<RenderShader> vertexShader;
+        std::unique_ptr<RenderShader> pixelShader;
+        std::unique_ptr<RenderPipeline> pipeline;
+        RenderShaderFormat shaderFormat = RenderShaderFormat::UNKNOWN;
+        RenderSampleCounts sampleCount = 0;
+        bool pipelineUsesHDR = false;
+        uint64_t loggedDraws = 0;
+        uint64_t loggedRecords = 0;
+        float windTimeSeconds = 0.0f;
+        std::chrono::steady_clock::time_point windLastFrame{};
+        bool windClockInitialized = false;
+        std::vector<WakeStamp> wakeHistory;
+        std::array<BumbleGrassPosition, BumbleGrassPlayerCount>
+            lastContactPosition{};
+        std::array<float, BumbleGrassPlayerCount> contactSeconds{};
+        uint32_t previousGroundedMask = 0;
+        uint32_t wakeMode = 0;
+        uint64_t lastWakeSubmissionFrame = UINT64_MAX;
+        std::chrono::steady_clock::time_point lastWakeUpdate{};
+        bool wakeClockInitialized = false;
+        BumbleGrassPosition lastWakeCamera{};
+        bool lastWakeCameraValid = false;
+
+        BumbleGrassRenderer();
+        void reset();
+        bool ensurePipeline(
+            RenderWorker *worker,
+            RenderShaderFormat format,
+            const RenderMultisampling &multisampling,
+            bool usesHDR
+        );
+        uint32_t addDraw(
+            const BumbleGrassSnapshot &snapshot,
+            const interop::float4x4 &viewProj,
+            const interop::RSPViewport &rspViewport,
+            const RenderRect &scissor,
+            uint64_t submissionFrame,
+            float deltaSeconds
+        );
+        void appendUpload(std::vector<BufferUploader::Upload> &uploads);
+        void record(RenderWorker *worker, uint32_t drawIndex);
+
+    private:
+        void clearWakeHistory();
+        void updateWakeHistory(
+            const BumbleGrassSnapshot &snapshot,
+            uint64_t submissionFrame,
+            float deltaSeconds
+        );
+    };
+}
diff --git a/src/render/rt64_bumble_shadow_renderer.cpp b/src/render/rt64_bumble_shadow_renderer.cpp
new file mode 100644
index 0000000..678cb47
--- /dev/null
+++ b/src/render/rt64_bumble_shadow_renderer.cpp
@@ -0,0 +1,372 @@
+//
+// Project-owned cached directional shadow-map renderer.
+//
+
+#include "rt64_bumble_shadow_renderer.h"
+
+#include <cassert>
+#include <cinttypes>
+#include <cstring>
+#include <cstdio>
+
+#include "shaders/BumbleShadowVS.hlsl.spirv.h"
+#ifdef _WIN32
+#   include "shaders/BumbleShadowVS.hlsl.dxil.h"
+#elif defined(__APPLE__)
+#   include "shaders/BumbleShadowVS.hlsl.metal.h"
+#endif
+
+#include "rt64_render_worker.h"
+#include "rt64_bumble_environment.h"
+
+namespace RT64 {
+    namespace {
+        const void *shadowShaderBlob(
+            RenderShaderFormat format,
+            size_t &size
+        ) {
+            switch (format) {
+#ifdef _WIN32
+            case RenderShaderFormat::DXIL:
+                size = sizeof(BumbleShadowVSBlobDXIL);
+                return BumbleShadowVSBlobDXIL;
+#endif
+            case RenderShaderFormat::SPIRV:
+                size = sizeof(BumbleShadowVSBlobSPIRV);
+                return BumbleShadowVSBlobSPIRV;
+#ifdef __APPLE__
+            case RenderShaderFormat::METAL:
+                size = sizeof(BumbleShadowVSBlobMSL);
+                return BumbleShadowVSBlobMSL;
+#endif
+            default:
+                size = 0;
+                return nullptr;
+            }
+        }
+    }
+
+    BumbleShadowRenderer::BumbleShadowRenderer(
+        CachePolicy cachePolicy,
+        const char *debugName,
+        uint32_t resolution
+    ) : cachePolicy(cachePolicy),
+        debugName(debugName),
+        resolution(resolution) {
+        assert(debugName != nullptr);
+        assert(resolution > 0u);
+        ranges.reserve(InitialRangeCapacity);
+    }
+
+    void BumbleShadowRenderer::reset() {
+        ranges.clear();
+        casterDrawCount = 0;
+        framePrepared = false;
+        reusePrepared = false;
+        pendingSubmissionFrame = UINT64_MAX;
+        pendingContentKey = UINT64_MAX;
+    }
+
+    bool BumbleShadowRenderer::ensureResources(
+        RenderWorker *worker,
+        RenderShaderFormat format
+    ) {
+        assert(worker != nullptr);
+        if (depthTexture == nullptr) {
+            recordedContentKey = UINT64_MAX;
+            const RenderClearValue clearValue = RenderClearValue::Depth(
+                RenderDepth(1.0f),
+                RenderFormat::D32_FLOAT
+            );
+            const RenderTextureDesc textureDesc =
+                RenderTextureDesc::DepthTarget(
+                    resolution,
+                    resolution,
+                    RenderFormat::D32_FLOAT,
+                    RenderMultisampling(),
+                    &clearValue
+                );
+            depthTexture = worker->device->createTexture(textureDesc);
+            if (depthTexture == nullptr) {
+                return false;
+            }
+            depthTexture->setName(debugName);
+            depthTextureView = depthTexture->createTextureView(
+                RenderTextureViewDesc::Texture2D(RenderFormat::D32_FLOAT)
+            );
+            framebuffer = worker->device->createFramebuffer(
+                RenderFramebufferDesc(nullptr, 0, depthTexture.get())
+            );
+            if (depthTextureView == nullptr || framebuffer == nullptr) {
+                return false;
+            }
+        }
+
+        if (pipeline != nullptr && shaderFormat == format) {
+            return true;
+        }
+
+        pipeline.reset();
+        pipelineLayout.reset();
+        vertexShader.reset();
+        size_t blobSize = 0;
+        const void *blob = shadowShaderBlob(format, blobSize);
+        if (blob == nullptr) {
+            return false;
+        }
+        vertexShader = worker->device->createShader(
+            blob,
+            blobSize,
+            "VSMain",
+            format
+        );
+        if (vertexShader == nullptr) {
+            return false;
+        }
+
+        RenderPipelineLayoutBuilder layoutBuilder;
+        layoutBuilder.begin(false, true);
+        layoutBuilder.addPushConstant(
+            0,
+            0,
+            sizeof(Constants),
+            RenderShaderStageFlag::VERTEX
+        );
+        layoutBuilder.end();
+        pipelineLayout = layoutBuilder.create(worker->device);
+
+        static const RenderInputSlot InputSlot(
+            0,
+            sizeof(float) * 4
+        );
+        static const RenderInputElement InputElement(
+            "POSITION",
+            0,
+            0,
+            RenderFormat::R32G32B32A32_FLOAT,
+            0,
+            0
+        );
+        RenderGraphicsPipelineDesc desc;
+        desc.pipelineLayout = pipelineLayout.get();
+        desc.vertexShader = vertexShader.get();
+        desc.pixelShader = nullptr;
+        desc.primitiveTopology = RenderPrimitiveTopology::TRIANGLE_LIST;
+        desc.cullMode = RenderCullMode::NONE;
+        desc.depthClipEnabled = true;
+        desc.depthEnabled = true;
+        desc.depthWriteEnabled = true;
+        desc.depthFunction = RenderComparisonFunction::LESS_EQUAL;
+        desc.depthTargetFormat = RenderFormat::D32_FLOAT;
+        desc.depthBias = 240;
+        // A zero clamp keeps the pass valid on Vulkan devices where the optional depthBiasClamp feature is unavailable.
+        desc.depthBiasClamp = 0.0f;
+        desc.slopeScaledDepthBias = 1.25f;
+        desc.renderTargetCount = 0;
+        desc.inputSlots = &InputSlot;
+        desc.inputSlotsCount = 1;
+        desc.inputElements = &InputElement;
+        desc.inputElementsCount = 1;
+        pipeline = worker->device->createGraphicsPipeline(desc);
+        shaderFormat = format;
+        if (pipeline != nullptr && bumbleRendererProofLogEnabled()) {
+            std::fprintf(
+                stderr,
+                "BUMBLE_LIGHTING stage=shadow_pipeline_ready"
+                " owner=%s resolution=%" PRIu32 " format=%d"
+                " pcf=%s depth=D32 caster_policy=opaque_world\n",
+                debugName,
+                resolution,
+                static_cast<int>(format),
+                cachePolicy == CachePolicy::StaticScene
+                    ? "4tap_compact_bilinear"
+                    : "1tap_bilinear"
+            );
+            std::fflush(stderr);
+        }
+        return pipeline != nullptr;
+    }
+
+    bool BumbleShadowRenderer::begin(
+        const interop::float4x4 &lightViewProjection,
+        uint64_t cacheFrame,
+        uint64_t contentKey
+    ) {
+        if (framePrepared) {
+            return false;
+        }
+        framePrepared = true;
+        pendingSubmissionFrame = cacheFrame;
+        pendingContentKey = contentKey;
+        const bool submissionOrderValid =
+            recordedSubmissionFrame != UINT64_MAX &&
+            cacheFrame >= recordedSubmissionFrame;
+        const uint64_t cacheAge = submissionOrderValid
+            ? cacheFrame - recordedSubmissionFrame
+            : UINT64_MAX;
+        const bool cacheAgeValid =
+            cachePolicy == CachePolicy::StaticScene ||
+            cacheAge == 0u;
+        reusePrepared = recordedFrames > 0u && submissionOrderValid &&
+            cacheAgeValid &&
+            recordedContentKey == contentKey &&
+            std::memcmp(
+                &constants.lightViewProjection,
+                &lightViewProjection,
+                sizeof(lightViewProjection)
+            ) == 0;
+        if (!reusePrepared) {
+            constants.lightViewProjection = lightViewProjection;
+        }
+        return true;
+    }
+
+    void BumbleShadowRenderer::addCasterRange(
+        uint32_t indexStart,
+        uint32_t indexCount
+    ) {
+        if (!framePrepared || reusePrepared || indexCount == 0) {
+            return;
+        }
+        ++casterDrawCount;
+        if (!ranges.empty()) {
+            Range &last = ranges.back();
+            if (last.indexStart + last.indexCount == indexStart) {
+                last.indexCount += indexCount;
+                return;
+            }
+        }
+        ranges.push_back({ indexStart, indexCount });
+    }
+
+    void BumbleShadowRenderer::record(
+        RenderWorker *worker,
+        const RenderVertexBufferView &worldPositionView,
+        const RenderIndexBufferView &indexView
+    ) {
+        if (worker == nullptr || pipeline == nullptr || !active()) {
+            return;
+        }
+
+        if (reusePrepared) {
+            ++reusedFrames;
+            if (bumbleRendererProofLogEnabled() &&
+                (reusedFrames == 1u || (reusedFrames % 240u) == 0u)) {
+                std::fprintf(
+                    stderr,
+                    "BUMBLE_LIGHTING stage=shadow_map_reused"
+                    " owner=%s"
+                    " frame=%" PRIu64 " submission=%" PRIu64
+                    " source_draws_saved=%" PRIu32
+                    " merged_ranges_saved=%" PRIu32
+                    " resolution=%" PRIu32
+                    " cache=%s\n",
+                    debugName,
+                    reusedFrames,
+                    pendingSubmissionFrame,
+                    recordedCasterDrawCount,
+                    recordedRangeCount,
+                    resolution,
+                    cachePolicy == CachePolicy::StaticScene
+                        ? "same_level_scene"
+                        : "same_presentation"
+                );
+                std::fflush(stderr);
+            }
+            return;
+        }
+
+        worker->commandList->barriers(
+            RenderBarrierStage::GRAPHICS,
+            RenderTextureBarrier(
+                depthTexture.get(),
+                RenderTextureLayout::DEPTH_WRITE
+            )
+        );
+        worker->commandList->setFramebuffer(framebuffer.get());
+        worker->commandList->clearDepth();
+        worker->commandList->setViewports(RenderViewport(
+            0.0f,
+            0.0f,
+            static_cast<float>(resolution),
+            static_cast<float>(resolution)
+        ));
+        worker->commandList->setScissors(RenderRect(
+            0,
+            0,
+            static_cast<int32_t>(resolution),
+            static_cast<int32_t>(resolution)
+        ));
+        const RenderInputSlot inputSlot(0, sizeof(float) * 4);
+        worker->commandList->setGraphicsPipelineLayout(pipelineLayout.get());
+        worker->commandList->setPipeline(pipeline.get());
+        worker->commandList->setVertexBuffers(
+            0,
+            &worldPositionView,
+            1,
+            &inputSlot
+        );
+        worker->commandList->setIndexBuffer(&indexView);
+        worker->commandList->setGraphicsPushConstants(0, &constants);
+        for (const Range &range : ranges) {
+            worker->commandList->drawIndexedInstanced(
+                range.indexCount,
+                1,
+                range.indexStart,
+                0,
+                0
+            );
+        }
+        worker->commandList->barriers(
+            RenderBarrierStage::GRAPHICS,
+            RenderTextureBarrier(
+                depthTexture.get(),
+                RenderTextureLayout::DEPTH_READ
+            )
+        );
+
+        ++recordedFrames;
+        recordedSubmissionFrame = pendingSubmissionFrame;
+        recordedContentKey = pendingContentKey;
+        recordedCasterDrawCount = casterDrawCount;
+        recordedRangeCount = static_cast<uint32_t>(ranges.size());
+        if (bumbleRendererProofLogEnabled() && recordedFrames == 1u) {
+            std::fprintf(
+                stderr,
+                "BUMBLE_LIGHTING stage=shadow_map_recorded"
+                " owner=%s"
+                " frame=%" PRIu64 " source_draws=%" PRIu32
+                " merged_ranges=%" PRIu32
+                " resolution=%" PRIu32
+                " retained_range_capacity=%zu\n",
+                debugName,
+                recordedFrames,
+                casterDrawCount,
+                recordedRangeCount,
+                resolution,
+                ranges.capacity()
+            );
+            std::fflush(stderr);
+        }
+    }
+
+    bool BumbleShadowRenderer::active() const {
+        const bool hasFrameContent =
+            cachePolicy == CachePolicy::DynamicPerPresentation ||
+            reusePrepared || !ranges.empty();
+        return framePrepared && hasFrameContent && depthTexture != nullptr;
+    }
+
+    RenderTexture *BumbleShadowRenderer::texture() const {
+        return depthTexture.get();
+    }
+
+    RenderTextureView *BumbleShadowRenderer::textureView() const {
+        return depthTextureView.get();
+    }
+
+    const interop::float4x4 &
+    BumbleShadowRenderer::lightViewProjection() const {
+        return constants.lightViewProjection;
+    }
+}
diff --git a/src/render/rt64_bumble_shadow_renderer.h b/src/render/rt64_bumble_shadow_renderer.h
new file mode 100644
index 0000000..b8f82e7
--- /dev/null
+++ b/src/render/rt64_bumble_shadow_renderer.h
@@ -0,0 +1,86 @@
+//
+// Project-owned cached directional shadow-map renderer.
+//
+
+#pragma once
+
+#include <cstdint>
+#include <memory>
+#include <vector>
+
+#include "common/rt64_plume.h"
+#include "shared/rt64_hlsl.h"
+
+namespace RT64 {
+    struct RenderWorker;
+
+    struct BumbleShadowRenderer {
+        // Static architecture keeps the accepted high-resolution solar silhouette.
+        static constexpr uint32_t StaticResolution = 1024;
+        static constexpr uint32_t DynamicResolution = 512;
+        static constexpr uint32_t InitialRangeCapacity = 512;
+
+        enum class CachePolicy {
+            StaticScene,
+            DynamicPerPresentation,
+        };
+
+        struct Constants {
+            interop::float4x4 lightViewProjection;
+        };
+
+        struct Range {
+            uint32_t indexStart = 0;
+            uint32_t indexCount = 0;
+        };
+
+        std::vector<Range> ranges;
+        uint32_t casterDrawCount = 0;
+        Constants constants{};
+        bool framePrepared = false;
+        bool reusePrepared = false;
+
+        std::unique_ptr<RenderTexture> depthTexture;
+        std::unique_ptr<RenderTextureView> depthTextureView;
+        std::unique_ptr<RenderFramebuffer> framebuffer;
+        std::unique_ptr<RenderPipelineLayout> pipelineLayout;
+        std::unique_ptr<RenderShader> vertexShader;
+        std::unique_ptr<RenderPipeline> pipeline;
+        RenderShaderFormat shaderFormat = RenderShaderFormat::UNKNOWN;
+        uint64_t recordedFrames = 0;
+        uint64_t reusedFrames = 0;
+        uint64_t pendingSubmissionFrame = UINT64_MAX;
+        uint64_t recordedSubmissionFrame = UINT64_MAX;
+        uint64_t pendingContentKey = UINT64_MAX;
+        uint64_t recordedContentKey = UINT64_MAX;
+        uint32_t recordedCasterDrawCount = 0;
+        uint32_t recordedRangeCount = 0;
+        CachePolicy cachePolicy;
+        const char *debugName;
+        uint32_t resolution;
+
+        BumbleShadowRenderer(
+            CachePolicy cachePolicy,
+            const char *debugName,
+            uint32_t resolution
+        );
+        void reset();
+        bool ensureResources(RenderWorker *worker, RenderShaderFormat format);
+        bool begin(
+            const interop::float4x4 &lightViewProjection,
+            uint64_t cacheFrame,
+            uint64_t contentKey
+        );
+        void addCasterRange(uint32_t indexStart, uint32_t indexCount);
+        void record(
+            RenderWorker *worker,
+            const RenderVertexBufferView &worldPositionView,
+            const RenderIndexBufferView &indexView
+        );
+
+        bool active() const;
+        RenderTexture *texture() const;
+        RenderTextureView *textureView() const;
+        const interop::float4x4 &lightViewProjection() const;
+    };
+}
diff --git a/src/render/rt64_bumble_sky.cpp b/src/render/rt64_bumble_sky.cpp
new file mode 100644
index 0000000..ea24da5
--- /dev/null
+++ b/src/render/rt64_bumble_sky.cpp
@@ -0,0 +1,476 @@
+//
+// Project-owned Buck Bumble procedural sky bridge and renderer.
+//
+
+#include "rt64_bumble_sky.h"
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cassert>
+#include <cinttypes>
+#include <cmath>
+#include <cstdio>
+#include <mutex>
+
+#include "common/rt64_math.h"
+#include "shaders/BumbleSkyPS.hlsl.spirv.h"
+#include "shaders/BumbleSkyVS.hlsl.spirv.h"
+#ifdef _WIN32
+#   include "shaders/BumbleSkyPS.hlsl.dxil.h"
+#   include "shaders/BumbleSkyVS.hlsl.dxil.h"
+#elif defined(__APPLE__)
+#   include "shaders/BumbleSkyPS.hlsl.metal.h"
+#   include "shaders/BumbleSkyVS.hlsl.metal.h"
+#endif
+
+#include "rt64_render_target.h"
+#include "rt64_render_worker.h"
+#include "rt64_bumble_environment.h"
+
+namespace RT64 {
+    namespace {
+        constexpr size_t SnapshotRingSize = 64;
+
+        struct SnapshotEntry {
+            uint32_t ticket = 0;
+            BumbleSkySnapshot snapshot{};
+        };
+
+        std::array<SnapshotEntry, SnapshotRingSize> snapshotRing{};
+        std::atomic_uint32_t nextTicket{1};
+        std::mutex snapshotMutex;
+        std::atomic_uint64_t missedSnapshots{0};
+
+        const void *shaderBlob(
+            RenderShaderFormat format,
+            bool vertex,
+            size_t &size
+        ) {
+            switch (format) {
+#ifdef _WIN32
+            case RenderShaderFormat::DXIL:
+                if (vertex) {
+                    size = sizeof(BumbleSkyVSBlobDXIL);
+                    return BumbleSkyVSBlobDXIL;
+                }
+                size = sizeof(BumbleSkyPSBlobDXIL);
+                return BumbleSkyPSBlobDXIL;
+#endif
+            case RenderShaderFormat::SPIRV:
+                if (vertex) {
+                    size = sizeof(BumbleSkyVSBlobSPIRV);
+                    return BumbleSkyVSBlobSPIRV;
+                }
+                size = sizeof(BumbleSkyPSBlobSPIRV);
+                return BumbleSkyPSBlobSPIRV;
+#ifdef __APPLE__
+            case RenderShaderFormat::METAL:
+                if (vertex) {
+                    size = sizeof(BumbleSkyVSBlobMSL);
+                    return BumbleSkyVSBlobMSL;
+                }
+                size = sizeof(BumbleSkyPSBlobMSL);
+                return BumbleSkyPSBlobMSL;
+#endif
+            default:
+                size = 0;
+                return nullptr;
+            }
+        }
+
+        float byteToUnit(uint32_t value, uint32_t shift) {
+            return static_cast<float>((value >> shift) & 0xFFu) / 255.0f;
+        }
+
+        bool finiteDirection(const BumbleSkyDirection &direction) {
+            return std::isfinite(direction.x) &&
+                std::isfinite(direction.y) &&
+                std::isfinite(direction.z);
+        }
+
+        bool reviewedPresetForLevel(uint32_t levelIndex, uint32_t preset) {
+            switch (levelIndex) {
+            case 1u:
+            case 2u:
+            case 3u:
+            case 4u:
+            case 5u:
+            case 6u:
+                return preset == BumbleSkyPresetCloudyDay;
+            case 7u:
+            case 9u:
+            case 10u:
+            case 11u:
+            case 12u:
+            case 13u:
+            case 15u:
+            case 16u:
+            case 18u:
+                return preset == BumbleSkyPresetDarkOvercast;
+            default:
+                return false;
+            }
+        }
+
+        const char *presetName(uint32_t preset) {
+            switch (preset) {
+            case BumbleSkyPresetCloudyDay:
+                return "cloudy_day";
+            case BumbleSkyPresetDarkOvercast:
+                return "dark_overcast";
+            default:
+                return "invalid";
+            }
+        }
+    }
+
+    uint32_t publishBumbleSkySnapshot(const BumbleSkySnapshot &snapshot) {
+        uint32_t ticket = nextTicket.fetch_add(1, std::memory_order_relaxed);
+        if (ticket == 0u) {
+            ticket = nextTicket.fetch_add(1, std::memory_order_relaxed);
+        }
+
+        const std::lock_guard<std::mutex> lock(snapshotMutex);
+        SnapshotEntry &entry = snapshotRing[ticket % SnapshotRingSize];
+        entry.snapshot = snapshot;
+        entry.ticket = ticket;
+        return ticket;
+    }
+
+    bool consumeBumbleSkySnapshot(
+        uint32_t ticket,
+        BumbleSkySnapshot &snapshot
+    ) {
+        const std::lock_guard<std::mutex> lock(snapshotMutex);
+        SnapshotEntry &entry = snapshotRing[ticket % SnapshotRingSize];
+        if (ticket == 0u || entry.ticket != ticket) {
+            const uint64_t missed =
+                missedSnapshots.fetch_add(1, std::memory_order_relaxed) + 1u;
+            if (bumbleRendererProofLogEnabled() &&
+                (missed <= 4u || missed == 60u)) {
+                std::fprintf(
+                    stderr,
+                    "BUMBLE_SKY stage=snapshot_missed ticket=%" PRIu32
+                    " misses=%" PRIu64 " ring=%zu\n",
+                    ticket,
+                    missed,
+                    SnapshotRingSize
+                );
+                std::fflush(stderr);
+            }
+            return false;
+        }
+
+        snapshot = entry.snapshot;
+        entry.ticket = 0u;
+        return true;
+    }
+
+    BumbleSkyRenderer::BumbleSkyRenderer() { }
+
+    void BumbleSkyRenderer::reset() {
+        draws.clear();
+    }
+
+    bool BumbleSkyRenderer::ensurePipeline(
+        RenderWorker *worker,
+        RenderShaderFormat format,
+        const RenderMultisampling &multisampling,
+        bool usesHDR
+    ) {
+        assert(worker != nullptr);
+        if (pipeline != nullptr && shaderFormat == format &&
+            sampleCount == multisampling.sampleCount &&
+            pipelineUsesHDR == usesHDR) {
+            return true;
+        }
+
+        pipeline.reset();
+        pipelineLayout.reset();
+        vertexShader.reset();
+        pixelShader.reset();
+
+        size_t vertexBlobSize = 0;
+        size_t pixelBlobSize = 0;
+        const void *vertexBlob = shaderBlob(format, true, vertexBlobSize);
+        const void *pixelBlob = shaderBlob(format, false, pixelBlobSize);
+        if (vertexBlob == nullptr || pixelBlob == nullptr) {
+            return false;
+        }
+
+        vertexShader = worker->device->createShader(
+            vertexBlob,
+            vertexBlobSize,
+            "VSMain",
+            format
+        );
+        pixelShader = worker->device->createShader(
+            pixelBlob,
+            pixelBlobSize,
+            "PSMain",
+            format
+        );
+
+        RenderPipelineLayoutBuilder layoutBuilder;
+        layoutBuilder.begin(false, false);
+        layoutBuilder.addPushConstant(
+            0,
+            0,
+            sizeof(PushConstants),
+            RenderShaderStageFlag::VERTEX | RenderShaderStageFlag::PIXEL
+        );
+        layoutBuilder.end();
+        pipelineLayout = layoutBuilder.create(worker->device);
+
+        RenderGraphicsPipelineDesc desc;
+        desc.pipelineLayout = pipelineLayout.get();
+        desc.vertexShader = vertexShader.get();
+        desc.pixelShader = pixelShader.get();
+        desc.primitiveTopology = RenderPrimitiveTopology::TRIANGLE_LIST;
+        desc.cullMode = RenderCullMode::NONE;
+        desc.depthClipEnabled = false;
+        desc.depthEnabled = true;
+        desc.depthWriteEnabled = false;
+        desc.depthFunction = RenderComparisonFunction::LESS_EQUAL;
+        desc.depthTargetFormat = RenderFormat::D32_FLOAT;
+        desc.multisampling = multisampling;
+        desc.alphaToCoverageEnabled = false;
+        desc.renderTargetFormat[0] = RenderTarget::colorBufferFormat(usesHDR);
+        desc.renderTargetBlend[0] = RenderBlendDesc::Copy();
+        desc.renderTargetCount = 1;
+        pipeline = worker->device->createGraphicsPipeline(desc);
+
+        shaderFormat = format;
+        sampleCount = multisampling.sampleCount;
+        pipelineUsesHDR = usesHDR;
+        if (bumbleRendererProofLogEnabled()) {
+            std::fprintf(
+                stderr,
+                "BUMBLE_SKY stage=gpu_pipeline_ready shader_format=%d"
+                " samples=%" PRIu32
+                " topology=fullscreen_triangle depth=read_only"
+                " depth_write=disabled blend=opaque_copy cull=none"
+                " texture_samples=0 barrier=analytic_hex_plane"
+                " ceiling_y=800.000\n",
+                static_cast<int>(format),
+                sampleCount
+            );
+            std::fflush(stderr);
+        }
+        return pipeline != nullptr;
+    }
+
+    uint32_t BumbleSkyRenderer::addDraw(
+        const BumbleSkySnapshot &snapshot,
+        const interop::float4x4 &presentationView,
+        const interop::float4x4 &presentationProjection,
+        const RenderRect &scissor,
+        float viewportWidth,
+        float viewportHeight,
+        uint64_t submissionFrame,
+        bool modernLightingActive
+    ) {
+        if (snapshot.mode == 0u ||
+            !reviewedPresetForLevel(snapshot.levelIndex, snapshot.preset) ||
+            scissor.isEmpty() || !std::isfinite(viewportWidth) ||
+            !std::isfinite(viewportHeight) || viewportWidth <= 0.0f ||
+            viewportHeight <= 0.0f ||
+            !std::isfinite(snapshot.playerY) ||
+            !finiteDirection(snapshot.eye) ||
+            !finiteDirection(snapshot.forward) ||
+            !finiteDirection(snapshot.right) ||
+            !finiteDirection(snapshot.up)) {
+            return BumbleSkyInvalidDraw;
+        }
+
+        // The snapshot owns game/environment state, but its camera basis is a 30 Hz guest sample.
+        const hlslpp::float4x4 presentationViewInverse =
+            hlslpp::inverse(presentationView);
+        const hlslpp::float3 presentationEye =
+            presentationViewInverse[3].xyz;
+        const hlslpp::float4x4 presentationViewProjectionInverse =
+            hlslpp::inverse(hlslpp::mul(
+                presentationView,
+                presentationProjection
+            ));
+        const auto finiteVector = [](const hlslpp::float3 &value) {
+            return std::isfinite(value.x) && std::isfinite(value.y) &&
+                std::isfinite(value.z);
+        };
+        const auto unprojectRay = [&](float x, float y,
+                                      hlslpp::float3 &ray) {
+            const hlslpp::float4 world = hlslpp::mul(
+                hlslpp::float4(x, y, 0.5f, 1.0f),
+                presentationViewProjectionInverse
+            );
+            if (!std::isfinite(world.x) || !std::isfinite(world.y) ||
+                !std::isfinite(world.z) || !std::isfinite(world.w) ||
+                std::abs(world.w) <= 1.0e-6f) {
+                return false;
+            }
+            ray = world.xyz / world.w - presentationEye;
+            return finiteVector(ray);
+        };
+        hlslpp::float3 rayCenter;
+        hlslpp::float3 rayRight;
+        hlslpp::float3 rayUp;
+        if (!finiteVector(presentationEye) ||
+            !unprojectRay(0.0f, 0.0f, rayCenter) ||
+            !unprojectRay(1.0f, 0.0f, rayRight) ||
+            !unprojectRay(0.0f, 1.0f, rayUp)) {
+            return BumbleSkyInvalidDraw;
+        }
+        const hlslpp::float3 rayRightStep = rayRight - rayCenter;
+        const hlslpp::float3 rayUpStep = rayUp - rayCenter;
+        const float presentationPlayerY = snapshot.playerY +
+            (presentationEye.y - snapshot.eye.y);
+
+        Draw draw{};
+        draw.scissor = scissor;
+        draw.levelIndex = snapshot.levelIndex;
+        draw.levelIdWord = snapshot.levelIdWord;
+        draw.horizonRgb = snapshot.horizonRgb;
+        draw.preset = snapshot.preset;
+        draw.submissionFrame = submissionFrame;
+        draw.aspect = viewportWidth / viewportHeight;
+        draw.constants.rayCenterFogScale = {
+            rayCenter.x,
+            rayCenter.y,
+            rayCenter.z,
+            std::clamp(snapshot.fogScale, 0.0f, 1.0f),
+        };
+        draw.constants.rayRightStepAspect = {
+            rayRightStep.x,
+            rayRightStep.y,
+            rayRightStep.z,
+            draw.aspect,
+        };
+        draw.constants.rayUpStep = {
+            rayUpStep.x,
+            rayUpStep.y,
+            rayUpStep.z,
+            0.0f,
+        };
+        draw.constants.horizonPreset = {
+            byteToUnit(snapshot.horizonRgb, 24u),
+            byteToUnit(snapshot.horizonRgb, 16u),
+            byteToUnit(snapshot.horizonRgb, 8u),
+            presentationEye.z,
+        };
+        // Threshold and contribution retain the reviewed preset distinction.
+        if (snapshot.preset == BumbleSkyPresetDarkOvercast) {
+            draw.constants.cloudShape = {
+                0.44f, presentationPlayerY, 0.88f, presentationEye.x,
+            };
+            draw.constants.sunColorIntensity = {
+                1.00f, 0.72f, 0.42f,
+                modernLightingActive ? 2.20f : 0.0f,
+            };
+            draw.constants.shaftParams = {
+                modernLightingActive ? 0.48f : 0.0f,
+                modernLightingActive ? 0.58f : 0.0f,
+                0.78f,
+                presentationEye.y,
+            };
+        }
+        else {
+            draw.constants.cloudShape = {
+                0.52f, presentationPlayerY, 0.74f, presentationEye.x,
+            };
+            draw.constants.sunColorIntensity = {
+                1.00f, 0.88f, 0.62f,
+                modernLightingActive ? 2.60f : 0.0f,
+            };
+            draw.constants.shaftParams = {
+                modernLightingActive ? 0.40f : 0.0f,
+                modernLightingActive ? 0.66f : 0.0f,
+                0.68f,
+                presentationEye.y,
+            };
+        }
+        draw.constants.sunDirectionAngular = {
+            -0.6612f, 0.4208f, 0.6211f, 0.99863f,
+        };
+
+        const uint32_t drawIndex = static_cast<uint32_t>(draws.size());
+        draws.push_back(draw);
+        ++loggedPreparedDraws;
+        if (bumbleRendererProofLogEnabled() &&
+            (loggedPreparedDraws <= 4u ||
+             (loggedPreparedDraws % 240u) == 0u)) {
+            std::fprintf(
+                stderr,
+                "BUMBLE_SKY stage=gpu_draw_prepared draw=%" PRIu64
+                " draw_index=%" PRIu32 " submission=%" PRIu64
+                " level=%" PRIu32 " preset=%s"
+                " aspect=%.6f fog_scale=%.3f horizon=0x%08" PRIX32
+                " scissor=%d,%d,%d,%d texture_samples=0"
+                " model=direction_space_triangular_fbm"
+                " sun_disk=%d god_rays=%d barrier=analytic_hex_plane"
+                " ceiling_y=800.000 eye_y=%.3f player_y=%.3f"
+                " player_gap=%.3f extra_draws=0 texture_samples=0\n",
+                loggedPreparedDraws,
+                drawIndex,
+                submissionFrame,
+                draw.levelIndex,
+                presetName(draw.preset),
+                static_cast<double>(draw.aspect),
+                static_cast<double>(draw.constants.rayCenterFogScale.w),
+                draw.horizonRgb,
+                draw.scissor.left,
+                draw.scissor.top,
+                draw.scissor.right,
+                draw.scissor.bottom,
+                modernLightingActive ? 1 : 0,
+                modernLightingActive ? 1 : 0,
+                static_cast<double>(presentationEye.y),
+                static_cast<double>(presentationPlayerY),
+                static_cast<double>(std::max(
+                    800.0f - presentationPlayerY,
+                    0.0f
+                ))
+            );
+            std::fflush(stderr);
+        }
+        return drawIndex;
+    }
+
+    void BumbleSkyRenderer::record(
+        RenderWorker *worker,
+        uint32_t drawIndex
+    ) {
+        if (worker == nullptr || pipeline == nullptr ||
+            drawIndex >= draws.size()) {
+            return;
+        }
+        const Draw &draw = draws[drawIndex];
+        if (draw.scissor.isEmpty()) {
+            return;
+        }
+
+        worker->commandList->setGraphicsPipelineLayout(pipelineLayout.get());
+        worker->commandList->setPipeline(pipeline.get());
+        worker->commandList->setScissors(draw.scissor);
+        worker->commandList->setVertexBuffers(0, nullptr, 0, nullptr);
+        worker->commandList->setIndexBuffer(nullptr);
+        worker->commandList->setGraphicsPushConstants(0, &draw.constants);
+        worker->commandList->drawInstanced(3, 1, 0, 0);
+
+        ++loggedRecordedDraws;
+        if (bumbleRendererProofLogEnabled() &&
+            (loggedRecordedDraws <= 4u ||
+             (loggedRecordedDraws % 240u) == 0u)) {
+            std::fprintf(
+                stderr,
+                "BUMBLE_SKY stage=gpu_draw_recorded record=%" PRIu64
+                " draw_index=%" PRIu32
+                " vertices=3 instances=1 texture_samples=0"
+                " ordering=after_opaque_before_blended\n",
+                loggedRecordedDraws,
+                drawIndex
+            );
+            std::fflush(stderr);
+        }
+    }
+}
