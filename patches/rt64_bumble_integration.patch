+//
+// Project-owned Buck Bumble modern electric-effect renderer.
+//
+
+#pragma once
+
+#include <chrono>
+#include <cstdint>
+#include <memory>
+#include <type_traits>
+#include <vector>
+
+#include "common/rt64_plume.h"
+#include "shared/rt64_hlsl.h"
+#include "shared/rt64_rsp_viewport.h"
+
+#include "rt64_buffer_uploader.h"
+#include "rt64_bumble_electric.h"
+
+namespace RT64 {
+    constexpr uint32_t BumbleElectricInvalidDraw = UINT32_MAX;
+
+    struct RenderWorker;
+
+    // A segment or billboard expanded by the vertex shader.
+    struct BumbleElectricGPURecord {
+        float startX = 0.0f;
+        float startY = 0.0f;
+        float startZ = 0.0f;
+        float width = 1.0f;
+        float endX = 0.0f;
+        float endY = 0.0f;
+        float endZ = 0.0f;
+        float intensity = 1.0f;
+        float taper = 1.0f;
+        float pulse = 0.0f;
+        uint32_t kind = 0u;
+        uint32_t seed = 0u;
+    };
+
+    static_assert(std::is_trivially_copyable_v<BumbleElectricGPURecord>);
+    static_assert(sizeof(BumbleElectricGPURecord) == 48u);
+
+    struct BumbleElectricRenderer {
+        struct PushConstants {
+            interop::float4x4 viewProj;
+            // x/y: RSP depth scale/translate, z/w: target width/height.
+            interop::float4 depthViewport;
+            // x: glow pass, y: width scale, z: brightness, w: phase.
+            interop::float4 passParams;
+            // x: first record, y: record count.
+            interop::uint4 population;
+        };
+
+        struct Draw {
+            PushConstants constants{};
+            RenderRect scissor{};
+            uint32_t recordStart = 0u;
+            uint32_t recordCount = 0u;
+            uint32_t additiveRecordCount = 0u;
+            uint32_t smokeRecordStart = 0u;
+            uint32_t smokeRecordCount = 0u;
+            uint32_t arcCount = 0u;
+            uint32_t effectCount = 0u;
+            uint64_t sequence = 0u;
+        };
+
+        std::vector<BumbleElectricGPURecord> records;
+        std::vector<Draw> draws;
+        BufferPair recordBuffer;
+        std::unique_ptr<RenderDescriptorSetBase> descriptorSet;
+        uint32_t recordDescriptorIndex = 0u;
+        std::unique_ptr<RenderPipelineLayout> pipelineLayout;
+        std::unique_ptr<RenderShader> vertexShader;
+        std::unique_ptr<RenderShader> pixelShader;
+        std::unique_ptr<RenderPipeline> pipeline;
+        std::unique_ptr<RenderPipeline> smokePipeline;
+        RenderShaderFormat shaderFormat = RenderShaderFormat::UNKNOWN;
+        RenderSampleCounts sampleCount = 0;
+        bool pipelineUsesHDR = false;
+        bool uploadPending = false;
+        uint64_t loggedDraws = 0u;
+        uint64_t loggedRecords = 0u;
+        float animationTimeSeconds = 0.0f;
+        std::chrono::steady_clock::time_point animationLastFrame{};
+        bool animationClockInitialized = false;
+
+        BumbleElectricRenderer();
+        void reset();
+        bool ensurePipeline(
+            RenderWorker *worker,
+            RenderShaderFormat format,
+            const RenderMultisampling &multisampling,
+            bool usesHDR
+        );
+        uint32_t addDraw(
+            const BumbleElectricSnapshot &snapshot,
+            const interop::float4x4 &viewProj,
+            const interop::RSPViewport &rspViewport,
+            const RenderRect &scissor
+        );
+        void appendUpload(std::vector<BufferUploader::Upload> &uploads);
+        void record(RenderWorker *worker, uint32_t drawIndex);
+    };
+}
