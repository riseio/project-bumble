+//
+// Project-owned Buck Bumble procedural sky bridge and renderer.
+//
+
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <memory>
+#include <type_traits>
+#include <vector>
+
+#include "common/rt64_plume.h"
