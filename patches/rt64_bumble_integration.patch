+    static bool bumbleDynamicShadowCaster(
+        const DrawData &drawData,
+        const GameCall &call
+    ) {
+        const uint32_t first = call.callDesc.minWorldMatrix;
+        const uint32_t last = call.callDesc.maxWorldMatrix;
+        if (first > last || last >= drawData.worldTransformGroups.size()) {
+            return false;
+        }
+        for (uint32_t matrixIndex = first;
+             matrixIndex <= last;
+             ++matrixIndex) {
+            const uint32_t groupIndex =
+                drawData.worldTransformGroups[matrixIndex];
+            if (groupIndex >= drawData.transformGroups.size()) {
+                continue;
+            }
+            const uint32_t matrixId =
+                drawData.transformGroups[groupIndex].matrixId;
+            // Native actor draws use their stable guest actor address as the transform group id.
+            if (matrixId >= 0x80000000u && matrixId <= 0x807FFFFFu) {
+                return true;
+            }
+            // AUTO/IGNORE is not proof of immobility.
+            if (matrixIndex < drawData.worldTransforms.size() &&
+                matrixIndex < drawData.prevWorldTransforms.size() &&
+                std::memcmp(
+                    &drawData.worldTransforms[matrixIndex],
+                    &drawData.prevWorldTransforms[matrixIndex],
+                    sizeof(interop::float4x4)
+                ) != 0) {
+                return true;
+            }
+        }
+        return false;
+    }
