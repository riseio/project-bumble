@@ -0,0 +1,149 @@
+//
+// Project-owned Buck Bumble collision debug bridge.
+//
+
+#pragma once
+
+#include <cstdint>
+#include <type_traits>
+#include <vector>
+
+namespace RT64 {
+    struct BumbleCollisionDebugVertex {
+        float x = 0.0f;
+        float y = 0.0f;
+        float z = 0.0f;
+        float padding = 0.0f;
+    };
+
+    static_assert(
+        std::is_trivially_copyable_v<BumbleCollisionDebugVertex>
+    );
+    static_assert(sizeof(BumbleCollisionDebugVertex) == 16u);
+
+    struct BumbleCollisionDebugMesh {
+        uint64_t generation = 0u;
+        uint32_t levelIndex = 0u;
+        bool valid = false;
+        std::vector<BumbleCollisionDebugVertex> vertices;
+        std::vector<BumbleCollisionDebugVertex> liquidCells;
+    };
+
+    struct BumbleCollisionDebugGateMesh {
+        uint64_t generation = 0u;
+        uint32_t levelIndex = 0u;
+        bool valid = false;
+        std::vector<BumbleCollisionDebugVertex> vertices;
+    };
+
+    enum BumbleCollisionDebugPrimitiveKind : uint32_t {
+        BumbleCollisionDebugPrimitiveActorSphere = 0u,
+        BumbleCollisionDebugPrimitiveActorPoint = 1u,
+        BumbleCollisionDebugPrimitivePlayerCapsule = 2u,
+        BumbleCollisionDebugPrimitiveSupportProbe = 3u,
+    };
+
+    enum BumbleCollisionDebugStyle : uint32_t {
+        BumbleCollisionDebugStyleStaticFloor = 0u,
+        BumbleCollisionDebugStyleStaticWall = 1u,
+        BumbleCollisionDebugStyleActorCollider = 2u,
+        BumbleCollisionDebugStyleActorPoint = 3u,
+        BumbleCollisionDebugStylePlayerInteraction = 4u,
+        BumbleCollisionDebugStylePlayerCapsule = 5u,
+        BumbleCollisionDebugStyleLiquidThreshold = 6u,
+        BumbleCollisionDebugStyleCeiling = 7u,
+        BumbleCollisionDebugStyleSupportProbe = 8u,
+    };
+
+    // The marker snapshot owns every live non-terrain primitive for one game frame.
+    struct BumbleCollisionDebugPrimitive {
+        float centerX = 0.0f;
+        float centerY = 0.0f;
+        float centerZ = 0.0f;
+        float radius = 0.0f;
+        float extentX = 0.0f;
+        float extentY = 0.0f;
+        float extentZ = 0.0f;
+        float halfHeight = 0.0f;
+        uint32_t kind = BumbleCollisionDebugPrimitiveActorPoint;
+        uint32_t style = BumbleCollisionDebugStyleActorPoint;
+        uint32_t actorAddress = 0u;
+        uint32_t category = 0u;
+        uint32_t collisionFlags = 0u;
+        uint32_t collisionMask = 0u;
+        uint32_t objectIdAndType = 0u;
+        uint32_t state = 0u;
+    };
+
+    static_assert(
+        std::is_trivially_copyable_v<BumbleCollisionDebugPrimitive>
+    );
+    static_assert(sizeof(BumbleCollisionDebugPrimitive) == 64u);
+
+    struct BumbleCollisionDebugSnapshot {
+        uint64_t sequence = 0u;
+        uint32_t levelIndex = 0u;
+        uint32_t actorCount = 0u;
+        uint32_t activeSphereCount = 0u;
+        uint32_t pointOnlyCount = 0u;
+        uint32_t playerCount = 0u;
+        uint32_t listMask = 0u;
+        uint32_t malformedListCount = 0u;
+        uint32_t editorPreviewOnly = 0u;
+        std::vector<BumbleCollisionDebugPrimitive> primitives;
+    };
+
+    struct BumbleCollisionDebugCapsule {
+        float centerX = 0.0f;
+        float centerY = 0.0f;
+        float centerZ = 0.0f;
+        float radius = 0.0f;
+        float halfHeight = 0.0f;
+        // Zero means no downward probe was used this frame.
+        float supportProbeDistance = 0.0f;
+        bool valid = false;
+    };
+
+    // Zero disables the feature.
+    uint32_t bumbleCollisionDebugMode();
+    void setBumbleCollisionDebugMode(uint32_t mode);
+
+    void publishBumbleCollisionDebugMesh(
+        uint32_t levelIndex,
+        std::vector<BumbleCollisionDebugVertex> vertices,
+        std::vector<BumbleCollisionDebugVertex> liquidCells
+    );
+    void clearBumbleCollisionDebugScene();
+    bool copyBumbleCollisionDebugMeshIfChanged(
+        uint64_t knownGeneration,
+        BumbleCollisionDebugMesh &mesh
+    );
+    void publishBumbleCollisionDebugGateMesh(
+        uint32_t levelIndex,
+        std::vector<BumbleCollisionDebugVertex> vertices
+    );
+    bool copyBumbleCollisionDebugGateMeshIfChanged(
+        uint64_t knownGeneration,
+        BumbleCollisionDebugGateMesh &mesh
+    );
+
+    void publishBumbleCollisionDebugCapsule(
+        float centerX,
+        float centerY,
+        float centerZ,
+        float radius,
+        float halfHeight,
+        float supportProbeDistance
+    );
+    bool readBumbleCollisionDebugCapsule(
+        BumbleCollisionDebugCapsule &capsule
+    );
+
+    uint32_t publishBumbleCollisionDebugSnapshot(
+        BumbleCollisionDebugSnapshot snapshot
+    );
+    bool consumeBumbleCollisionDebugSnapshot(
+        uint32_t ticket,
+        BumbleCollisionDebugSnapshot &snapshot
+    );
+}
