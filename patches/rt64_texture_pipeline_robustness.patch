diff --git a/src/shared/rt64_texture_lod.h b/src/shared/rt64_texture_lod.h
new file mode 100644
--- /dev/null
+++ b/src/shared/rt64_texture_lod.h
@@ -0,0 +1,27 @@
+// Shared CPU/shader domain contract for texture LOD selection.
+#pragma once
+
+#ifdef HLSL_CPU
+#include <algorithm>
+#include <cmath>
+namespace interop {
+using std::floor;
+using std::log2;
+using std::max;
+using std::min;
+#endif
+
+inline float textureMipLevel(float gradientSquared, float maxMip) {
+    // All magnification selects level zero.
+    float mip = 0.5f * log2(max(gradientSquared, 1.0f)) - 0.25f;
+    return min(max(mip, 0.0f), maxMip);
+}
+
+inline int textureLODTileBase(float distance) {
+    // Preserve the original distance for authored detail/sharpen fractions.
+    return int(floor(log2(max(distance, 1.0f / 65536.0f))));
+}
+
+#ifdef HLSL_CPU
+}
+#endif
