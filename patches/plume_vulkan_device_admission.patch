     // VulkanDescriptorSetLayout
 
+    static bool needsUpdateAfterBindPool(VulkanDevice *device, const RenderDescriptorSetDesc &desc) {
+        if (desc.lastRangeIsBoundless) return true;
+        uint64_t samplers = 0, uniform = 0, storage = 0, sampled = 0, images = 0;
+        for (uint32_t i = 0; i < desc.descriptorRangesCount; ++i) {
+            const auto &range = desc.descriptorRanges[i];
+            switch (toVk(range.type)) {
+            case VK_DESCRIPTOR_TYPE_SAMPLER: samplers += range.count; break;
+            case VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER: uniform += range.count; break;
+            case VK_DESCRIPTOR_TYPE_STORAGE_BUFFER: storage += range.count; break;
+            case VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE:
+            case VK_DESCRIPTOR_TYPE_UNIFORM_TEXEL_BUFFER: sampled += range.count; break;
+            case VK_DESCRIPTOR_TYPE_STORAGE_IMAGE:
+            case VK_DESCRIPTOR_TYPE_STORAGE_TEXEL_BUFFER: images += range.count; break;
+            default: break;
+            }
+        }
+        const auto &limits = device->physicalDeviceProperties.limits;
+        // Static descriptor bindings must not change after submission.
+        return samplers > std::min(limits.maxPerStageDescriptorSamplers, limits.maxDescriptorSetSamplers) ||
+            uniform > std::min(limits.maxPerStageDescriptorUniformBuffers, limits.maxDescriptorSetUniformBuffers) ||
+            storage > std::min(limits.maxPerStageDescriptorStorageBuffers, limits.maxDescriptorSetStorageBuffers) ||
+            sampled > std::min(limits.maxPerStageDescriptorSampledImages, limits.maxDescriptorSetSampledImages) ||
+            images > std::min(limits.maxPerStageDescriptorStorageImages, limits.maxDescriptorSetStorageImages);
+    }
