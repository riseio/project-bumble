+#pragma once
+#include "shared/rt64_render_params.h"
+
+struct BumbleShadowConstants {
+    float4x4 lightViewProjection;
+    uint ccL;
+    uint ccH;
+    uint omL;
+    uint omH;
+    uint flags;
+    uint instanceIndex;
+    uint tileIndex;
+    uint tileCount;
+    float resolution;
+    uint3 padding;
+};
+
+[[vk::push_constant]] ConstantBuffer<BumbleShadowConstants> gShadow : register(b0);
diff --git a/src/shaders/BumbleShadowMaterialVS.hlsl b/src/shaders/BumbleShadowMaterialVS.hlsl
new file mode 100644
index 0000000..7d9d2d1
--- /dev/null
+++ b/src/shaders/BumbleShadowMaterialVS.hlsl
@@ -0,0 +1,13 @@
+#include "BumbleShadowMaterial.hlsli"
+#include "FbRendererCommon.hlsli"
+
+void VSMain(float4 worldPosition : POSITION0, float2 uv : TEXCOORD0,
+    uint vertex : SV_VertexID, out float4 position : SV_POSITION,
+    out float2 materialUv : TEXCOORD0, out float4 materialColor : COLOR0,
+    out float2 coverageCoordinate : TEXCOORD1) {
+    position = mul(gShadow.lightViewProjection, worldPosition);
+    materialUv = uv;
+    coverageCoordinate = mul((float3x3)gShadow.lightViewProjection, worldPosition.xyz).xy *
+        float2(0.5f, -0.5f) * gShadow.resolution;
+    materialColor = float4(0, 0, 0, float(bumbleMaterialColor.Load(vertex * 4) >> 24) / 255.0f);
+}
diff --git a/src/shaders/BumbleShadowMaterialPS.hlsl b/src/shaders/BumbleShadowMaterialPS.hlsl
new file mode 100644
index 0000000..593d6e3
--- /dev/null
+++ b/src/shaders/BumbleShadowMaterialPS.hlsl
@@ -0,0 +1,66 @@
+#define DYNAMIC_RENDER_PARAMS
+#include "BumbleShadowMaterial.hlsli"
+#include "TextureSampler.hlsli"
+#include "shared/rt64_color_combiner.h"
+#include "shared/rt64_blender.h"
+
+void PSMain(float4 position : SV_POSITION, float2 uv : TEXCOORD0,
+    float4 color : COLOR0, float2 coverageCoordinate : TEXCOORD1) {
+    const RenderParams rp = { gShadow.ccL, gShadow.ccH, gShadow.omL, gShadow.omH, gShadow.flags };
+    const OtherMode mode = { rp.omL, rp.omH };
+    const RDPParams rdp = instanceRDPParams[gShadow.instanceIndex];
+    float2 dx = ddx(uv), dy = ddy(uv);
+    int first = 0, second = 1;
+    float lod;
+    computeLOD(mode, gShadow.tileCount, rdp.primLOD, 1.0f,
+        dx, dy, first, second, lod);
+    float4 texels[2] = { float4(0, 0, 0, 1), float4(0, 0, 0, 1) };
+    const bool oneCycle = mode.cycleType() == G_CYC_1CYCLE;
+    [unroll] for (uint slot = 0; slot < 2; ++slot) {
+        if (slot == 0 ? renderFlagUsesTexture0(rp.flags) : renderFlagUsesTexture1(rp.flags)) {
+            uint index = gShadow.tileIndex + ((slot == 0 || oneCycle) ? first : second);
+            RDPTile tile = RDPTiles[index];
+            if (!renderFlagDynamicTiles(rp.flags)) {
+                bool useFirst = slot == 0 || oneCycle;
+                tile.cms = useFirst ? renderCMS0(rp.flags) : renderCMS1(rp.flags);
+                tile.cmt = useFirst ? renderCMT0(rp.flags) : renderCMT1(rp.flags);
+                tile.nativeSampler = useFirst ? renderFlagNativeSampler0(rp.flags) : renderFlagNativeSampler1(rp.flags);
+            }
+            texels[slot] = sampleTexture(mode, rp.flags, uv, dx, dy,
+                tile, GPUTiles[index], slot == 1 && oneCycle);
+        }
+    }
+    ColorCombiner::Inputs inputs;
+    inputs.otherMode = mode;
+    inputs.alphaOnly = true;
+    inputs.texVal0 = texels[0];
+    inputs.texVal1 = texels[1];
+    inputs.primColor = rdp.primColor;
+    inputs.shadeColor = color;
+    inputs.envColor = rdp.envColor;
+    inputs.keyCenter = rdp.keyCenter;
+    inputs.keyScale = rdp.keyScale;
+    inputs.lodFraction = lod;
+    inputs.primLodFrac = rdp.primLOD.x;
+    inputs.noise = 0.0f;
+    inputs.K4 = rdp.convertK[4] / 255.0f;
+    inputs.K5 = rdp.convertK[5] / 255.0f;
+    const ColorCombiner combiner = { rp.ccL, rp.ccH };
+    float4 combined;
+    float alpha;
+    combiner.run(inputs, combined, alpha);
+    // Stable light-space coverage; never seed translucency from the camera or frame.
+    const int2 pixel = int2(floor(coverageCoordinate));
+    const uint bayer[16] = { 0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5 };
+    const float threshold = (bayer[(pixel.y & 3u) * 4u + (pixel.x & 3u)] + 0.5f) / 16.0f;
+    if (mode.alphaCompare() == G_AC_THRESHOLD && alpha < rdp.blendColor.a) discard;
+    if (mode.alphaCompare() == G_AC_DITHER && alpha < threshold) discard;
+    if (mode.cvgXAlpha() && combined.a < threshold) discard;
+    if (Blender::usesAlphaBlend(mode)) {
+        Blender::Inputs blend;
+        blend.blendColor = rdp.blendColor;
+        blend.fogColor = rdp.fogColor;
+        blend.shadeAlpha = color.a;
+        if (Blender::run(mode, rp.flags, blend, combined, false).a < threshold) discard;
+    }
+}
