+                    const float content[] = { data.tcFloats.at(vertex * 2),
+                        data.tcFloats.at(vertex * 2 + 1),
+                        float(data.normColBytes.at(vertex * 4 + 3)) };
+                    key = XXH3_64bits(content, sizeof(content));
+                    animatedMaterialVertices[vertex] = data.lookAtIndices.at(vertex) != 0 ||
+                        data.tcVelFloats.at(vertex * 2) != 0 || data.tcVelFloats.at(vertex * 2 + 1) != 0;
+                }
+                animated |= animatedMaterialVertices[vertex] != 0;
+                mix(key);
+            }
+            for (uint32_t i = 0; i < desc.tileCount; ++i) {
+                const uint32_t index = desc.tileIndex + i;
+                materialTiles.push_back(index);
+                const auto &tile = data.callTiles.at(index);
+                mix(tile.tmemHashOrID);
+                mix(XXH3_64bits(&data.rdpTiles.at(index), sizeof(interop::RDPTile)));
+                animated |= tile.tileCopyUsed;
+                if (index < data.lerpRdpTiles.size()) {
+                    animated |= std::memcmp(&data.rdpTiles[index], &data.lerpRdpTiles[index], sizeof(interop::RDPTile)) != 0;
+                }
+            }
+            return hash;
         }
 
         uint64_t key(const DrawData &data, uint64_t first, uint64_t count) {
