     struct RenderDescriptorSet {
+        enum class WriteKind : uint8_t { Buffer, Texture, Sampler, AccelerationStructure, Immutable };
+
+        // Validate before native layout/allocation work.
+        static uint32_t validateDescription(const RenderDescriptorSetDesc &desc) {
+            if ((desc.descriptorRangesCount && !desc.descriptorRanges) ||
+                (desc.lastRangeIsBoundless && !desc.descriptorRangesCount)) {
+                throw std::invalid_argument("Plume descriptor ranges are missing");
+            }
+            uint64_t declared = 0, allocated = 0;
+            for (uint32_t i = 0; i < desc.descriptorRangesCount; i++) {
+                const auto &range = desc.descriptorRanges[i];
+                if (!range.count || range.type <= RenderDescriptorRangeType::UNKNOWN ||
+                    range.type > RenderDescriptorRangeType::ACCELERATION_STRUCTURE) {
+                    throw std::invalid_argument("Plume invalid descriptor range");
+                }
+                const bool variable = desc.lastRangeIsBoundless && i == desc.descriptorRangesCount - 1;
+                const uint32_t count = variable ? std::max(desc.boundlessRangeSize, 1U) : range.count;
+                if (count > range.count || (variable && range.immutableSampler)) {
+                    throw std::invalid_argument("Plume descriptor allocation exceeds layout");
+                }
+                if (range.immutableSampler) {
+                    if (range.type != RenderDescriptorRangeType::SAMPLER)
+                        throw std::invalid_argument("Plume immutable resource is not a sampler");
+                    for (uint32_t s = 0; s < range.count; ++s)
+                        if (!range.immutableSampler[s]) throw std::invalid_argument("Plume immutable sampler is null");
+                }
+                declared += range.count;
+                allocated += count;
+                if (declared > UINT32_MAX || allocated > UINT32_MAX) {
+                    throw std::invalid_argument("Plume descriptor count overflow");
+                }
+            }
+            return uint32_t(allocated);
+        }
+
+        explicit RenderDescriptorSet(const RenderDescriptorSetDesc &desc) {
+            writeKinds.reserve(validateDescription(desc));
+            for (uint32_t i = 0; i < desc.descriptorRangesCount; i++) {
+                const auto &range = desc.descriptorRanges[i];
+                WriteKind kind = WriteKind::Buffer;
+                switch (range.type) {
+                case RenderDescriptorRangeType::TEXTURE:
+                case RenderDescriptorRangeType::READ_WRITE_TEXTURE: kind = WriteKind::Texture; break;
+                case RenderDescriptorRangeType::SAMPLER: kind = WriteKind::Sampler; break;
+                case RenderDescriptorRangeType::ACCELERATION_STRUCTURE: kind = WriteKind::AccelerationStructure; break;
+                default: break;
+                }
+                if (range.immutableSampler) kind = WriteKind::Immutable;
+                const uint32_t count = desc.lastRangeIsBoundless && i == desc.descriptorRangesCount - 1
+                    ? std::max(desc.boundlessRangeSize, 1U) : range.count;
+                writeKinds.insert(writeKinds.end(), count, kind);
+            }
+        }
+
+        // One bounds comparison and byte lookup per write, including Release.
+        void validateWrite(uint32_t index, WriteKind kind) const {
+            if (index >= writeKinds.size()) throw std::out_of_range("Plume descriptor write exceeds allocation");
+            if (writeKinds[index] != kind) throw std::invalid_argument("Plume incompatible descriptor write");
+            if (!allocationReady) throw std::runtime_error("Plume descriptor allocation failed");
+        }
+        bool allocationReady = false;
+
+    private:
+        std::vector<WriteKind> writeKinds;
+
+    public:
         // Descriptor indices correspond to the index assuming the descriptor set is one contiguous array. They DO NOT correspond to the bindings, which can be sparse.
         // User code should derive these indices on its own by looking at the order the bindings were assigned during set creation along with the descriptor count and
         // assume it was all allocated in one contiguous array. This allows efficient mapping between Vulkan and D3D12's descriptor models.
