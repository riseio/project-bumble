 namespace RT64 {
+    // The submission allocator is independent of cache residency/high-water indices.
+    struct SubmissionTextureIndices {
+        const uint32_t capacity;
+        uint32_t count = 0;
+        std::vector<uint32_t> cacheIndices;
+        std::vector<std::pair<uint32_t, uint32_t>> staticBindings;
+
+        explicit SubmissionTextureIndices(uint32_t capacity) : capacity(capacity) { }
+        void reset(size_t cacheSize) {
+            cacheIndices.assign(cacheSize, UINT32_MAX);
+            staticBindings.clear();
+            count = 0;
+        }
+        uint32_t allocate() {
+            if (count >= capacity) throw std::out_of_range("RT64 submission exceeds texture descriptor capacity");
+            return count++;
+        }
+        uint32_t mapStatic(uint32_t cacheIndex) {
+            auto &index = cacheIndices.at(cacheIndex);
+            if (index == UINT32_MAX) {
+                if (count >= capacity) throw std::out_of_range("RT64 submission exceeds texture descriptor capacity");
+                // Publish identity only after the vector insertion succeeds.
+                staticBindings.emplace_back(count, cacheIndex);
+                index = count++;
+            }
+            return index;
+        }
+    };
