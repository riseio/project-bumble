diff --git a/src/shaders/BumbleSurfaceFog.hlsli b/src/shaders/BumbleSurfaceFog.hlsli
new file mode 100644
--- /dev/null
+++ b/src/shaders/BumbleSurfaceFog.hlsli
@@ -0,0 +1,17 @@
+#pragma once
+
+#include "shared/rt64_blender.h"
+
+// Only separate the standard atmospheric cycle from an opaque material.
+bool bumbleCanDeferSurfaceFog(OtherMode mode, RenderFlags flags) {
+    return mode.cycleType() == G_CYC_2CYCLE && !mode.forceBlend() &&
+        renderBlenderApproximation(flags) == 0 &&
+        Blender::usesStandardFogCycle(mode.blenderInputs(), 0) &&
+        Blender::decodeInputP(mode.blenderInputs(), true) == Blender::PM_CC_OR_BLENDER;
+}
+
+float3 bumbleComposeSurfaceFog(OtherMode mode, RenderFlags flags,
+    Blender::Inputs inputs, float3 litSurface, float combinerAlpha) {
+    // Use the native blender to preserve rounding and overflow.
+    return Blender::run(mode, flags, inputs, float4(litSurface, combinerAlpha), false).rgb;
+}

diff --git a/src/shaders/BumbleShadowReceiver.hlsli b/src/shaders/BumbleShadowReceiver.hlsli
new file mode 100644
--- /dev/null
+++ b/src/shaders/BumbleShadowReceiver.hlsli
@@ -0,0 +1,31 @@
+#pragma once
+
+float2 bumbleShadowDepthGradient(float3 dx, float3 dy) {
+    const float determinant = dx.x * dy.y - dx.y * dy.x;
+    const float scale = abs(dx.x * dy.y) + abs(dx.y * dy.x);
+    if (abs(determinant) <= max(scale * 1.0e-6f, 1.0e-30f)) {
+        return 0.0f;
+    }
+    return float2(dy.y * dx.z - dx.y * dy.z,
+        dx.x * dy.z - dy.x * dx.z) / determinant;
+}
+
+float bumbleShadowReceiverVisibility(float4 depths, float3 coordinate,
+    float2 inverseSize, float2 depthGradient, float bias, bool bilinear) {
+    const float2 fraction = frac(coordinate.xy / inverseSize - 0.5f);
+    // HLSL Gather order: lower-left, lower-right, upper-right, upper-left.
+    const float4 offsetX = clamp(coordinate.x +
+        (float4(0, 1, 1, 0) - fraction.x) * inverseSize.x,
+        inverseSize.x * 0.5f, 1.0f - inverseSize.x * 0.5f) - coordinate.x;
+    const float4 offsetY = clamp(coordinate.y +
+        (float4(1, 1, 0, 0) - fraction.y) * inverseSize.y,
+        inverseSize.y * 0.5f, 1.0f - inverseSize.y * 0.5f) - coordinate.y;
+    const float4 references = coordinate.z - bias +
+        depthGradient.x * offsetX + depthGradient.y * offsetY;
+    const float4 visible = float4(references <= depths);
+    if (bilinear) {
+        return lerp(lerp(visible.w, visible.z, fraction.x),
+            lerp(visible.x, visible.y, fraction.x), fraction.y);
+    }
+    return dot(visible, 0.25f.xxxx);
+}
