+    void PerformanceProfiler::startDisplayObservation(
+        void *nativeWindow,
+        uint32_t presentationQueueCapacity
+    ) {
+        ProfilerState &profiler = state();
+        if (!profiler.accepting.load(std::memory_order_acquire)) {
+            return;
+        }
+        startHostObservation();
+#ifdef _WIN32
+        if (nativeWindow == nullptr) {
+            return;
+        }
+
+        if (profiler.lowOverhead &&
+            !parseEnabledFlag("RT64_PROFILE_EXTERNAL_DISPLAY_OBSERVATION")) {
+            PerformanceProfiler::setMetadata(
+                "desktop_output_observation",
+                "disabled_in_low_overhead"
+            );
+            PerformanceProfiler::setMetadata(
+                "display_vblank_observation",
+                "disabled_in_low_overhead"
+            );
+            return;
+        }
+
+        const std::scoped_lock startLock(
+            profiler.displayObservationMutex
+        );
+        if (profiler.displayObservationThread.joinable()) {
+            return;
+        }
+
+        profiler.displayObservationRunning.store(
+            true,
+            std::memory_order_release
+        );
+        profiler.estimatedDisplayQueueDepth.store(
+            0,
+            std::memory_order_relaxed
+        );
+        profiler.estimatedDisplayQueueCapacity =
+            std::max(presentationQueueCapacity, 1u);
+        profiler.displayObservationThread = std::thread(
+            [nativeWindow]() {
+                PerformanceProfiler::setThreadName(
+                    "RT64 Desktop Output Observation"
+                );
+                ProfilerState &threadProfiler = state();
+                const HMONITOR targetMonitor = MonitorFromWindow(
+                    static_cast<HWND>(nativeWindow),
+                    MONITOR_DEFAULTTONEAREST
+                );
+
+                IDXGIFactory1 *factory = nullptr;
+                IDXGIAdapter1 *selectedAdapter = nullptr;
+                IDXGIOutput *selectedOutput = nullptr;
+                ID3D11Device *device = nullptr;
+                ID3D11DeviceContext *deviceContext = nullptr;
+                IDXGIOutput1 *output1 = nullptr;
+                IDXGIOutputDuplication *duplication = nullptr;
+
+                HRESULT result = CreateDXGIFactory1(
+                    __uuidof(IDXGIFactory1),
+                    reinterpret_cast<void **>(&factory)
+                );
+                if (SUCCEEDED(result)) {
+                    for (UINT adapterIndex = 0;
+                         selectedOutput == nullptr;
+                         adapterIndex++) {
+                        IDXGIAdapter1 *adapter = nullptr;
+                        if (factory->EnumAdapters1(
+                                adapterIndex,
+                                &adapter
+                            ) == DXGI_ERROR_NOT_FOUND) {
+                            break;
+                        }
+                        for (UINT outputIndex = 0;; outputIndex++) {
+                            IDXGIOutput *output = nullptr;
+                            if (adapter->EnumOutputs(
+                                    outputIndex,
+                                    &output
+                                ) == DXGI_ERROR_NOT_FOUND) {
+                                break;
+                            }
+                            DXGI_OUTPUT_DESC outputDescription = {};
+                            if (SUCCEEDED(output->GetDesc(
+                                    &outputDescription
+                                )) &&
+                                outputDescription.Monitor == targetMonitor) {
+                                selectedAdapter = adapter;
+                                selectedOutput = output;
+                                break;
+                            }
+                            output->Release();
+                        }
+                        if (selectedOutput == nullptr) {
+                            adapter->Release();
+                        }
+                    }
+                }
+
+                if (selectedAdapter != nullptr &&
+                    selectedOutput != nullptr) {
+                    const D3D_FEATURE_LEVEL featureLevels[] = {
+                        D3D_FEATURE_LEVEL_11_1,
+                        D3D_FEATURE_LEVEL_11_0,
+                        D3D_FEATURE_LEVEL_10_1,
+                        D3D_FEATURE_LEVEL_10_0
+                    };
+                    D3D_FEATURE_LEVEL selectedFeatureLevel =
+                        D3D_FEATURE_LEVEL_10_0;
+                    result = D3D11CreateDevice(
+                        selectedAdapter,
+                        D3D_DRIVER_TYPE_UNKNOWN,
+                        nullptr,
+                        D3D11_CREATE_DEVICE_BGRA_SUPPORT,
+                        featureLevels,
+                        UINT(std::size(featureLevels)),
+                        D3D11_SDK_VERSION,
+                        &device,
+                        &selectedFeatureLevel,
+                        &deviceContext
+                    );
+                    if (result == E_INVALIDARG) {
+                        result = D3D11CreateDevice(
+                            selectedAdapter,
+                            D3D_DRIVER_TYPE_UNKNOWN,
+                            nullptr,
+                            D3D11_CREATE_DEVICE_BGRA_SUPPORT,
+                            featureLevels + 1,
+                            UINT(std::size(featureLevels) - 1),
+                            D3D11_SDK_VERSION,
+                            &device,
+                            &selectedFeatureLevel,
+                            &deviceContext
+                        );
+                    }
+                }
+                if (SUCCEEDED(result) && selectedOutput != nullptr) {
+                    result = selectedOutput->QueryInterface(
+                        __uuidof(IDXGIOutput1),
+                        reinterpret_cast<void **>(&output1)
+                    );
+                }
+                if (SUCCEEDED(result) && output1 != nullptr) {
+                    result = output1->DuplicateOutput(device, &duplication);
+                }
+
+                PerformanceProfiler::setMetadata(
+                    "desktop_output_observation",
+                    (SUCCEEDED(result) && duplication != nullptr)
+                        ? "dxgi_output_duplication"
+                        : "unavailable_hresult_" + std::to_string(
+                            uint32_t(result)
+                        )
+                );
+                PerformanceProfiler::setMetadata(
+                    "display_vblank_observation",
+                    "dwm_composition_timing_fifo_queue_model"
+                );
+
+                LARGE_INTEGER performanceFrequency = {};
+                QueryPerformanceFrequency(&performanceFrequency);
+                int64_t previousPresentTime = 0;
+                int64_t previousVBlankTime = 0;
+                uint64_t previousRefreshCount = 0;
+                int64_t lastEstimatedDisplayTime = 0;
+                uint64_t desktopObservationSequence = 0;
+                uint64_t vblankObservationSequence = 0;
+                uint64_t desktopFramesAcquired = 0;
+                uint64_t desktopPresentTimestamps = 0;
+                uint64_t displayQueueUnderruns = 0;
+                uint64_t nextDuplicationRetryNanoseconds = 0;
+                while (threadProfiler.displayObservationRunning.load(
+                    std::memory_order_acquire
+                )) {
+                    if (duplication == nullptr && output1 != nullptr &&
+                        device != nullptr) {
+                        const uint64_t nowNanoseconds =
+                            PerformanceProfiler::nowNanoseconds();
+                        if (nowNanoseconds >=
+                            nextDuplicationRetryNanoseconds) {
+                            result = output1->DuplicateOutput(
+                                device,
+                                &duplication
+                            );
+                            nextDuplicationRetryNanoseconds =
+                                nowNanoseconds + 1'000'000'000ULL;
+                            if (SUCCEEDED(result) && duplication != nullptr) {
+                                previousPresentTime = 0;
+                                PerformanceProfiler::setMetadata(
+                                    "desktop_output_observation",
+                                    "dxgi_output_duplication_recovered"
+                                );
+                            }
+                        }
+                    }
+
+                    if (duplication != nullptr) {
+                        DXGI_OUTDUPL_FRAME_INFO frameInfo = {};
+                        IDXGIResource *desktopResource = nullptr;
+                        result = duplication->AcquireNextFrame(
+                            8,
+                            &frameInfo,
+                            &desktopResource
+                        );
+                        if (SUCCEEDED(result)) {
+                            desktopFramesAcquired++;
+                            const int64_t presentTime =
+                                frameInfo.LastPresentTime.QuadPart;
+                            if (presentTime > previousPresentTime &&
+                                previousPresentTime != 0 &&
+                                performanceFrequency.QuadPart > 0) {
+                                desktopPresentTimestamps++;
+                                const uint32_t accumulatedFrames = std::max(
+                                    frameInfo.AccumulatedFrames,
+                                    1u
+                                );
+                                const long double intervalNanoseconds =
+                                    (static_cast<long double>(presentTime -
+                                        previousPresentTime) *
+                                        1'000'000'000.0L) /
+                                    (static_cast<long double>(
+                                        performanceFrequency.QuadPart
+                                    ) * static_cast<long double>(
+                                        accumulatedFrames
+                                    ));
+                                const uint64_t boundedIntervalNanoseconds =
+                                    uint64_t(std::clamp<long double>(
+                                        intervalNanoseconds,
+                                        0.0L,
+                                        static_cast<long double>(
+                                            std::numeric_limits<uint64_t>::max()
+                                        )
+                                    ));
+                                const uint64_t observationTime =
+                                    PerformanceProfiler::nowNanoseconds();
+                                PerformanceProfiler::recordDuration(
+                                    PerformanceCategory::Pacing,
+                                    "Present.DesktopOutputChangeInterval",
+                                    observationTime >
+                                        boundedIntervalNanoseconds
+                                        ? observationTime -
+                                            boundedIntervalNanoseconds
+                                        : 0,
+                                    observationTime,
+                                    ++desktopObservationSequence,
+                                    accumulatedFrames,
+                                    frameInfo.ProtectedContentMaskedOut
+                                        ? 1u
+                                        : 0u
+                                );
+                            }
+                            if (presentTime != 0) {
+                                previousPresentTime = presentTime;
+                            }
+                            if (desktopResource != nullptr) {
+                                desktopResource->Release();
+                            }
+                            duplication->ReleaseFrame();
+                        }
+                        else if (result != DXGI_ERROR_WAIT_TIMEOUT) {
+                            duplication->Release();
+                            duplication = nullptr;
+                            previousPresentTime = 0;
+                            PerformanceProfiler::setMetadata(
+                                "desktop_output_observation",
+                                "recovering_hresult_" + std::to_string(
+                                    uint32_t(result)
+                                )
+                            );
+                        }
+                    }
+                    else {
+                        std::this_thread::sleep_for(
+                            std::chrono::milliseconds(8)
+                        );
+                    }
+
+                    DWM_TIMING_INFO timingInfo = {};
+                    timingInfo.cbSize = sizeof(timingInfo);
+                    const HRESULT timingResult =
+                        DwmGetCompositionTimingInfo(nullptr, &timingInfo);
+                    const int64_t currentVBlankTime =
+                        timingInfo.qpcVBlank;
+                    const uint64_t currentRefreshCount =
+                        timingInfo.cRefresh;
+                    if (SUCCEEDED(timingResult) &&
+                        performanceFrequency.QuadPart > 0 &&
+                        currentVBlankTime > previousVBlankTime &&
+                        previousVBlankTime != 0) {
+                        uint64_t refreshCount =
+                            currentRefreshCount > previousRefreshCount
+                                ? currentRefreshCount - previousRefreshCount
+                                : 0u;
+                        if (refreshCount == 0u) {
+                            const int64_t refreshPeriod =
+                                std::max<int64_t>(
+                                    timingInfo.qpcRefreshPeriod,
+                                    1
+                                );
+                            refreshCount = uint64_t(std::max<int64_t>(
+                                (currentVBlankTime - previousVBlankTime +
+                                    (refreshPeriod / 2)) / refreshPeriod,
+                                1
+                            ));
+                        }
+
+                        const uint32_t boundedRefreshCount = uint32_t(
+                            std::min<uint64_t>(
+                                refreshCount,
+                                std::numeric_limits<uint32_t>::max()
+                            )
+                        );
+                        uint32_t queueDepth =
+                            threadProfiler.estimatedDisplayQueueDepth.load(
+                                std::memory_order_acquire
+                            );
+                        uint32_t consumedFrames = 0;
+                        do {
+                            consumedFrames = std::min(
+                                queueDepth,
+                                boundedRefreshCount
+                            );
+                        } while (!threadProfiler.estimatedDisplayQueueDepth
+                            .compare_exchange_weak(
+                                queueDepth,
+                                queueDepth - consumedFrames,
+                                std::memory_order_acq_rel,
+                                std::memory_order_acquire
+                            ));
+                        const uint32_t underrunFrames =
+                            boundedRefreshCount - consumedFrames;
+                        displayQueueUnderruns += underrunFrames;
+
+                        const uint64_t intervalNanoseconds = uint64_t(
+                            (static_cast<long double>(
+                                currentVBlankTime - previousVBlankTime
+                            ) * 1'000'000'000.0L) /
+                            (static_cast<long double>(
+                                performanceFrequency.QuadPart
+                            ) * static_cast<long double>(refreshCount))
+                        );
+                        const uint64_t observationTime =
+                            PerformanceProfiler::nowNanoseconds();
+                        PerformanceProfiler::recordDuration(
+                            PerformanceCategory::Pacing,
+                            "Present.DisplayVBlankInterval",
+                            observationTime > intervalNanoseconds
+                                ? observationTime - intervalNanoseconds
+                                : 0,
+                            observationTime,
+                            ++vblankObservationSequence,
+                            queueDepth,
+                            underrunFrames
+                        );
+
+                        if (consumedFrames > 0u) {
+                            if (lastEstimatedDisplayTime != 0) {
+                                const uint64_t displayedIntervalNanoseconds =
+                                    uint64_t(
+                                        (static_cast<long double>(
+                                            currentVBlankTime -
+                                            lastEstimatedDisplayTime
+                                        ) * 1'000'000'000.0L) /
+                                        static_cast<long double>(
+                                            performanceFrequency.QuadPart
+                                        )
+                                    );
+                                PerformanceProfiler::recordDuration(
+                                    PerformanceCategory::Pacing,
+                                    "Present.EstimatedDisplayedFrameInterval",
+                                    observationTime >
+                                        displayedIntervalNanoseconds
+                                        ? observationTime -
+                                            displayedIntervalNanoseconds
+                                        : 0,
+                                    observationTime,
+                                    vblankObservationSequence,
+                                    queueDepth,
+                                    underrunFrames
+                                );
+                            }
+                            lastEstimatedDisplayTime = currentVBlankTime;
+                        }
+                        else if (underrunFrames > 0u) {
+                            PerformanceProfiler::recordInstant(
+                                PerformanceCategory::Pacing,
+                                "Present.DisplayQueueUnderrun",
+                                vblankObservationSequence,
+                                underrunFrames,
+                                queueDepth
+                            );
+                        }
+                    }
+                    if (SUCCEEDED(timingResult) &&
+                        currentVBlankTime > 0) {
+                        previousVBlankTime = currentVBlankTime;
+                        previousRefreshCount = currentRefreshCount;
+                    }
+                }
+
+                PerformanceProfiler::setMetadata(
+                    "desktop_output_frames_acquired",
+                    std::to_string(desktopFramesAcquired)
+                );
+                PerformanceProfiler::setMetadata(
+                    "desktop_output_present_timestamps",
+                    std::to_string(desktopPresentTimestamps)
+                );
+                PerformanceProfiler::setMetadata(
+                    "display_queue_model_underruns",
+                    std::to_string(displayQueueUnderruns)
+                );
+
+                if (duplication != nullptr) duplication->Release();
+                if (output1 != nullptr) output1->Release();
+                if (deviceContext != nullptr) deviceContext->Release();
+                if (device != nullptr) device->Release();
+                if (selectedOutput != nullptr) selectedOutput->Release();
+                if (selectedAdapter != nullptr) selectedAdapter->Release();
+                if (factory != nullptr) factory->Release();
+                threadProfiler.displayObservationRunning.store(
+                    false,
+                    std::memory_order_release
+                );
+            }
+        );
+#else
+        (void)(nativeWindow);
+        (void)(presentationQueueCapacity);
+#endif
+    }
+
+    void PerformanceProfiler::noteDisplaySubmission() {
+#ifdef _WIN32
+        ProfilerState &profiler = state();
+        if (!profiler.accepting.load(std::memory_order_acquire) ||
+            !profiler.displayObservationRunning.load(
+                std::memory_order_acquire
+            )) {
+            return;
+        }
+
+        uint32_t queueDepth = profiler.estimatedDisplayQueueDepth.load(
+            std::memory_order_acquire
+        );
+        const uint32_t queueCapacity = std::max(
+            profiler.estimatedDisplayQueueCapacity,
+            1u
+        );
+        while (queueDepth < queueCapacity &&
+            !profiler.estimatedDisplayQueueDepth.compare_exchange_weak(
+                queueDepth,
+                queueDepth + 1u,
+                std::memory_order_acq_rel,
+                std::memory_order_acquire
+            )) {
+        }
+#endif
+    }
+
+    uint64_t PerformanceProfiler::nowNanoseconds() {
+        const ProfilerState &profiler = state();
+        if (!profiler.accepting.load(std::memory_order_acquire)) {
+            return 0;
+        }
+        return uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+            Clock::now() - profiler.origin
+        ).count());
+    }
+
+    uint64_t PerformanceProfiler::currentThreadCpuNanoseconds() {
+#ifdef _WIN32
+        FILETIME creationTime{};
+        FILETIME exitTime{};
+        FILETIME kernelTime{};
+        FILETIME userTime{};
+        if (!GetThreadTimes(
+                GetCurrentThread(),
+                &creationTime,
+                &exitTime,
+                &kernelTime,
+                &userTime
+            )) {
+            return 0;
+        }
+        ULARGE_INTEGER kernel{};
+        kernel.LowPart = kernelTime.dwLowDateTime;
+        kernel.HighPart = kernelTime.dwHighDateTime;
+        ULARGE_INTEGER user{};
+        user.LowPart = userTime.dwLowDateTime;
+        user.HighPart = userTime.dwHighDateTime;
+        return (kernel.QuadPart + user.QuadPart) * 100u;
+#elif defined(__linux__)
+        timespec value{};
+        if (clock_gettime(CLOCK_THREAD_CPUTIME_ID, &value) != 0) {
+            return 0;
+        }
+        return uint64_t(value.tv_sec) * 1'000'000'000ULL +
+            uint64_t(value.tv_nsec);
+#else
+        return 0;
+#endif
+    }
+
+    bool PerformanceProfiler::shouldMeasureThreadCpu(std::string_view name) {
+        return (name == "Application.ProcessDisplayLists") ||
+            (name == "State.FullSync") ||
+            (name == "Workload.InterpolationBatch") ||
+            (name == "Renderer.Frame") ||
+            (name == "Present.CommandBuildAndSubmit");
+    }
+
+    void PerformanceProfiler::setThreadName(std::string_view name) {
+        ThreadBuffer *buffer = threadBuffer();
+        if (buffer != nullptr) {
+            buffer->name.assign(name.data(), name.size());
+        }
+    }
+
+    void PerformanceProfiler::setMetadata(
+        std::string_view key,
+        std::string_view value
+    ) {
+        ProfilerState &profiler = state();
+        if (!profiler.accepting.load(std::memory_order_acquire)) {
+            return;
+        }
+
+        const std::scoped_lock lock(profiler.metadataMutex);
+        profiler.metadata[std::string(key)] = std::string(value);
+    }
+
+    void PerformanceProfiler::recordDuration(
+        PerformanceCategory category,
+        std::string_view name,
+        uint64_t startNanoseconds,
+        uint64_t endNanoseconds,
+        uint64_t correlationId,
+        uint64_t argument0,
+        uint64_t argument1
+    ) {
+        if (!shouldRecordDuration(name)) {
+            return;
+        }
+
+        recordAcceptedDuration(
+            category,
+            name,
+            startNanoseconds,
+            endNanoseconds,
+            correlationId,
+            argument0,
+            argument1
+        );
+    }
+
+    void PerformanceProfiler::recordAcceptedDuration(
+        PerformanceCategory category,
+        std::string_view name,
+        uint64_t startNanoseconds,
+        uint64_t endNanoseconds,
+        uint64_t correlationId,
+        uint64_t argument0,
+        uint64_t argument1,
+        uint64_t threadCpuDurationNanoseconds,
+        bool threadCpuMeasured
+    ) {
+        if (endNanoseconds < startNanoseconds) {
+            return;
+        }
+
+        const uint64_t durationNanoseconds =
+            endNanoseconds - startNanoseconds;
+        ProfilerState &profiler = state();
+        if (profiler.lowOverhead) {
+            const bool retainEverySample =
+                (name == "FrameProduction.ScreenUpdateActionWork") ||
+                (name == "FrameProduction.GraphicsTaskActionWork") ||
+                (name == "FrameProduction.RuntimeVIInterval") ||
+                (name == "FrameProduction.GuestGraphicsTaskInterval") ||
+                (name == "FrameProduction.GuestGraphicsWaitAfterCompletion") ||
+                (name == "FrameProduction.PresentQueueStarvation") ||
+                (name == "Workload.InterpolationBatch") ||
+                (name == "Renderer.Frame") ||
+                (name == "Present.ActualScanoutInterval") ||
+                (name == "Present.DesktopOutputChangeInterval") ||
+                (name == "Present.DisplayVBlankInterval") ||
+                (name == "Present.EstimatedDisplayedFrameInterval") ||
+                (name == "Present.PresentWaitCompletionInterval") ||
+                (name ==
+                    "Present.SwapChainImageReleaseObservationInterval");
+            if (!retainEverySample &&
+                (durationNanoseconds <
+                    profiler.lowOverheadMinimumDurationNanoseconds)) {
+                return;
+            }
+
+            Event event;
+            copyEventName(event, name);
+            event.timestampNanoseconds = startNanoseconds;
+            event.durationNanoseconds = durationNanoseconds;
+            event.threadCpuDurationNanoseconds =
+                threadCpuDurationNanoseconds;
+            event.threadCpuMeasured = threadCpuMeasured;
+            event.correlationId = correlationId;
+            event.argument0 = argument0;
+            event.argument1 = argument1;
+            event.category = category;
+            event.kind = EventKind::Duration;
+            appendEvent(std::move(event));
+            return;
+        }
+
+        const bool presentationCriticalRecord =
+            (name.substr(0, 8) == "Present.") ||
+            (name == "RenderWorker.QueueMutexWait") ||
+            (name == "RenderWorker.QueueSubmitWithSemaphores") ||
+            (name == "Renderer.InterpolationBatchFenceDrain") ||
+            (name == "Renderer.InterpolationWorkerReuseWait") ||
+            (name == "Workload.InterpolationTargetWait") ||
+            (name == "Workload.PresentationQueueHandoff") ||
+            (name == "Workload.PresentationTargetClaimWait") ||
+            (name == "Workload.PresentationEventQueueWait") ||
+            (name == "Workload.PresentationSetCommitWait") ||
+            (name == "Workload.FirstPresentationQueueWait") ||
+            (name == "Workload.PreviousPresentWait");
+        const bool timingCriticalRecord =
+            (name == "Present.ActualScanoutInterval") ||
+            (name == "Present.DesktopOutputChangeInterval") ||
+            (name == "Present.DisplayVBlankInterval") ||
+            (name == "Present.EstimatedDisplayedFrameInterval") ||
+            (name == "Present.PresentWaitCompletionInterval") ||
+            (name ==
+                "Present.SwapChainImageReleaseObservationInterval") ||
+            (name == "FrameProduction.ScreenUpdateActionQueueDelay") ||
+            (name == "FrameProduction.GraphicsTaskActionQueueDelay") ||
+            (name == "FrameProduction.ScreenUpdateActionWork") ||
+            (name == "FrameProduction.GraphicsTaskActionWork") ||
+            (name == "FrameProduction.WorkloadProducerBackpressure") ||
+            (name == "Workload.InterpolationBatch");
+        const bool alwaysRecord = timingCriticalRecord ||
+            presentationCriticalRecord ||
+            category == PerformanceCategory::GPU ||
+            category == PerformanceCategory::Compile ||
+            category == PerformanceCategory::IO;
+        if (!alwaysRecord &&
+            durationNanoseconds < state().minimumDurationNanoseconds) {
+            return;
+        }
+
+        if (!alwaysRecord &&
+            durationNanoseconds < state().slowDurationNanoseconds) {
+            const uint64_t durationInterval = state().durationInterval;
+            thread_local uint64_t routineDurationSequence = 0;
+            const uint64_t sampleKey = correlationId != 0
+                ? correlationId
+                : ++routineDurationSequence;
+            if ((sampleKey % durationInterval) != 0) {
+                return;
+            }
+        }
+
+        Event event;
+        copyEventName(event, name);
+        event.timestampNanoseconds = startNanoseconds;
+        event.durationNanoseconds = durationNanoseconds;
+        event.threadCpuDurationNanoseconds = threadCpuDurationNanoseconds;
+        event.threadCpuMeasured = threadCpuMeasured;
+        event.correlationId = correlationId;
+        event.argument0 = argument0;
+        event.argument1 = argument1;
+        event.category = category;
+        event.kind = EventKind::Duration;
+        appendEvent(std::move(event));
+    }
+
+    void PerformanceProfiler::recordGPUDuration(
+        std::string_view name,
+        uint64_t gpuStartNanoseconds,
+        uint64_t gpuEndNanoseconds,
+        uint64_t cpuCompletionNanoseconds,
+        uint64_t correlationId,
+        uint64_t argument0,
+        uint64_t argument1
+    ) {
+        if (!gpuInstrumentationEnabled() ||
+            (gpuEndNanoseconds < gpuStartNanoseconds)) {
+            return;
+        }
+
+        const uint64_t duration = gpuEndNanoseconds - gpuStartNanoseconds;
+        Event event;
+        copyEventName(event, name);
+        event.timestampNanoseconds = cpuCompletionNanoseconds > duration
+            ? cpuCompletionNanoseconds - duration
+            : 0;
+        event.durationNanoseconds = duration;
+        event.correlationId = correlationId;
+        event.argument0 = argument0;
+        event.argument1 = argument1;
+        event.gpuStartNanoseconds = gpuStartNanoseconds;
+        event.gpuEndNanoseconds = gpuEndNanoseconds;
+        event.category = PerformanceCategory::GPU;
+        event.kind = EventKind::Duration;
+        event.gpuClock = true;
+        appendEvent(std::move(event));
+    }
+
+    void PerformanceProfiler::recordInstant(
+        PerformanceCategory category,
+        std::string_view name,
+        uint64_t correlationId,
+        uint64_t argument0,
+        uint64_t argument1
+    ) {
+        if (!captureEnabled()) {
+            return;
+        }
+        if (lowOverheadEnabled() &&
+            (name != "Present.Submitted") &&
+            (name != "Present.Enqueued") &&
+            (name != "Present.Dequeued") &&
+            (name != "Present.InterpolationResolved") &&
+            (name != "Present.SwapChainConfigured") &&
+            (name != "Present.CompletionObservation") &&
+            (name != "Present.PendingDepthChanged") &&
+            (name != "Present.CoalescedDuplicateWorkload") &&
+            (name != "Present.ManualPacingResult") &&
+            (name != "Present.FifoRateCalibrationObservation") &&
+            (name != "Present.FifoRateCalibrated") &&
+            (name != "Workload.InterpolationDecision") &&
+            (name != "Workload.InterpolationSetPublished") &&
+            (name != "State.FullSyncEarlyPresentDecision") &&
+            (name != "Workload.InterpolationReuseBlocked") &&
+            (name != "Present.InterpolationBlocked")) {
+            return;
+        }
+
+        Event event;
+        copyEventName(event, name);
+        event.timestampNanoseconds = nowNanoseconds();
+        event.correlationId = correlationId;
+        event.argument0 = argument0;
+        event.argument1 = argument1;
+        event.category = category;
+        event.kind = EventKind::Instant;
+        appendEvent(std::move(event));
+    }
+
+    void PerformanceProfiler::recordCounter(
+        std::string_view name,
+        double value,
+        uint64_t correlationId
+    ) {
+        if (!enabled()) {
+            return;
+        }
+
+        const uint64_t counterInterval = state().counterInterval;
+        if ((correlationId != 0) &&
+            ((correlationId % counterInterval) != 0)) {
+            return;
+        }
+
+        Event event;
+        copyEventName(event, name);
+        event.timestampNanoseconds = nowNanoseconds();
+        event.correlationId = correlationId;
+        event.value = value;
+        event.category = PerformanceCategory::Counter;
+        event.kind = EventKind::Counter;
+        appendEvent(std::move(event));
+    }
+
+    void PerformanceProfiler::finish() {
+        ProfilerState &profiler = state();
+        if (profiler.outputPath.empty() ||
+            profiler.finished.exchange(true, std::memory_order_acq_rel)) {
+            return;
+        }
+
+        profiler.hostObservationRunning.store(
+            false,
+            std::memory_order_release
+        );
+        {
+            const std::scoped_lock hostObservationLock(
+                profiler.hostObservationMutex
+            );
+            if (profiler.hostObservationThread.joinable()) {
+                profiler.hostObservationThread.join();
+            }
+        }
+#ifdef _WIN32
+        profiler.displayObservationRunning.store(
+            false,
+            std::memory_order_release
+        );
+        {
+            const std::scoped_lock displayObservationLock(
+                profiler.displayObservationMutex
+            );
+            if (profiler.displayObservationThread.joinable()) {
+                profiler.displayObservationThread.join();
+            }
+        }
+#endif
+        profiler.accepting.store(false, std::memory_order_release);
+        std::vector<ThreadBuffer *> buffers;
+        {
+            const std::scoped_lock lock(profiler.registryMutex);
+            buffers = profiler.threadBuffers;
+        }
+        {
+            const std::scoped_lock lock(profiler.metadataMutex);
+            const bool summaryWritten = writeSummary(profiler, buffers);
+            const bool traceWritten = writeTrace(profiler, buffers);
+            std::fprintf(
+                stderr,
+                "RT64_PROFILE finished=1 trace_written=%d summary_written=%d events=%llu dropped=%llu trace=%s summary=%s\n",
+                traceWritten ? 1 : 0,
+                summaryWritten ? 1 : 0,
+                static_cast<unsigned long long>(recordedEventCount(buffers)),
+                static_cast<unsigned long long>(
+                    droppedEventCount(profiler, buffers)
+                ),
+                profiler.outputPath.string().c_str(),
+                profiler.summaryPath.string().c_str()
+            );
+            std::fflush(stderr);
+        }
+    }
+
+    PerformanceScope::PerformanceScope(
+        PerformanceCategory category,
+        std::string_view name,
+        uint64_t correlationId,
+        uint64_t argument0,
+        uint64_t argument1
+    )
+        : category(category),
+          name(name),
+          correlationId(correlationId),
+          argument0(argument0),
+          argument1(argument1),
+          active(PerformanceProfiler::shouldRecordDuration(name)) {
+        if (active) {
+            startNanoseconds = PerformanceProfiler::nowNanoseconds();
+            measureThreadCpu =
+                PerformanceProfiler::shouldMeasureThreadCpu(name);
+            if (measureThreadCpu) {
+                startThreadCpuNanoseconds =
+                    PerformanceProfiler::currentThreadCpuNanoseconds();
+                threadCpuMeasurementAvailable =
+                    startThreadCpuNanoseconds > 0;
+            }
+        }
+    }
+
+    PerformanceScope::~PerformanceScope() {
+        end();
+    }
+
+    void PerformanceScope::end() {
+        if (active) {
+            uint64_t threadCpuDurationNanoseconds = 0;
+            if (threadCpuMeasurementAvailable) {
+                const uint64_t endThreadCpuNanoseconds =
+                    PerformanceProfiler::currentThreadCpuNanoseconds();
+                if ((startThreadCpuNanoseconds > 0) &&
+                    (endThreadCpuNanoseconds >=
+                        startThreadCpuNanoseconds)) {
+                    threadCpuDurationNanoseconds =
+                        endThreadCpuNanoseconds -
+                        startThreadCpuNanoseconds;
+                }
+                else {
+                    threadCpuMeasurementAvailable = false;
+                }
+            }
+            PerformanceProfiler::recordAcceptedDuration(
+                category,
+                name,
+                startNanoseconds,
+                PerformanceProfiler::nowNanoseconds(),
+                correlationId,
+                argument0,
+                argument1,
+                threadCpuDurationNanoseconds,
+                threadCpuMeasurementAvailable
+            );
+            active = false;
+        }
+    }
+}
diff --git a/src/common/rt64_performance_profiler.h b/src/common/rt64_performance_profiler.h
