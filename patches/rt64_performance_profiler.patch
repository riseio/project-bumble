+                output << "    {\"category\":\"" << categoryName(entry.category)
+                    << "\",\"name\":\"" << jsonEscape(entry.name)
+                    << "\",\"count\":" << entry.milliseconds.size()
+                    << ",\"mean_ms\":"
+                    << (entry.totalMilliseconds / double(entry.milliseconds.size()))
+                    << ",\"p50_ms\":" << percentile(entry.milliseconds, 0.50)
+                    << ",\"p95_ms\":" << percentile(entry.milliseconds, 0.95)
