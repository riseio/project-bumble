+
+        bool readLinuxSystemCpu(uint64_t &total, uint64_t &idle) {
+            std::ifstream input("/proc/stat");
+            std::string label;
+            uint64_t user = 0, nice = 0, system = 0, idleValue = 0;
+            uint64_t ioWait = 0, irq = 0, softIrq = 0, steal = 0;
+            if (!(input >> label >> user >> nice >> system >> idleValue >>
+                    ioWait >> irq >> softIrq >> steal) || label != "cpu") {
+                return false;
+            }
+            idle = idleValue + ioWait;
+            total = user + nice + system + idleValue + ioWait + irq +
+                softIrq + steal;
+            return true;
+        }
+
+        bool readLinuxProcess(uint32_t processId, uint64_t &cpuTicks,
+            std::string &name, double &workingSetMiB, long pageSize) {
+            const std::string root = "/proc/" + std::to_string(processId);
+            std::ifstream stat(root + "/stat");
+            std::string line;
+            if (!std::getline(stat, line)) {
+                return false;
+            }
+            const size_t nameBegin = line.find('(');
+            const size_t nameEnd = line.rfind(')');
+            if (nameBegin == std::string::npos ||
+                nameEnd == std::string::npos || nameEnd <= nameBegin) {
+                return false;
+            }
+            name = hostCounterProcessName(
+                std::string_view(line).substr(
+                    nameBegin + 1u,
+                    nameEnd - nameBegin - 1u
+                )
+            );
+            std::istringstream fields(line.substr(nameEnd + 2u));
+            std::vector<std::string> values;
+            std::string value;
+            while (fields >> value) {
+                values.emplace_back(std::move(value));
+            }
+            if (values.size() <= 12u) {
+                return false;
+            }
+            try {
+                // The token after ')' is field 3 (state); utime/stime are fields 14 and 15, therefore indices 11 and 12 here.
+                cpuTicks = std::stoull(values[11]) +
+                    std::stoull(values[12]);
+            }
+            catch (...) {
+                return false;
+            }
+            std::ifstream statm(root + "/statm");
+            uint64_t totalPages = 0, residentPages = 0;
+            if (statm >> totalPages >> residentPages) {
+                workingSetMiB = double(residentPages) * double(pageSize) /
+                    (1024.0 * 1024.0);
+            }
+            return true;
+        }
+
+        bool sampleHostResources(HostResourceSamplerState &sampler,
+            double elapsedSeconds, HostResourceSnapshot &snapshot) {
+            uint64_t systemTotal = 0, systemIdle = 0;
+            if (readLinuxSystemCpu(systemTotal, systemIdle)) {
+                const uint64_t totalDelta = systemTotal -
+                    sampler.previousSystemTotal;
+                const uint64_t idleDelta = systemIdle -
+                    sampler.previousSystemIdle;
+                if (sampler.previousSystemTotal != 0u && totalDelta > 0u) {
+                    snapshot.systemCpuPercent = std::clamp(
+                        (double(totalDelta - std::min(idleDelta, totalDelta)) /
+                            double(totalDelta)) * 100.0,
+                        0.0,
+                        100.0
+                    );
+                }
+                sampler.previousSystemTotal = systemTotal;
+                sampler.previousSystemIdle = systemIdle;
+            }
+            std::ifstream memory("/proc/meminfo");
+            std::string key, unit;
+            uint64_t memoryValue = 0;
+            while (memory >> key >> memoryValue >> unit) {
+                if (key == "MemAvailable:") {
+                    snapshot.availableMemoryMiB =
+                        double(memoryValue) / 1024.0;
+                    break;
+                }
+            }
+            std::unordered_map<uint32_t, uint64_t> currentProcessCpu;
+            DIR *directory = opendir("/proc");
+            if (directory == nullptr) {
+                return false;
+            }
+            const uint32_t currentProcessId = uint32_t(getpid());
+            for (dirent *entry = readdir(directory);
+                 entry != nullptr;
+                 entry = readdir(directory)) {
+                char *end = nullptr;
+                const unsigned long parsed = std::strtoul(
+                    entry->d_name,
+                    &end,
+                    10
+                );
+                if (end == entry->d_name || *end != '\0' || parsed == 0u) {
+                    continue;
+                }
+                const uint32_t processId = uint32_t(parsed);
+                uint64_t cpuTicks = 0;
+                std::string name;
+                double workingSetMiB = 0.0;
+                if (!readLinuxProcess(
+                        processId,
+                        cpuTicks,
+                        name,
+                        workingSetMiB,
+                        sampler.pageSize
+                    )) {
+                    continue;
+                }
+                currentProcessCpu[processId] = cpuTicks;
+                const auto previous = sampler.previousProcessCpu.find(
+                    processId
+                );
+                if (processId == currentProcessId ||
+                    previous == sampler.previousProcessCpu.end() ||
+                    cpuTicks < previous->second) {
+                    continue;
+                }
+                HostProcessUsage usage;
+                usage.processId = processId;
+                usage.name = std::move(name);
+                usage.cpuPercent = std::clamp(
+                    (double(cpuTicks - previous->second) /
+                        (elapsedSeconds * double(sampler.clockTicks) *
+                            double(sampler.logicalProcessorCount))) * 100.0,
+                    0.0,
+                    100.0
+                );
+                usage.workingSetMiB = workingSetMiB;
+                snapshot.externalCpuPercent += usage.cpuPercent;
+                if (usage.cpuPercent >= 0.25 || workingSetMiB >= 256.0) {
+                    snapshot.processes.emplace_back(std::move(usage));
+                }
+            }
+            closedir(directory);
+            sampler.previousProcessCpu = std::move(currentProcessCpu);
+            return true;
+        }
+#endif
