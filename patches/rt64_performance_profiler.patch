+    build_shader_spirv(rt64 "src/shaders/RasterPS.hlsl" "${DXC_PS_OPTS}" "${BUMBLE_FAMILY_PREFIX}Flat.hlsl" "-D SPEC_CONSTANT_RENDER_PARAMS" "${BUMBLE_FAMILY_DEFINE}" "-D VERTEX_FLAT_COLOR")
