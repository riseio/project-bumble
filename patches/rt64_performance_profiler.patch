+            output << "]},\n";
+            output << "  \"gpu_draw_breakdown\": {\"available\":"
+                << (!drawBreakdown.empty() ? "true" : "false")
+                << ",\"entries\":[";
+            for (size_t i = 0; i < drawBreakdown.size(); i++) {
+                const Statistics &entry = *drawBreakdown[i];
+                if (i > 0) {
+                    output << ',';
+                }
+                output << "{\"name\":\"" << jsonEscape(entry.name)
+                    << "\",\"count\":" << entry.milliseconds.size()
+                    << ",\"total_ms\":" << entry.totalMilliseconds
+                    << ",\"mean_ms\":"
+                    << (entry.totalMilliseconds /
