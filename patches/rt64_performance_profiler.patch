+#ifdef _WIN32
+        uint64_t fileTimeValue(const FILETIME &value) {
+            ULARGE_INTEGER integer{};
+            integer.LowPart = value.dwLowDateTime;
+            integer.HighPart = value.dwHighDateTime;
+            return integer.QuadPart;
+        }
+
+        struct HostResourceSamplerState {
+            std::unordered_map<uint32_t, uint64_t> previousProcessCpu;
+            uint64_t previousSystemIdle = 0;
+            uint64_t previousSystemKernel = 0;
+            uint64_t previousSystemUser = 0;
+            PDH_HQUERY gpuQuery = nullptr;
+            PDH_HCOUNTER gpuCounter = nullptr;
+            uint32_t logicalProcessorCount = std::max(
+                std::thread::hardware_concurrency(),
+                1u
+            );
+
+            HostResourceSamplerState() {
+                FILETIME idle{}, kernel{}, user{};
+                if (GetSystemTimes(&idle, &kernel, &user)) {
+                    previousSystemIdle = fileTimeValue(idle);
+                    previousSystemKernel = fileTimeValue(kernel);
+                    previousSystemUser = fileTimeValue(user);
+                }
+                if ((PdhOpenQueryW(nullptr, 0, &gpuQuery) == ERROR_SUCCESS) &&
+                    (PdhAddEnglishCounterW(
+                        gpuQuery,
+                        L"\\GPU Engine(*)\\Utilization Percentage",
+                        0,
+                        &gpuCounter
+                    ) == ERROR_SUCCESS)) {
+                    PdhCollectQueryData(gpuQuery);
+                }
+                else {
+                    gpuCounter = nullptr;
+                }
+            }
+
+            ~HostResourceSamplerState() {
+                if (gpuQuery != nullptr) {
+                    PdhCloseQuery(gpuQuery);
+                }
+            }
+        };
+
+        std::unordered_map<uint32_t, double> sampleWindowsGPU(
+            HostResourceSamplerState &sampler) {
+            std::unordered_map<uint32_t, double> usageByProcess;
+            if (sampler.gpuCounter == nullptr ||
+                PdhCollectQueryData(sampler.gpuQuery) != ERROR_SUCCESS) {
+                return usageByProcess;
+            }
+            DWORD byteCount = 0;
+            DWORD itemCount = 0;
+            PDH_STATUS status = PdhGetFormattedCounterArrayW(
+                sampler.gpuCounter,
+                PDH_FMT_DOUBLE,
+                &byteCount,
+                &itemCount,
+                nullptr
+            );
+            if (status != PDH_MORE_DATA || byteCount == 0u) {
+                return usageByProcess;
+            }
+            std::vector<uint8_t> bytes(byteCount);
+            auto *items = reinterpret_cast<PDH_FMT_COUNTERVALUE_ITEM_W *>(
+                bytes.data()
+            );
+            status = PdhGetFormattedCounterArrayW(
+                sampler.gpuCounter,
+                PDH_FMT_DOUBLE,
+                &byteCount,
+                &itemCount,
+                items
+            );
+            if (status != ERROR_SUCCESS) {
+                return usageByProcess;
+            }
+            for (DWORD i = 0; i < itemCount; i++) {
+                const wchar_t *name = items[i].szName;
+                const wchar_t *pidText = name != nullptr
+                    ? std::wcsstr(name, L"pid_")
+                    : nullptr;
+                if (pidText == nullptr ||
+                    items[i].FmtValue.CStatus != ERROR_SUCCESS) {
+                    continue;
+                }
+                wchar_t *end = nullptr;
+                const unsigned long processId = std::wcstoul(
+                    pidText + 4,
+                    &end,
+                    10
+                );
+                if (end == pidText + 4 || processId == 0u) {
+                    continue;
+                }
+                double &processUsage = usageByProcess[uint32_t(processId)];
+                processUsage = std::max(
+                    processUsage,
+                    std::clamp(
+                        items[i].FmtValue.doubleValue,
+                        0.0,
+                        100.0
+                    )
+                );
+            }
+            return usageByProcess;
+        }
+
+        bool sampleHostResources(HostResourceSamplerState &sampler,
+            double elapsedSeconds, HostResourceSnapshot &snapshot) {
+            if (elapsedSeconds <= 0.0) {
+                return false;
+            }
+            FILETIME idle{}, kernel{}, user{};
+            if (GetSystemTimes(&idle, &kernel, &user)) {
+                const uint64_t idleValue = fileTimeValue(idle);
+                const uint64_t kernelValue = fileTimeValue(kernel);
+                const uint64_t userValue = fileTimeValue(user);
+                const uint64_t idleDelta = idleValue -
+                    sampler.previousSystemIdle;
+                const uint64_t totalDelta = (kernelValue -
+                    sampler.previousSystemKernel) + (userValue -
+                    sampler.previousSystemUser);
+                snapshot.systemCpuPercent = totalDelta > 0u
+                    ? std::clamp(
+                        (double(totalDelta - std::min(idleDelta, totalDelta)) /
+                            double(totalDelta)) * 100.0,
+                        0.0,
+                        100.0
+                    )
+                    : 0.0;
+                sampler.previousSystemIdle = idleValue;
+                sampler.previousSystemKernel = kernelValue;
+                sampler.previousSystemUser = userValue;
+            }
+            MEMORYSTATUSEX memory{};
+            memory.dwLength = sizeof(memory);
+            if (GlobalMemoryStatusEx(&memory)) {
+                snapshot.availableMemoryMiB =
+                    double(memory.ullAvailPhys) / (1024.0 * 1024.0);
+            }
+            const auto gpuUsage = sampleWindowsGPU(sampler);
+            const uint32_t currentProcessId = GetCurrentProcessId();
+            std::unordered_map<uint32_t, uint64_t> currentProcessCpu;
+            HANDLE processSnapshot = CreateToolhelp32Snapshot(
+                TH32CS_SNAPPROCESS,
+                0
+            );
+            if (processSnapshot == INVALID_HANDLE_VALUE) {
+                return false;
+            }
+            PROCESSENTRY32W entry{};
+            entry.dwSize = sizeof(entry);
+            for (BOOL available = Process32FirstW(processSnapshot, &entry);
+                 available;
+                 available = Process32NextW(processSnapshot, &entry)) {
+                const uint32_t processId = entry.th32ProcessID;
+                HANDLE process = OpenProcess(
+                    PROCESS_QUERY_LIMITED_INFORMATION | PROCESS_VM_READ,
+                    FALSE,
+                    processId
+                );
+                if (process == nullptr) {
+                    continue;
+                }
+                FILETIME creation{}, exit{}, processKernel{}, processUser{};
+                if (GetProcessTimes(
+                        process,
+                        &creation,
+                        &exit,
+                        &processKernel,
+                        &processUser
+                    )) {
+                    const uint64_t cpuValue = fileTimeValue(processKernel) +
+                        fileTimeValue(processUser);
+                    currentProcessCpu[processId] = cpuValue;
+                    const auto previous = sampler.previousProcessCpu.find(
+                        processId
+                    );
+                    if (processId != currentProcessId &&
+                        previous != sampler.previousProcessCpu.end() &&
+                        cpuValue >= previous->second) {
+                        HostProcessUsage usage;
+                        usage.processId = processId;
+                        char processName[MAX_PATH] = {};
+                        const int converted = WideCharToMultiByte(
+                            CP_UTF8,
+                            0,
+                            entry.szExeFile,
+                            -1,
+                            processName,
+                            int(std::size(processName)),
+                            nullptr,
+                            nullptr
+                        );
+                        usage.name = converted > 0
+                            ? hostCounterProcessName(processName)
+                            : "unknown";
+                        usage.cpuPercent = std::clamp(
+                            (double(cpuValue - previous->second) /
+                                (elapsedSeconds * 10'000'000.0 *
+                                    double(sampler.logicalProcessorCount))) *
+                                100.0,
+                            0.0,
+                            100.0
+                        );
+                        const auto gpu = gpuUsage.find(processId);
+                        if (gpu != gpuUsage.end()) {
+                            usage.gpuPercent = gpu->second;
+                        }
+                        PROCESS_MEMORY_COUNTERS counters{};
+                        if (GetProcessMemoryInfo(
+                                process,
+                                &counters,
+                                sizeof(counters)
+                            )) {
+                            usage.workingSetMiB =
+                                double(counters.WorkingSetSize) /
+                                    (1024.0 * 1024.0);
+                        }
+                        snapshot.externalCpuPercent += usage.cpuPercent;
+                        snapshot.externalGpuPercent = std::min(
+                            snapshot.externalGpuPercent + usage.gpuPercent,
+                            100.0
+                        );
+                        if (usage.cpuPercent >= 0.25 ||
+                            usage.gpuPercent >= 0.25 ||
+                            usage.workingSetMiB >= 256.0) {
+                            snapshot.processes.emplace_back(std::move(usage));
+                        }
+                    }
+                }
+                CloseHandle(process);
+            }
+            CloseHandle(processSnapshot);
+            sampler.previousProcessCpu = std::move(currentProcessCpu);
+            return true;
+        }
+#elif defined(__linux__)
+        struct HostResourceSamplerState {
