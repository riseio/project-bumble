+                    << "\",\"count\":" << entry.milliseconds.size()
+                    << ",\"mean_ms\":"
+                    << (entry.totalMilliseconds /
+                        double(entry.milliseconds.size()))
+                    << ",\"p95_ms\":"
+                    << percentile(entry.milliseconds, 0.95)
+                    << ",\"p99_ms\":"
+                    << percentile(entry.milliseconds, 0.99)
