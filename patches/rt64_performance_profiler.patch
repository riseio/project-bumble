+    void PresentQueue::updatePresentationBacklog() {
+        const uint64_t submittedId = ext.swapChain->getLastPresentId();
+        const uint64_t completedId =
+            ext.swapChain->getLastCompletedPresentId();
+        const uint64_t pendingCount = submittedId > completedId
+            ? submittedId - completedId
+            : 0u;
+        const uint32_t boundedPendingCount = uint32_t(std::min<uint64_t>(
+            pendingCount,
+            std::numeric_limits<uint32_t>::max()
+        ));
+        const uint32_t previousPendingCount =
+            ext.sharedResources->pendingSwapChainPresentations.exchange(
+                boundedPendingCount,
+                std::memory_order_acq_rel
+            );
+        if (previousPendingCount != boundedPendingCount) {
+            PerformanceProfiler::recordInstant(
+                PerformanceCategory::Pacing,
+                "Present.PendingDepthChanged",
+                submittedId,
+                completedId,
+                boundedPendingCount
+            );
+            ext.sharedResources->interpolatedCondition.notify_all();
+        }
+    }
+
+    void PresentQueue::ensurePresentationSlots() {
+        const uint32_t requiredSlots = ext.swapChain->getTextureCount();
+        if (presentationSlots.size() == requiredSlots) {
+            return;
+        }
+
+        drainPresentationSlots("Present.PresentationSlotResizeWait");
+        presentationSlots.clear();
+        presentationSlots.reserve(requiredSlots);
+        for (uint32_t i = 0; i < requiredSlots; i++) {
+            PresentationSlot slot;
+            slot.worker = std::make_unique<RenderWorker>(
+                ext.device,
+                "Present Frame " + std::to_string(i),
+                RenderCommandListType::DIRECT,
+                ext.presentGraphicsWorker
+            );
+            slot.acquiredSemaphore =
+                ext.device->createCommandSemaphore();
+            if (performanceGPUInstrumentationEnabled) {
+                slot.performanceQueryPool =
+                    ext.device->createQueryPool(5);
+            }
+            presentationSlots.emplace_back(std::move(slot));
+        }
+        presentationSlotCursor = 0;
+        PerformanceProfiler::setMetadata(
+            "presentation_inflight_slots",
+            std::to_string(requiredSlots)
+        );
+    }
+
+    void PresentQueue::waitForPresentationSlot(
+        PresentationSlot &slot, const char *waitStage) {
+        const uint64_t waitStart =
+            PerformanceProfiler::nowNanoseconds();
+        std::unique_lock<std::mutex> retirementLock(
+            presentationRetirementMutex
+        );
+        presentationRetirementCondition.wait(
+            retirementLock,
+            [&]() {
+                return !slot.submitted;
+            }
+        );
+        PerformanceProfiler::recordDuration(
+            PerformanceCategory::Wait,
+            waitStage,
+            waitStart,
+            PerformanceProfiler::nowNanoseconds(),
+            slot.presentId,
+            slot.workloadId,
+            slot.targetSetId
+        );
+    }
+
+    void PresentQueue::retirePresentationSlot(
+        PresentationSlot &slot, const char *completionStage) {
+        const uint64_t waitStart =
+            PerformanceProfiler::nowNanoseconds();
+        const bool waited = slot.worker->waitIfPending();
+        const uint64_t waitEnd =
+            PerformanceProfiler::nowNanoseconds();
+        assert(waited);
+        PerformanceProfiler::recordDuration(
+            PerformanceCategory::Wait,
+            completionStage,
+            waitStart,
+            waitEnd,
+            slot.presentId,
+            slot.workloadId,
+            slot.targetSetId
+        );
+
+        if (slot.measureGPU &&
+            (slot.performanceQueryPool != nullptr)) {
+            slot.performanceQueryPool->queryResults();
+            const uint64_t *timestamps =
+                slot.performanceQueryPool->getResults();
+            PerformanceProfiler::recordGPUDuration(
+                "GPU.Present",
+                timestamps[0], timestamps[4], waitEnd,
+                slot.presentId, slot.workloadId, slot.targetSetId
+            );
+            PerformanceProfiler::recordGPUDuration(
+                "GPU.Present.Resolve",
+                timestamps[0], timestamps[1], waitEnd,
+                slot.presentId
+            );
+            PerformanceProfiler::recordGPUDuration(
+                "GPU.Present.VideoInterface",
+                timestamps[1], timestamps[2], waitEnd,
+                slot.presentId
+            );
+            PerformanceProfiler::recordGPUDuration(
+                "GPU.Present.RenderHooks",
+                timestamps[2], timestamps[3], waitEnd,
+                slot.presentId
+            );
+            PerformanceProfiler::recordGPUDuration(
+                "GPU.Present.Finalize",
+                timestamps[3], timestamps[4], waitEnd,
+                slot.presentId
+            );
+        }
+
+        if (slot.frameCounters != nullptr) {
+            {
+                const std::scoped_lock<std::mutex> interpolatedLock(
+                    ext.sharedResources->interpolatedMutex
+                );
+                InterpolatedFrameCounters &frameCounters =
+                    *slot.frameCounters;
+                frameCounters.presented = std::max(
+                    frameCounters.presented,
+                    slot.nextPresented
+                );
+                assert(frameCounters.pendingPresentationFrames > 0u);
+                frameCounters.pendingPresentationFrames--;
+                if (frameCounters.consumerLoopComplete &&
+                    (frameCounters.pendingPresentationFrames == 0u)) {
+                    frameCounters.presented = std::max(
+                        frameCounters.presented,
+                        frameCounters.count
+                    );
+                    frameCounters.consumerComplete = true;
+                }
+            }
+            ext.sharedResources->interpolatedCondition.notify_all();
+        }
+
+        if (slot.captureComplete != nullptr) {
+            slot.captureComplete();
+        }
+        {
+            const std::scoped_lock<std::mutex> retirementLock(
+                presentationRetirementMutex
+            );
+            slot.frameCounters = nullptr;
+            slot.captureComplete = nullptr;
+            slot.nextPresented = 0;
+            slot.presentId = 0;
+            slot.workloadId = 0;
+            slot.targetSetId = 0;
+            slot.measureGPU = false;
+            slot.submitted = false;
+        }
+        presentationRetirementCondition.notify_all();
+    }
+
+    void PresentQueue::drainPresentationSlots(const char *waitStage) {
+        const uint64_t waitStart =
+            PerformanceProfiler::nowNanoseconds();
+        std::unique_lock<std::mutex> retirementLock(
+            presentationRetirementMutex
+        );
+        presentationRetirementCondition.wait(
+            retirementLock,
+            [&]() {
+                return std::all_of(
+                    presentationSlots.begin(),
+                    presentationSlots.end(),
+                    [](const PresentationSlot &slot) {
+                        return !slot.submitted;
+                    }
+                );
+            }
+        );
+        PerformanceProfiler::recordDuration(
+            PerformanceCategory::Wait,
+            waitStage,
+            waitStart,
+            PerformanceProfiler::nowNanoseconds()
+        );
+    }
+
+    void PresentQueue::presentationRetirementThreadLoop() {
+        Thread::setCurrentThreadName("RT64 Present Retire");
+        PerformanceProfiler::setThreadName("RT64 Present Retire");
+        while (true) {
+            PresentationSlot *slot = nullptr;
+            {
+                std::unique_lock<std::mutex> retirementLock(
+                    presentationRetirementMutex
+                );
+                presentationRetirementCondition.wait(
+                    retirementLock,
+                    [&]() {
+                        return !presentationRetirementQueue.empty() ||
+                            !presentationRetirementThreadRunning;
+                    }
+                );
+                if (presentationRetirementQueue.empty()) {
+                    if (!presentationRetirementThreadRunning) {
+                        break;
+                    }
+                    continue;
+                }
+                slot = presentationRetirementQueue.front();
+                presentationRetirementQueue.pop_front();
+            }
+            retirePresentationSlot(
+                *slot,
+                "Present.PresentationSlotGPUCompletion"
+            );
+        }
+    }
