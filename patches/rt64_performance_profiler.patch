+        double percentile(std::vector<double> values, double fraction) {
+            if (values.empty()) {
+                return 0.0;
+            }
+
+            std::sort(values.begin(), values.end());
+            const double position = fraction * double(values.size() - 1);
+            const size_t lower = size_t(std::floor(position));
+            const size_t upper = size_t(std::ceil(position));
+            const double weight = position - double(lower);
+            return values[lower] * (1.0 - weight) + values[upper] * weight;
+        }
+
+        const Statistics *findStatistics(
+            const std::vector<Statistics> &statistics,
+            PerformanceCategory category,
+            std::string_view name
+        ) {
+            for (const Statistics &entry : statistics) {
+                if ((entry.category == category) && (entry.name == name)) {
+                    return &entry;
+                }
+            }
+
+            return nullptr;
+        }
+
+        const Statistics *largestP95(
+            const std::vector<Statistics> &statistics,
+            PerformanceCategory category,
+            std::string_view excludedName = {}
+        ) {
+            const Statistics *largest = nullptr;
+            double largestValue = -1.0;
+            for (const Statistics &entry : statistics) {
+                if ((entry.category != category) ||
+                    (!excludedName.empty() && (entry.name == excludedName))) {
+                    continue;
+                }
+                if (category == PerformanceCategory::Pacing &&
+                    ((entry.name == "Present.ActualScanoutInterval") ||
+                     (entry.name ==
+                        "Present.DesktopOutputChangeInterval") ||
+                     (entry.name == "Present.DisplayVBlankInterval") ||
+                     (entry.name ==
+                        "Present.EstimatedDisplayedFrameInterval") ||
+                     (entry.name ==
+                        "Present.PresentWaitCompletionInterval") ||
+                     (entry.name ==
+                        "Present.SwapChainImageReleaseObservationInterval"))) {
+                    continue;
+                }
+
+                const double value = percentile(entry.milliseconds, 0.95);
+                if (value > largestValue) {
+                    largest = &entry;
+                    largestValue = value;
+                }
+            }
+
+            return largest;
+        }
