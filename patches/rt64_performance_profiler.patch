+        bool writeTrace(
+            const ProfilerState &profiler,
+            const std::vector<ThreadBuffer *> &buffers
+        ) {
+            ensureParentDirectory(profiler.outputPath);
+            std::ofstream output(profiler.outputPath, std::ios::binary);
+            if (!output.is_open()) {
+                return false;
+            }
+
+            output << "{\n  \"schema\": \"rt64-performance-trace-v1\",\n";
+            output << "  \"clock\": \"steady_clock_nanoseconds\",\n";
+            output << "  \"gpu_clock_alignment\": \"fence_completion_estimate\",\n";
+            output << "  \"traceEvents\": [\n";
+            bool first = true;
+            auto separator = [&]() {
+                if (!first) {
+                    output << ",\n";
+                }
+                first = false;
+            };
+
+            for (const ThreadBuffer *buffer : buffers) {
+                separator();
+                output << "    {\"name\":\"thread_name\",\"ph\":\"M\",\"pid\":1,\"tid\":"
+                    << buffer->id << ",\"args\":{\"name\":\""
+                    << jsonEscape(buffer->name) << "\"}}";
+            }
+            separator();
+            output << "    {\"name\":\"thread_name\",\"ph\":\"M\",\"pid\":1,\"tid\":4294967294,\"args\":{\"name\":\"RT64 GPU samples\"}}";
+
+            for (const ThreadBuffer *buffer : buffers) {
+                for (uint64_t eventIndex = 0;
+                    eventIndex < buffer->eventCount;
+                    ++eventIndex) {
+                    const Event &event = eventAt(*buffer, eventIndex);
+                    constexpr std::string_view DrawPrefix = "GPU.Draw.";
+                    const std::string_view eventName(event.name.data());
+                    if (!profiler.keepDrawEvents &&
+                        (eventName.size() >= DrawPrefix.size()) &&
+                        (eventName.substr(0, DrawPrefix.size()) == DrawPrefix)) {
+                        continue;
+                    }
+                    separator();
+                    const uint32_t traceThread = event.gpuClock
+                        ? 4'294'967'294u
+                        : event.threadId;
+                    output << "    {\"name\":\"" << jsonEscape(event.name.data())
+                        << "\",\"cat\":\"" << categoryName(event.category)
+                        << "\",\"pid\":1,\"tid\":" << traceThread
+                        << ",\"ts\":" << std::fixed << std::setprecision(3)
+                        << (double(event.timestampNanoseconds) / 1'000.0);
+                    switch (event.kind) {
+                    case EventKind::Duration:
+                        output << ",\"ph\":\"X\",\"dur\":"
+                            << (double(event.durationNanoseconds) / 1'000.0);
+                        break;
+                    case EventKind::Instant:
+                        output << ",\"ph\":\"i\",\"s\":\"t\"";
+                        break;
+                    case EventKind::Counter:
+                        output << ",\"ph\":\"C\"";
+                        break;
+                    }
+                    output << ",\"args\":{\"correlation_id\":"
+                        << event.correlationId << ",\"argument0\":"
+                        << event.argument0 << ",\"argument1\":"
+                        << event.argument1;
+                    if (event.kind == EventKind::Counter) {
+                        output << ",\"value\":" << event.value;
+                    }
+                    if (event.threadCpuMeasured) {
+                        output << ",\"thread_cpu_duration_ns\":"
+                            << event.threadCpuDurationNanoseconds;
+                    }
+                    if (event.gpuClock) {
+                        output << ",\"raw_gpu_start_ns\":"
+                            << event.gpuStartNanoseconds
+                            << ",\"raw_gpu_end_ns\":"
+                            << event.gpuEndNanoseconds
+                            << ",\"alignment\":\"fence_completion_estimate\"";
+                    }
+                    output << "}}";
+                }
+            }
+
+            output << "\n  ],\n  \"metadata\": {";
+            bool firstMetadata = true;
+            for (const auto &[key, value] : profiler.metadata) {
+                if (!firstMetadata) {
+                    output << ',';
+                }
+                firstMetadata = false;
+                output << "\n    \"" << jsonEscape(key) << "\": \""
+                    << jsonEscape(value) << "\"";
+            }
+            if (!firstMetadata) {
+                output << ',';
+            }
+            output << "\n    \"budget_ms\": " << profiler.budgetMilliseconds
+                << ",\n    \"dropped_events\": "
+                << droppedEventCount(profiler, buffers)
+                << "\n  }\n}\n";
+            return output.good();
+        }
+
+        bool isFrameContainer(std::string_view name) {
+            return (name == "Application.Setup") ||
+                (name == "Application.ProcessDisplayLists") ||
+                (name == "State.FullSync") ||
+                (name == "State.FullSyncWorkloadAdvance") ||
+                (name == "Present.Batch") ||
+                (name == "Present.OutputFrame") ||
+                (name == "Renderer.Frame") ||
+                (name == "State.UpdateScreenAndSubmit") ||
+                (name == "Workload.InterpolationBatch") ||
+                (name == "Workload.Process") ||
+                (name == "GPU.Frame") ||
+                (name == "GPU.Framebuffers");
+        }
+
+        bool isConcurrentBackgroundStage(const Event &event) {
+            const std::string_view name(event.name.data());
+            return (event.category == PerformanceCategory::Compile) ||
+                (event.category == PerformanceCategory::IO) ||
+                (name == "Present.PresentationSlotGPUCompletion") ||
+                ((event.category == PerformanceCategory::Upload) &&
+                    (name != "Renderer.UploadWait"));
+        }
+
+        bool isFrameProductionCadenceObservation(const Event &event) {
+            const std::string_view name(event.name.data());
+            return (name == "FrameProduction.RuntimeVIInterval") ||
+                (name == "FrameProduction.RuntimeVIWakeDeadlineMiss") ||
+                (name == "FrameProduction.GuestGraphicsTaskInterval") ||
+                (name == "FrameProduction.GuestGraphicsWaitAfterCompletion") ||
+                (name == "FrameProduction.PresentQueueStarvation") ||
+                (name == "FrameProduction.WorkloadQueueStarvation");
+        }
+
+        bool isDisplayCadenceObservation(const Event &event) {
+            const std::string_view name(event.name.data());
+            return (name == "Present.ActualScanoutInterval") ||
+                (name == "Present.DesktopOutputChangeInterval") ||
+                (name == "Present.DisplayVBlankInterval") ||
+                (name == "Present.EstimatedDisplayedFrameInterval") ||
+                (name == "Present.PresentWaitCompletionInterval") ||
+                (name ==
+                    "Present.SwapChainImageReleaseObservationInterval");
+        }
+
+        bool isBufferedProducerBackpressure(const Event &event) {
+            const std::string_view name(event.name.data());
+            return (name == "FrameProduction.WorkloadProducerBackpressure") ||
+                (name == "FrameProduction.PresentProducerBackpressure");
+        }
+
+        bool bufferedBackpressureMatchesDisplayedFrame(
+            const Event &event,
+            const Event &displayed
+        ) {
+            if ((event.correlationId == 0) ||
+                !isBufferedProducerBackpressure(event)) {
+                return false;
+            }
+
+            const std::string_view name(event.name.data());
+            if (name == "FrameProduction.WorkloadProducerBackpressure") {
+                return event.correlationId == displayed.argument0;
+            }
+
+            return event.correlationId == displayed.correlationId;
+        }
+
+        bool isCriticalPathStage(const Event &event) {
+            if ((event.kind != EventKind::Duration) ||
+                (event.durationNanoseconds == 0)) {
+                return false;
+            }
+
+            const std::string_view name(event.name.data());
+            if (isFrameContainer(name) || isConcurrentBackgroundStage(event) ||
+                isFrameProductionCadenceObservation(event) ||
+                isDisplayCadenceObservation(event)) {
+                return false;
+            }
+
+            // RenderWorker waits mirror their owning renderer/present waits.
+            constexpr std::string_view renderWorkerPrefix = "RenderWorker.";
+            if ((name.size() >= renderWorkerPrefix.size()) &&
+                (name.substr(0, renderWorkerPrefix.size()) == renderWorkerPrefix)) {
+                return false;
+            }
+
+            return (event.category == PerformanceCategory::CPU) ||
+                (event.category == PerformanceCategory::GPU) ||
+                (event.category == PerformanceCategory::Wait) ||
+                (event.category == PerformanceCategory::Pacing) ||
+                (event.category == PerformanceCategory::Upload);
+        }
+
+        double overlapMilliseconds(
+            const Event &event,
+            uint64_t intervalStart,
+            uint64_t intervalEnd
+        ) {
+            const uint64_t eventEnd = event.timestampNanoseconds +
+                event.durationNanoseconds;
+            if ((event.timestampNanoseconds >= intervalEnd) ||
+                (eventEnd <= intervalStart)) {
+                return 0.0;
+            }
+
+            const uint64_t overlapStart = std::max(
+                event.timestampNanoseconds,
+                intervalStart
+            );
+            const uint64_t overlapEnd = std::min(eventEnd, intervalEnd);
+            return double(overlapEnd - overlapStart) / 1'000'000.0;
+        }
+
+        std::string diagnosisForCategory(PerformanceCategory category) {
+            switch (category) {
+            case PerformanceCategory::GPU: return "GPU_BOUND";
+            case PerformanceCategory::CPU: return "CPU_BOUND";
+            case PerformanceCategory::Wait:
+                return "SYNCHRONIZATION_OR_QUEUE_WAIT";
+            case PerformanceCategory::Pacing:
+                return "DISPLAY_PACING_OR_BACKPRESSURE";
+            case PerformanceCategory::Upload:
+                return "RESOURCE_UPLOAD_BLOCKING_RENDERER";
+            default: return "EXTERNAL_OR_UNINSTRUMENTED_STALL";
+            }
+        }
+
+        bool isFrameProductionStage(const Event &event) {
+            constexpr std::string_view frameProductionPrefix =
+                "FrameProduction.";
+            const std::string_view name(event.name.data());
+            return (name.size() >= frameProductionPrefix.size()) &&
+                (name.substr(0, frameProductionPrefix.size()) ==
+                    frameProductionPrefix);
+        }
+
+        bool isInterpolationBurstStage(const Event &event) {
+            const uint32_t sourceRate =
+                uint32_t(event.argument1 >> 32u);
+            const uint32_t targetRate =
+                uint32_t(event.argument1 & 0xFFFFFFFFULL);
+            const uint32_t expectedMaximumDisplayFrames =
+                (sourceRate > 0) && (targetRate > 0)
+                    ? uint32_t((uint64_t(targetRate) + sourceRate - 1u) /
+                        sourceRate)
+                    : 0u;
+            return (event.kind == EventKind::Duration) &&
+                (std::string_view(event.name.data()) ==
+                    "Workload.InterpolationBatch") &&
+                (expectedMaximumDisplayFrames > 0) &&
+                (event.argument0 > expectedMaximumDisplayFrames);
+        }
+
+        uint32_t interpolationSourceRate(const Event &event) {
+            return uint32_t(event.argument1 >> 32u);
+        }
+
+        uint32_t interpolationTargetRate(const Event &event) {
+            return uint32_t(event.argument1 & 0xFFFFFFFFULL);
+        }
+
+        double interpolationDeadlineMilliseconds(const Event &event) {
+            const uint32_t sourceRate = interpolationSourceRate(event);
+            return sourceRate > 0
+                ? (1'000.0 / double(sourceRate))
+                : 0.0;
+        }
+
+        bool isInterpolationDeadlineMiss(const Event &event) {
+            const double deadline = interpolationDeadlineMilliseconds(event);
+            return (deadline > 0.0) &&
+                ((double(event.durationNanoseconds) / 1'000'000.0) > deadline);
+        }
+
+        std::string diagnosisForEvent(const Event &event) {
+            const std::string_view name(event.name.data());
+            if (name == "FrameProduction.RuntimeVIWakeDeadlineMiss") {
+                return "RUNTIME_VI_TIMER_DEADLINE_MISS";
+            }
+            if (name == "FrameProduction.RuntimeVIInterval") {
+                return "RUNTIME_VI_SCHEDULER_STALL";
+            }
+            if (isInterpolationBurstStage(event)) {
+                return "INTERPOLATION_BURST_BACKPRESSURE";
+            }
+            if (isFrameProductionStage(event)) {
+                return (name.find("Backpressure") != std::string_view::npos)
+                    ? "FRAME_PRODUCTION_BACKPRESSURE"
+                    : "FRAME_PRODUCTION_STARVATION";
+            }
+
+            return diagnosisForCategory(event.category);
+        }
+
+        bool writeSummary(
+            const ProfilerState &profiler,
+            const std::vector<ThreadBuffer *> &buffers
+        ) {
+            std::map<std::pair<PerformanceCategory, std::string>, Statistics> map;
+            std::map<std::string, ThreadExecutionStatistics>
+                threadExecutionMap;
+            std::map<std::string, std::vector<double>> counterValues;
+            std::vector<const Event *> durationEvents;
+            std::vector<const Event *> displayedEvents;
+            std::vector<const Event *> actualScanoutEvents;
+            std::vector<const Event *> desktopOutputEvents;
+            std::vector<const Event *> displayVBlankEvents;
+            std::vector<const Event *> estimatedDisplayedFrameEvents;
+            std::vector<const Event *> presentWaitCompletionEvents;
+            std::vector<const Event *> imageReacquireCompletionEvents;
+            std::vector<const Event *> interpolationBatchEvents;
+            std::vector<const Event *> interpolationDecisionEvents;
+            std::vector<const Event *> interpolationReuseBlockedEvents;
+            std::vector<const Event *> presentInterpolationBlockedEvents;
+            std::vector<const Event *> pendingDepthEvents;
+            std::vector<const Event *> runtimeVIIntervalEvents;
+            std::vector<const Event *> runtimeVIWakeDeadlineMissEvents;
+            std::vector<const Event *> manualPacingResultEvents;
+            std::vector<double> runtimeVIIntervals;
+            std::vector<double> runtimeVIWakeDeadlineMisses;
+            uint64_t runtimeVISkippedRetraces = 0;
+            std::map<uint64_t, HostResourceObservation>
+                hostResourceObservationMap;
+            uint64_t displayQueueUnderruns = 0;
+            uint64_t presentationEnqueuedCount = 0;
+            uint64_t presentationDequeuedCount = 0;
+            uint64_t presentationDequeuedSkippedCount = 0;
+            uint64_t presentationDequeuedCoalescedCount = 0;
+            uint64_t interpolationSetPublishedCount = 0;
+            uint64_t interpolationResolvedCount = 0;
+            uint64_t interpolationResolvedMatchedCount = 0;
+            uint64_t interpolationResolvedGeneratedCount = 0;
+            uint64_t interpolationResolvedConsumedCount = 0;
+            uint64_t interpolationFramebufferMismatchCount = 0;
+            uint64_t earlyPresentDecisionCount = 0;
+            uint64_t earlyPresentEnabledCount = 0;
+            uint64_t earlyPresentCandidateCount = 0;
+            uint64_t earlyPresentSubmittedCount = 0;
+            uint64_t earlyPresentSubmissionMissCount = 0;
+            uint64_t coalescedDuplicateWorkloadCount = 0;
+            std::vector<double> manualPacingOvershootMilliseconds;
+            uint64_t fifoRateCalibrationObservationCount = 0;
+            uint64_t fifoRateCalibrationCompletionId = 0;
+            uint32_t fifoRateAdvertisedHz = 0;
+            double fifoRateObservedHz = 0.0;
+            uint32_t fifoRateEffectiveHz = 0;
+            bool fifoRateCalibrationApplied = false;
+            std::unordered_map<uint64_t, double>
+                presentationHandoffMilliseconds;
+            std::vector<double> presentationSubmissionIntervals;
+            std::vector<double> scanoutIntervals;
+            std::vector<double> presentWaitCompletionIntervals;
+            std::vector<double> imageReacquireCompletionIntervals;
+            std::unordered_map<uint64_t, GPUWorkloadAccumulator>
+                gpuWorkloads;
+            std::map<std::pair<std::string, uint32_t>, DrawHotspotStatistics>
+                drawHotspotMap;
+            for (const ThreadBuffer *buffer : buffers) {
+                for (uint64_t eventIndex = 0;
+                    eventIndex < buffer->eventCount;
+                    ++eventIndex) {
+                    const Event &event = eventAt(*buffer, eventIndex);
+                    if ((event.kind == EventKind::Duration) &&
+                        (event.durationNanoseconds > 0)) {
+                        durationEvents.emplace_back(&event);
+                        const auto key = std::make_pair(
+                            event.category,
+                            std::string(event.name.data())
+                        );
+                        Statistics &entry = map[key];
+                        entry.name = key.second;
+                        entry.category = key.first;
+                        const double milliseconds =
+                            double(event.durationNanoseconds) / 1'000'000.0;
+                        entry.milliseconds.emplace_back(milliseconds);
+                        entry.totalMilliseconds += milliseconds;
+                        const std::string_view eventName(event.name.data());
+                        if (event.threadCpuMeasured) {
+                            ThreadExecutionStatistics &execution =
+                                threadExecutionMap[std::string(eventName)];
+                            execution.name = eventName;
+                            const double cpuMilliseconds = double(
+                                event.threadCpuDurationNanoseconds
+                            ) / 1'000'000.0;
+                            execution.wallMilliseconds.emplace_back(
+                                milliseconds
+                            );
+                            execution.cpuMilliseconds.emplace_back(
+                                cpuMilliseconds
+                            );
+                            execution.offCpuMilliseconds.emplace_back(
+                                std::max(0.0, milliseconds - cpuMilliseconds)
+                            );
+                        }
+                        if (eventName == "Present.ActualScanoutInterval") {
+                            actualScanoutEvents.emplace_back(&event);
+                        }
+                        else if (eventName ==
+                            "Present.DesktopOutputChangeInterval") {
+                            desktopOutputEvents.emplace_back(&event);
+                        }
+                        else if (eventName ==
+                            "Present.DisplayVBlankInterval") {
+                            displayVBlankEvents.emplace_back(&event);
+                        }
+                        else if (eventName ==
+                            "Present.EstimatedDisplayedFrameInterval") {
+                            estimatedDisplayedFrameEvents.emplace_back(&event);
+                        }
+                        else if (eventName ==
+                            "Present.PresentWaitCompletionInterval") {
+                            presentWaitCompletionEvents.emplace_back(&event);
+                        }
+                        else if (eventName ==
+                            "Present.SwapChainImageReleaseObservationInterval") {
+                            imageReacquireCompletionEvents.emplace_back(
+                                &event
+                            );
+                        }
+                        else if (eventName ==
+                            "Workload.InterpolationBatch") {
+                            interpolationBatchEvents.emplace_back(&event);
+                        }
+                        else if (eventName ==
+                            "FrameProduction.RuntimeVIInterval") {
+                            runtimeVIIntervalEvents.emplace_back(&event);
+                        }
+                        else if (eventName ==
+                            "FrameProduction.RuntimeVIWakeDeadlineMiss") {
+                            runtimeVIWakeDeadlineMissEvents.emplace_back(
+                                &event
+                            );
+                        }
+                        else if ((eventName ==
+                            "Workload.PresentationQueueHandoff") ||
+                            (eventName ==
+                                "Workload.InterpolationReuseWait") ||
+                            (eventName ==
+                                "Workload.PresentationTargetClaimWait") ||
+                            (eventName ==
+                                "Workload.PresentationEventQueueWait") ||
+                            (eventName ==
+                                "Workload.PresentationSetCommitWait") ||
+                            (eventName ==
+                                "Workload.FirstPresentationQueueWait")) {
+                            presentationHandoffMilliseconds[
+                                event.correlationId
+                            ] += milliseconds;
+                        }
+                        if ((eventName == "GPU.Frame") &&
+                            (event.argument0 != 0u)) {
+                            GPUWorkloadAccumulator &gpuWorkload =
+                                gpuWorkloads[event.argument0];
+                            gpuWorkload.frameMilliseconds += milliseconds;
+                            gpuWorkload.sampledFrames++;
+                        }
+                        constexpr std::string_view DrawPrefix = "GPU.Draw.";
+                        if ((eventName.size() >= DrawPrefix.size()) &&
+                            (eventName.substr(0, DrawPrefix.size()) ==
+                                DrawPrefix)) {
+                            const uint32_t shaderHash =
+                                uint32_t(event.argument1 & 0xFFFFFFFFu);
+                            const uint32_t faceCount =
+                                uint32_t(event.argument1 >> 32u);
+                            const auto drawKey = std::make_pair(
+                                std::string(eventName),
+                                shaderHash
+                            );
+                            DrawHotspotStatistics &hotspot =
+                                drawHotspotMap[drawKey];
+                            hotspot.name = drawKey.first;
+                            hotspot.shaderHash = shaderHash;
+                            hotspot.samples++;
+                            hotspot.faces += faceCount;
+                            hotspot.totalMilliseconds += milliseconds;
+                            hotspot.milliseconds.emplace_back(milliseconds);
+                        }
+                    }
+                    else if (event.kind == EventKind::Instant) {
+                        const std::string_view eventName(event.name.data());
+                        if ((event.category == PerformanceCategory::Frame) &&
+                            (eventName == "Present.Submitted")) {
+                            displayedEvents.emplace_back(&event);
+                        }
+                        else if (eventName ==
+                            "Workload.InterpolationDecision") {
+                            interpolationDecisionEvents.emplace_back(&event);
+                        }
+                        else if (eventName ==
+                            "Workload.InterpolationReuseBlocked") {
+                            interpolationReuseBlockedEvents.emplace_back(&event);
+                        }
+                        else if (eventName ==
+                            "Present.InterpolationBlocked") {
+                            presentInterpolationBlockedEvents.emplace_back(&event);
+                        }
+                        else if (eventName ==
+                            "Present.PendingDepthChanged") {
+                            pendingDepthEvents.emplace_back(&event);
+                        }
+                        else if (eventName ==
+                            "Present.DisplayQueueUnderrun") {
+                            displayQueueUnderruns += event.argument0;
+                        }
+                        else if (eventName == "Present.Enqueued") {
+                            presentationEnqueuedCount++;
+                        }
+                        else if (eventName == "Present.Dequeued") {
+                            presentationDequeuedCount++;
+                            presentationDequeuedSkippedCount +=
+                                (event.argument1 & 1u) != 0u ? 1u : 0u;
+                            presentationDequeuedCoalescedCount +=
+                                (event.argument1 & (1u << 1u)) != 0u
+                                    ? 1u
+                                    : 0u;
+                        }
+                        else if (eventName ==
+                            "Workload.InterpolationSetPublished") {
+                            interpolationSetPublishedCount++;
+                        }
+                        else if (eventName ==
+                            "Present.InterpolationResolved") {
+                            const uint64_t flags = event.argument0 & 0xFFu;
+                            interpolationResolvedCount++;
+                            interpolationResolvedMatchedCount +=
+                                (flags & 1u) != 0u ? 1u : 0u;
+                            interpolationResolvedGeneratedCount +=
+                                (flags & (1u << 1u)) != 0u ? 1u : 0u;
+                            interpolationResolvedConsumedCount +=
+                                (flags & (1u << 2u)) != 0u ? 1u : 0u;
+                            interpolationFramebufferMismatchCount +=
+                                (flags & (1u << 3u)) != 0u ? 1u : 0u;
+                        }
+                        else if (eventName ==
+                            "State.FullSyncEarlyPresentDecision") {
+                            const uint64_t flags = event.argument0 & 0xFFu;
+                            const bool enabled = (flags & 1u) != 0u;
+                            const bool candidate =
+                                (flags & (1u << 2u)) != 0u;
+                            const bool submitted =
+                                (flags & (1u << 3u)) != 0u;
+                            earlyPresentDecisionCount++;
+                            earlyPresentEnabledCount += enabled ? 1u : 0u;
+                            earlyPresentCandidateCount += candidate ? 1u : 0u;
+                            earlyPresentSubmittedCount += submitted ? 1u : 0u;
+                            earlyPresentSubmissionMissCount +=
+                                enabled && candidate && !submitted ? 1u : 0u;
+                        }
+                        else if (eventName ==
+                            "Present.CoalescedDuplicateWorkload") {
+                            coalescedDuplicateWorkloadCount++;
+                        }
+                        else if (eventName ==
+                            "Present.ManualPacingResult") {
+                            manualPacingResultEvents.emplace_back(&event);
+                        }
+                        else if (eventName ==
+                            "Present.FifoRateCalibrationObservation") {
+                            fifoRateCalibrationObservationCount++;
+                            fifoRateCalibrationCompletionId =
+                                event.correlationId;
+                            fifoRateAdvertisedHz =
+                                uint32_t(event.argument0);
+                            fifoRateObservedHz =
+                                double(event.argument1) / 1'000.0;
+                        }
+                        else if (eventName ==
+                            "Present.FifoRateCalibrated") {
+                            fifoRateCalibrationApplied = true;
+                            fifoRateCalibrationCompletionId =
+                                event.correlationId;
+                            fifoRateAdvertisedHz =
+                                uint32_t(event.argument0);
+                            fifoRateEffectiveHz =
+                                uint32_t(event.argument1);
+                        }
+                    }
+                    else if (event.kind == EventKind::Counter) {
+                        const std::string name(event.name.data());
+                        counterValues[name].emplace_back(event.value);
+                        HostResourceObservation *observation = nullptr;
+                        if ((name == "Host.SystemCPUPercent") ||
+                            (name == "Host.ExternalCPUPercent") ||
+                            (name == "Host.ExternalGPUPercent") ||
+                            (name == "Host.AvailableMemoryMiB") ||
+                            (name.compare(
+                                0,
+                                HostProcessCpuPrefix.size(),
+                                HostProcessCpuPrefix
+                            ) == 0) ||
+                            (name.compare(
+                                0,
+                                HostProcessGpuPrefix.size(),
+                                HostProcessGpuPrefix
+                            ) == 0) ||
+                            (name.compare(
+                                0,
+                                HostProcessMemoryPrefix.size(),
+                                HostProcessMemoryPrefix
+                            ) == 0)) {
+                            observation = &hostResourceObservationMap[
+                                event.correlationId
+                            ];
+                            observation->timestampNanoseconds = std::max(
+                                observation->timestampNanoseconds,
+                                event.timestampNanoseconds
+                            );
+                        }
+                        if (observation == nullptr) {
+                            continue;
+                        }
+                        if (name == "Host.SystemCPUPercent") {
+                            observation->systemCpuPercent = event.value;
+                            observation->systemCpuAvailable = true;
+                        }
+                        else if (name == "Host.ExternalCPUPercent") {
+                            observation->externalCpuPercent = event.value;
+                            observation->externalCpuAvailable = true;
+                        }
+                        else if (name == "Host.ExternalGPUPercent") {
+                            observation->externalGpuPercent = event.value;
+                            observation->externalGpuAvailable = true;
+                        }
+                        else if (name == "Host.AvailableMemoryMiB") {
+                            observation->availableMemoryMiB = event.value;
+                            observation->availableMemoryAvailable = true;
+                        }
+                        else if (name.compare(
+                            0,
+                            HostProcessCpuPrefix.size(),
+                            HostProcessCpuPrefix
+                        ) == 0) {
+                            observation->contributors[name.substr(
+                                HostProcessCpuPrefix.size()
+                            )].cpuPercent = event.value;
+                        }
+                        else if (name.compare(
+                            0,
+                            HostProcessGpuPrefix.size(),
+                            HostProcessGpuPrefix
+                        ) == 0) {
+                            observation->contributors[name.substr(
+                                HostProcessGpuPrefix.size()
+                            )].gpuPercent = event.value;
+                        }
+                        else if (name.compare(
+                            0,
+                            HostProcessMemoryPrefix.size(),
+                            HostProcessMemoryPrefix
+                        ) == 0) {
+                            observation->contributors[name.substr(
+                                HostProcessMemoryPrefix.size()
+                            )].workingSetMiB = event.value;
+                        }
+                    }
+                }
+            }
+
+            std::sort(
+                displayedEvents.begin(),
+                displayedEvents.end(),
+                [](const Event *left, const Event *right) {
+                    return left->timestampNanoseconds < right->timestampNanoseconds;
+                }
+            );
+            const size_t analysisEnd = (displayedEvents.size() >
+                profiler.cooldownFrames)
+                ? (displayedEvents.size() - profiler.cooldownFrames)
+                : 0;
+            const size_t analysisStart = std::min<size_t>(
+                profiler.warmupFrames,
+                analysisEnd
+            );
+            const uint64_t analysisStartNanoseconds =
+                analysisStart < analysisEnd
+                    ? displayedEvents[analysisStart]->timestampNanoseconds
+                    : 0u;
+            const uint64_t analysisEndNanoseconds =
+                analysisStart < analysisEnd
+                    ? displayedEvents[analysisEnd - 1u]->timestampNanoseconds
+                    : 0u;
+            const auto eventInsideAnalysis = [&](const Event &event) {
+                const uint64_t eventEndNanoseconds =
+                    event.timestampNanoseconds + event.durationNanoseconds;
+                return (analysisStartNanoseconds == 0u) ||
+                    ((eventEndNanoseconds >= analysisStartNanoseconds) &&
+                        (event.timestampNanoseconds <=
+                            analysisEndNanoseconds));
+            };
+            for (const Event *event : runtimeVIIntervalEvents) {
+                if (eventInsideAnalysis(*event)) {
+                    runtimeVIIntervals.emplace_back(
+                        double(event->durationNanoseconds) / 1'000'000.0
+                    );
+                }
+            }
+            for (const Event *event : runtimeVIWakeDeadlineMissEvents) {
+                if (eventInsideAnalysis(*event)) {
+                    runtimeVIWakeDeadlineMisses.emplace_back(
+                        double(event->durationNanoseconds) / 1'000'000.0
+                    );
+                    runtimeVISkippedRetraces += event->argument0;
+                }
+            }
+            for (const Event *event : manualPacingResultEvents) {
+                if (eventInsideAnalysis(*event)) {
+                    manualPacingOvershootMilliseconds.emplace_back(
+                        double(event->argument1) / 1'000'000.0
+                    );
+                }
