+            output << "\n  ],\n  \"interpretation\": "
+                << "\"Slow-frame diagnoses use only stages measured on the RT64 "
+                << "critical presentation path. Concurrent shader, streaming, and "
+                << "upload work is reported as correlation, not called causal unless "
+                << "the renderer blocks on it. GPU spans use exact timestamp "
+                << "durations with approximate CPU placement. Cadence detection "
+                << "reports both severe gaps and smaller long/short micro-stutter "
+                << "pairs. Thread execution reports wall time, on-CPU time, and "
+                << "their off-CPU remainder for core renderer scopes; that "
+                << "remainder can include explicit or uninstrumented blocking. "
+                << "Physical scanout is identified separately when the "
+                << "backend exposes it. A controlled "
+                << "before/after capture is still required to prove that a code "
+                << "change removes the cause.\"\n}\n";
+            return output.good();
+        }
+
+        void startHostObservation() {
+            ProfilerState &profiler = state();
+            const std::scoped_lock startLock(profiler.hostObservationMutex);
+            if (profiler.hostObservationThread.joinable()) {
+                return;
+            }
+#if defined(_WIN32) || defined(__linux__)
+            profiler.hostObservationRunning.store(
+                true,
+                std::memory_order_release
+            );
+            profiler.hostObservationThread = std::thread([]() {
+                PerformanceProfiler::setThreadName("RT64 Host Resources");
+                ProfilerState &threadProfiler = state();
+                HostResourceSamplerState sampler;
+#ifdef _WIN32
+                PerformanceProfiler::setMetadata(
+                    "host_gpu_sampling",
+                    sampler.gpuCounter != nullptr
+                        ? "windows_pdh_gpu_engine"
+                        : "unavailable"
+                );
+#else
+                PerformanceProfiler::setMetadata(
+                    "host_gpu_sampling",
+                    "unavailable_platform"
+                );
+#endif
+                PerformanceProfiler::setMetadata(
+                    "host_cpu_sampling",
+#ifdef _WIN32
+                    "windows_process_times"
+#else
+                    "linux_procfs"
+#endif
+                );
+                auto previous = Clock::now();
+                uint64_t sequence = 0;
+                while (threadProfiler.hostObservationRunning.load(
+                    std::memory_order_acquire
+                )) {
+                    std::this_thread::sleep_for(
+                        std::chrono::milliseconds(1'000)
+                    );
+                    const auto current = Clock::now();
+                    const double elapsedSeconds =
+                        std::chrono::duration<double>(current - previous)
+                            .count();
+                    previous = current;
+                    HostResourceSnapshot snapshot;
+                    if (!sampleHostResources(
+                            sampler,
+                            elapsedSeconds,
+                            snapshot
+                        )) {
+                        continue;
+                    }
+                    sequence++;
+                    appendCounterSample(
+                        "Host.SystemCPUPercent",
+                        snapshot.systemCpuPercent,
+                        sequence
+                    );
+                    appendCounterSample(
+                        "Host.ExternalCPUPercent",
+                        snapshot.externalCpuPercent,
+                        sequence
+                    );
+                    appendCounterSample(
+                        "Host.ExternalGPUPercent",
+                        snapshot.externalGpuPercent,
+                        sequence
+                    );
+                    appendCounterSample(
+                        "Host.AvailableMemoryMiB",
+                        snapshot.availableMemoryMiB,
+                        sequence
+                    );
+                    std::sort(
+                        snapshot.processes.begin(),
+                        snapshot.processes.end(),
+                        [](const HostProcessUsage &left,
+                           const HostProcessUsage &right) {
+                            return std::max(
+                                left.cpuPercent,
+                                left.gpuPercent
+                            ) > std::max(
+                                right.cpuPercent,
+                                right.gpuPercent
+                            );
+                        }
+                    );
+                    const size_t contributorCount = std::min<size_t>(
+                        snapshot.processes.size(),
+                        8u
+                    );
+                    for (size_t i = 0; i < contributorCount; i++) {
+                        const HostProcessUsage &usage = snapshot.processes[i];
+                        const std::string identity =
+                            std::to_string(usage.processId) + "." +
+                            usage.name;
+                        appendCounterSample(
+                            "Host.ProcessCPU." + identity,
+                            usage.cpuPercent,
+                            sequence
+                        );
+                        appendCounterSample(
+                            "Host.ProcessGPU." + identity,
+                            usage.gpuPercent,
+                            sequence
+                        );
+                        appendCounterSample(
+                            "Host.ProcessMemoryMiB." + identity,
+                            usage.workingSetMiB,
+                            sequence
+                        );
+                    }
+                }
+            });
+#else
+            PerformanceProfiler::setMetadata(
+                "host_cpu_sampling",
+                "unavailable_platform"
+            );
+            PerformanceProfiler::setMetadata(
+                "host_gpu_sampling",
+                "unavailable_platform"
+            );
+#endif
+        }
+    }
