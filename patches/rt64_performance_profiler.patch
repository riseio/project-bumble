+                    << ",\"max_ms\":" << percentile(entry.milliseconds, 1.0)
+                    << "}";
+            }
+            output << "\n  ],\n  \"counters\": [\n";
+            size_t counterIndex = 0;
+            for (const auto &[name, values] : counterValues) {
+                if (counterIndex++ > 0) {
