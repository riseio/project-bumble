+                }
+                double total = 0.0;
+                for (const double value : values) {
+                    total += value;
+                }
+                output << "    {\"name\":\"" << jsonEscape(name)
+                    << "\",\"count\":" << values.size()
+                    << ",\"mean\":" << (total / double(values.size()))
+                    << ",\"p95\":" << percentile(values, 0.95)
+                    << ",\"max\":" << percentile(values, 1.0) << "}";
