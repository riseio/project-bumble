+//
+// RT64
+//
+
+#include "rt64_performance_profiler.h"
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <cstring>
+#include <cstdio>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <iomanip>
+#include <limits>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <new>
+#include <sstream>
+#include <string>
+#include <thread>
+#include <unordered_map>
+#include <unordered_set>
+#include <utility>
+#include <vector>
+
+#ifdef _WIN32
+#include <d3d11.h>
+#include <dwmapi.h>
+#include <dxgi1_2.h>
+#include <pdh.h>
+#include <pdhmsg.h>
+#include <psapi.h>
+#include <tlhelp32.h>
+#elif defined(__linux__)
+#include <dirent.h>
+#include <unistd.h>
+#include <time.h>
+#endif
+
+namespace RT64 {
+    namespace {
+        using Clock = std::chrono::steady_clock;
+
+        enum class EventKind : uint8_t {
+            Duration,
+            Instant,
+            Counter
+        };
+
+        struct Event {
+            std::array<char, 80> name = {};
+            uint64_t timestampNanoseconds = 0;
+            uint64_t durationNanoseconds = 0;
+            uint64_t threadCpuDurationNanoseconds = 0;
+            uint64_t correlationId = 0;
+            uint64_t argument0 = 0;
+            uint64_t argument1 = 0;
+            uint64_t gpuStartNanoseconds = 0;
+            uint64_t gpuEndNanoseconds = 0;
+            double value = 0.0;
+            uint32_t threadId = 0;
+            PerformanceCategory category = PerformanceCategory::CPU;
+            EventKind kind = EventKind::Duration;
+            bool gpuClock = false;
+            bool threadCpuMeasured = false;
+        };
+
+        constexpr uint64_t EventChunkSize = 1'024;
+
+        struct ThreadBuffer {
+            uint32_t id = 0;
+            std::string name;
+            std::vector<std::unique_ptr<Event[]>> eventChunks;
+            uint64_t eventCount = 0;
+            uint64_t reservedEventsRemaining = 0;
+            uint64_t droppedEvents = 0;
+        };
+
+        struct Statistics {
+            std::string name;
+            PerformanceCategory category = PerformanceCategory::CPU;
+            std::vector<double> milliseconds;
+            double totalMilliseconds = 0.0;
+        };
+
+        struct ThreadExecutionStatistics {
+            std::string name;
+            std::vector<double> wallMilliseconds;
+            std::vector<double> cpuMilliseconds;
+            std::vector<double> offCpuMilliseconds;
+        };
+
+        struct HostContributorObservation {
+            double cpuPercent = 0.0;
+            double gpuPercent = 0.0;
+            double workingSetMiB = 0.0;
+        };
+
+        struct HostResourceObservation {
+            uint64_t timestampNanoseconds = 0;
+            double systemCpuPercent = 0.0;
+            double externalCpuPercent = 0.0;
+            double externalGpuPercent = 0.0;
+            double availableMemoryMiB = 0.0;
+            bool systemCpuAvailable = false;
+            bool externalCpuAvailable = false;
+            bool externalGpuAvailable = false;
+            bool availableMemoryAvailable = false;
+            std::map<std::string, HostContributorObservation> contributors;
+        };
+
+        struct InterpolationBatchStatistics {
+            std::vector<double> wallMilliseconds;
+            std::vector<double> activeMilliseconds;
+            std::vector<double> gpuTransactionMilliseconds;
+            uint64_t activeDeadlineMisses = 0;
+            uint64_t gpuDeadlineMisses = 0;
+            uint64_t gpuTransactionsObserved = 0;
+            uint64_t gpuTransactionsComplete = 0;
+        };
+
+        struct GPUInterpolationTransaction {
+            uint64_t workloadId = 0;
+            uint32_t frameCount = 0;
+            double milliseconds = 0.0;
+            double deadlineMilliseconds = 0.0;
+        };
+
+        struct GPUWorkloadAccumulator {
+            double frameMilliseconds = 0.0;
+            uint64_t sampledFrames = 0;
+        };
+
+        struct DrawHotspotStatistics {
+            std::string name;
+            uint32_t shaderHash = 0;
+            uint64_t samples = 0;
+            uint64_t faces = 0;
+            double totalMilliseconds = 0.0;
+            std::vector<double> milliseconds;
+        };
+
+        struct SlowFrame {
+            uint64_t presentId = 0;
+            uint64_t workloadId = 0;
+            uint64_t targetSetId = 0;
+            double intervalMilliseconds = 0.0;
+            std::string diagnosis;
+            std::string primaryStage;
+            double primaryStageMilliseconds = 0.0;
+            double primaryOverlapMilliseconds = 0.0;
+            double primaryEvidenceMilliseconds = 0.0;
+            std::string primaryEvidenceBasis;
+            double pacingOverlapMilliseconds = 0.0;
+            std::string concurrentStage;
+            double concurrentOverlapMilliseconds = 0.0;
+            std::string confidence;
+        };
+
+        struct HostProcessUsage {
+            uint32_t processId = 0;
+            std::string name;
+            double cpuPercent = 0.0;
+            double gpuPercent = 0.0;
+            double workingSetMiB = 0.0;
+        };
+
+        struct HostResourceSnapshot {
+            double systemCpuPercent = 0.0;
+            double externalCpuPercent = 0.0;
+            double externalGpuPercent = 0.0;
+            double availableMemoryMiB = 0.0;
+            std::vector<HostProcessUsage> processes;
+        };
+
+        struct ProfilerState {
+            Clock::time_point origin = Clock::now();
+            std::filesystem::path outputPath;
+            std::filesystem::path summaryPath;
+            double budgetMilliseconds = 16.667;
+            uint64_t maximumEvents = 1'000'000;
+            uint64_t warmupFrames = 120;
+            uint64_t cooldownFrames = 30;
+            uint64_t minimumDurationNanoseconds = 250'000;
+            uint64_t slowDurationNanoseconds = 25'000'000;
+            uint64_t durationInterval = 16;
+            uint64_t counterInterval = 16;
+            uint64_t lowOverheadMinimumDurationNanoseconds = 500'000;
+            bool lowOverhead = false;
+            bool gpuInstrumentation = false;
+            uint64_t gpuFrameSampleInterval = 1;
+            bool keepDrawEvents = false;
+            std::atomic<uint64_t> reservedEvents = 0;
+            std::atomic<uint64_t> droppedEvents = 0;
+            std::atomic<bool> accepting = false;
+            std::atomic<bool> finished = false;
+            std::mutex registryMutex;
+            std::vector<ThreadBuffer *> threadBuffers;
+            std::mutex metadataMutex;
+            std::map<std::string, std::string> metadata;
+            std::mutex hostObservationMutex;
+            std::atomic<bool> hostObservationRunning = false;
+            std::thread hostObservationThread;
+#ifdef _WIN32
+            std::mutex displayObservationMutex;
+            std::atomic<bool> displayObservationRunning = false;
+            std::atomic<uint32_t> estimatedDisplayQueueDepth = 0;
+            uint32_t estimatedDisplayQueueCapacity = 0;
+            std::thread displayObservationThread;
+#endif
+        };
+
+        const char *categoryName(PerformanceCategory category) {
+            switch (category) {
+            case PerformanceCategory::Frame: return "frame";
+            case PerformanceCategory::CPU: return "cpu";
+            case PerformanceCategory::GPU: return "gpu";
+            case PerformanceCategory::Wait: return "wait";
+            case PerformanceCategory::Pacing: return "pacing";
+            case PerformanceCategory::Upload: return "upload";
+            case PerformanceCategory::Compile: return "compile";
+            case PerformanceCategory::IO: return "io";
+            case PerformanceCategory::Counter: return "counter";
+            default: return "unknown";
+            }
+        }
+
+        double parsePositiveDouble(const char *name, double fallback) {
+            const char *text = std::getenv(name);
+            if ((text == nullptr) || (text[0] == '\0')) {
+                return fallback;
+            }
+
+            char *end = nullptr;
+            const double value = std::strtod(text, &end);
+            return ((end != text) && (end != nullptr) && (*end == '\0') &&
+                std::isfinite(value) && (value > 0.0)) ? value : fallback;
+        }
+
+        uint64_t parsePositiveInteger(const char *name, uint64_t fallback) {
+            const char *text = std::getenv(name);
+            if ((text == nullptr) || (text[0] == '\0')) {
+                return fallback;
+            }
+
+            char *end = nullptr;
+            const unsigned long long value = std::strtoull(text, &end, 10);
+            return ((end != text) && (end != nullptr) && (*end == '\0') &&
+                (value > 0)) ? uint64_t(value) : fallback;
+        }
+
+        uint64_t parseNonNegativeInteger(const char *name, uint64_t fallback) {
+            const char *text = std::getenv(name);
+            if ((text == nullptr) || (text[0] == '\0')) {
+                return fallback;
+            }
+
+            char *end = nullptr;
+            const unsigned long long value = std::strtoull(text, &end, 10);
+            return ((end != text) && (end != nullptr) && (*end == '\0'))
+                ? uint64_t(value)
+                : fallback;
+        }
+
+        bool parseEnabledFlag(const char *name) {
+            const char *text = std::getenv(name);
+            return (text != nullptr) && (text[0] != '\0') &&
+                (text[0] != '0');
+        }
+
+        std::string jsonEscape(std::string_view text) {
+            std::ostringstream escaped;
+            for (const unsigned char character : text) {
+                switch (character) {
+                case '"': escaped << "\\\""; break;
+                case '\\': escaped << "\\\\"; break;
+                case '\b': escaped << "\\b"; break;
+                case '\f': escaped << "\\f"; break;
+                case '\n': escaped << "\\n"; break;
+                case '\r': escaped << "\\r"; break;
+                case '\t': escaped << "\\t"; break;
+                default:
+                    if (character < 0x20) {
+                        escaped << "\\u" << std::hex << std::setw(4)
+                            << std::setfill('0') << int(character) << std::dec;
+                    }
+                    else {
+                        escaped << char(character);
+                    }
+                    break;
+                }
+            }
+
+            return escaped.str();
+        }
+
+        ProfilerState &state() {
+            static ProfilerState *instance = []() {
+                auto *newState = new ProfilerState();
+                const char *output = std::getenv("RT64_PROFILE_OUTPUT");
+                if ((output == nullptr) || (output[0] == '\0')) {
+                    return newState;
+                }
+
+                newState->outputPath = std::filesystem::path(output);
+                const char *summary = std::getenv("RT64_PROFILE_SUMMARY");
+                if ((summary != nullptr) && (summary[0] != '\0')) {
+                    newState->summaryPath = std::filesystem::path(summary);
+                }
+                else {
+                    newState->summaryPath = newState->outputPath;
+                    newState->summaryPath += ".summary.json";
+                }
+
+                newState->budgetMilliseconds = parsePositiveDouble(
+                    "RT64_PROFILE_BUDGET_MS",
+                    newState->budgetMilliseconds
+                );
+                newState->maximumEvents = std::max<uint64_t>(
+                    1'000,
+                    parsePositiveInteger(
+                        "RT64_PROFILE_MAX_EVENTS",
+                        newState->maximumEvents
+                    )
+                );
+                newState->warmupFrames = parseNonNegativeInteger(
+                    "RT64_PROFILE_WARMUP_FRAMES",
+                    newState->warmupFrames
+                );
+                newState->cooldownFrames = parseNonNegativeInteger(
+                    "RT64_PROFILE_COOLDOWN_FRAMES",
+                    newState->cooldownFrames
+                );
+                const uint64_t minimumDurationMicroseconds =
+                    parseNonNegativeInteger(
+                        "RT64_PROFILE_MIN_DURATION_US",
+                        newState->minimumDurationNanoseconds / 1'000
+                    );
+                newState->minimumDurationNanoseconds = std::min(
+                    minimumDurationMicroseconds,
+                    std::numeric_limits<uint64_t>::max() / 1'000
+                ) * 1'000;
+                newState->slowDurationNanoseconds = uint64_t(
+                    std::min(
+                        newState->budgetMilliseconds * 1.5 * 1'000'000.0,
+                        double(std::numeric_limits<uint64_t>::max())
+                    )
+                );
+                newState->durationInterval = std::max<uint64_t>(
+                    1,
+                    parsePositiveInteger(
+                        "RT64_PROFILE_DURATION_INTERVAL",
+                        newState->durationInterval
+                    )
+                );
+                newState->counterInterval = std::max<uint64_t>(
+                    1,
+                    parsePositiveInteger(
+                        "RT64_PROFILE_COUNTER_INTERVAL",
+                        newState->counterInterval
+                    )
+                );
+                const uint64_t lowOverheadMinimumDurationMicroseconds =
+                    parseNonNegativeInteger(
+                        "RT64_PROFILE_LOW_OVERHEAD_MIN_DURATION_US",
+                        newState->lowOverheadMinimumDurationNanoseconds / 1'000
+                    );
+                newState->lowOverheadMinimumDurationNanoseconds = std::min(
+                    lowOverheadMinimumDurationMicroseconds,
+                    std::numeric_limits<uint64_t>::max() / 1'000
+                ) * 1'000;
+                newState->lowOverhead =
+                    parseEnabledFlag("RT64_PROFILE_LOW_OVERHEAD");
+                // GPU timestamp query pools are deliberately opt-in.
+                newState->gpuInstrumentation =
+                    (parseEnabledFlag("RT64_PROFILE_GPU") ||
+                        parseEnabledFlag("RT64_PROFILE_DRAW_DETAIL"));
+                newState->gpuFrameSampleInterval = std::max<uint64_t>(
+                    1,
+                    parsePositiveInteger(
+                        "RT64_PROFILE_GPU_FRAME_INTERVAL",
+                        newState->lowOverhead ? 8 : 1
+                    )
+                );
+                newState->keepDrawEvents =
+                    parseEnabledFlag("RT64_PROFILE_KEEP_DRAW_EVENTS");
+                newState->accepting.store(true, std::memory_order_release);
+                std::fprintf(
+                    stderr,
+                    "RT64_PROFILE enabled=1 mode=%s output=%s summary=%s budget_ms=%.3f max_events=%llu warmup_frames=%llu cooldown_frames=%llu min_duration_us=%llu slow_duration_us=%llu duration_interval=%llu counter_interval=%llu low_overhead_min_duration_us=%llu gpu_instrumentation=%d\n",
+                    newState->lowOverhead ? "low_overhead" : "detailed",
+                    newState->outputPath.string().c_str(),
+                    newState->summaryPath.string().c_str(),
+                    newState->budgetMilliseconds,
+                    static_cast<unsigned long long>(newState->maximumEvents),
+                    static_cast<unsigned long long>(newState->warmupFrames),
+                    static_cast<unsigned long long>(newState->cooldownFrames),
+                    static_cast<unsigned long long>(
+                        newState->minimumDurationNanoseconds / 1'000
+                    ),
+                    static_cast<unsigned long long>(
+                        newState->slowDurationNanoseconds / 1'000
+                    ),
+                    static_cast<unsigned long long>(
+                        newState->durationInterval
+                    ),
+                    static_cast<unsigned long long>(
+                        newState->counterInterval
+                    ),
+                    static_cast<unsigned long long>(
+                        newState->lowOverheadMinimumDurationNanoseconds / 1'000
+                    ),
+                    newState->gpuInstrumentation ? 1 : 0
+                );
+                std::fflush(stderr);
+                std::atexit([]() { PerformanceProfiler::finish(); });
+                return newState;
+            }();
+            return *instance;
+        }
+
+        ThreadBuffer *threadBuffer() {
+            ProfilerState &profiler = state();
+            if (!profiler.accepting.load(std::memory_order_acquire)) {
+                return nullptr;
+            }
+
+            thread_local ThreadBuffer *buffer = nullptr;
+            if (buffer == nullptr) {
+                buffer = new ThreadBuffer();
+                buffer->name = "Thread";
+                const std::scoped_lock lock(profiler.registryMutex);
+                buffer->id = uint32_t(profiler.threadBuffers.size() + 1);
+                profiler.threadBuffers.emplace_back(buffer);
+            }
+
+            return buffer;
+        }
+
+        void copyEventName(Event &event, std::string_view name) {
+            const size_t count = std::min(name.size(), event.name.size() - 1);
+            std::copy_n(name.data(), count, event.name.data());
+            event.name[count] = '\0';
+        }
+
+        void appendEvent(Event event) {
+            ProfilerState &profiler = state();
+            if (!profiler.accepting.load(std::memory_order_acquire)) {
+                return;
+            }
+
+            ThreadBuffer *buffer = threadBuffer();
+            if (buffer == nullptr) {
+                profiler.droppedEvents.fetch_add(1, std::memory_order_relaxed);
+                return;
+            }
+
+            if (buffer->reservedEventsRemaining == 0) {
+                constexpr uint64_t EventReservationSize = 1'024;
+                const uint64_t reservationStart =
+                    profiler.reservedEvents.fetch_add(
+                        EventReservationSize,
+                        std::memory_order_relaxed
+                    );
+                if (reservationStart >= profiler.maximumEvents) {
+                    ++buffer->droppedEvents;
+                    return;
+                }
+                buffer->reservedEventsRemaining = std::min(
+                    EventReservationSize,
+                    profiler.maximumEvents - reservationStart
+                );
+            }
+
+            if ((buffer->eventCount % EventChunkSize) == 0) {
+                std::unique_ptr<Event[]> chunk(
+                    new (std::nothrow) Event[EventChunkSize]
+                );
+                if (chunk == nullptr) {
+                    ++buffer->droppedEvents;
+                    return;
+                }
+
+                try {
+                    buffer->eventChunks.emplace_back(std::move(chunk));
+                }
+                catch (const std::bad_alloc &) {
+                    ++buffer->droppedEvents;
+                    return;
+                }
+            }
+
+            event.threadId = buffer->id;
+            Event &destination = buffer->eventChunks[
+                buffer->eventCount / EventChunkSize
+            ][buffer->eventCount % EventChunkSize];
+            destination = std::move(event);
+            ++buffer->eventCount;
+            --buffer->reservedEventsRemaining;
+        }
+
+        void appendCounterSample(std::string_view name, double value,
+            uint64_t correlationId) {
+            Event event;
+            copyEventName(event, name);
+            event.timestampNanoseconds = PerformanceProfiler::nowNanoseconds();
+            event.correlationId = correlationId;
+            event.value = value;
+            event.category = PerformanceCategory::Counter;
+            event.kind = EventKind::Counter;
+            appendEvent(std::move(event));
+        }
+
+        constexpr std::string_view HostProcessCpuPrefix =
+            "Host.ProcessCPU.";
+        constexpr std::string_view HostProcessGpuPrefix =
+            "Host.ProcessGPU.";
+        constexpr std::string_view HostProcessMemoryPrefix =
+            "Host.ProcessMemoryMiB.";
+
+        std::string hostCounterProcessName(std::string_view name) {
+            std::string result;
+            result.reserve(std::min<size_t>(name.size(), 32u));
+            for (const unsigned char character : name) {
+                if (result.size() >= 32u) {
+                    break;
+                }
+                const bool accepted =
+                    (character >= 'a' && character <= 'z') ||
+                    (character >= 'A' && character <= 'Z') ||
+                    (character >= '0' && character <= '9') ||
+                    character == '-' || character == '_';
+                result.push_back(accepted ? char(character) : '_');
+            }
+            return result.empty() ? "unknown" : result;
+        }
