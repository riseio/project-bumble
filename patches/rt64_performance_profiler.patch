+    uint32_t ShaderDescription::bumbleShaderFamily() const {
+        constexpr uint32_t FeatureMask = 0x7FFu;
+        constexpr uint32_t MaterialShift = 12u;
+        constexpr uint32_t MaterialMask = 0x7u;
+        constexpr uint32_t LightingEligible = 1u << 15u;
+        constexpr uint32_t ReflectionPass = 1u << 17u;
+        constexpr uint32_t MaterialEarth = 1u;
+        constexpr uint32_t MaterialWater = 2u;
+        constexpr uint32_t MaterialLegacyWaterOverlay = 3u;
+        constexpr uint32_t MaterialToxicWater = 4u;
+        constexpr uint32_t FamilyGeneric = 0u;
+        constexpr uint32_t FamilyWorld = 1u;
+        constexpr uint32_t FamilyWater = 2u;
+        constexpr uint32_t FamilyOverlay = 3u;
+
+        const uint32_t variant = bumbleShaderVariant;
+        if ((variant & ReflectionPass) != 0u) {
+            return FamilyGeneric;
+        }
+
+        const uint32_t material =
+            (variant >> MaterialShift) & MaterialMask;
+        if (material == MaterialWater ||
+            material == MaterialToxicWater) {
+            return FamilyWater;
+        }
+        if (material == MaterialLegacyWaterOverlay) {
+            return FamilyOverlay;
+        }
+        if (material == MaterialEarth ||
+            (variant & LightingEligible) != 0u) {
+            return FamilyWorld;
+        }
+
+        // Feature bits remain live push-constant data and deliberately do not select a family.
+        (void)FeatureMask;
+        return FamilyGeneric;
     }
 
