+                << "  },\n";
+            output << "  \"ranked_stages\": [\n";
+            const size_t rankedCount = std::min<size_t>(statistics.size(), 40);
+            for (size_t i = 0; i < rankedCount; i++) {
+                const Statistics &entry = statistics[i];
+                if (i > 0) {
+                    output << ",\n";
