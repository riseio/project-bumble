+
+            bool available = false;
+            for (dirent *entry = readdir(directory);
+                 entry != nullptr;
+                 entry = readdir(directory)) {
+                char *end = nullptr;
+                std::strtoul(entry->d_name, &end, 10);
+                if (end == entry->d_name || *end != '\0') {
+                    continue;
+                }
+
+                std::ifstream input(fdInfoRoot + "/" + entry->d_name);
+                std::string line;
+                while (std::getline(input, line)) {
+                    constexpr std::string_view EnginePrefix =
+                        "drm-engine-";
+                    if (line.compare(
+                            0,
+                            EnginePrefix.size(),
+                            EnginePrefix
+                        ) != 0) {
+                        continue;
+                    }
+
+                    const size_t separator = line.find(':');
+                    if (separator == std::string::npos) {
+                        continue;
+                    }
+                    std::istringstream valueStream(
+                        line.substr(separator + 1u)
+                    );
+                    uint64_t value = 0;
+                    std::string unit;
+                    if ((valueStream >> value >> unit) &&
+                        ((unit == "ns") || (unit == "nanoseconds"))) {
+                        gpuNanoseconds += value;
+                        available = true;
+                    }
+                }
+            }
+            closedir(directory);
+            return available;
+        }
