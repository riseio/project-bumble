diff --git a/src/render/rt64_bumble_shadow_geometry.h b/src/render/rt64_bumble_shadow_geometry.h
new file mode 100644
--- /dev/null
+++ b/src/render/rt64_bumble_shadow_geometry.h
@@ -0,0 +1,41 @@
+#pragma once
+
+#include "hle/rt64_workload.h"
+#include "xxHash/xxh3.h"
+#include <stdexcept>
+
+namespace RT64 {
+    // Source geometry is immutable within a workload, not across workloads.
+    inline uint64_t bumbleShadowGeometryKey(const DrawData &data,
+        uint64_t first, uint64_t count) {
+        if (first > data.faceIndices.size() || count > data.faceIndices.size() - first)
+            throw std::runtime_error("Invalid shadow caster index range");
+        XXH3_state_t state{};
+        XXH3_64bits_reset(&state);
+        for (uint64_t i = first; i < first + count; ++i) {
+            const uint32_t vertex = data.faceIndices[i];
+            const uint64_t position = uint64_t(vertex) * 3;
+            if (vertex >= data.worldIndices.size() || position + 3 > data.posFloats.size())
+                throw std::runtime_error("Invalid shadow caster vertex");
+            XXH3_64bits_update(&state, &vertex, sizeof(vertex));
+            XXH3_64bits_update(&state, &data.worldIndices[vertex], sizeof(data.worldIndices[vertex]));
+            XXH3_64bits_update(&state, &data.posFloats[position], 3 * sizeof(float));
+        }
+        return XXH3_64bits_digest(&state);
+    }
+
+    inline bool bumbleShadowGeometryMoving(const DrawData &data,
+        uint64_t first, uint64_t count) {
+        if (first > data.faceIndices.size() || count > data.faceIndices.size() - first)
+            throw std::runtime_error("Invalid shadow caster index range");
+        for (uint64_t i = first; i < first + count; ++i) {
+            const uint64_t position = uint64_t(data.faceIndices[i]) * 3;
+            if (position + 3 > data.velFloats.size())
+                throw std::runtime_error("Invalid shadow caster velocity");
+            if (data.velFloats[position] != 0 || data.velFloats[position + 1] != 0 ||
+                data.velFloats[position + 2] != 0)
+                return true;
+        }
+        return false;
+    }
+}
